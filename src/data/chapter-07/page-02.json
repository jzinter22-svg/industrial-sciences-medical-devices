    {
      "id": "subsection-7-2-1",
      "number": "1-2-7",
      "title": {
        "ar": "وحدة الإضاءة",
        "en": "Projector Unit"
      },
      "blocks": [
        {
          "type": "paragraph",
          "id": "projector-para-01",
          "content": {
            "ar": "تتألف هذه الوحدة من الاقسام الآتية والموضحة بالشكل (2-7):"
          }
        },
        {
          "type": "numbered-list",
          "id": "projector-parts",
          "items": [
            {
              "id": "part-01",
              "content": {
                "ar": "الجزء الاول من الدراع (قاعدة التثبيت) وهو الجزء المثبت بالجهاز."
              }
            },
            {
              "id": "part-02",
              "content": {
                "ar": "الجزء الثاني من الدراع الخاص بتحريك الضوء وممتصل بفصل متحرك لغرض سهولة تحريك الضوء للحصول على رؤية واضحة وممركزة وحركة من قبل الطبيب."
              }
            },
            {
              "id": "part-03",
              "content": {
                "ar": "المصدر الضوئي (الضوء والعاكس) (Light and Reflector) والعاكس هو لينعكس الإضاءة ويزيد من شدتها."
              }
            },
            {
              "id": "part-04",
              "content": {
                "ar": "المرشح الذي لايسمح بمرور الاطوال الموجية للون الأخضر-الأزرق، والتي تسمى بالالوان الباردة، لكون المصباح قريب من وجه المريض، ان المواصفات الفنية لوحدة الإضاءة هي تكون مركبة على درأع ذي حركة سهلة الحركة تسمح بالحصول على رؤية مركزة وواضحة لمساعدة الطبيب المعالج على التشخيص الصحيح، وإمكانية تعديل والسيطرة على شدة الإضاءة عن طريق مفتاح خاص. وتتميز المصابيح المستخدمة بسهولة تبديلها، وهي من نوع الهالوجين."
              }
            }
          ]
        },
