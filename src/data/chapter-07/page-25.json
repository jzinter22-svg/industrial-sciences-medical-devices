        {
          "type": "numbered-list",
          "id": "questions-part-1",
          "items": [
            {
              "id": "q-01",
              "content": {
                "ar": "اشرح الفرق بين آلات الحفر البطيئة والسريعة (التوربينات)؟"
              }
            },
            {
              "id": "q-02",
              "content": {
                "ar": "ما هي وظيفة صمام الأمان في ضاغط الهواء؟"
              }
            },
            {
              "id": "q-03",
              "content": {
                "ar": "اشرح المحرك الهوائي وأهم مميزاته؟"
              }
            },
            {
              "id": "q-04",
              "content": {
                "ar": "ما هو الفرق بين المحرك الكهربائي والمحرك الهوائي؟"
              }
            },
            {
              "id": "q-05",
              "content": {
                "ar": "اشرح دورة الهواء في جهاز الأسنان؟"
              }
            },
            {
              "id": "q-06",
              "content": {
                "ar": "ما هي الوحدات الرئيسية في جهاز الأسنان؟"
              }
            },
            {
              "id": "q-07",
              "content": {
                "ar": "اشرح وظيفة السرنج الثلاثي وأهم أجزاؤه؟"
              }
            },
            {
              "id": "q-08",
              "content": {
                "ar": "ما هو دور المضخة (الحوض) في جهاز الأسنان؟"
              }
            }
          ]
        }
      ]
    }
