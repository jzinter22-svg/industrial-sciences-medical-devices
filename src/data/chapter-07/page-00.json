  "sections": [
    {
      "id": "section-objectives",
      "number": "",
      "title": {
        "ar": "الأهداف"
      },
      "blocks": [
        {
          "type": "paragraph",
          "id": "objective-general",
          "content": {
            "ar": "الهدف العام: دراسة مكونات عيادة الأسنان الحديثة والأجهزة والأدوات المستخدمة فيها والتعرف على مبادئ عملها."
          }
        },
        {
          "type": "paragraph",
          "id": "objectives-intro",
          "content": {
            "ar": "الأهداف الخاصة: يستطيع الطالب بعد الانتهاء من دراسة وفهم الفصل أن:"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "يعرّف جهاز الأسنان ومكوناته الأساسية."
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "يشرح مبدأ عمل نظام الضاغط الهوائي ودوره في التجهيزات."
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "يعدد أنواع أدوات الحفر ويميز بين التوربينات والمحركات البطيئة."
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "يشرح وظائف نظام الكرسي الهيدروليكي والحركات المختلفة."
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "يفهم أنظمة الشفط والتفريغ والأدوات المساعدة."
              }
            },
            {
              "id": "objective-06",
              "content": {
                "ar": "يتعرف على الدوائر الكهربائية والتحكمية للجهاز."
              }
            },
            {
              "id": "objective-07",
              "content": {
                "ar": "يرسم المخططات الكتلوية للأنظمة المختلفة."
              }
            },
            {
              "id": "objective-08",
              "content": {
                "ar": "يحل جميع التمارين والأسئلة الموجودة في نهاية الفصل."
              }
            }
          ]
        }
      ]
    },

