          "id": "objectives-intro",
          "content": {
            "ar": "يكون الطالب بعد انهاء دراسته لهذا الفصل قد تعلم على مايلي:"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "معرفة جهاز الأسنان وأجزاؤه"
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "التعرف على الوحدات الرئيسية"
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "معرفة الوحدات الفرعية المتحركة بالجهاز"
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "مبدأ عمل كافة الأجزاء للجهاز"
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "مبدأ عمل الأجهزة الملحقة بالجهاز"
              }
            },
            {
              "id": "objective-06",
              "content": {
                "ar": "التعرف على مبادئ عمل أكثر من جهاز"
              }
            },
            {
              "id": "objective-07",
              "content": {
                "ar": "تعلم الدورات الاساسية للجهاز وهي الدورة الهوائية والدورة المائية ودورة الماء المقطر والدورة الكهربائية"
              }
            }
          ]
