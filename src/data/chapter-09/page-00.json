  "sections": [
    {
      "id": "section-objectives",
      "number": "",
      "title": {
        "ar": "الأهداف"
      },
      "blocks": [
        {
          "type": "paragraph",
          "id": "objective-general",
          "content": {
            "ar": "الهدف العام: يهدف هذا الفصل إلى دراسة جهاز التخدير، أجزاءه ومكوناته وكيفية عمل كل جزء منه بالتفصيل."
          }
        },
        {
          "type": "paragraph",
          "id": "objectives-intro",
          "content": {
            "ar": "الهدف الخاص: يُفترض من الطالب أن يكون قادرا على:"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "فهم ماهية التخدير وماهي الغازات والسوائل المستخدمة لهذا الغرض مع حفظ النسب المئوية لكل غاز."
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "استيعاب المخطط العام لجهاز التخدير وأجزائه وتفاصيله."
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "التعرف على بعض الأجهزة المهمة مثل صمام التحكم الدقيق والروتاميتر."
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "فهم نظرية عمل المبخرات ودراسة أنواعها."
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "دراسة دائرة عدم الرجوع ودائرة المريض وتتبع مسار الغازات."
              }
            }
          ]
        }
      ]
    },

