      "blocks": [
        {
          "type": "paragraph",
          "id": "objectives-intro",
          "content": {
            "ar": "يتمكن الطالب من معرفة ما يأتي:"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "مكونات القلب والعضلة القلبية والصمامات والدورات الدموية للقلب."
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "الأجزاء الكهربائية والميكانيكية لجهاز تخطيط القلب."
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "كيفية ربط المريض على جهاز تخطيط القلب."
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "طريقة رسم الإشارة القلبية من المفهوم الكهربائي للقلب."
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "الفعالية الكهربائية للقلب وشكل الإشارة القلبية."
              }
            },
            {
              "id": "objective-06",
              "content": {
                "ar": "كيفية استخدام ملحقات الجهاز."
              }
            },
            {
              "id": "objective-07",
              "content": {
                "ar": "المراحل الكهربائية داخل الجهاز."
              }
            },
            {
              "id": "objective-08",
              "content": {
                "ar": "طريقة تكبير الإشارة القلبية."
              }
            },
            {
              "id": "objective-09",
              "content": {
                "ar": "المخططات الكهربائية لكل مرحلة من مراحل تكبير الإشارة والمنظومات الملحقة بالجهاز."
              }
            }
          ]
        }
      ]
    },

