      "title": {
        "ar": "الأهداف"
      },
      "blocks": [
        {
          "type": "paragraph",
          "id": "objective-general",
          "content": {
            "ar": "الهدف العام: دراسة الأمواج الفوق صوتية ومعرفة استخداماتها الطبية المختلفة."
          }
        },
        {
          "type": "paragraph",
          "id": "objectives-intro",
          "content": {
            "ar": "الأهداف الخاصة: يستطيع الطالب بعد الانتهاء من دراسة وفهم الفصل أن:"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "يعرف : الموجات الفوق صوتية- المجس- البلورة- الظاهرة الكهروضوئية – تأثير دوبلر."
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "يعدد ويكتب القوانين الثلاثة للصوت مع فهم الأمثلة."
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "يعدد فوائد استخدام الأجهزة الفوق صوتية ويعدد أنماط إرسال الموجات."
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "يعدد الأجزاء التي تتكون منها الأجهزة الفوق صوتية الحديثة."
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "يعدد ويشرح أنواع العرض الصوري للأجهزة الصوتية."
              }
            },
            {
              "id": "objective-06",
              "content": {
                "ar": "يفهم ويحل جميع التمارين والأسئلة الموجودة في نهاية الفصل."
              }
            },
            {
              "id": "objective-07",
              "content": {
                "ar": "يرسم المخططات الكتلوية للأجهزة ويؤشر عليها باللغتين العربية والانكليزية."
              }
            },
            {
              "id": "objective-08",
              "content": {
                "ar": "يعدد اهم استخدامات الأمواج الفوق صوتية صوتية للعلاج."
              }
            }
          ]
        }
      ]
    },

