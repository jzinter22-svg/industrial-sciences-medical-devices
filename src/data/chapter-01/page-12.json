    {
      "id": "section-1-5-p12",
      "number": "1-5",
      "title": {
        "ar": "الوقاية من الإشعاع",
        "en": "X-Ray Protection"
      },
      "blocks": [

        {
          "type": "subsection",
          "id": "subsection-operators-protection",
          "number": "",
          "title": {
            "ar": "أولا : حماية العاملين",
            "en": "Operators Protection"
          }
        },

        {
          "type": "numbered-list",
          "id": "list-operators-protection-1",
          "items": [
            {
              "id": "operator-protection-01",
              "content": {
                "ar": "تجنب الحزمة الاولية: وهو اهم مبدأ حيث يجب الا يقع المصور الشعاعي ضمن مجال حزمة الاشعة فلا يواجه الحزمة مباشرة."
              }
            },
            {
              "id": "operator-protection-02",
              "content": {
                "ar": "المسافة: يجب ان يبتعد المصور الشعاعي عن مصدر الاشعة قدر الامكان، كما يجب ان يبتعد عن المصادر الثانوية الاخرى للاشعة وخاصة رأس المريض في حالة اشعة الاسنان حيث يبتعد على الاقل (6) قدم."
              }
            },
            {
              "id": "operator-protection-03",
              "content": {
                "ar": "الواقيات: يجب على المصور الشعاعي الوقوف خلف حاجز واق مصنوع من الرصاص لامتصاص الاشعة المتناثرة وهذا يمكن الطبيب مراقبة المريض عبر نافذة مؤلفة من الزجاج المخلوط بالرصاص."
              }
            }
          ]
        }

      ]
    }
  ],

