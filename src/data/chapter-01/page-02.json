        {
          "type": "definition",
          "id": "definition-main-power-supply",
          "number": "1-3-1",
          "term": {
            "ar": "مجهز القدرة الرئيسي",
            "en": "Main Power Supply"
          },
          "definition": {
            "ar": "يتم تجهيز جهاز الاشعة السينية من مصدر تجهيز القدرة الرئيسي اما احادي الطور (Singal Phase) (220V-50Hz) او ثلاثي الطور (Three Phase) (380V-50Hz) اعتمادا على قدرة الاجهزة وهنالك أجهزة تعمل بالتردد العالي (High Frequency)."
          }
        },

        {
          "type": "subsection",
          "id": "subsection-1-3-2",
          "number": "1-3-2",
          "title": {
            "ar": "أنبوبة الاشعة السينية",
            "en": "X-Ray Tube"
          }
        },

        {
          "type": "paragraph",
          "id": "intro-xray-tube",
          "content": {
            "ar": "لاحظ مكونات انبوبة الاشعة السينية في الشكل (1-2):-"
          }
        },

        {
          "type": "definition",
          "id": "definition-cathode",
          "number": "أ",
          "term": {
            "ar": "الكاثود (المهبط)",
            "en": "The Cathode"
          },
          "definition": {
            "ar": "وهو القطب السالب في انبوبة الاشعة السينية وهو عبارة عن فتيل (Filament) من مادة التنكستن (Tungsten) يتم امرار تيار فيه ويسبب هذا التيار تسخين الفتيل وتهيج ذراته واطلاق الكترونات تتجمع حول هذا الفتيل. يمكن ان يتألف الكاثود من فتيل واحد ويسمى الانبوب في هذه الحالة احادي التركيز ويمكن ان يتألف من فتيلين ويسمى ثنائي التركيز."
          }
        }

      ]
    }
