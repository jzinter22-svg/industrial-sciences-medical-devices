          "id": "objectives-intro",
          "content": {
            "ar": "بعد أن يكتمل الفصل يستطيع الطالب أن: -"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "يعرف جهاز الاشعة السينية وأنواعه ومجال أستخدام كل نوع."
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "يعدد مكونات أنبوبة الاشعة السينية ووظيفة كل مكون."
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "يعدد أنواع مولدة الضغط العالي المستخدمة في جهاز الاشعة السينية."
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "يرسم المخطط الكتلوي لجهاز الاشعة السينية."
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "يعرف مراحل تحميض الأفلام الشعاعية."
              }
            },
            {
              "id": "objective-06",
              "content": {
                "ar": "يعدد وسائل الحماية من الإشعاع للعاملين في مجال الاشعة السينية."
              }
            },
            {
              "id": "objective-07",
              "content": {
                "ar": "يعدد وسائل حماية المريض من الاشعة."
              }
            },
            {
              "id": "objective-08",
              "content": {
                "ar": "يعدد وسائل حماية المحيط من أجهزة الاشعة السينية."
              }
            }
          ]
        }
      ]
