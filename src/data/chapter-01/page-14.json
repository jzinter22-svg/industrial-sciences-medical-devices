        {
          "type": "question",
          "id": "question-01",
          "number": 1,
          "question": { "ar": "عدد انواع اجهزة الاشعة السينية ومجال استخدام كل من هذه الانواع." }
        },
        {
          "type": "question",
          "id": "question-02",
          "number": 2,
          "question": { "ar": "عدد مكونات انبوبة الاشعة السينية." }
        },
        {
          "type": "question",
          "id": "question-03",
          "number": 3,
          "question": { "ar": "ارسم المخطط الكتلوي لجهاز الاشعة السينية." }
        },
        {
          "type": "question",
          "id": "question-04",
          "number": 4,
          "question": { "ar": "ما وظيفة كل من:-" },
          "parts": [
            { "id": "q4-a", "label": "أ", "content": { "ar": "الكاثود" } },
            { "id": "q4-b", "label": "ب", "content": { "ar": "الانود" } },
            { "id": "q4-c", "label": "ج", "content": { "ar": "الغلاف الزجاجي" } },
            { "id": "q4-d", "label": "د", "content": { "ar": "الغلاف المعدني" } }
          ]
        },
        {
          "type": "question",
          "id": "question-05",
          "number": 5,
          "question": { "ar": "علل مايلي :-" },
          "parts": [
            { "id": "q5-1", "label": "1", "content": { "ar": "وضع زيت بين الغلاف الزجاجي والغلاف المعدني." } },
            { "id": "q5-2", "label": "2", "content": { "ar": "تفريغ أنبوبة الاشعة السينية من الهواء وأية غازات أخرى." } },
            { "id": "q5-3", "label": "3", "content": { "ar": "استبدال الانود الثابت بانود دوار." } },
            { "id": "q5-4", "label": "4", "content": { "ar": "وجود مقياس mAs في وحدة السيطرة." } }
          ]
        },
        {
          "type": "question",
          "id": "question-06",
          "number": 6,
          "question": { "ar": "اشرح وظيفة المؤقت في جهاز الاشعة السينية مع رسم الدائرة الكهربائية." }
        },
        {
          "type": "question",
          "id": "question-07",
          "number": 7,
          "question": { "ar": "عدد أهم أنواع أجهزة التوقيت المستعملة اجهزة الاشعة السينية." }
        },
        {
          "type": "question",
          "id": "question-08",
          "number": 8,
          "question": { "ar": "عدد محاسن مولدة الضغط العالي ثلاثية الأطوار." }
        },
        {
          "type": "question",
          "id": "question-09",
          "number": 9,
          "question": { "ar": "عدد أنواع مولدة الضغط العالي المستخدمة في جهاز الاشعة السينية." }
        },
        {
          "type": "question",
          "id": "question-10",
          "number": 10,
          "question": { "ar": "عدد مساوئ مولدة الضغط العالي ثلاثية الأطوار." }
        },
        {
          "type": "question",
          "id": "question-11",
