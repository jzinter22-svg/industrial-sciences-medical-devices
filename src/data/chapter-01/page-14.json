              }
            },
            {
              "id": "environment-protection-04",
              "content": {
                "ar": "الالتزام بمبادئ حماية العاملين والمريض والإقلال قدر الإمكان من أخطاء التصوير ومعالجة الأفلام."
              }
            }
          ]
        }

      ]
