          "content": {
            "ar": "بعد ان يكتمل الفصل يستطيع الطالب أن :-"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            { "id": "objective-01", "content": { "ar": "يعرف أنواع وأنماط منظمات القلب الاصطناعية." } },
            { "id": "objective-02", "content": { "ar": "يعرف مساوئ استعمال منظم ضربات القلب الخارجي." } },
            { "id": "objective-03", "content": { "ar": "يرسم المخطط الكتلوي للمنظم الاصطناعي غير التزامني والمنظم الاصطناعي عند الطلب." } },
            { "id": "objective-04", "content": { "ar": "يعرف أنواع المذبذبات المستعملة في أجهزة تنظيم ضربات القلب." } },
            { "id": "objective-05", "content": { "ar": "يعرف أنواع ومزايا اجهزة الرجة الكهربائية." } },
            { "id": "objective-06", "content": { "ar": "يعرف تركيب وعمل جهاز الرجة الكهربائية غير المتزامن والمتزامن." } },
            { "id": "objective-07", "content": { "ar": "يعرف الأشكال الموجية لأجهزة الرجة الكهربائية." } }
          ]
        }
      ]
    },

