      },
      "blocks": [
        {
          "type": "paragraph",
          "id": "objectives-intro",
          "content": {
            "ar": "بعد ان يكتمل الفصل يستطيع الطالب أن:-"
          }
        },
        {
          "type": "numbered-list",
          "id": "list-objectives",
          "items": [
            {
              "id": "objective-01",
              "content": {
                "ar": "يعرف مبدأ عمل جهاز الجراحة الكهربائي."
              }
            },
            {
              "id": "objective-02",
              "content": {
                "ar": "يعرف أنواع أقطاب أجهزة الجراحة الكهربائية."
              }
            },
            {
              "id": "objective-03",
              "content": {
                "ar": "يعرف العوامل التي تعتمد عليها كمية الحرارة المتولدة في النسيج."
              }
            },
            {
              "id": "objective-04",
              "content": {
                "ar": "يعرف الإشكال الموجية المستعملة في أنماط الجراحة."
              }
            },
            {
              "id": "objective-05",
              "content": {
                "ar": "يعرف تطبيقات أجهزة الجراحة الكهربائية."
              }
            },
            {
              "id": "objective-06",
              "content": {
                "ar": "يرسم المخطط الكتلي لوحدة الجراحة الكهربائية."
              }
            },
            {
              "id": "objective-07",
              "content": {
                "ar": "يعرف مبدأ عمل دوائر وحدة الجراحة الكهربائية مع رسم دائرة كل منها."
              }
            },
            {
              "id": "objective-08",
              "content": {
                "ar": "يعرف أنواع أجهزة الجراحة الكهربائية."
              }
            },
            {
              "id": "objective-09",
              "content": {
                "ar": "يعرف وظائف أجهزة الجراحة الكهربائية الحديثة."
              }
            },
            {
              "id": "objective-10",
              "content": {
                "ar": "يعرف احتياطات استعمال أجهزة الجراحة الكهربائية."
              }
            }
          ]
        }
      ]
