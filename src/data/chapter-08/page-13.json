  "title": {
    "ar": "أجهزة الجراحة الكهربائية",
    "en": "Electrosurgical Instruments"
  },

  "sections": [
    {
      "id": "section-questions",
      "number": "",
      "title": {
        "ar": "أسئلة الفصل الثامن"
      },
      "blocks": [
        {
          "type": "question",
          "id": "question-01",
          "number": 1,
          "question": {
            "ar": "عرّف ما يأتي: جهاز الجراحة الكهربائي، القطب الفعال، القطب غير الفعال، دواسة القدم، عملية القطع، عملية التخثر."
          }
        },
        {
          "type": "question",
          "id": "question-02",
          "number": 2,
          "question": {
            "ar": "علّل ما يأتي:-"
          },
          "parts": [
            { "id": "q2-a", "label": "أ", "content": { "ar": "استعمال تيار كهربائي ذي تردد عالٍ في أجهزة الجراحة الكهربائية." } },
            { "id": "q2-b", "label": "ب", "content": { "ar": "الحرارة المتولدة في القطب الفعال تكون عالية بينما تكون حرارة القطب غير الفعال قليلة، على الرغم من مرور التيار نفسه في القطبين." } },
            { "id": "q2-c", "label": "جـ", "content": { "ar": "يُفضّل استعمال محولة رافعة نوع الفرايت في دائرة مكبر القدرة." } }
          ]
        },
        {
          "type": "question",
          "id": "question-03",
          "number": 3,
          "question": {
            "ar": "ما مبدأ عمل جهاز الجراحة الكهربائي؟"
          }
        },
        {
          "type": "question",
          "id": "question-04",
          "number": 4,
          "question": {
            "ar": "اذكر العوامل التي تعتمد عليها كمية حرارة النسيج."
          }
        },
        {
          "type": "question",
          "id": "question-05",
          "number": 5,
          "question": {
            "ar": "ما الإشكال الموجية المستخدمة في أنماط الجراحة؟ وضّح ذلك مع الرسم."
          }
        },
        {
          "type": "question",
          "id": "question-06",
          "number": 6,
          "question": {
            "ar": "ارسم المخطط الكتلي لوحدة الجراحة الكهربائية."
          }
        },
        {
          "type": "question",
          "id": "question-07",
          "number": 7,
          "question": {
            "ar": "وضّح مع الرسم عمل الدوائر الالكترونية لجهاز الجراحة الكهربائي الآتية:-"
          },
          "parts": [
            { "id": "q7-a", "label": "أ", "content": { "ar": "دائرة الحماية والسيطرة." } },
            { "id": "q7-b", "label": "ب", "content": { "ar": "دائرة مذبذب التردد العالي." } },
            { "id": "q7-c", "label": "جـ", "content": { "ar": "دائرة مكبر القدرة." } },
            { "id": "q7-d", "label": "د", "content": { "ar": "دائرة مفتاح اختيار قطع/ تخثر." } },
            { "id": "q7-e", "label": "هـ", "content": { "ar": "دائرة المذبذب المتعدد الغير مستقر." } }
          ]
        },
        {
          "type": "question",
          "id": "question-08",
          "number": 8,
          "question": {
            "ar": "عدد أنواع أقطاب أجهزة الجراحة الكهربائية."
          }
        },
        {
          "type": "question",
          "id": "question-09",
          "number": 9,
          "question": {
            "ar": "ما مبدأ عمل أجهزة الجراحة الكهربائية التي تعمل بتقنية مذبذب الترانزستور والمفتاح الالكتروني؟ وضّح ذلك مع الرسم."
          }
        },
        {
          "type": "question",
          "id": "question-10",
          "number": 10,
          "question": {
            "ar": "ما مبدأ عمل أجهزة الجراحة الكهربائية التي تعمل بتقنية التضمين ومولد الدالة؟ وضّح ذلك مع الرسم."
          }
        },
        {
          "type": "question",
          "id": "question-11",
          "number": 11,
          "question": {
            "ar": "عدد وظائف أجهزة الجراحة الكهربائية الحديثة."
          }
        },
        {
          "type": "question",
          "id": "question-12",
          "number": 12,
          "question": {
            "ar": "ما احتياطات استعمال أجهزة الجراحة الكهربائية؟"
          }
        }
      ]
    }
  ],

