export function getStaticPaths() {
  return bookData.chapters.flatMap((chapter) =>
    chapter.lessons.map((lesson) => ({
      params: { chapter: chapter.id, lesson: lesson.id },
      props: { chapter, lesson },
    }))
  );
}

const { chapter, lesson } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isChapter01Lesson01 = chapter.id === "chapter-01" && lesson.id === "lesson-01";
const isChapter02Lesson01 = chapter.id === "chapter-02" && lesson.id === "lesson-01";
const isChapter03Lesson01 = chapter.id === "chapter-03" && lesson.id === "lesson-01";
const isChapter04Lesson01 = chapter.id === "chapter-04" && lesson.id === "lesson-01";
const isChapter05Lesson01 = chapter.id === "chapter-05" && lesson.id === "lesson-01";
const isChapter06Lesson01 = chapter.id === "chapter-06" && lesson.id === "lesson-01";
const isChapter07Lesson01 = chapter.id === "chapter-07" && lesson.id === "lesson-01";
const hasContent = isChapter01Lesson01 || isChapter02Lesson01 || isChapter03Lesson01 || isChapter04Lesson01 || isChapter05Lesson01 || isChapter06Lesson01 || isChapter07Lesson01;
const lessonPages = isChapter01Lesson01
  ? chapter01Lesson01Pages
  : isChapter02Lesson01
    ? chapter02Lesson01Pages
    : isChapter03Lesson01
      ? chapter03Lesson01Pages
      : isChapter04Lesson01
        ? chapter04Lesson01Pages
        : isChapter05Lesson01
          ? chapter05Lesson01Pages
          : isChapter06Lesson01
            ? chapter06Lesson01Pages
            : chapter07Lesson01Pages;
---

<PageLayout title={`${lesson.title.ar} — ${chapter.title.ar} — ${bookData.book.ar}`}>
  {hasContent ? (
    <Fragment>
      <div class="lesson-breadcrumb-bar">
        <Breadcrumb
          crumbs={[
            { label: "الرئيسية", href: `${base}/` },
            { label: chapter.title.ar, href: `${base}/${chapter.id}/` },
            { label: lesson.title.ar },
          ]}
        />
      </div>
      <LessonRenderer pages={lessonPages} />
    </Fragment>
  ) : (
    <main class="lesson-placeholder-page">
      <Breadcrumb
        crumbs={[
          { label: "الرئيسية", href: `${base}/` },
          { label: chapter.title.ar, href: `${base}/${chapter.id}/` },
          { label: lesson.title.ar },
        ]}
      />
      <div class="lesson-placeholder neo-surface-soft">
        <h1 class="lesson-placeholder-title">{lesson.title.ar}</h1>
        {lesson.title.en && <p class="lesson-placeholder-title-en" dir="ltr">{lesson.title.en}</p>}
        <p class="lesson-placeholder-status">هذا الدرس قيد الإعداد وسيُضاف قريبًا.</p>
      </div>
    </main>
  )}
</PageLayout>

<style>
