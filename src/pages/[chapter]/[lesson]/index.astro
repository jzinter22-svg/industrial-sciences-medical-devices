    font-weight: 600;
    color: var(--neo-primary);
    unicode-bidi: isolate;
  }

  .lesson-placeholder-status {
    margin: var(--neo-space-md) 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--neo-muted);
  }

  @media (max-width: 640px) {
    .lesson-placeholder-page {
      padding: var(--neo-space-md) var(--neo-space-sm) var(--neo-space-lg);
    }
  }

  .lesson-breadcrumb-bar {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--neo-space-md) var(--neo-space-md) 0;
  }

  @media (max-width: 640px) {
    .lesson-breadcrumb-bar {
      padding: var(--neo-space-md) var(--neo-space-sm) 0;
    }
  }
</style>
