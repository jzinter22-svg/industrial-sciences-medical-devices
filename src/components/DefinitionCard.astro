---
// A dedicated card for "definition" blocks — per the Interactive Book
// Constitution (§5), a definition must remain clearly identifiable as a
// definition rather than blending into an ordinary paragraph. Reused for
// every "term: explanation" pair in the source, whether labeled with a
// letter (أ/ب/ج/د), a digit (1/2/3), or a full subsection number
// (e.g. "1-3-1"), since the source itself mixes all three schemes.
interface Props {
  number?: string;
  termAr: string;
  termEn?: string;
  content: string;
}

const { number, termAr, termEn, content } = Astro.props;
---

<article class="definition-card neo-surface">
  <div class="definition-header">
    {number && <span class="definition-badge" dir="ltr">{number}</span>}
    <div class="definition-titles">
      <h4 class="definition-term-ar">{termAr}</h4>
      {termEn && <p class="definition-term-en" dir="ltr">{termEn}</p>}
    </div>
  </div>
  <p class="definition-text">{content}</p>
</article>

<style>
  .definition-card {
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
    min-width: 0;
  }

  .definition-header {
    display: flex;
    align-items: flex-start;
    gap: var(--neo-space-sm);
    min-width: 0;
  }

  .definition-badge {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.9rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--neo-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .definition-titles {
    flex: 1;
    min-width: 0;
  }

  .definition-term-ar {
    margin: 0;
    font-size: var(--neo-font-size-h3);
    font-weight: 700;
    color: var(--neo-text);
  }

  .definition-term-en {
    margin: 2px 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-primary);
    unicode-bidi: isolate;
  }

  .definition-text {
    margin: 0;
    font-size: 0.98rem;
    line-height: var(--neo-line-height);
    color: var(--neo-text);
  }
</style>
