---
// Figure 8-14 (دائرة المذبذب المتعدد) — the Q2/Q3 cross-coupled
// transistor oscillator whose output square-wave period depends on the
// variable resistor Rp (F = 1 / (0.7×(R+Rp)×C)). Rather than a fixed
// waveform, this gets an interactive Rp slider (the same "control a
// parameter, watch the waveform respond" pattern as Chapter 1's kV/mA
// sliders) that redraws the square wave live and reports the qualitative
// effect — no invented absolute R/C/Hz values are shown, since the source
// gives only the relationship, not example component values.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft astable-multivibrator-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة المذبذب المتعدد الغير مستقر</span>
      <span class="simulator-subtitle">شكل 8-14 — أثر المقاومة المتغيرة (Rp) على التردد</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es14-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="780"
          height="330"
          viewBox="0 0 780 330"
          role="img"
          aria-label="دائرة المذبذب المتعدد"
        >
          <defs>
            <marker id="es14-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="es14BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es14Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es14GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="es14GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="es14Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es14Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="780" height="330" rx="20" fill="url(#es14BgGrad)"></rect>
          <rect x="0" y="0" width="780" height="330" rx="20" fill="url(#es14Grid)"></rect>

          <text x="390" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">المذبذب المتعدد الغير مستقر (Astable Multivibrator)</text>

          <g class="hotspot" data-component="cross-coupled-pair" tabindex="0" role="button" aria-label="زوج الترانزستورين المتقاطعين Q2 و Q3">
            <rect class="box-shape" x="50" y="70" width="220" height="140" rx="10" fill="url(#es14GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#es14Elevate)"></rect>
            <circle cx="115" cy="150" r="16" fill="none" stroke="#38BDF8" stroke-width="1.6"></circle>
            <text x="115" y="155" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">Q2</text>
            <circle cx="205" cy="150" r="16" fill="none" stroke="#38BDF8" stroke-width="1.6"></circle>
            <text x="205" y="155" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">Q3</text>
            <line x1="131" y1="145" x2="189" y2="155" stroke="#38BDF8" stroke-width="1.2" stroke-dasharray="3 3"></line>
            <line x1="131" y1="155" x2="189" y2="145" stroke="#38BDF8" stroke-width="1.2" stroke-dasharray="3 3"></line>
            <text x="160" y="95" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">تغذية عكسية متقاطعة</text>
            <text x="160" y="192" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" fill="#8fb8e0" direction="rtl">تتحكم Rp بزمن التوصيل/القطع</text>
          </g>

          <g class="link" data-link="cross-coupled-pair" data-link-to="output">
            <line id="es14-wire-1" x1="270" y1="140" x2="315" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es14-arrow)"></line>
            <line class="trail" x1="270" y1="140" x2="313" y2="140" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#38BDF8" filter="url(#es14Glow)" style="offset-path: url(#es14-wire-1); --flow-delay:0.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="output" tabindex="0" role="button" aria-label="خرج المذبذب">
            <rect class="box-shape" x="315" y="70" width="415" height="140" rx="10" fill="url(#es14GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es14Elevate)"></rect>
            <path class="square-wave" fill="none" stroke="#4ADE80" stroke-width="2.4" stroke-linejoin="round" filter="url(#es14Glow)"></path>
            <text x="522" y="195" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">موجة مربعة ذات تردد متغير</text>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">أثر Rp على التردد</h3>
        <ul class="status-list">
          <li class="status-row" data-status="cross-coupled-pair"><span class="status-dot dot-blue"></span><span class="status-label">Q2 / Q3</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يتذبذب</span></span></li>
          <li class="status-row" data-status="output"><span class="status-dot dot-green"></span><span class="status-label">الخرج</span><span class="status-value"><span class="value-off">لا يوجد</span><span class="value-on">موجة مربعة</span></span></li>
        </ul>

        <div class="rp-slider-block">
          <label for="es14-rp-slider" class="rp-slider-label">قيمة المقاومة المتغيرة Rp</label>
          <input id="es14-rp-slider" class="rp-slider" type="range" min="0" max="100" value="20" step="1" aria-describedby="es14-rp-readout" />
          <p id="es14-rp-readout" class="rp-readout">Rp منخفضة → تردد أعلى (F = 1 / (0.7×(R+Rp)×C))</p>
        </div>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>حرّك شريط Rp لمشاهدة أثره على شكل الموجة، أو انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الترانزستوران المتقاطعان</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الخرج المربّع</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#es14Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es14Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#es14Glow); }

  .rp-slider-block {
    margin-top: var(--neo-space-md);
    padding-top: var(--neo-space-sm);
    border-top: 1px dashed var(--neo-shadow-dark);
  }

  .rp-slider-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--neo-text);
    margin-bottom: 0.4rem;
  }

  .rp-slider {
    width: 100%;
    accent-color: #4ADE80;
  }

  .rp-readout {
    margin: 0.4rem 0 0;
    font-size: 0.78rem;
    color: var(--neo-muted);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es14-shape-activate { to { filter: url(#es14Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es14-reveal-trail { to { opacity: 0.85; } }
    @keyframes es14-status-value-on { to { opacity: 1; } }
    @keyframes es14-status-value-off { to { opacity: 0; } }
    @keyframes es14-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes es14-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="cross-coupled-pair"] .box-shape { animation: es14-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="cross-coupled-pair"] .status-dot { animation: es14-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="cross-coupled-pair"] .value-on { animation: es14-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="cross-coupled-pair"] .value-off { animation: es14-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="cross-coupled-pair"] .trail { animation: es14-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="output"] .box-shape { animation: es14-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="output"] .status-dot { animation: es14-dot-on-green 0.4s ease-out 1.1s forwards; }
    .playing [data-status="output"] .value-on { animation: es14-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="output"] .value-off { animation: es14-status-value-off 0.4s ease-out 1.1s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes es14-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: es14-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "cross-coupled-pair": {
      title: "الترانزستوران المتقاطعان (Q2, Q3)",
      text: "عندما يكون Q1 (المسمى هنا Q2 حسب ترقيم الدائرة) في حالة توصيل يصبح الآخر في حالة قطع، والعكس بالعكس. يمكن التحكم بزمن التوصيل والقطع عن طريق تغيير قيمة المقاومة المتغيرة (Rp).",
    },
    output: {
      title: "خرج المذبذب",
      text: "موجة مربعة الشكل ذات تردد منخفض. عندما تكون Rp=0 يكون زمن القطع مساويا لزمن التوصيل (R1=R2=R، C1=C2=C). وكلما زادت Rp زاد زمن القطع والتوصيل معا (ينخفض التردد)، حسب F = 1 / (0.7×(R+Rp)×C).",
    },
  };

  wireDiagramSimulator(".astable-multivibrator-diagram", { cycleMs: 2600, componentInfo: COMPONENT_INFO });

  // Rp slider: redraws the square wave live and reports the qualitative
  // effect on frequency (no invented absolute R/C/Hz values — the source
  // only gives the relationship, not example component values).
  document.querySelectorAll(".astable-multivibrator-diagram").forEach((figure) => {
    const slider = figure.querySelector<HTMLInputElement>(".rp-slider");
    const wave = figure.querySelector<SVGPathElement>(".square-wave");
    const readout = figure.querySelector(".rp-readout");
    if (!slider || !wave || !readout) return;

    const drawSquareWave = (rp: number) => {
      // rp in [0,100]; map to a half-period in px — higher Rp = wider
      // half-periods = visibly lower frequency, matching F = 1/(0.7(R+Rp)C).
      const halfPeriod = 14 + rp * 0.55;
      const x0 = 345;
      const width = 355;
      const yHigh = 115;
      const yLow = 165;
      let d = `M ${x0},${yLow}`;
      let x = x0;
      let high = true;
      while (x < x0 + width) {
        const next = Math.min(x + halfPeriod, x0 + width);
        d += ` L ${x},${high ? yHigh : yLow} L ${next},${high ? yHigh : yLow}`;
        x = next;
        high = !high;
      }
      wave.setAttribute("d", d);
    };

    const updateReadout = (rp: number) => {
      if (rp < 20) {
        readout.textContent = "Rp منخفضة جدا → زمن قطع وتوصيل قصير → تردد مرتفع";
      } else if (rp < 60) {
        readout.textContent = "Rp متوسطة → زمن قطع وتوصيل معتدل → تردد متوسط";
      } else {
        readout.textContent = "Rp مرتفعة → زمن قطع وتوصيل طويل → تردد منخفض";
      }
    };

    const rerender = () => {
      const rp = Number(slider.value);
      drawSquareWave(rp);
      updateReadout(rp);
    };

    slider.addEventListener("input", rerender);
    rerender();
  });
</script>
