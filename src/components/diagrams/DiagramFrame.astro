---
// Reusable layout shell for the Educational Diagram System.
//
// Visual authority: docs/design/GOLDEN_VISUAL_REFERENCE.png, specified in
// docs/design/GOLDEN_VISUAL_REFERENCE.md. Composition: one dominant
// illustration on one side, a single top-to-bottom column of
// self-contained explanatory cards on the other side, connected by short
// non-crossing leader lines. An optional narrow zone carries lighter-weight
// secondary annotations (e.g. a tiny structure that doesn't warrant a full
// numbered card) on the illustration's other flank.
//
// This component owns ONLY the stage layout — it has no knowledge of any
// specific diagram's shapes, cards, colors, or scientific content. The one
// exception is the leader-line overlay below: it connects any element
// carrying `data-leader-anchor="<id>"` (inside the illustration) to any
// element carrying `data-leader-target="<id>"` (inside the cards/minor
// zones) using their real rendered positions. This is deliberately generic
// (no anatomy/label knowledge) because cards and minor labels stack in
// normal document flow — their heights vary with real text at each screen
// width, so only a measured line, not a computed percentage, can stay
// attached to a card that may have shifted. (An earlier evenly-spaced
// percentage scheme was measured to overlap every card at every
// breakpoint; this replaces it.)
interface Props {
  ariaLabel: string;
}

const { ariaLabel } = Astro.props;
---

<div class="diagram-frame neo-surface-soft" role="group" aria-label={ariaLabel}>
  <div class="diagram-stage">
    <div class="diagram-minor">
      <slot name="minor" />
    </div>
    <div class="diagram-illustration">
      <slot name="illustration" />
    </div>
    <div class="diagram-cards">
      <slot name="cards" />
    </div>
    <svg class="leader-overlay" aria-hidden="true"></svg>
  </div>

  <div class="diagram-caption">
    <slot name="caption" />
  </div>

  <div class="diagram-controls">
    <slot name="controls" />
  </div>
</div>

<style>
  /* An explicit width (not "auto") is load-bearing here, not decoration:
     this element also has horizontal auto margins (below) to center it.
     A flex/block item with auto side margins but no explicit width sizes
     to its own content's min-content width instead of its parent's —
     measured, at width:100%, to be 464px (the stage grid's column
     floors), which overflowed the actual device card (as narrow as
     ~275px in the 3-column device grid at 1024px) by up to ~190px. An
     explicit percentage forces sizing from the parent's actual available
     width first.
     92%, not 100%: measured to otherwise fill its parent card's content
     box exactly, edge to edge, at every breakpoint — no breathing room,
     nothing for the auto side margins to actually center against. 92%
     leaves ~4% clear on each side. Width is intentionally NOT reduced
     further in this pass — the illustration's own rendered size is a
     percentage of this same box (see TomographySectionsDiagram.astro),
     so any further width cut would shrink the illustration too, which is
     explicitly out of scope here. Only the frame's own vertical margin/
     padding/gap were tightened (below), to fit the whole diagram — all
     five cards plus the complete illustration — inside one mobile
     viewport height with a safety margin: measured at 375×667px (the
     smallest common modern phone, no browser chrome subtracted) the
     total was already 634px against a 667px viewport before this change
     — technically fitting, but only by 33px, too thin a margin against
     any real device's address-bar chrome. max-width kept as a defensive
     ceiling (still never the binding constraint against any of this
     project's device cards, at any width). */
  .diagram-frame {
    width: 92%;
    max-width: 440px;
    margin: var(--neo-space-xs) auto 0;
    padding: 0.4rem var(--neo-space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--neo-space-xs);
    min-width: 0;
    box-sizing: border-box;
  }

  /* Side by side at every width, not just above a breakpoint: each card is
     connected to its illustration anchor by a measured leader line (see the
     script below), so stacking illustration above/below the card column on
     narrow screens would point every leader line at empty space instead of
     adapting — keeping the zones side by side is what actually preserves
     the label-to-structure relationship on mobile. The illustration stays
     the dominant zone (wider than the card column) at every width.
     Column floors are sized for the diagram's real container — a device
     card, not the full viewport — measured as narrow as ~250px (3-column
     device grid at 1024px). A viewport media query can't safely detect
     that (1024px is "desktop" by viewport but yields a narrower card than
     768px's 2-column layout), so both this and the breakpoint below use
     floors proven to fit the tightest real case, and let each column's fr
     weight (illustration highest) claim any real extra space instead.
     Cards' floor was measured to be a *frozen* minimum in this grid (with
     illustration's much higher fr weight, cards receive none of the
     track-sizing algorithm's leftover space beyond their floor at any
     tested width) — so cards' floor is effectively their actual rendered
     width, and illustration's floor is a starting point it then grows
     from. This pass leaves cards' floor essentially alone (refinement
     came from tighter card padding instead, see DiagramCard.astro) and
     takes the illustration's further growth from the minor column, whose
     floor shrank too — its labels are now spaced by real proportional
     gaps (see the diagram's own "minor" slot) instead of even
     space-around distribution, so it no longer needs as much height/width
     to stay uncrowded. */
  .diagram-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(20px, 0.3fr) minmax(116px, 1.9fr) minmax(104px, 1.1fr);
    gap: var(--neo-space-xs);
    align-items: stretch;
    min-width: 0;
  }

  /* Cards and minor labels stack in normal flow (not absolute + percent):
     their real content height varies with text length at each width, so
     letting the browser lay them out top-to-bottom is what actually
     guarantees no overlap. space-between lets a short column (e.g. two
     minor labels) spread across the full row height, which is set by
     whichever zone (illustration or cards) is naturally tallest.
     No justify-content here (unlike .diagram-cards below): the minor
     column's own flex-grow spacers — rendered by the diagram alongside
     each label, sized proportionally to that label's real anatomical
     anchor position — already control the vertical distribution, so an
     even space-around/space-between would fight them. Even distribution
     previously put each label at a fixed fraction of the row regardless
     of where its actual anchor sat, which is what made some connector
     lines noticeably longer/more diagonal than necessary. */
  .diagram-minor {
    grid-row: 1;
    grid-column: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .diagram-minor:empty {
    display: none;
  }

  .diagram-illustration {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .diagram-cards {
    grid-row: 1;
    grid-column: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.3rem;
    min-width: 0;
  }

  .leader-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .diagram-caption {
    text-align: center;
  }

  .diagram-caption:empty {
    display: none;
  }

  .diagram-controls {
    display: flex;
    justify-content: center;
  }

  .diagram-controls:empty {
    display: none;
  }

  @media (min-width: 640px) {
    .diagram-stage {
      /* A modest floor bump, not the previous 160px/200px: those assumed
         a viewport ≥640px implies a wide container, but this component's
         real container is a device card, which is only ~250-315px wide
         across every breakpoint that matters here (see comment above).
         Cards' floor stays well above the point where a card's header
         (badge+title+icon) was measured to collapse and visually
         overlap — text is the one thing here that must never be
         compressed — re-verified per card, individually, after this
         rebalance toward the illustration. */
      grid-template-columns: minmax(22px, 0.3fr) minmax(122px, 1.9fr) minmax(106px, 1.1fr);
    }
  }
</style>

<script>
  document.querySelectorAll(".diagram-frame").forEach((frame) => {
    // The optional replay control for an optional supplementary animation.
    // Targets `[data-playable]` rather than assuming an `<svg>` root: the
    // illustration may be a raster image (with an absolutely-positioned
    // overlay element carrying the animation) just as easily as inline SVG.
    const playableEl = frame.querySelector(".diagram-illustration [data-playable]");
    const replayButton = frame.querySelector(".diagram-replay-button");
    if (replayButton && playableEl) {
      replayButton.addEventListener("click", () => {
        playableEl.classList.remove("playing");
        void playableEl.getBoundingClientRect();
        playableEl.classList.add("playing");
      });
      playableEl.addEventListener("animationend", () => {
        playableEl.classList.remove("playing");
      });
    }

    // Leader-line overlay: connects each `[data-leader-anchor]` element
    // (inside the illustration) to the `[data-leader-target]` element
    // sharing its id (a card or a minor label), using their real rendered
    // positions rather than a computed percentage — cards and labels stack
    // in normal flow and can be any height, so only a measured line stays
    // attached to the right one.
    //
    // Each connector is drawn as a two-point polyline, not a single line
    // straight from the anchor to the card:
    //   1. true anchor position → the illustration zone's near edge, at
    //      the SAME y as the anchor (a short stub, so the line visually
    //      touches the dot instead of starting from an unrelated point on
    //      the container's outer edge).
    //   2. that edge point → the target (card/label), predominantly
    //      horizontal since step 1 already absorbed the anchor's vertical
    //      offset from the edge.
    // Collapsing every connector's step-2 start onto one shared edge x
    // (not the anchor's true interior x) is what keeps connectors
    // non-crossing: two point-sets sorted in the same top-to-bottom order
    // along two vertical lines can never cross when connected pairwise.
    const stage = frame.querySelector(".diagram-stage");
    const overlay = frame.querySelector(".leader-overlay");
    const illustrationZone = frame.querySelector(".diagram-illustration");
    if (!stage || !overlay || !illustrationZone) return;

    const drawLeaders = () => {
      const stageBox = stage.getBoundingClientRect();
      const illusBox = illustrationZone.getBoundingClientRect();
      overlay.setAttribute("viewBox", `0 0 ${stageBox.width} ${stageBox.height}`);
      overlay.innerHTML = "";

      frame.querySelectorAll("[data-leader-anchor]").forEach((anchorEl) => {
        const id = anchorEl.getAttribute("data-leader-anchor");
        const targetEl = frame.querySelector(`[data-leader-target="${id}"]`);
        if (!targetEl) return;

        const a = anchorEl.getBoundingClientRect();
        const t = targetEl.getBoundingClientRect();
        const facingRight = t.left + t.width / 2 > illusBox.left + illusBox.width / 2;
        const anchorX = a.left + a.width / 2 - stageBox.left;
        const anchorY = a.top + a.height / 2 - stageBox.top;
        const edgeX = (facingRight ? illusBox.right : illusBox.left) - stageBox.left;
        const tx = (t.left < a.left ? t.right : t.left) - stageBox.left;
        const ty = t.top + t.height / 2 - stageBox.top;

        const polyline = document.createElementNS("http://www.w3.org/2000/svg", "polyline");
        polyline.setAttribute("points", `${anchorX},${anchorY} ${edgeX},${anchorY} ${tx},${ty}`);
        polyline.setAttribute("fill", "none");
        polyline.setAttribute("stroke", anchorEl.getAttribute("data-leader-color") || "currentColor");
        polyline.setAttribute("stroke-width", anchorEl.getAttribute("data-leader-width") || "1.5");
        polyline.setAttribute("stroke-linejoin", "round");
        if (anchorEl.hasAttribute("data-leader-dashed")) {
          polyline.setAttribute("stroke-dasharray", "3 3");
        }
        overlay.appendChild(polyline);
      });
    };

    drawLeaders();
    window.addEventListener("resize", drawLeaders);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(drawLeaders);
    }
    new ResizeObserver(drawLeaders).observe(stage);
  });
</script>
