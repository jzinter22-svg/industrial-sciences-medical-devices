---
// Reusable layout shell for the Educational Diagram System.
//
// Approved visual standard: "Simplified Educational Infographic". The
// illustration is the primary object; Arabic labels sit directly around it
// (never a separate numbered legend) connected by short, non-crossing
// leader lines. This component owns ONLY the three-zone stage layout
// (start callouts | illustration | end callouts) plus the caption/controls
// zones below it — it has no knowledge of any specific diagram's shapes,
// callouts, or scientific content.
//
// "start"/"end" (not "left"/"right"): in this RTL-primary book, logical
// start renders on the right and end on the left, matching normal reading
// flow instead of hard-coding a physical side.
interface Props {
  ariaLabel: string;
}

const { ariaLabel } = Astro.props;
---

<div class="diagram-frame neo-surface-soft" role="group" aria-label={ariaLabel}>
  <div class="diagram-stage">
    <div class="diagram-callouts diagram-callouts-start">
      <slot name="callouts-start" />
    </div>
    <div class="diagram-illustration">
      <slot name="illustration" />
    </div>
    <div class="diagram-callouts diagram-callouts-end">
      <slot name="callouts-end" />
    </div>
  </div>

  <div class="diagram-caption">
    <slot name="caption" />
  </div>

  <div class="diagram-controls">
    <slot name="controls" />
  </div>
</div>

<style>
  .diagram-frame {
    margin-top: var(--neo-space-sm);
    padding: var(--neo-space-sm) var(--neo-space-md);
    display: flex;
    flex-direction: column;
    gap: var(--neo-space-md);
    min-width: 0;
  }

  /* The three-column stage (start callouts | illustration | end callouts)
     is used at every width, not just above some breakpoint: each callout's
     vertical position is a percentage of the illustration's own height
     (see DiagramCallout), so stacking columns above/below the illustration
     on narrow screens would point every leader line at empty space instead
     of intelligently adapting — keeping the three zones side by side is
     what actually preserves the label-to-structure relationship on mobile.
     Columns narrow and callout text wraps to two lines instead. */
  .diagram-stage {
    display: grid;
    grid-template-columns: minmax(60px, 0.8fr) minmax(96px, 1.3fr) minmax(60px, 0.8fr);
    gap: var(--neo-space-xs);
    align-items: stretch;
    min-width: 0;
  }

  .diagram-illustration {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .diagram-callouts {
    position: relative;
    min-width: 0;
  }

  .diagram-callouts-start {
    grid-row: 1;
    grid-column: 1;
  }

  .diagram-callouts-end {
    grid-row: 1;
    grid-column: 3;
  }

  .diagram-caption {
    text-align: center;
  }

  .diagram-caption:empty {
    display: none;
  }

  .diagram-controls {
    display: flex;
    justify-content: center;
  }

  .diagram-controls:empty {
    display: none;
  }

  /* Callout columns get a little more breathing room once there's space
     for it; the illustration itself grows too so the stage stays
     proportionate rather than just leaving extra gutter. */
  @media (min-width: 640px) {
    .diagram-stage {
      grid-template-columns: minmax(120px, 0.85fr) minmax(160px, 1.3fr) minmax(120px, 0.85fr);
    }
  }
</style>

<script>
  // The only cross-zone behavior a diagram may need from this shell: an
  // optional replay control for an optional supplementary animation.
  document.querySelectorAll(".diagram-frame").forEach((frame) => {
    const svg = frame.querySelector("svg");
    const replayButton = frame.querySelector(".diagram-replay-button");
    if (replayButton && svg) {
      replayButton.addEventListener("click", () => {
        svg.classList.remove("playing");
        void svg.getBoundingClientRect();
        svg.classList.add("playing");
      });
      svg.addEventListener("animationend", () => {
        svg.classList.remove("playing");
      });
    }
  });
</script>
