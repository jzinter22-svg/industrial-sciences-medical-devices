---
// Animated Figure 2-5 (المراقب واقف والعربة تتحرك بسرعة) — printed page
// 28. Static artwork kept pixel-identical (same 4 wavefront circles at
// their existing, already-compressed-ahead/spread-behind radii and
// centers — nothing repositioned or resized). Animation ripples the
// rings in true emission order: the largest/left-most ring (emitted
// earliest, while the source was farther back) pulses first, and the
// smallest/right-most ring (just emitted, nearest the source's current
// position) pulses last — visually teaching why the wavefronts bunch up
// ahead of a moving source and spread out behind it.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram doppler-moving-diagram">
  <div class="diagram-block-image">
    <svg
      class="dm-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="760"
      height="360"
      viewBox="0 0 760 360"
      role="img"
      aria-label="المراقب واقف والعربة تتحرك بسرعة"
    >
      <defs>
        <marker id="dm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#dc2626"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="760" height="360" fill="none"></rect>

      <g fill="none" stroke="#263238" stroke-width="2">
        <circle class="ripple-ring ring-newest" cx="410" cy="170" r="40"></circle>
        <circle class="ripple-ring ring-2" cx="390" cy="170" r="75"></circle>
        <circle class="ripple-ring ring-3" cx="360" cy="170" r="112"></circle>
        <circle class="ripple-ring ring-oldest" cx="320" cy="170" r="152"></circle>
      </g>

      <g class="flow-highlight truck">
        <rect x="370" y="150" width="80" height="35" rx="4" fill="#dc2626" stroke="#263238" stroke-width="2"></rect>
        <rect x="380" y="130" width="35" height="24" rx="3" fill="#dc2626" stroke="#263238" stroke-width="2"></rect>
        <circle cx="385" cy="188" r="9" fill="#263238"></circle>
        <circle cx="435" cy="188" r="9" fill="#263238"></circle>
      </g>
      <text x="410" y="220" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#dc2626" text-anchor="middle" direction="ltr">V m/s</text>
      <line class="flow-highlight velocity-arrow" x1="450" y1="167" x2="500" y2="167" stroke="#dc2626" stroke-width="3" marker-end="url(#dm-arrow)"></line>

      <text x="60" y="175" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="start" direction="ltr">λ</text>

      <path class="flow-highlight sine-trace" d="M 130,270 q 25,-25 50,0 t 50,0 t 45,-25 35,0 t 30,-25 25,0 t 22,-25 20,0" fill="none" stroke="#1d4ed8" stroke-width="2.5"></path>

      <g class="flow-highlight listener">
        <rect x="620" y="145" width="120" height="55" fill="#22c55e" stroke="#263238" stroke-width="2"></rect>
        <text x="680" y="168" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المستمع ساكن</text>
        <text x="680" y="188" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">والعربة تتحرك</text>
        <line x1="680" y1="135" x2="680" y2="105" stroke="#dc2626" stroke-width="3" marker-end="url(#dm-arrow)"></line>
      </g>

      <g class="flow-layer" aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 3.1s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 460px;
    display: flex;
    justify-content: center;
  }

  .dm-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .truck, .velocity-arrow { --highlight-delay: 1.3s; --highlight-duration: 0.5s; }
  .sine-trace { --highlight-delay: 1.9s; --highlight-duration: 0.8s; }
  .listener { --highlight-delay: 2.6s; --highlight-duration: 0.5s; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes ripple-fade {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }

    .playing .ring-oldest { animation: ripple-fade 0.4s ease-in-out 0.1s; }
    .playing .ring-3 { animation: ripple-fade 0.4s ease-in-out 0.4s; }
    .playing .ring-2 { animation: ripple-fade 0.4s ease-in-out 0.7s; }
    .playing .ring-newest { animation: ripple-fade 0.4s ease-in-out 1.0s; }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".doppler-moving-diagram");
</script>
