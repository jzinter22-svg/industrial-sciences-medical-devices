---
// Figures 8-3 (Monopolar) and 8-4 (Bipolar) — merged into a single
// interactive "before/after" comparison rather than two static drawings,
// since they are literally two configurations of the same generator ->
// electrode -> tissue -> return-path circuit. A mode toggle (in addition
// to the usual play/pause/reset) swaps which return path is shown: a
// separate large passive-electrode pad and full patient body for
// Monopolar, versus a second forceps tip with the tissue confined
// directly between the two prongs for Bipolar — this is the actual
// scientific difference the source text describes (no ground pad needed
// in Bipolar because the tissue is bounded by both electrode tips).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft electrode-types-diagram">
  <div class="simulator-shell" data-mode="monopolar">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة أنواع أقطاب أجهزة الجراحة</span>
      <span class="simulator-subtitle">شكل 8-3 و 8-4 — أحادي القطب مقابل ثنائي القطب</span>
    </div>

    <div class="mode-toggle-row">
      <button type="button" class="mode-toggle-button" data-mode-button="monopolar" aria-pressed="true">أحادي القطب (Monopolar)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="bipolar" aria-pressed="false">ثنائي القطب (Bipolar)</button>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es3-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="420"
          viewBox="0 0 820 420"
          role="img"
          aria-label="مقارنة الجراحة الكهربائية أحادية القطب وثنائية القطب"
        >
          <defs>
            <marker id="es3-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="es3BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es3Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es3GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="es3GradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1414"></stop><stop offset="100%" stop-color="#1a0a0a"></stop></linearGradient>
            <linearGradient id="es3GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="es3GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="es3Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es3Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="420" rx="20" fill="url(#es3BgGrad)"></rect>
          <rect x="0" y="0" width="820" height="420" rx="20" fill="url(#es3Grid)"></rect>

          <text class="mode-title-monopolar" x="410" y="34" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">الجراحة الكهربائية أحادية القطب (Monopolar)</text>
          <text class="mode-title-bipolar" x="410" y="34" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">الجراحة الكهربائية ثنائية القطب (Bipolar)</text>

          <!-- Generator: shared by both modes -->
          <g class="hotspot" data-component="generator" tabindex="0" role="button" aria-label="المولد">
            <rect class="box-shape" x="40" y="165" width="130" height="100" rx="10" fill="url(#es3GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#es3Elevate)"></rect>
            <text x="105" y="208" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">المولد</text>
            <text x="105" y="228" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Generator</text>
          </g>

          <!-- generator -> electrode (shared wire) -->
          <g class="link" data-link="generator" data-link-to="active-electrode">
            <path id="es3-wire-1" d="M 170,195 L 330,195" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es3-arrow)"></path>
            <path class="trail" d="M 170,195 L 328,195" fill="none" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></path>
            <circle class="current-particle" r="3.6" fill="#FBBF24" filter="url(#es3Glow)" style="offset-path: url(#es3-wire-1); --flow-delay:0.4s; --flow-duration:1s;"></circle>
          </g>

          <!-- Active electrode: pen icon (monopolar) -->
          <g class="hotspot monopolar-only" data-component="active-electrode" tabindex="0" role="button" aria-label="القطب الفعال">
            <rect class="box-shape" x="330" y="150" width="55" height="60" rx="8" fill="url(#es3GradRed)" stroke="#EF4444" stroke-width="2" filter="url(#es3Elevate)"></rect>
            <line x1="357" y1="210" x2="357" y2="240" stroke="#EF4444" stroke-width="4" stroke-linecap="round"></line>
            <text x="357" y="173" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">القطب</text>
            <text x="357" y="188" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">الفعال</text>
          </g>

          <!-- Active electrode: forceps icon (bipolar) — two prongs -->
          <g class="hotspot bipolar-only" data-component="active-electrode" tabindex="0" role="button" aria-label="القطبان الثنائيان">
            <rect class="box-shape" x="330" y="150" width="55" height="60" rx="8" fill="url(#es3GradRed)" stroke="#EF4444" stroke-width="2" filter="url(#es3Elevate)"></rect>
            <line x1="348" y1="210" x2="340" y2="248" stroke="#EF4444" stroke-width="4" stroke-linecap="round"></line>
            <line x1="366" y1="210" x2="374" y2="248" stroke="#38BDF8" stroke-width="4" stroke-linecap="round"></line>
            <text x="357" y="173" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">ملقط</text>
            <text x="357" y="188" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">ثنائي</text>
          </g>

          <!-- MONOPOLAR: patient body + passive electrode pad + return wire -->
          <g class="monopolar-only">
            <g class="link" data-link="active-electrode" data-link-to="patient">
              <path id="es3-wire-2" d="M 357,240 L 357,270" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#es3-arrow)"></path>
              <path class="trail" d="M 357,240 L 357,268" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="4 5"></path>
            </g>

            <g class="hotspot" data-component="patient" tabindex="0" role="button" aria-label="جسم المريض">
              <rect class="box-shape" x="260" y="270" width="200" height="80" rx="32" fill="url(#es3GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#es3Elevate)"></rect>
              <text x="360" y="308" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">جسم المريض</text>
              <text x="360" y="324" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#38BDF8" direction="ltr">Patient</text>
            </g>

            <g class="link" data-link="patient" data-link-to="passive-electrode">
              <path id="es3-wire-3" d="M 357,350 L 357,375" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es3-arrow)"></path>
              <path class="trail" d="M 357,350 L 357,373" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
              <circle class="current-particle" r="3.2" fill="#38BDF8" filter="url(#es3Glow)" style="offset-path: url(#es3-wire-3); --flow-delay:2.0s; --flow-duration:0.6s;"></circle>
            </g>

            <g class="hotspot" data-component="passive-electrode" tabindex="0" role="button" aria-label="القطب غير الفعال">
              <rect class="box-shape" x="250" y="375" width="220" height="28" rx="8" fill="url(#es3GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es3Elevate)"></rect>
              <text x="360" y="394" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">القطب غير الفعال (صفيحة أرضية)</text>
            </g>

            <g class="link" data-link="passive-electrode" data-link-to="generator">
              <path id="es3-wire-4" d="M 250,389 L 105,389 L 105,265" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es3-arrow)"></path>
              <path class="trail" d="M 250,389 L 105,389 L 105,267" fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></path>
              <circle class="current-particle" r="3.6" fill="#4ADE80" filter="url(#es3Glow)" style="offset-path: url(#es3-wire-4); --flow-delay:2.6s; --flow-duration:1.3s;"></circle>
            </g>
          </g>

          <!-- BIPOLAR: small tissue zone between prongs + return from second prong -->
          <g class="bipolar-only">
            <g class="link" data-link="active-electrode" data-link-to="tissue-zone">
              <path id="es3-wire-2b" d="M 340,248 L 340,275" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#es3-arrow)"></path>
              <path class="trail" d="M 340,248 L 340,273" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="4 5"></path>
            </g>

            <g class="hotspot" data-component="tissue-zone" tabindex="0" role="button" aria-label="النسيج المحصور بين الملقط">
              <ellipse class="box-shape" cx="357" cy="300" rx="55" ry="30" fill="url(#es3GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#es3Elevate)"></ellipse>
              <text x="357" y="296" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">نسيج محصور</text>
              <text x="357" y="311" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">بين الملقط</text>
            </g>

            <g class="link" data-link="tissue-zone" data-link-to="active-electrode">
              <path id="es3-wire-3b" d="M 374,275 L 374,248" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#es3-arrow)"></path>
              <path class="trail" d="M 374,275 L 374,250" fill="none" stroke="#38BDF8" stroke-width="2" stroke-dasharray="4 5"></path>
              <circle class="current-particle" r="3" fill="#38BDF8" filter="url(#es3Glow)" style="offset-path: url(#es3-wire-3b); --flow-delay:1.9s; --flow-duration:0.5s;"></circle>
            </g>

            <text x="480" y="300" text-anchor="start" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">لا حاجة لصفيحة أرضية — التيار</text>
            <text x="480" y="318" text-anchor="start" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">يرجع مباشرة عبر القطب الثاني</text>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة الدائرة</h3>
        <ul class="status-list">
          <li class="status-row" data-status="generator"><span class="status-dot dot-yellow"></span><span class="status-label">المولد</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يولّد RF</span></span></li>
          <li class="status-row" data-status="active-electrode"><span class="status-dot dot-red"></span><span class="status-label">القطب الفعال</span><span class="status-value"><span class="value-off">بارد</span><span class="value-on">نشط</span></span></li>
          <li class="status-row monopolar-only" data-status="patient"><span class="status-dot dot-blue"></span><span class="status-label">جسم المريض</span><span class="status-value"><span class="value-off">—</span><span class="value-on">يمر به التيار</span></span></li>
          <li class="status-row bipolar-only" data-status="tissue-zone"><span class="status-dot dot-blue"></span><span class="status-label">النسيج المحصور</span><span class="status-value"><span class="value-off">—</span><span class="value-on">يمر به التيار</span></span></li>
          <li class="status-row monopolar-only" data-status="passive-electrode"><span class="status-dot dot-green"></span><span class="status-label">القطب غير الفعال</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">تيار عائد</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون في المخطط لعرض شرحه — أو بدّل بين أحادي وثنائي القطب من الأزرار أعلاه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>المولد</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>القطب الفعال</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>مسار العودة عبر النسيج</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>القطب غير الفعال (أحادي فقط)</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .mode-toggle-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0 var(--neo-space-md) var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .mode-toggle-button {
    font-family: "Cairo", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #c3c9dc;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .mode-toggle-button:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .mode-toggle-button[aria-pressed="true"] {
    background: #FBBF24;
    border-color: #FBBF24;
    color: #1a1608;
  }

  .mode-title-bipolar { opacity: 0; }
  .simulator-shell[data-mode="bipolar"] .mode-title-monopolar { opacity: 0; }
  .simulator-shell[data-mode="bipolar"] .mode-title-bipolar { opacity: 1; }

  .bipolar-only { opacity: 0; pointer-events: none; }
  .simulator-shell[data-mode="bipolar"] .bipolar-only { opacity: 1; pointer-events: auto; }
  .simulator-shell[data-mode="bipolar"] .monopolar-only { opacity: 0; pointer-events: none; }

  li.monopolar-only, li.bipolar-only { transition: opacity 0.2s ease; }

  .hotspot .box-shape {
    filter: url(#es3Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es3Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#es3Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es3-shape-activate { to { filter: url(#es3Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es3-reveal-trail { to { opacity: 0.85; } }
    @keyframes es3-status-value-on { to { opacity: 1; } }
    @keyframes es3-status-value-off { to { opacity: 0; } }
    @keyframes es3-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes es3-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes es3-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes es3-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="generator"] .box-shape { animation: es3-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generator"] .status-dot { animation: es3-dot-on-yellow 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generator"] .value-on { animation: es3-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generator"] .value-off { animation: es3-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="generator"] .trail { animation: es3-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="active-electrode"] .box-shape { animation: es3-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="active-electrode"] .status-dot { animation: es3-dot-on-red 0.4s ease-out 1.1s forwards; }
    .playing [data-status="active-electrode"] .value-on { animation: es3-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="active-electrode"] .value-off { animation: es3-status-value-off 0.4s ease-out 1.1s forwards; }

    /* Monopolar timeline */
    .playing [data-link="active-electrode"][data-link-to="patient"] .trail { animation: es3-reveal-trail 0.3s ease-out 1.6s forwards; }
    .playing [data-component="patient"] .box-shape { animation: es3-shape-activate 0.4s ease-out 1.9s forwards; }
    .playing [data-status="patient"] .status-dot { animation: es3-dot-on-blue 0.4s ease-out 1.9s forwards; }
    .playing [data-status="patient"] .value-on { animation: es3-status-value-on 0.4s ease-out 1.9s forwards; }
    .playing [data-status="patient"] .value-off { animation: es3-status-value-off 0.4s ease-out 1.9s forwards; }
    .playing [data-link="patient"] .trail { animation: es3-reveal-trail 0.3s ease-out 2.4s forwards; }
    .playing [data-component="passive-electrode"] .box-shape { animation: es3-shape-activate 0.4s ease-out 2.7s forwards; }
    .playing [data-status="passive-electrode"] .status-dot { animation: es3-dot-on-green 0.4s ease-out 2.7s forwards; }
    .playing [data-status="passive-electrode"] .value-on { animation: es3-status-value-on 0.4s ease-out 2.7s forwards; }
    .playing [data-status="passive-electrode"] .value-off { animation: es3-status-value-off 0.4s ease-out 2.7s forwards; }
    .playing [data-link="passive-electrode"] .trail { animation: es3-reveal-trail 0.3s ease-out 3.0s forwards; }

    /* Bipolar timeline */
    .playing [data-link="active-electrode"][data-link-to="tissue-zone"] .trail { animation: es3-reveal-trail 0.3s ease-out 1.6s forwards; }
    .playing [data-component="tissue-zone"] .box-shape { animation: es3-shape-activate 0.4s ease-out 1.9s forwards; }
    .playing [data-status="tissue-zone"] .status-dot { animation: es3-dot-on-blue 0.4s ease-out 1.9s forwards; }
    .playing [data-status="tissue-zone"] .value-on { animation: es3-status-value-on 0.4s ease-out 1.9s forwards; }
    .playing [data-status="tissue-zone"] .value-off { animation: es3-status-value-off 0.4s ease-out 1.9s forwards; }
    .playing [data-link="tissue-zone"] .trail { animation: es3-reveal-trail 0.3s ease-out 2.2s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes es3-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: es3-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
    .simulator-shell[data-mode="bipolar"] .monopolar-only .current-particle,
    .simulator-shell:not([data-mode="bipolar"]) .bipolar-only .current-particle {
      animation: none !important;
      opacity: 0 !important;
    }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    generator: {
      title: "المولد (Generator)",
      text: "يولّد التيار المتناوب عالي التردد الذي يسري إلى القطب الفعال في يد الجراح.",
    },
    "active-electrode": {
      title: "القطب الفعال",
      text: "في أحادي القطب: على شكل قلم بمقطع صغير جدا. في ثنائي القطب: على شكل ملقط بقطبين، يعمل أحدهما فعالا والآخر لرجوع التيار.",
    },
    patient: {
      title: "جسم المريض (Monopolar)",
      text: "يمر التيار خلال جسم المريض بالكامل من موضع الجراحة إلى القطب غير الفعال.",
    },
    "passive-electrode": {
      title: "القطب غير الفعال (Monopolar)",
      text: "صفيحة معدنية كبيرة توضع أسفل المريض ليعود منها التيار إلى المولد، دون أن تسبب تسخينا محسوسا لكبر مساحتها.",
    },
    "tissue-zone": {
      title: "النسيج المحصور بين الملقط (Bipolar)",
      text: "في الجراحة الثنائية القطب يكون النسيج محصورا فقط بين جانبي الملقط، فلا حاجة لصفيحة أرضية لأن التيار يرجع مباشرة عبر القطب الثاني.",
    },
  };

  wireDiagramSimulator(".electrode-types-diagram", { cycleMs: 4000, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".electrode-types-diagram .mode-toggle-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".electrode-types-diagram")?.querySelector(".simulator-shell");
      const mode = btn.getAttribute("data-mode-button");
      if (!(shell instanceof HTMLElement) || !mode) return;
      shell.dataset.mode = mode;
      shell.querySelectorAll(".mode-toggle-button").forEach((b) => {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
    });
  });
</script>
