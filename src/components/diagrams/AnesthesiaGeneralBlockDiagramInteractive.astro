---
// Figure 9-1 (المخطط العام لجهاز التخدير) — the flagship diagram for
// Chapter 9. Traces the full gas path through the anesthesia device: gas
// cylinder -> pressure regulator -> needle valve -> collection manifold ->
// vaporizer -> back bar -> patient circuit (reservoir bag + mask). This is
// the same diagram referenced again in prose at the end of section 9-5
// (page-19), so every hotspot id here doubles as the vocabulary the rest
// of the chapter's diagrams build on.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft anesthesia-general-block-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة المخطط العام لجهاز التخدير</span>
      <span class="simulator-subtitle">شكل 9-1 — من مصدر الغاز إلى دائرة المريض</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="gt1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="980"
          height="380"
          viewBox="0 0 980 380"
          role="img"
          aria-label="المخطط العام لجهاز التخدير"
        >
          <defs>
            <marker id="gt1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="gt1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="gt1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="gt1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="gt1GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="gt1GradMagenta" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#331229"></stop><stop offset="100%" stop-color="#1a0916"></stop></linearGradient>
            <linearGradient id="gt1GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="gt1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>

            <filter id="gt1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="gt1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="980" height="380" rx="20" fill="url(#gt1BgGrad)"></rect>
          <rect x="0" y="0" width="980" height="380" rx="20" fill="url(#gt1Grid)"></rect>

          <text x="490" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">مسار الغاز عبر جهاز التخدير</text>

          <!-- 1. Gas supply cylinder -->
          <g class="hotspot" data-component="gas-supply" tabindex="0" role="button" aria-label="مصدر الغاز">
            <rect class="box-shape" x="20" y="130" width="95" height="90" rx="10" fill="url(#gt1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <rect x="55" y="115" width="25" height="18" rx="4" fill="none" stroke="#38BDF8" stroke-width="1.6"></rect>
            <text x="67" y="185" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">مصدر الغاز</text>
            <text x="67" y="200" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7.5" fill="#9fd8f8" direction="ltr">Gas supply</text>
          </g>

          <g class="link" data-link="gas-supply" data-link-to="regulator">
            <line id="gt1-wire-1" x1="115" y1="175" x2="150" y2="175" stroke="#5b6478" stroke-width="2.5" marker-end="url(#gt1-arrow)"></line>
            <line class="trail" x1="115" y1="175" x2="148" y2="175" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#gt1Glow)" style="offset-path: url(#gt1-wire-1); --flow-delay:0.2s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- 2. Pressure regulator -->
          <g class="hotspot" data-component="regulator" tabindex="0" role="button" aria-label="منظم الضغط">
            <rect class="box-shape" x="150" y="130" width="95" height="90" rx="10" fill="url(#gt1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <circle cx="197" cy="163" r="14" fill="none" stroke="#38BDF8" stroke-width="1.6"></circle>
            <line x1="197" y1="163" x2="203" y2="155" stroke="#38BDF8" stroke-width="1.6"></line>
            <text x="197" y="195" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">منظم الضغط</text>
            <text x="197" y="208" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#9fd8f8" direction="ltr">Regulator</text>
          </g>

          <g class="link" data-link="regulator" data-link-to="needle-valve">
            <line id="gt1-wire-2" x1="245" y1="175" x2="280" y2="175" stroke="#5b6478" stroke-width="2.5" marker-end="url(#gt1-arrow)"></line>
            <line class="trail" x1="245" y1="175" x2="278" y2="175" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#gt1Glow)" style="offset-path: url(#gt1-wire-2); --flow-delay:0.9s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- 3. Needle valve -->
          <g class="hotspot" data-component="needle-valve" tabindex="0" role="button" aria-label="صمام التحكم الدقيق">
            <rect class="box-shape" x="280" y="130" width="95" height="90" rx="10" fill="url(#gt1GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <path d="M 315,150 L 340,175 L 315,200" fill="none" stroke="#FB923C" stroke-width="1.8"></path>
            <text x="327" y="185" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">صمام التحكم</text>
            <text x="327" y="198" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#fcd9b6" direction="ltr">Needle valve</text>
          </g>

          <g class="link" data-link="needle-valve" data-link-to="manifold">
            <line id="gt1-wire-3" x1="375" y1="175" x2="410" y2="175" stroke="#5b6478" stroke-width="2.5" marker-end="url(#gt1-arrow)"></line>
            <line class="trail" x1="375" y1="175" x2="408" y2="175" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FB923C" filter="url(#gt1Glow)" style="offset-path: url(#gt1-wire-3); --flow-delay:1.6s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- 4. Manifold -->
          <g class="hotspot" data-component="manifold" tabindex="0" role="button" aria-label="مشعب التجميع">
            <rect class="box-shape" x="410" y="120" width="110" height="110" rx="10" fill="url(#gt1GradMagenta)" stroke="#E879F9" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <path d="M 435,145 L 445,175 L 455,145 M 460,145 L 470,175 L 480,145 M 485,145 L 495,175 L 505,145" fill="none" stroke="#E879F9" stroke-width="1.4"></path>
            <text x="465" y="200" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">مشعب التجميع</text>
            <text x="465" y="213" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#f5c2fb" direction="ltr">Manifold</text>
          </g>

          <g class="link" data-link="manifold" data-link-to="vaporizer">
            <line id="gt1-wire-4" x1="520" y1="175" x2="555" y2="175" stroke="#5b6478" stroke-width="2.5" marker-end="url(#gt1-arrow)"></line>
            <line class="trail" x1="520" y1="175" x2="553" y2="175" stroke="#E879F9" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#E879F9" filter="url(#gt1Glow)" style="offset-path: url(#gt1-wire-4); --flow-delay:2.3s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- 5. Vaporizer -->
          <g class="hotspot" data-component="vaporizer" tabindex="0" role="button" aria-label="المبخر">
            <rect class="box-shape" x="555" y="130" width="95" height="90" rx="10" fill="url(#gt1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <rect x="580" y="150" width="45" height="40" rx="6" fill="none" stroke="#4ADE80" stroke-width="1.6"></rect>
            <text x="602" y="205" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">المبخر</text>
            <text x="602" y="218" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#bcf5d1" direction="ltr">Vap</text>
          </g>

          <g class="link" data-link="vaporizer" data-link-to="back-bar">
            <line id="gt1-wire-5" x1="650" y1="175" x2="685" y2="175" stroke="#5b6478" stroke-width="2.5" marker-end="url(#gt1-arrow)"></line>
            <line class="trail" x1="650" y1="175" x2="683" y2="175" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#4ADE80" filter="url(#gt1Glow)" style="offset-path: url(#gt1-wire-5); --flow-delay:3.0s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- 6. Back bar -->
          <g class="hotspot" data-component="back-bar" tabindex="0" role="button" aria-label="العمود الخلفي">
            <rect class="box-shape" x="685" y="130" width="90" height="90" rx="10" fill="url(#gt1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <line x1="700" y1="150" x2="700" y2="200" stroke="#FBBF24" stroke-width="1.6" stroke-dasharray="4 4"></line>
            <text x="737" y="185" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">العمود الخلفي</text>
            <text x="737" y="198" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#fbe9b8" direction="ltr">Back bar</text>
          </g>

          <g class="link" data-link="back-bar" data-link-to="patient-circuit">
            <line id="gt1-wire-6" x1="775" y1="175" x2="810" y2="175" stroke="#5b6478" stroke-width="2.5" marker-end="url(#gt1-arrow)"></line>
            <line class="trail" x1="775" y1="175" x2="808" y2="175" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FBBF24" filter="url(#gt1Glow)" style="offset-path: url(#gt1-wire-6); --flow-delay:3.7s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- 7. Patient circuit -->
          <g class="hotspot" data-component="patient-circuit" tabindex="0" role="button" aria-label="دائرة المريض">
            <rect class="box-shape" x="810" y="115" width="150" height="120" rx="10" fill="url(#gt1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#gt1Elevate)"></rect>
            <ellipse cx="850" cy="175" rx="18" ry="26" fill="none" stroke="#FBBF24" stroke-width="1.6"></ellipse>
            <path d="M 875,175 Q 905,155 930,175 Q 905,195 890,180" fill="none" stroke="#FBBF24" stroke-width="1.6"></path>
            <text x="885" y="215" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">دائرة المريض</text>
            <text x="885" y="228" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#fbe9b8" direction="ltr">Patient circuit</text>
          </g>

          <text x="490" y="345" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">من الأسطوانة أو شبكة المستشفى، مرورا بالمبخر، وصولا إلى المريض عبر كيس التنفس الاحتياطي</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة المسار</h3>
        <ul class="status-list">
          <li class="status-row" data-status="gas-supply"><span class="status-dot dot-blue"></span><span class="status-label">مصدر الغاز</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يغذّي الجهاز</span></span></li>
          <li class="status-row" data-status="regulator"><span class="status-dot dot-blue"></span><span class="status-label">منظم الضغط</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يخفض الضغط</span></span></li>
          <li class="status-row" data-status="needle-valve"><span class="status-dot dot-orange"></span><span class="status-label">صمام التحكم الدقيق</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">يضبط التدفق</span></span></li>
          <li class="status-row" data-status="manifold"><span class="status-dot dot-magenta"></span><span class="status-label">مشعب التجميع</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يجمع الغازات</span></span></li>
          <li class="status-row" data-status="vaporizer"><span class="status-dot dot-green"></span><span class="status-label">المبخر</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يضيف البخار</span></span></li>
          <li class="status-row" data-status="back-bar"><span class="status-dot dot-yellow"></span><span class="status-label">العمود الخلفي</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يمرّر الخليط</span></span></li>
          <li class="status-row" data-status="patient-circuit"><span class="status-dot dot-yellow"></span><span class="status-label">دائرة المريض</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يستنشق المريض</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي جزء من الجهاز لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>مصدر الغاز ومنظم الضغط</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>صمام التحكم الدقيق</li>
      <li class="legend-item"><span class="legend-swatch legend-magenta"></span>مشعب التجميع</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>المبخر</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>العمود الخلفي ودائرة المريض</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#gt1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#gt1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#gt1Glow); }

  .legend-blue { background: #38BDF8; }
  .legend-magenta { background: #E879F9; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes gt1-shape-activate { to { filter: url(#gt1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes gt1-reveal-trail { to { opacity: 0.85; } }
    @keyframes gt1-status-value-on { to { opacity: 1; } }
    @keyframes gt1-status-value-off { to { opacity: 0; } }
    @keyframes gt1-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes gt1-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes gt1-dot-on-magenta { to { background: #E879F9; box-shadow: 0 0 8px 1px rgba(232, 121, 249, 0.8); } }
    @keyframes gt1-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes gt1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }

    .playing [data-component="gas-supply"] .box-shape { animation: gt1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-supply"] .status-dot { animation: gt1-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-supply"] .value-on { animation: gt1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-supply"] .value-off { animation: gt1-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="gas-supply"] .trail { animation: gt1-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="regulator"] .box-shape { animation: gt1-shape-activate 0.4s ease-out 0.8s forwards; }
    .playing [data-status="regulator"] .status-dot { animation: gt1-dot-on-blue 0.4s ease-out 0.8s forwards; }
    .playing [data-status="regulator"] .value-on { animation: gt1-status-value-on 0.4s ease-out 0.8s forwards; }
    .playing [data-status="regulator"] .value-off { animation: gt1-status-value-off 0.4s ease-out 0.8s forwards; }
    .playing [data-link="regulator"] .trail { animation: gt1-reveal-trail 0.3s ease-out 1.1s forwards; }

    .playing [data-component="needle-valve"] .box-shape { animation: gt1-shape-activate 0.4s ease-out 1.5s forwards; }
    .playing [data-status="needle-valve"] .status-dot { animation: gt1-dot-on-orange 0.4s ease-out 1.5s forwards; }
    .playing [data-status="needle-valve"] .value-on { animation: gt1-status-value-on 0.4s ease-out 1.5s forwards; }
    .playing [data-status="needle-valve"] .value-off { animation: gt1-status-value-off 0.4s ease-out 1.5s forwards; }
    .playing [data-link="needle-valve"] .trail { animation: gt1-reveal-trail 0.3s ease-out 1.8s forwards; }

    .playing [data-component="manifold"] .box-shape { animation: gt1-shape-activate 0.4s ease-out 2.2s forwards; }
    .playing [data-status="manifold"] .status-dot { animation: gt1-dot-on-magenta 0.4s ease-out 2.2s forwards; }
    .playing [data-status="manifold"] .value-on { animation: gt1-status-value-on 0.4s ease-out 2.2s forwards; }
    .playing [data-status="manifold"] .value-off { animation: gt1-status-value-off 0.4s ease-out 2.2s forwards; }
    .playing [data-link="manifold"] .trail { animation: gt1-reveal-trail 0.3s ease-out 2.5s forwards; }

    .playing [data-component="vaporizer"] .box-shape { animation: gt1-shape-activate 0.4s ease-out 2.9s forwards; }
    .playing [data-status="vaporizer"] .status-dot { animation: gt1-dot-on-green 0.4s ease-out 2.9s forwards; }
    .playing [data-status="vaporizer"] .value-on { animation: gt1-status-value-on 0.4s ease-out 2.9s forwards; }
