---
// Figures 7-16 and 7-17 (التوربينات عالية السرعة مع مكوناتها وخصائصها)
// built as a dark neumorphic interactive simulator, following the exact
// Chapter 1-6 system (see AnimatedTimerCircuit.astro's compact "detail"
// format). Zooms into a single turbine's internal anatomy — the air path
// that spins it and cools it — reusing the exact RPM/cooling facts
// already established in HandpiecesComparisonDiagramInteractive.astro's
// COMPONENT_INFO rather than inventing new specifications.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft turbine-anatomy-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة تشريح التوربينة</span>
      <span class="simulator-subtitle">شكل 16-7 و 17-7 — مسار الهواء والتبريد داخل التوربينة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="tba1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="800"
          height="400"
          viewBox="0 0 800 400"
          role="img"
          aria-label="تشريح التوربينة عالية السرعة"
        >
          <defs>
            <marker id="tba1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="tba1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="tba1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="tba1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="tba1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="tba1GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="tba1GradCyan" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="tba1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="tba1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="tba1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="800" height="400" rx="20" fill="url(#tba1BgGrad)"></rect>
          <rect x="0" y="0" width="800" height="400" rx="20" fill="url(#tba1Grid)"></rect>

          <text x="400" y="32" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">تشريح التوربينة عالية السرعة</text>

          <g class="hotspot" data-component="air-inlet" tabindex="0" role="button" aria-label="مدخل الهواء">
            <circle class="box-shape" cx="90" cy="190" r="34" fill="url(#tba1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#tba1Elevate)"></circle>
            <text x="90" y="187" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">مدخل</text>
            <text x="90" y="202" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">الهواء</text>
          </g>

          <g class="link" data-link="air-inlet" data-link-to="rotor-bearing">
            <line x1="124" y1="190" x2="175" y2="190" stroke="#5b6478" stroke-width="2.5" marker-end="url(#tba1-arrow)"></line>
            <line class="trail" x1="124" y1="190" x2="173" y2="190" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="rotor-bearing" tabindex="0" role="button" aria-label="المحمل والدوار">
            <rect class="box-shape" x="175" y="130" width="180" height="120" rx="10" fill="url(#tba1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#tba1Elevate)"></rect>
            <circle cx="265" cy="190" r="34" fill="none" stroke="#FBBF24" stroke-width="1.6" opacity="0.7"></circle>
            <circle cx="265" cy="190" r="6" fill="#FBBF24" opacity="0.7"></circle>
            <text x="265" y="234" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">المحمل والدوار</text>
            <text x="265" y="118" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">300,000+ RPM</text>
          </g>

          <g class="link" data-link="rotor-bearing" data-link-to="bur-chuck">
            <line x1="355" y1="190" x2="405" y2="190" stroke="#5b6478" stroke-width="2.5" marker-end="url(#tba1-arrow)"></line>
            <line class="trail" x1="355" y1="190" x2="403" y2="190" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="bur-chuck" tabindex="0" role="button" aria-label="ملقط الأداة">
            <rect class="box-shape" x="405" y="150" width="130" height="80" rx="10" fill="url(#tba1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#tba1Elevate)"></rect>
            <path d="M 460,175 L 480,175 L 480,215 L 460,215 Z" fill="none" stroke="#4ADE80" stroke-width="1.6" opacity="0.8"></path>
            <text x="470" y="245" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="rtl">ملقط الأداة</text>
          </g>

          <g class="link" data-link="rotor-bearing" data-link-to="water-spray">
            <path d="M 265,130 L 265,90 L 340,90" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#tba1-arrow)"></path>
            <path class="trail" d="M 265,130 L 265,90 L 338,90" fill="none" stroke="#22D3EE" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="hotspot" data-component="water-spray" tabindex="0" role="button" aria-label="رذاذ الماء للتبريد">
            <circle class="box-shape" cx="380" cy="90" r="30" fill="url(#tba1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#tba1Elevate)"></circle>
            <text x="380" y="86" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">رذاذ</text>
            <text x="380" y="100" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">التبريد</text>
          </g>

          <g class="link" data-link="rotor-bearing" data-link-to="exhaust-air">
            <path d="M 265,250 L 265,290 L 340,290" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#tba1-arrow)"></path>
            <path class="trail" d="M 265,250 L 265,290 L 338,290" fill="none" stroke="#C084FC" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="hotspot" data-component="exhaust-air" tabindex="0" role="button" aria-label="خروج الهواء العادم">
            <circle class="box-shape" cx="380" cy="290" r="30" fill="url(#tba1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#tba1Elevate)"></circle>
            <text x="380" y="286" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">هواء</text>
            <text x="380" y="300" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">عادم</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="124" cy="190" r="4.5" fill="#38BDF8" filter="url(#tba1Glow)" style="--tx:38px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="air-inlet"><span class="status-dot dot-blue"></span><span class="status-label">مدخل الهواء</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">يدخل</span></span></li>
          <li class="status-row" data-status="rotor-bearing"><span class="status-dot dot-yellow"></span><span class="status-label">المحمل والدوار</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يدور</span></span></li>
          <li class="status-row" data-status="bur-chuck"><span class="status-dot dot-green"></span><span class="status-label">ملقط الأداة</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يدور</span></span></li>
          <li class="status-row" data-status="water-spray"><span class="status-dot dot-cyan"></span><span class="status-label">رذاذ التبريد</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يرش</span></span></li>
          <li class="status-row" data-status="exhaust-air"><span class="status-dot dot-purple"></span><span class="status-label">الهواء العادم</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يخرج</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي جزء في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>مسار الهواء الدافع</li>
      <li class="legend-item"><span class="legend-swatch legend-cyan"></span>ماء التبريد</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الدوران</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الهواء العادم</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-cyan { background: #22D3EE; }
  .status-dot.dot-cyan { background: #3a4258; }

  .hotspot .box-shape {
    filter: url(#tba1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#tba1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#tba1Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes tba1-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: tba1-particle-move var(--particle-duration, 0.4s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes tba1-shape-activate { to { filter: url(#tba1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes tba1-reveal-trail { to { opacity: 0.85; } }
    @keyframes tba1-status-value-on { to { opacity: 1; } }
    @keyframes tba1-status-value-off { to { opacity: 0; } }
    @keyframes tba1-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes tba1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes tba1-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes tba1-dot-on-cyan { to { background: #22D3EE; box-shadow: 0 0 8px 1px rgba(34, 211, 238, 0.8); } }
    @keyframes tba1-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="air-inlet"] .box-shape { animation: tba1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="air-inlet"] .status-dot { animation: tba1-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="air-inlet"] .value-on { animation: tba1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="air-inlet"] .value-off { animation: tba1-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="air-inlet"] .trail { animation: tba1-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="rotor-bearing"] .box-shape { animation: tba1-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="rotor-bearing"] .status-dot { animation: tba1-dot-on-yellow 0.4s ease-out 0.6s forwards; }
    .playing [data-status="rotor-bearing"] .value-on { animation: tba1-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="rotor-bearing"] .value-off { animation: tba1-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-link="rotor-bearing"][data-link-to="bur-chuck"] .trail { animation: tba1-reveal-trail 0.3s ease-out 1.0s forwards; }
    .playing [data-component="bur-chuck"] .box-shape { animation: tba1-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="bur-chuck"] .status-dot { animation: tba1-dot-on-green 0.4s ease-out 1.1s forwards; }
    .playing [data-status="bur-chuck"] .value-on { animation: tba1-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="bur-chuck"] .value-off { animation: tba1-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-link="rotor-bearing"][data-link-to="water-spray"] .trail { animation: tba1-reveal-trail 0.3s ease-out 1.5s forwards; }
    .playing [data-component="water-spray"] .box-shape { animation: tba1-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="water-spray"] .status-dot { animation: tba1-dot-on-cyan 0.4s ease-out 1.6s forwards; }
    .playing [data-status="water-spray"] .value-on { animation: tba1-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="water-spray"] .value-off { animation: tba1-status-value-off 0.4s ease-out 1.6s forwards; }

    .playing [data-link="rotor-bearing"][data-link-to="exhaust-air"] .trail { animation: tba1-reveal-trail 0.3s ease-out 2.0s forwards; }
    .playing [data-component="exhaust-air"] .box-shape { animation: tba1-shape-activate 0.4s ease-out 2.1s forwards; }
    .playing [data-status="exhaust-air"] .status-dot { animation: tba1-dot-on-purple 0.4s ease-out 2.1s forwards; }
    .playing [data-status="exhaust-air"] .value-on { animation: tba1-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="exhaust-air"] .value-off { animation: tba1-status-value-off 0.4s ease-out 2.1s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "air-inlet": {
      title: "مدخل الهواء (Air Inlet)",
      text: "يدخل الهواء المضغوط القادم من وحدة الضاغط إلى التوربينة عبر خرطوم رفيع مرن.",
    },
    "rotor-bearing": {
      title: "المحمل والدوار (Rotor Bearing)",
      text: "يدور بسرعات عالية جداً قد تصل إلى 300,000-400,000 دورة في الدقيقة، مدفوعاً بالهواء المضغوط مباشرة دون محرك كهربائي.",
    },
    "bur-chuck": {
      title: "ملقط الأداة (Bur Chuck)",
      text: "يثبّت رأس الحفر (البر) ويدور معه بنفس سرعة الدوار، ويُستخدم لحفر وإزالة الأسنان المصابة بكفاءة عالية.",
    },
    "water-spray": {
      title: "رذاذ التبريد (Water Spray)",
      text: "يرش الماء على منطقة العمل أثناء الدوران السريع لتبريد السن وحماية الأنسجة من الحرارة الناتجة عن الاحتكاك.",
    },
    "exhaust-air": {
      title: "خروج الهواء العادم (Exhaust Air)",
      text: "يخرج الهواء بعد دفع الدوار عبر فتحات جانبية، مكمّلاً دورة التشغيل الهوائي للتوربينة.",
    },
  };

  wireDiagramSimulator(".turbine-anatomy-diagram", { cycleMs: 2900, componentInfo: COMPONENT_INFO });
</script>
