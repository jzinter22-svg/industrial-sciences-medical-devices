---
// Figure 9-14 (طريقة التحكم بتركيز بخار المادة المخدرة) — the three
// lever positions (أ) closed, (ب) open, (ج) fully submerged that control
// how much of the flowing gas passes through the vaporizer's dark glass
// bottle vs. bypassing it directly. Generalizes the 2-state Cut/Coag
// mode-toggle pattern (ElectrosurgicalUnitBlockDiagramInteractive.astro)
// to three buttons/three data-mode values; the JS click handler is
// identical (it already iterates over N buttons), only the CSS state
// selectors and the extra "submerged" bubbles are new.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft boyle-vaporizer-lever-diagram">
  <div class="simulator-shell" data-mode="closed">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة أوضاع ذراع مبخر بويل</span>
      <span class="simulator-subtitle">شكل 9-14 — التحكم بتركيز بخار المادة المخدرة</span>
    </div>

    <div class="mode-toggle-row">
      <button type="button" class="mode-toggle-button" data-mode-button="closed" aria-pressed="true">مغلق (أ)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="open" aria-pressed="false">مفتوح (ب)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="submerged" aria-pressed="false">أقصى فتح (ج)</button>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="vp14-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="760"
          height="460"
          viewBox="0 0 760 460"
          role="img"
          aria-label="أوضاع ذراع التحكم بتركيز بخار المادة المخدرة"
        >
          <defs>
            <marker id="vp14-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="vp14BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="vp14Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="vp14GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="vp14GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="vp14GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="vp14GradSilver" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#2a3242"></stop><stop offset="100%" stop-color="#12161f"></stop></linearGradient>
            <linearGradient id="vp14GradBottle" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1a2a18"></stop><stop offset="100%" stop-color="#0a120a"></stop></linearGradient>

            <filter id="vp14Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="vp14Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="760" height="460" rx="20" fill="url(#vp14BgGrad)"></rect>
          <rect x="0" y="0" width="760" height="460" rx="20" fill="url(#vp14Grid)"></rect>

          <text x="380" y="24" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">التحكم بتركيز بخار المادة المخدرة</text>

          <!-- direct bypass path (top) -->
          <g class="bypass-path">
            <line id="vp14-wire-bypass" x1="60" y1="90" x2="700" y2="90" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp14-arrow)"></line>
            <line class="trail" x1="60" y1="90" x2="698" y2="90" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#vp14Glow)" style="offset-path: url(#vp14-wire-bypass); --flow-delay:0.2s; --flow-duration:1.4s;"></circle>
          </g>
          <text x="380" y="80" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" fill="#9fd8f8" direction="ltr">Direct path</text>

          <!-- chamber path (down through the bottle) -->
          <g class="chamber-path">
            <path id="vp14-wire-chamber" d="M 60,90 L 60,180 L 340,270 L 340,330 L 420,330 L 420,270 L 700,180 L 700,90" fill="none" stroke="#5b6478" stroke-width="2.2" marker-end="url(#vp14-arrow)"></path>
            <path class="trail" d="M 60,90 L 60,180 L 340,270 L 340,328 L 420,328 L 420,270 L 700,180 L 700,92" fill="none" stroke="#4ADE80" stroke-width="2.2" stroke-dasharray="5 7"></path>
            <circle class="current-particle" r="3.2" fill="#4ADE80" filter="url(#vp14Glow)" style="offset-path: url(#vp14-wire-chamber); --flow-delay:0.6s; --flow-duration:2.2s;"></circle>
          </g>

          <!-- lever + track -->
          <g class="hotspot" data-component="lever" tabindex="0" role="button" aria-label="الذراع">
            <rect class="box-shape" x="30" y="130" width="30" height="260" rx="14" fill="url(#vp14GradSilver)" stroke="#cbd5e1" stroke-width="2" filter="url(#vp14Elevate)"></rect>
            <text x="45" y="122" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#4ADE80" direction="ltr">on</text>
            <text x="45" y="405" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#EF4444" direction="ltr">off</text>
            <rect class="lever-handle" x="24" y="345" width="42" height="30" rx="8" fill="#FBBF24" stroke="#1a1608" stroke-width="1.5"></rect>
          </g>

          <!-- glass bottle -->
          <g class="hotspot" data-component="glass-bottle" tabindex="0" role="button" aria-label="الزجاجة">
            <rect class="box-shape" x="260" y="140" width="260" height="240" rx="20" fill="url(#vp14GradBottle)" stroke="#3f6b3a" stroke-width="2" filter="url(#vp14Elevate)"></rect>
            <rect x="350" y="110" width="60" height="34" rx="6" fill="#0a120a" stroke="#3f6b3a" stroke-width="1.6"></rect>
            <path d="M 270,340 q 45,-14 90,0 t 90,0 t 90,0 v34 h-270 z" fill="#f4d35e" opacity="0.5"></path>
            <g class="bubbles">
              <circle cx="360" cy="330" r="4" fill="#eaf6ff" opacity="0.75"></circle>
              <circle cx="385" cy="345" r="3" fill="#eaf6ff" opacity="0.65"></circle>
              <circle cx="405" cy="325" r="3.5" fill="#eaf6ff" opacity="0.7"></circle>
              <circle cx="420" cy="350" r="2.6" fill="#eaf6ff" opacity="0.6"></circle>
            </g>
            <text x="390" y="165" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">الزجاجة</text>
          </g>

          <!-- opening O mark, only meaningful in open mode -->
          <g class="opening-o-mark">
            <circle cx="470" cy="185" r="10" fill="none" stroke="#FBBF24" stroke-width="1.6"></circle>
            <text x="470" y="189" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FBBF24" direction="ltr">O</text>
          </g>

          <!-- packing gland -->
          <g class="hotspot" data-component="packing-gland" tabindex="0" role="button" aria-label="علبة الحشو">
            <rect class="box-shape" x="358" y="96" width="44" height="26" rx="6" fill="url(#vp14GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#vp14Elevate)"></rect>
            <text x="380" y="70" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7.5" font-weight="700" fill="#eef1f8" direction="rtl">علبة الحشو</text>
          </g>

          <!-- plunger: knob + rod that scales down toward the cover -->
          <g class="hotspot" data-component="plunger" tabindex="0" role="button" aria-label="المكبس">
            <circle class="box-shape" cx="380" cy="36" r="16" fill="url(#vp14GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#vp14Elevate)"></circle>
            <text x="380" y="15" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7.5" font-weight="700" fill="#eef1f8" direction="rtl">المكبس (P)</text>
            <rect class="plunger-rod" x="374" y="52" width="12" height="42" fill="#FB923C"></rect>
          </g>

          <!-- metal cover, repositions per mode -->
          <g class="hotspot" data-component="metal-cover" tabindex="0" role="button" aria-label="الغطاء المعدني">
            <g class="metal-cover-shape">
              <rect class="box-shape" x="335" y="168" width="110" height="16" rx="5" fill="url(#vp14GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#vp14Elevate)"></rect>
              <text x="390" y="205" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7.5" font-weight="700" fill="#c9f6d8" direction="rtl">الغطاء (C)</text>
            </g>
          </g>

          <text class="mode-caption-closed" x="380" y="430" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">مغلق: تمر الغازات مباشرة دون الدخول إلى الزجاجة</text>
          <text class="mode-caption-open" x="380" y="430" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">مفتوح: تدخل الغازات إلى الزجاجة عبر الفتحة (O)</text>
          <text class="mode-caption-submerged" x="380" y="430" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">أقصى فتح: يلامس الغطاء سطح السائل فتتكوّن فقاعات ويزداد التبخر</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة المبخر</h3>
        <ul class="status-list">
          <li class="status-row" data-status="lever"><span class="status-dot dot-silver"></span><span class="status-label">الذراع</span><span class="status-value"><span class="value-off">—</span><span class="value-on">يضبط الوضع</span></span></li>
          <li class="status-row" data-status="plunger"><span class="status-dot dot-orange"></span><span class="status-label">المكبس (P)</span><span class="status-value"><span class="value-off">—</span><span class="value-on">يضبط الغطاء</span></span></li>
          <li class="status-row" data-status="packing-gland"><span class="status-dot dot-orange"></span><span class="status-label">علبة الحشو</span><span class="status-value"><span class="value-off">—</span><span class="value-on">تمنع التسرب</span></span></li>
          <li class="status-row" data-status="metal-cover"><span class="status-dot dot-green"></span><span class="status-label">الغطاء المعدني (C)</span><span class="status-value"><span class="value-off">—</span><span class="value-on">في وضعه</span></span></li>
          <li class="status-row" data-status="glass-bottle"><span class="status-dot dot-yellow"></span><span class="status-label">الزجاجة</span><span class="status-value"><span class="value-off">—</span><span class="value-on">سائل مخدر</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه — أو بدّل بين الأوضاع الثلاثة من الأزرار أعلاه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>المسار المباشر</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>المسار عبر الزجاجة</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>المكبس والحشو</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>السائل المخدر</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .dot-silver { background: #cbd5e1; }

  .mode-toggle-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0 var(--neo-space-md) var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .mode-toggle-button {
    font-family: "Cairo", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #c3c9dc;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .mode-toggle-button:hover { background: rgba(255, 255, 255, 0.08); }

  .mode-toggle-button[aria-pressed="true"] {
    background: #FBBF24;
    border-color: #FBBF24;
    color: #1a1608;
  }

  .hotspot .box-shape {
    filter: url(#vp14Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#vp14Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#vp14Glow); }

  /* Lever handle slides from "off" (bottom, closed) to "on" (top, open/submerged) */
  .lever-handle {
    transform: translateY(0px);
    transition: transform 0.45s ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .simulator-shell[data-mode="open"] .lever-handle,
  .simulator-shell[data-mode="submerged"] .lever-handle {
    transform: translateY(-190px);
  }

  /* Metal cover lowers progressively: high (off/closed) -> mid (open, O visible) -> touching liquid (submerged) */
  .metal-cover-shape {
    transform: translateY(0px);
    transition: transform 0.45s ease;
    transform-box: fill-box;
    transform-origin: top;
  }
  .simulator-shell[data-mode="open"] .metal-cover-shape { transform: translateY(70px); }
  .simulator-shell[data-mode="submerged"] .metal-cover-shape { transform: translateY(150px); }

  /* Plunger rod grows longer as the cover descends */
  .plunger-rod {
    transform: scaleY(1);
    transition: transform 0.45s ease;
    transform-box: fill-box;
    transform-origin: top;
  }
  .simulator-shell[data-mode="open"] .plunger-rod { transform: scaleY(2.7); }
  .simulator-shell[data-mode="submerged"] .plunger-rod { transform: scaleY(4.3); }

  .opening-o-mark { opacity: 0; transition: opacity 0.3s ease; }
  .simulator-shell[data-mode="open"] .opening-o-mark { opacity: 1; }

  .bubbles { opacity: 0; transition: opacity 0.3s ease; }
  .simulator-shell[data-mode="submerged"] .bubbles { opacity: 1; }

  .bypass-path { opacity: 1; transition: opacity 0.3s ease; }
  .chamber-path { opacity: 0.2; transition: opacity 0.3s ease; }
  .simulator-shell[data-mode="open"] .bypass-path,
  .simulator-shell[data-mode="submerged"] .bypass-path { opacity: 0.25; }
  .simulator-shell[data-mode="open"] .chamber-path,
  .simulator-shell[data-mode="submerged"] .chamber-path { opacity: 1; }

  .mode-caption-open, .mode-caption-submerged { opacity: 0; }
  .simulator-shell[data-mode="open"] .mode-caption-closed,
  .simulator-shell[data-mode="submerged"] .mode-caption-closed { opacity: 0; }
  .simulator-shell[data-mode="open"] .mode-caption-open { opacity: 1; }
  .simulator-shell[data-mode="submerged"] .mode-caption-submerged { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes vp14-shape-activate { to { filter: url(#vp14Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes vp14-reveal-trail { to { opacity: 0.85; } }
    @keyframes vp14-status-value-on { to { opacity: 1; } }
    @keyframes vp14-status-value-off { to { opacity: 0; } }
    @keyframes vp14-dot-on-silver { to { background: #cbd5e1; box-shadow: 0 0 8px 1px rgba(203, 213, 225, 0.8); } }
    @keyframes vp14-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes vp14-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes vp14-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }

    .playing [data-component="lever"] .box-shape { animation: vp14-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="lever"] .status-dot { animation: vp14-dot-on-silver 0.4s ease-out 0.1s forwards; }
    .playing [data-status="lever"] .value-on { animation: vp14-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="lever"] .value-off { animation: vp14-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-component="plunger"] .box-shape { animation: vp14-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="plunger"] .status-dot { animation: vp14-dot-on-orange 0.4s ease-out 0.6s forwards; }
    .playing [data-status="plunger"] .value-on { animation: vp14-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="plunger"] .value-off { animation: vp14-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-component="packing-gland"] .box-shape { animation: vp14-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="packing-gland"] .status-dot { animation: vp14-dot-on-orange 0.4s ease-out 1.1s forwards; }
    .playing [data-status="packing-gland"] .value-on { animation: vp14-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="packing-gland"] .value-off { animation: vp14-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-component="metal-cover"] .box-shape { animation: vp14-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="metal-cover"] .status-dot { animation: vp14-dot-on-green 0.4s ease-out 1.6s forwards; }
    .playing [data-status="metal-cover"] .value-on { animation: vp14-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="metal-cover"] .value-off { animation: vp14-status-value-off 0.4s ease-out 1.6s forwards; }

    .playing [data-component="glass-bottle"] .box-shape { animation: vp14-shape-activate 0.4s ease-out 2.1s forwards; }
    .playing [data-status="glass-bottle"] .status-dot { animation: vp14-dot-on-yellow 0.4s ease-out 2.1s forwards; }
    .playing [data-status="glass-bottle"] .value-on { animation: vp14-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="glass-bottle"] .value-off { animation: vp14-status-value-off 0.4s ease-out 2.1s forwards; }

    .playing .bypass-path .trail { animation: vp14-reveal-trail 0.3s ease-out 0.4s forwards; }
    .playing .chamber-path .trail { animation: vp14-reveal-trail 0.3s ease-out 0.8s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes vp14-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: vp14-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
    .simulator-shell:not([data-mode="closed"]) .bypass-path .current-particle,
    .simulator-shell[data-mode="closed"] .chamber-path .current-particle {
      animation: none !important;
      opacity: 0 !important;
    }

    @keyframes vp14-bubble-rise {
      0% { transform: translateY(0); opacity: 0; }
      15% { opacity: 0.8; }
      100% { transform: translateY(-45px); opacity: 0; }
    }
    .simulator-shell[data-mode="submerged"] .playing .bubbles circle {
      animation: vp14-bubble-rise 1.6s ease-in infinite;
      transform-box: fill-box;
    }
    .simulator-shell[data-mode="submerged"] .playing .bubbles circle:nth-child(2) { animation-delay: 0.4s; }
    .simulator-shell[data-mode="submerged"] .playing .bubbles circle:nth-child(3) { animation-delay: 0.8s; }
    .simulator-shell[data-mode="submerged"] .playing .bubbles circle:nth-child(4) { animation-delay: 1.2s; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    lever: {
      title: "الذراع",
      text: "يتحكم بمقدار فتح المسار إلى داخل زجاجة المبخر. في الوضع المغلق (للأسفل) يمر الخليط الغازي مباشرة عبر التوصيل المباشر دون الدخول إلى الزجاجة؛ وكلما تحرّك الذراع تدريجيا نحو الأعلى (الوضع المفتوح) زادت نسبة الغازات المارة داخل الزجاجة حتى يصل الذراع إلى أقصى وضع له.",
    },
    "metal-cover": {
      title: "الغطاء المعدني (C)",
      text: "بخفض الغطاء المعدني فوق نهاية الأنبوبة الملتوية (U) يمكن توجيه الغازات المتدفقة داخل الزجاجة لكي تصطدم أكثر بسطح السائل؛ فإذا خُفض إلى أقصى قيمة له حتى يلامس سطح السائل، تتكوّن فقاعات للغازات المتدفقة خلال السائل فيزداد معدل تبخّر السائل المخدر.",
    },
    plunger: {
      title: "المكبس (P)",
      text: "يضبط وضع الغطاء المعدني (C) ارتفاعا وانخفاضا، ويمر خلال علبة الحشو أثناء حركته.",
    },
    "packing-gland": {
      title: "علبة الحشو",
      text: "تحيط بالمكبس (P) عند مروره داخل غطاء زجاجة المبخر، وتمنع تسرّب الغازات إلى خارج المبخر أثناء حركة المكبس.",
    },
    "glass-bottle": {
      title: "الزجاجة (وعاء سائل التخدير)",
      text: "زجاجة مصنوعة من زجاج داكن (أسود أو بني أو أخضر) لمنع تحلل مادة التخدير تحت تأثير الضوء، وتحوي سائل التخدير الذي يتبخر داخلها حسب وضع الذراع والغطاء المعدني.",
    },
  };

  wireDiagramSimulator(".boyle-vaporizer-lever-diagram", { cycleMs: 3200, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".boyle-vaporizer-lever-diagram .mode-toggle-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".boyle-vaporizer-lever-diagram")?.querySelector(".simulator-shell");
      const mode = btn.getAttribute("data-mode-button");
      if (!(shell instanceof HTMLElement) || !mode) return;
      shell.dataset.mode = mode;
      shell.querySelectorAll(".mode-toggle-button").forEach((b) => {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
    });
  });
</script>
