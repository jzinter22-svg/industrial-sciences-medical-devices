---
// Figure 9-17 (دائرة المريض أثناء الشهيق والزفير) — the same fresh-gas
// inlet -> T-junction -> reservoir bag / breathing hose -> exhale valve
// -> mask circuit shown in two states. Inhale: gas flows fresh-gas ->
// hose -> mask, exhale valve shut. Exhale: the exhale valve opens and
// vents a portion of the patient's breath to atmosphere while the rest
// flows backward through the hose to refill the reservoir bag for the
// next breath. The reversible legs reuse a single particle each and
// flip direction per mode with `animation-direction: reverse` rather
// than duplicating paths.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft patient-circuit-breathing-diagram">
  <div class="simulator-shell" data-mode="inhale">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة دائرة المريض أثناء الشهيق والزفير</span>
      <span class="simulator-subtitle">شكل 9-17 — كيس الاحتياط وصمام الزفير</span>
    </div>

    <div class="mode-toggle-row">
      <button type="button" class="mode-toggle-button" data-mode-button="inhale" aria-pressed="true">شهيق (Inhale)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="exhale" aria-pressed="false">زفير (Exhale)</button>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="pc17-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="360"
          viewBox="0 0 900 360"
          role="img"
          aria-label="دائرة المريض أثناء الشهيق والزفير"
        >
          <defs>
            <marker id="pc17-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="pc17BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="pc17Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="pc17GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="pc17GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="pc17GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="pc17GradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1414"></stop><stop offset="100%" stop-color="#1a0a0a"></stop></linearGradient>
            <linearGradient id="pc17GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="pc17Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="pc17Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="360" rx="20" fill="url(#pc17BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="360" rx="20" fill="url(#pc17Grid)"></rect>

          <text class="mode-title-inhale" x="450" y="24" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">دائرة المريض أثناء الشهيق</text>
          <text class="mode-title-exhale" x="450" y="24" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">دائرة المريض أثناء الزفير</text>

          <!-- fresh gas inlet -->
          <g class="hotspot" data-component="fresh-gas-inlet" tabindex="0" role="button" aria-label="الغاز الطازج">
            <rect class="box-shape" x="30" y="115" width="105" height="65" rx="10" fill="url(#pc17GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#pc17Elevate)"></rect>
            <text x="82" y="145" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">الغاز الطازج</text>
            <text x="82" y="160" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#9fd8f8" direction="ltr">Fresh Gas</text>
          </g>

          <!-- T junction, decorative -->
          <circle cx="185" cy="147" r="4" fill="#5b6478"></circle>

          <g class="link" data-link="fresh-gas-inlet" data-link-to="breathing-hose">
            <line id="pc17-wire-1" x1="135" y1="147" x2="248" y2="147" stroke="#5b6478" stroke-width="2.5" marker-end="url(#pc17-arrow)"></line>
            <line class="trail inhale-only-trail" x1="135" y1="147" x2="246" y2="147" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#pc17Glow)" style="offset-path: url(#pc17-wire-1); --flow-delay:0.2s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- reservoir bag, hanging below the T junction -->
          <g class="hotspot" data-component="reservoir-bag" tabindex="0" role="button" aria-label="كيس التنفس الاحتياطي">
            <path class="box-shape bag-shape" d="M 185,180 C 145,190 130,240 150,280 C 165,310 205,310 220,280 C 240,240 225,190 185,180 Z" fill="url(#pc17GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#pc17Elevate)"></path>
            <text x="185" y="245" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#eef1f8" direction="rtl">كيس التنفس</text>
            <text x="185" y="260" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#eef1f8" direction="rtl">الاحتياطي</text>
          </g>

          <g class="link" data-link="breathing-hose" data-link-to="reservoir-bag">
            <line id="pc17-wire-bag" x1="185" y1="151" x2="185" y2="177" stroke="#5b6478" stroke-width="2.2"></line>
            <line class="trail" x1="185" y1="151" x2="185" y2="177" stroke="#FBBF24" stroke-width="2.2" stroke-dasharray="4 6"></line>
            <circle class="current-particle bag-branch-particle" r="3" fill="#FBBF24" filter="url(#pc17Glow)" style="offset-path: url(#pc17-wire-bag); --flow-delay:0.9s; --flow-duration:0.6s;"></circle>
          </g>

          <!-- breathing hose (corrugated) -->
          <g class="hotspot" data-component="breathing-hose" tabindex="0" role="button" aria-label="خرطوم التنفس">
            <rect class="box-shape" x="250" y="128" width="330" height="38" rx="10" fill="#1c2436" stroke="#4ADE80" stroke-width="2" filter="url(#pc17Elevate)"></rect>
            <path d="M 265,128 v38 M 285,128 v38 M 305,128 v38 M 325,128 v38 M 345,128 v38 M 365,128 v38 M 385,128 v38 M 405,128 v38 M 425,128 v38 M 445,128 v38 M 465,128 v38 M 485,128 v38 M 505,128 v38 M 525,128 v38 M 545,128 v38 M 565,128 v38" stroke="#4ADE80" stroke-width="1" opacity="0.5"></path>
            <text x="415" y="185" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">خرطوم التنفس</text>
          </g>

          <line id="pc17-wire-full" x1="580" y1="147" x2="800" y2="147" stroke="none" fill="none"></line>
          <g class="link" data-link="breathing-hose" data-link-to="exhale-valve">
            <line id="pc17-wire-2" x1="580" y1="147" x2="628" y2="147" stroke="#5b6478" stroke-width="2.5" marker-end="url(#pc17-arrow)"></line>
            <line class="trail" x1="580" y1="147" x2="626" y2="147" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle hose-mask-particle" r="3.4" fill="#4ADE80" filter="url(#pc17Glow)" style="offset-path: url(#pc17-wire-full); --flow-delay:1.4s; --flow-duration:0.9s;"></circle>
          </g>

          <!-- exhale valve -->
          <g class="hotspot" data-component="exhale-valve" tabindex="0" role="button" aria-label="صمام الزفير">
            <rect class="box-shape" x="630" y="112" width="90" height="90" rx="12" fill="url(#pc17GradRed)" stroke="#EF4444" stroke-width="2.5" filter="url(#pc17Elevate)"></rect>
            <circle class="valve-disc-closed" cx="675" cy="157" r="16" fill="#EF4444" stroke="#f7c9c9" stroke-width="1.6"></circle>
            <g class="valve-disc-open">
              <circle cx="675" cy="157" r="16" fill="none" stroke="#4ADE80" stroke-width="1.8"></circle>
              <path d="M 690,140 L 715,118" stroke="#4ADE80" stroke-width="2" marker-end="url(#pc17-arrow)"></path>
            </g>
            <text x="675" y="196" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7.5" font-weight="700" fill="#eef1f8" direction="rtl">صمام الزفير</text>
            <g class="vent-particles">
              <circle class="vent-particle" cx="690" cy="140" r="2.6" fill="#c3f0d2" filter="url(#pc17Glow)"></circle>
              <circle class="vent-particle p2" cx="690" cy="140" r="2.2" fill="#c3f0d2" filter="url(#pc17Glow)"></circle>
            </g>
          </g>

          <g class="link" data-link="exhale-valve" data-link-to="face-mask">
            <line id="pc17-wire-3" x1="720" y1="147" x2="748" y2="147" stroke="#5b6478" stroke-width="2.5" marker-end="url(#pc17-arrow)"></line>
            <line class="trail" x1="720" y1="147" x2="746" y2="147" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <!-- face mask -->
          <g class="hotspot" data-component="face-mask" tabindex="0" role="button" aria-label="القناع الوجهي">
            <path class="box-shape" d="M 750,110 h60 a40,40 0 0 1 40,40 v0 a40,40 0 0 1 -40,40 h-60 a30,30 0 0 1 0,-80 z" fill="url(#pc17GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#pc17Elevate)"></path>
            <text x="822" y="153" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#eef1f8" direction="rtl">القناع</text>
            <text x="822" y="168" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#eef1f8" direction="rtl">الوجهي</text>
          </g>

          <text class="mode-caption-inhale" x="450" y="335" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">الشهيق: الغاز الطازج يمر عبر الخرطوم إلى القناع، وصمام الزفير مغلق</text>
          <text class="mode-caption-exhale" x="450" y="335" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">الزفير: يعود الهواء نحو الكيس ليُدَّخر، ويخرج جزء منه للجو عبر صمام الزفير المفتوح</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة الدائرة</h3>
        <ul class="status-list">
          <li class="status-row" data-status="fresh-gas-inlet"><span class="status-dot dot-blue"></span><span class="status-label">الغاز الطازج</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يغذّي الدائرة</span></span></li>
          <li class="status-row" data-status="reservoir-bag"><span class="status-dot dot-yellow"></span><span class="status-label">كيس التنفس الاحتياطي</span><span class="status-value"><span class="value-off">—</span><span class="value-on value-inhale">يُفرغ</span><span class="value-on value-exhale">يمتلئ</span></span></li>
          <li class="status-row" data-status="breathing-hose"><span class="status-dot dot-green"></span><span class="status-label">خرطوم التنفس</span><span class="status-value"><span class="value-off">—</span><span class="value-on">ينقل الغاز</span></span></li>
          <li class="status-row" data-status="exhale-valve"><span class="status-dot dot-red"></span><span class="status-label">صمام الزفير</span><span class="status-value"><span class="value-off">—</span><span class="value-on value-inhale">مغلق</span><span class="value-on value-exhale">مفتوح</span></span></li>
          <li class="status-row" data-status="face-mask"><span class="status-dot dot-purple"></span><span class="status-label">القناع الوجهي</span><span class="status-value"><span class="value-off">—</span><span class="value-on value-inhale">شهيق المريض</span><span class="value-on value-exhale">زفير المريض</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه — أو بدّل بين الشهيق والزفير من الأزرار أعلاه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الغاز الطازج</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>كيس التنفس الاحتياطي</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>خرطوم التنفس</li>
      <li class="legend-item"><span class="legend-swatch legend-red"></span>صمام الزفير</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>القناع الوجهي</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .mode-toggle-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0 var(--neo-space-md) var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .mode-toggle-button {
    font-family: "Cairo", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #c3c9dc;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .mode-toggle-button:hover { background: rgba(255, 255, 255, 0.08); }

  .mode-toggle-button[aria-pressed="true"] {
    background: #FBBF24;
    border-color: #FBBF24;
    color: #1a1608;
  }

  .mode-title-exhale, .mode-caption-exhale { opacity: 0; }
  .simulator-shell[data-mode="exhale"] .mode-title-inhale,
  .simulator-shell[data-mode="exhale"] .mode-caption-inhale { opacity: 0; }
  .simulator-shell[data-mode="exhale"] .mode-title-exhale,
  .simulator-shell[data-mode="exhale"] .mode-caption-exhale { opacity: 1; }

  .value-inhale, .value-exhale { opacity: 0; }
  .simulator-shell[data-mode="exhale"] .value-inhale { display: none; }
  .simulator-shell:not([data-mode="exhale"]) .value-exhale { display: none; }

  .hotspot .box-shape {
    filter: url(#pc17Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#pc17Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#pc17Glow); }

  /* Bag visually deflates on inhale, expands on exhale */
  .bag-shape {
    transform: scale(1);
    transition: transform 0.4s ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .simulator-shell[data-mode="inhale"] .bag-shape { transform: scale(0.9); }
  .simulator-shell[data-mode="exhale"] .bag-shape { transform: scale(1.06); }

  /* Exhale valve disc swaps closed/open icon per mode */
  .valve-disc-open { opacity: 0; transition: opacity 0.3s ease; }
  .valve-disc-closed { transition: opacity 0.3s ease; }
  .simulator-shell[data-mode="exhale"] .valve-disc-closed { opacity: 0; }
  .simulator-shell[data-mode="exhale"] .valve-disc-open { opacity: 1; }

  .vent-particle { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes pc17-shape-activate { to { filter: url(#pc17Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes pc17-reveal-trail { to { opacity: 0.85; } }
    @keyframes pc17-status-value-on { to { opacity: 1; } }
    @keyframes pc17-status-value-off { to { opacity: 0; } }
    @keyframes pc17-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes pc17-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes pc17-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes pc17-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes pc17-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="fresh-gas-inlet"] .box-shape { animation: pc17-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="fresh-gas-inlet"] .status-dot { animation: pc17-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="fresh-gas-inlet"] .value-on { animation: pc17-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="fresh-gas-inlet"] .value-off { animation: pc17-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="fresh-gas-inlet"] .trail { animation: pc17-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="reservoir-bag"] .box-shape { animation: pc17-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="reservoir-bag"] .status-dot { animation: pc17-dot-on-yellow 0.4s ease-out 0.6s forwards; }
    .playing [data-status="reservoir-bag"] .value-on { animation: pc17-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="reservoir-bag"] .value-off { animation: pc17-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="breathing-hose"][data-link-to="reservoir-bag"] .trail { animation: pc17-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="breathing-hose"] .box-shape { animation: pc17-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="breathing-hose"] .status-dot { animation: pc17-dot-on-green 0.4s ease-out 1.1s forwards; }
    .playing [data-status="breathing-hose"] .value-on { animation: pc17-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="breathing-hose"] .value-off { animation: pc17-status-value-off 0.4s ease-out 1.1s forwards; }
    .playing [data-link="breathing-hose"][data-link-to="exhale-valve"] .trail { animation: pc17-reveal-trail 0.3s ease-out 1.4s forwards; }

    .playing [data-component="exhale-valve"] .box-shape { animation: pc17-shape-activate 0.4s ease-out 1.7s forwards; }
    .playing [data-status="exhale-valve"] .status-dot { animation: pc17-dot-on-red 0.4s ease-out 1.7s forwards; }
    .playing [data-status="exhale-valve"] .value-on { animation: pc17-status-value-on 0.4s ease-out 1.7s forwards; }
    .playing [data-status="exhale-valve"] .value-off { animation: pc17-status-value-off 0.4s ease-out 1.7s forwards; }
    .playing [data-link="exhale-valve"] .trail { animation: pc17-reveal-trail 0.3s ease-out 2.0s forwards; }

    .playing [data-component="face-mask"] .box-shape { animation: pc17-shape-activate 0.4s ease-out 2.3s forwards; }
    .playing [data-status="face-mask"] .status-dot { animation: pc17-dot-on-purple 0.4s ease-out 2.3s forwards; }
    .playing [data-status="face-mask"] .value-on { animation: pc17-status-value-on 0.4s ease-out 2.3s forwards; }
    .playing [data-status="face-mask"] .value-off { animation: pc17-status-value-off 0.4s ease-out 2.3s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes pc17-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: pc17-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }

    /* Reversible legs: default direction represents the exhale-mode flow
       (hose -> bag, mask -> hose); reversing flips them to the inhale
       direction (bag -> hose, hose -> mask). */
    .simulator-shell[data-mode="inhale"] .bag-branch-particle,
    .simulator-shell[data-mode="inhale"] .hose-mask-particle {
      animation-direction: reverse;
    }

    /* Fresh-gas particle is prominent only while inhaling */
    .simulator-shell[data-mode="exhale"] [data-link="fresh-gas-inlet"] .current-particle {
      opacity: 0.25 !important;
    }

    /* Exhale venting: a small burst of particles escapes through the
       open exhale valve, only while exhaling and playing. */
    @keyframes pc17-vent-burst {
      0% { opacity: 0; transform: translate(0, 0); }
      20% { opacity: 1; }
      100% { opacity: 0; transform: translate(30px, -24px); }
    }
    .simulator-shell[data-mode="exhale"] .playing .vent-particle {
      animation: pc17-vent-burst 1.1s ease-out infinite;
      transform-box: fill-box;
    }
    .simulator-shell[data-mode="exhale"] .playing .vent-particle.p2 { animation-delay: 0.5s; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "fresh-gas-inlet": {
      title: "الغاز الطازج (Fresh Gas)",
      text: "مصدر غازات التخدير الطازجة القادمة من الجهاز، تدخل الدائرة بصورة مستمرة لتمد المريض بها أثناء الشهيق.",
    },
    "reservoir-bag": {
      title: "كيس التنفس الاحتياطي",
      text: "كيس من المطاط يمد المريض بغازات التخدير أثناء الشهيق فقط، ويدّخر غازات الزفير خلال عملية الزفير للاستفادة منها في الشهيق التالي.",
    },
    "breathing-hose": {
      title: "خرطوم التنفس",
      text: "يوصل الخرطوم بالمطاط الوجهي بصمام الزفير، وينقل الغازات في الاتجاهين بين الجهاز والمريض.",
    },
    "exhale-valve": {
      title: "صمام الزفير",
      text: "صمام يسمح بمرور الغاز باتجاه واحد من الجهاز إلى المريض، ولا يسمح بمرور هواء الزفير إلى الجهاز، إذ يخرج هواء الزفير إلى الجو عن طريق هذا الصمام.",
    },
    "face-mask": {
      title: "القناع الوجهي",
      text: "الواجهة التي يستنشق المريض عبرها غازات التخدير أثناء الشهيق، ويزفر خلالها هواء الزفير.",
    },
  };

  wireDiagramSimulator(".patient-circuit-breathing-diagram", { cycleMs: 2600, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".patient-circuit-breathing-diagram .mode-toggle-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".patient-circuit-breathing-diagram")?.querySelector(".simulator-shell");
      const mode = btn.getAttribute("data-mode-button");
      if (!(shell instanceof HTMLElement) || !mode) return;
      shell.dataset.mode = mode;
      shell.querySelectorAll(".mode-toggle-button").forEach((b) => {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
    });
  });
</script>
