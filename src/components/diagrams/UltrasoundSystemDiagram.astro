---
// Redesigned Figure 2-21 (مخطط لاجزاء جهاز التصوير الفوق صوتي الحديث)
// using the Chapter 1 dark neumorphic simulator system. Reuses the
// shared shell/controller (src/styles/diagram-simulator.css +
// src/scripts/diagramSimulator.js).
//
// Geometry unchanged (hub-and-spoke block positions, connection lines,
// all labels identical to the prior build) — only fill/stroke
// treatment and the interaction/animation layer changed.
//
// Color mapping: a hub-and-spoke system diagram — purple for the CPU
// (the central "brain" every other unit connects through), blue for
// the peripheral I/O units (display, storage, keyboard, printer),
// orange for the pulse-control function, yellow for the probe/
// transducer (matches the probe-structure diagram's convention).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft ultrasound-system-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة جهاز التصوير الفوق صوتي الحديث</span>
      <span class="simulator-subtitle">شكل 2-21 — وحدة المعالجة كمحور للوحدات</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="us-system-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="460"
          viewBox="0 0 900 460"
          role="img"
          aria-label="مخطط لاجزاء جهاز التصوير الفوق صوتي الحديث"
        >
          <defs>
            <linearGradient id="usBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="usGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="usGradPurple" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </linearGradient>
            <linearGradient id="usGradBlue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="usGradOrange" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332210"></stop>
              <stop offset="100%" stop-color="#1a1108"></stop>
            </linearGradient>
            <linearGradient id="usGradYellow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332c10"></stop>
              <stop offset="100%" stop-color="#1a1608"></stop>
            </linearGradient>

            <filter id="usElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="usGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="460" rx="20" fill="url(#usBgGrad)"></rect>
          <rect x="0" y="0" width="900" height="460" rx="20" fill="url(#usGrid)"></rect>

          <g class="hotspot" data-component="display" tabindex="0" role="button" aria-label="شاشة العرض">
            <rect class="box-shape" x="380" y="40" width="140" height="60" rx="10" fill="url(#usGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#usElevate)"></rect>
            <text x="450" y="65" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">شاشة العرض</text>
            <text x="450" y="83" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Display</text>
          </g>

          <g class="hotspot" data-component="storage" tabindex="0" role="button" aria-label="وحدة التخزين">
            <rect class="box-shape" x="120" y="130" width="140" height="60" rx="10" fill="url(#usGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#usElevate)"></rect>
            <text x="190" y="155" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">وحدة التخزين</text>
            <text x="190" y="173" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Disk Storage</text>
          </g>

          <g class="hotspot" data-component="keyboard" tabindex="0" role="button" aria-label="لوحة المفاتيح">
            <rect class="box-shape" x="640" y="130" width="140" height="60" rx="10" fill="url(#usGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#usElevate)"></rect>
            <text x="710" y="150" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">لوحة المفاتيح</text>
            <text x="710" y="166" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Keyboard/Cursor</text>
          </g>

          <g class="hotspot" data-component="cpu" tabindex="0" role="button" aria-label="وحدة المعالجة الرئيسة">
            <rect class="box-shape" x="380" y="150" width="140" height="70" rx="12" fill="url(#usGradPurple)" stroke="#C084FC" stroke-width="2.5" filter="url(#usElevate)"></rect>
            <text x="450" y="190" font-family="Cairo, sans-serif" font-size="16" font-weight="800" fill="#C084FC" text-anchor="middle" direction="ltr">CPU</text>
          </g>

          <g class="hotspot" data-component="printer" tabindex="0" role="button" aria-label="الطابعة">
            <rect class="box-shape" x="120" y="250" width="140" height="55" rx="10" fill="url(#usGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#usElevate)"></rect>
            <text x="190" y="273" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الطابعة</text>
            <text x="190" y="291" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Printer</text>
          </g>

          <g class="hotspot" data-component="pulseControls" tabindex="0" role="button" aria-label="وحدة السيطرة على النبضات">
            <rect class="box-shape" x="345" y="250" width="210" height="70" rx="10" fill="url(#usGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#usElevate)"></rect>
            <text x="450" y="272" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">وحدة السيطرة على النبضات</text>
            <text x="450" y="288" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">Transducer Pulse Controls</text>
            <text x="450" y="305" font-family="Cairo, sans-serif" font-size="9" font-weight="600" fill="#8b94aa" text-anchor="middle" direction="ltr">Frequency · Duration · Scan mode</text>
          </g>

          <g class="hotspot" data-component="transducer" tabindex="0" role="button" aria-label="المجس">
            <rect class="box-shape" x="660" y="250" width="120" height="55" rx="10" fill="url(#usGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#usElevate)"></rect>
            <text x="720" y="273" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المجس</text>
            <text x="720" y="291" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Transducer</text>
          </g>

          <ellipse cx="720" cy="390" rx="90" ry="45" fill="#3a2530" stroke="#e879a8" stroke-width="2"></ellipse>
          <text x="720" y="395" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#e879a8" text-anchor="middle" direction="rtl">الجنين</text>

          <!-- connections (CPU as hub) -->
          <g class="link" data-link="display" data-link-to="cpu">
            <line x1="450" y1="100" x2="450" y2="150" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail trail-blue" x1="450" y1="100" x2="450" y2="148" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="storage" data-link-to="cpu">
            <line x1="260" y1="160" x2="380" y2="170" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail trail-blue" x1="260" y1="160" x2="378" y2="169" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="keyboard" data-link-to="cpu">
            <line x1="640" y1="160" x2="520" y2="170" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail trail-blue" x1="640" y1="160" x2="522" y2="169" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="printer" data-link-to="cpu">
            <line x1="260" y1="277" x2="345" y2="270" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail trail-blue" x1="260" y1="277" x2="343" y2="270" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="cpu" data-link-to="pulseControls">
            <line x1="450" y1="220" x2="450" y2="250" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail trail-orange" x1="450" y1="220" x2="450" y2="248" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="pulseControls" data-link-to="transducer">
            <line x1="555" y1="280" x2="660" y2="277" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail trail-orange" x1="555" y1="280" x2="658" y2="277" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="transducer">
            <line x1="720" y1="305" x2="720" y2="345" stroke="#5b6478" stroke-width="2"></line>
            <line class="trail" x1="720" y1="305" x2="720" y2="343" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle p-cpu-display" cx="450" cy="150" r="5" fill="#38BDF8" filter="url(#usGlow)" style="--tx:0px; --ty:-50px; --particle-delay:0.6s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-cpu-storage" cx="380" cy="170" r="5" fill="#38BDF8" filter="url(#usGlow)" style="--tx:-120px; --ty:-10px; --particle-delay:1.2s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-cpu-keyboard" cx="520" cy="170" r="5" fill="#38BDF8" filter="url(#usGlow)" style="--tx:120px; --ty:-10px; --particle-delay:1.2s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-cpu-printer" cx="345" cy="270" r="5" fill="#38BDF8" filter="url(#usGlow)" style="--tx:-85px; --ty:7px; --particle-delay:1.8s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-cpu-pulse" cx="450" cy="220" r="5" fill="#FB923C" filter="url(#usGlow)" style="--tx:0px; --ty:30px; --particle-delay:2.4s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-pulse-transducer" cx="555" cy="280" r="5" fill="#FB923C" filter="url(#usGlow)" style="--tx:105px; --ty:-3px; --particle-delay:3.0s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-transducer-fetus" cx="720" cy="305" r="5" fill="#FBBF24" filter="url(#usGlow)" style="--tx:0px; --ty:40px; --particle-delay:3.6s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="cpu"><span class="status-dot dot-purple"></span><span class="status-label">وحدة المعالجة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="display"><span class="status-dot dot-blue"></span><span class="status-label">شاشة العرض</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="storage"><span class="status-dot dot-blue"></span><span class="status-label">وحدة التخزين</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="keyboard"><span class="status-dot dot-blue"></span><span class="status-label">لوحة المفاتيح</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="printer"><span class="status-dot dot-blue"></span><span class="status-label">الطابعة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="pulseControls"><span class="status-dot dot-orange"></span><span class="status-label">السيطرة على النبضات</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="transducer"><span class="status-dot dot-yellow"></span><span class="status-label">المجس</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي وحدة لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>وحدة المعالجة</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>وحدات الادخال/الاخراج</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>السيطرة على النبضات</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>المجس</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#usElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#usElevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.015);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#usGlow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes us-shape-activate { to { filter: url(#usElevate) saturate(1.35) brightness(1.4); } }
    @keyframes us-reveal-trail { to { opacity: 0.85; } }
    @keyframes us-status-value-on { to { opacity: 1; } }
    @keyframes us-status-value-off { to { opacity: 0; } }
    @keyframes us-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes us-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes us-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes us-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }

    .playing [data-component="cpu"] .box-shape { animation: us-shape-activate 0.5s ease-out 0.1s forwards; }
    .playing [data-status="cpu"] .status-dot { animation: us-dot-on-purple 0.4s ease-out 0.1s forwards; }
    .playing [data-status="cpu"] .value-on { animation: us-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="cpu"] .value-off { animation: us-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-component="display"] .box-shape { animation: us-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="display"] .status-dot { animation: us-dot-on-blue 0.4s ease-out 0.6s forwards; }
    .playing [data-status="display"] .value-on { animation: us-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="display"] .value-off { animation: us-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="display"] .trail { animation: us-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="storage"] .box-shape,
    .playing [data-component="keyboard"] .box-shape { animation: us-shape-activate 0.4s ease-out 1.2s forwards; }
    .playing [data-status="storage"] .status-dot,
    .playing [data-status="keyboard"] .status-dot { animation: us-dot-on-blue 0.4s ease-out 1.2s forwards; }
    .playing [data-status="storage"] .value-on,
    .playing [data-status="keyboard"] .value-on { animation: us-status-value-on 0.4s ease-out 1.2s forwards; }
    .playing [data-status="storage"] .value-off,
    .playing [data-status="keyboard"] .value-off { animation: us-status-value-off 0.4s ease-out 1.2s forwards; }
    .playing [data-link="storage"] .trail,
    .playing [data-link="keyboard"] .trail { animation: us-reveal-trail 0.3s ease-out 1.0s forwards; }

    .playing [data-component="printer"] .box-shape { animation: us-shape-activate 0.4s ease-out 1.8s forwards; }
    .playing [data-status="printer"] .status-dot { animation: us-dot-on-blue 0.4s ease-out 1.8s forwards; }
    .playing [data-status="printer"] .value-on { animation: us-status-value-on 0.4s ease-out 1.8s forwards; }
    .playing [data-status="printer"] .value-off { animation: us-status-value-off 0.4s ease-out 1.8s forwards; }
    .playing [data-link="printer"] .trail { animation: us-reveal-trail 0.3s ease-out 1.6s forwards; }

    .playing [data-component="pulseControls"] .box-shape { animation: us-shape-activate 0.4s ease-out 2.4s forwards; }
    .playing [data-status="pulseControls"] .status-dot { animation: us-dot-on-orange 0.4s ease-out 2.4s forwards; }
    .playing [data-status="pulseControls"] .value-on { animation: us-status-value-on 0.4s ease-out 2.4s forwards; }
    .playing [data-status="pulseControls"] .value-off { animation: us-status-value-off 0.4s ease-out 2.4s forwards; }
    .playing [data-link="cpu"][data-link-to="pulseControls"] .trail { animation: us-reveal-trail 0.3s ease-out 2.2s forwards; }

    .playing [data-component="transducer"] .box-shape { animation: us-shape-activate 0.6s ease-out 3.0s forwards; }
    .playing [data-status="transducer"] .status-dot { animation: us-dot-on-yellow 0.4s ease-out 3.0s forwards; }
    .playing [data-status="transducer"] .value-on { animation: us-status-value-on 0.4s ease-out 3.0s forwards; }
    .playing [data-status="transducer"] .value-off { animation: us-status-value-off 0.4s ease-out 3.0s forwards; }
