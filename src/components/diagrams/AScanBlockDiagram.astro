---
// Redesigned Figure 2-13 (مخطط لاجزاء المسح الصوري للنوع A) using the
// Chapter 1 dark neumorphic simulator system. Reuses the shared
// shell/controller (src/styles/diagram-simulator.css +
// src/scripts/diagramSimulator.js).
//
// Geometry unchanged (block positions/sizes, connection paths, scope
// trace, all labels identical to the prior build) — only fill/stroke
// treatment and the interaction/animation layer changed.
//
// Color mapping: a signal-flow block diagram, so it reuses the
// Chapter 1 semantic system where it fits: green = the trigger/control
// signal (pulse generator), orange = transmission/generation, yellow =
// the probe/transducer (matches the probe-structure diagram's crystal
// color), blue = the received echo signal, purple = the display
// output (oscilloscope).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft a-scan-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة مسح النوع A</span>
      <span class="simulator-subtitle">شكل 2-13 — مسار الاشارة من المولد الى الراسم</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="a-scan-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="880"
          height="420"
          viewBox="0 0 880 420"
          role="img"
          aria-label="مخطط لاجزاء المسح الصوري للنوع (A)"
        >
          <defs>
            <marker id="as-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="asBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="asGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="asGradControl" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>
            <linearGradient id="asGradOrange" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332210"></stop>
              <stop offset="100%" stop-color="#1a1108"></stop>
            </linearGradient>
            <linearGradient id="asGradYellow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332c10"></stop>
              <stop offset="100%" stop-color="#1a1608"></stop>
            </linearGradient>
            <linearGradient id="asGradBlue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="asGradScope" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </linearGradient>

            <filter id="asElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="asGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="880" height="420" rx="20" fill="url(#asBgGrad)"></rect>
          <rect x="0" y="0" width="880" height="420" rx="20" fill="url(#asGrid)"></rect>

          <g class="hotspot" data-component="generator" tabindex="0" role="button" aria-label="مولد النبضات">
            <rect class="box-shape" x="60" y="40" width="130" height="60" rx="10" fill="url(#asGradControl)" stroke="#4ADE80" stroke-width="2" filter="url(#asElevate)"></rect>
            <text x="125" y="65" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مولد النبضات</text>
            <text x="125" y="83" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Generator</text>
          </g>

          <g class="hotspot" data-component="transmitter" tabindex="0" role="button" aria-label="المرسلة">
            <rect class="box-shape" x="60" y="170" width="130" height="60" rx="10" fill="url(#asGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#asElevate)"></rect>
            <text x="125" y="195" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المرسلة</text>
            <text x="125" y="213" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">Transmitter</text>
          </g>

          <g class="hotspot" data-component="probe" tabindex="0" role="button" aria-label="محول الطاقة (مجس)">
            <rect class="box-shape" x="60" y="300" width="130" height="70" rx="10" fill="url(#asGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#asElevate)"></rect>
            <text x="125" y="325" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">محول الطاقة</text>
            <text x="125" y="341" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">(مجس)</text>
            <text x="125" y="359" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Probe</text>
          </g>

          <ellipse cx="125" cy="405" rx="30" ry="13" fill="#3a2530" stroke="#e879a8" stroke-width="1.5"></ellipse>
          <text x="125" y="410" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#e879a8" text-anchor="middle" direction="rtl">الجنين</text>

          <g class="hotspot" data-component="receiver" tabindex="0" role="button" aria-label="المستقبلة">
            <rect class="box-shape" x="340" y="230" width="130" height="60" rx="10" fill="url(#asGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#asElevate)"></rect>
            <text x="405" y="255" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المستقبلة</text>
            <text x="405" y="273" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Receiver</text>
          </g>

          <g class="hotspot" data-component="scope" tabindex="0" role="button" aria-label="راسم الاشارة">
            <rect class="box-shape" x="620" y="60" width="220" height="220" rx="12" fill="url(#asGradScope)" stroke="#C084FC" stroke-width="2" filter="url(#asElevate)"></rect>
            <text x="730" y="45" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">راسم الاشارة</text>
            <circle cx="730" cy="140" r="55" fill="#0a0f1a" stroke="#8b94aa" stroke-width="3"></circle>
            <path class="scope-trace" d="M 685,140 L 700,140 L 705,105 L 712,175 L 720,140 L 775,140" fill="none" stroke="#4ADE80" stroke-width="2.5" filter="url(#asGlow)"></path>
            <text x="730" y="220" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Oscilloscope</text>
            <text x="700" y="245" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">V</text>
            <text x="760" y="245" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">H</text>
          </g>

          <!-- connections -->
          <g class="link" data-link="generator" data-link-to="transmitter">
            <line x1="125" y1="100" x2="125" y2="170" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></line>
            <line class="trail trail-green" x1="125" y1="100" x2="125" y2="168" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="generator" data-link-to="scope">
            <path d="M 190,60 L 730,60 L 730,85" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></path>
            <path class="trail trail-green" d="M 190,60 L 730,60 L 730,83" fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="transmitter" data-link-to="probe">
            <line x1="125" y1="230" x2="125" y2="300" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></line>
            <line class="trail trail-orange" x1="125" y1="230" x2="125" y2="298" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <line x1="125" y1="370" x2="125" y2="392" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></line>
          <line x1="145" y1="392" x2="145" y2="370" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></line>
          <g class="link" data-link="probe" data-link-to="receiver">
            <path d="M 190,340 L 405,340 L 405,290" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></path>
            <path class="trail trail-blue" d="M 190,340 L 405,340 L 405,292" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="receiver" data-link-to="scope">
            <path d="M 470,260 L 700,260 L 700,200" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#as-arrow)"></path>
            <path class="trail trail-blue" d="M 470,260 L 700,260 L 700,202" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle p-gen-scope" cx="190" cy="60" r="5" fill="#4ADE80" filter="url(#asGlow)" style="--tx:540px; --ty:0px; --particle-delay:0.3s; --particle-duration:0.6s"></circle>
            <circle class="flow-particle p-gen-tx" cx="125" cy="100" r="5" fill="#4ADE80" filter="url(#asGlow)" style="--tx:0px; --ty:70px; --particle-delay:0.3s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-tx-probe" cx="125" cy="230" r="5" fill="#FB923C" filter="url(#asGlow)" style="--tx:0px; --ty:70px; --particle-delay:1.1s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-out" cx="125" cy="370" r="5" fill="#FBBF24" filter="url(#asGlow)" style="--tx:0px; --ty:22px; --particle-delay:1.8s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-echo" cx="145" cy="392" r="5" fill="#FBBF24" filter="url(#asGlow)" style="--tx:0px; --ty:-22px; --particle-delay:2.4s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-probe-rx" cx="190" cy="340" r="5" fill="#38BDF8" filter="url(#asGlow)" style="--tx:215px; --ty:-50px; --particle-delay:2.9s; --particle-duration:0.6s"></circle>
            <circle class="flow-particle p-rx-scope" cx="470" cy="260" r="5" fill="#38BDF8" filter="url(#asGlow)" style="--tx:230px; --ty:-60px; --particle-delay:3.6s; --particle-duration:0.6s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="generator"><span class="status-dot dot-green"></span><span class="status-label">مولد النبضات</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="transmitter"><span class="status-dot dot-orange"></span><span class="status-label">المرسلة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="probe"><span class="status-dot dot-yellow"></span><span class="status-label">المجس</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="receiver"><span class="status-dot dot-blue"></span><span class="status-label">المستقبلة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="scope"><span class="status-dot dot-purple"></span><span class="status-label">راسم الاشارة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>اشارة التشغيل</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>الارسال</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>المجس</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الاستقبال</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>العرض</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#asElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#asElevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.015);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#asGlow);
  }

  .scope-trace {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes as-trace-appear {
      0%, 100% { opacity: 0; }
      15%, 85% { opacity: 1; }
    }
    .playing .scope-trace { animation: as-trace-appear 1.2s ease-in-out 3.9s; }

    @keyframes as-shape-activate { to { filter: url(#asElevate) saturate(1.35) brightness(1.4); } }
    @keyframes as-reveal-trail { to { opacity: 0.85; } }
    @keyframes as-status-value-on { to { opacity: 1; } }
    @keyframes as-status-value-off { to { opacity: 0; } }
    @keyframes as-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes as-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes as-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes as-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes as-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="generator"] .box-shape { animation: as-shape-activate 0.5s ease-out 0.1s forwards; }
    .playing [data-status="generator"] .status-dot { animation: as-dot-on-green 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generator"] .value-on { animation: as-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generator"] .value-off { animation: as-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="generator"] .trail { animation: as-reveal-trail 0.3s ease-out 0.5s forwards; }

    .playing [data-component="transmitter"] .box-shape { animation: as-shape-activate 0.5s ease-out 0.8s forwards; }
    .playing [data-status="transmitter"] .status-dot { animation: as-dot-on-orange 0.4s ease-out 0.8s forwards; }
    .playing [data-status="transmitter"] .value-on { animation: as-status-value-on 0.4s ease-out 0.8s forwards; }
    .playing [data-status="transmitter"] .value-off { animation: as-status-value-off 0.4s ease-out 0.8s forwards; }
    .playing [data-link="transmitter"] .trail { animation: as-reveal-trail 0.3s ease-out 1.3s forwards; }

    .playing [data-component="probe"] .box-shape { animation: as-shape-activate 0.5s ease-out 1.6s forwards; }
    .playing [data-status="probe"] .status-dot { animation: as-dot-on-yellow 0.4s ease-out 1.6s forwards; }
    .playing [data-status="probe"] .value-on { animation: as-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="probe"] .value-off { animation: as-status-value-off 0.4s ease-out 1.6s forwards; }
    .playing [data-link="probe"] .trail { animation: as-reveal-trail 0.3s ease-out 2.9s forwards; }

    .playing [data-component="receiver"] .box-shape { animation: as-shape-activate 0.5s ease-out 3.4s forwards; }
    .playing [data-status="receiver"] .status-dot { animation: as-dot-on-blue 0.4s ease-out 3.4s forwards; }
    .playing [data-status="receiver"] .value-on { animation: as-status-value-on 0.4s ease-out 3.4s forwards; }
    .playing [data-status="receiver"] .value-off { animation: as-status-value-off 0.4s ease-out 3.4s forwards; }
    .playing [data-link="receiver"] .trail { animation: as-reveal-trail 0.3s ease-out 3.6s forwards; }

    .playing [data-component="scope"] .box-shape { animation: as-shape-activate 0.5s ease-out 3.9s forwards; }
    .playing [data-status="scope"] .status-dot { animation: as-dot-on-purple 0.4s ease-out 3.9s forwards; }
    .playing [data-status="scope"] .value-on { animation: as-status-value-on 0.4s ease-out 3.9s forwards; }
    .playing [data-status="scope"] .value-off { animation: as-status-value-off 0.4s ease-out 3.9s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    generator: {
      title: "مولد النبضات (Pulse Generator)",
      // src/data/chapter-02/page-09.json #a-scan-p1 (excerpt)
      text: "تستخدم موجات فوق صوتية نبضية يولدها مولد النبضات (Pulse Generator) لتحفز المرسلة، وبنفس الوقت ترسل النبضات الى الاوسلوسكوب لإطلاق المسح الأفقي.",
    },
    transmitter: {
      title: "المرسلة (Transmitter)",
      // src/data/chapter-02/page-09.json #a-scan-p1 (excerpt)
      text: "المرسلة (Transmitter) الحاوية على المذبذب الكهربائي (Oscillator) ترسل نبضات الى بلورة المجس لتوليد الموجات الفوق صوتية.",
    },
    probe: {
      title: "محول الطاقة / المجس (Probe)",
      // src/data/chapter-02/page-10.json #a-scan-p2 (excerpt)
