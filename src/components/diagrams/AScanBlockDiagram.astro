---
// Animated Figure 2-13 (مخطط لاجزاء المسح الصوري للنوع A) — printed page 34.
// Teaches the A-scan signal path: the pulse generator triggers both the
// transmitter and the oscilloscope's horizontal sweep at the same instant,
// the transmitter drives the probe's crystal to emit ultrasound into the
// fetus, the echo returns to the same probe, and the receiver feeds the
// oscilloscope's vertical deflection — reusing the same flow-particle /
// highlight-pulse conventions established in Chapter 1's block diagrams.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram a-scan-diagram">
  <div class="diagram-block-image">
    <svg
      class="a-scan-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="880"
      height="420"
      viewBox="0 0 880 420"
      role="img"
      aria-label="مخطط لاجزاء المسح الصوري للنوع (A)"
    >
      <defs>
        <marker id="as-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="880" height="420" fill="none"></rect>

      <rect class="flow-highlight box-generator" x="60" y="40" width="130" height="60" rx="6" fill="#bbf7d0" stroke="#263238" stroke-width="2"></rect>
      <text x="125" y="65" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مولد النبضات</text>
      <text x="125" y="83" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Generator</text>

      <rect class="flow-highlight box-transmitter" x="60" y="170" width="130" height="60" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <text x="125" y="195" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المرسلة</text>
      <text x="125" y="213" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Transmitter</text>

      <rect class="flow-highlight box-probe" x="60" y="300" width="130" height="70" rx="6" fill="#fde68a" stroke="#263238" stroke-width="2"></rect>
      <text x="125" y="325" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">محول الطاقة</text>
      <text x="125" y="341" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">(مجس)</text>
      <text x="125" y="359" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Probe</text>

      <ellipse cx="125" cy="405" rx="30" ry="13" fill="#f9a8d4" stroke="#263238" stroke-width="1.5"></ellipse>
      <text x="125" y="410" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الجنين</text>

      <rect class="flow-highlight box-receiver" x="340" y="230" width="130" height="60" rx="6" fill="#bae6fd" stroke="#263238" stroke-width="2"></rect>
      <text x="405" y="255" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المستقبلة</text>
      <text x="405" y="273" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Receiver</text>

      <rect x="620" y="60" width="220" height="220" rx="8" fill="#f8fafc" stroke="#263238" stroke-width="2"></rect>
      <text x="730" y="45" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">راسم الاشارة</text>
      <circle class="flow-highlight scope-screen" cx="730" cy="140" r="55" fill="#0f172a" stroke="#57606f" stroke-width="3"></circle>
      <path class="scope-trace" d="M 685,140 L 700,140 L 705,105 L 712,175 L 720,140 L 775,140" fill="none" stroke="#4ade80" stroke-width="2"></path>
      <text x="730" y="220" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Oscilloscope</text>
      <text x="700" y="245" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">V</text>
      <text x="760" y="245" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">H</text>

      <!-- connections -->
      <line x1="125" y1="100" x2="125" y2="170" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></line>
      <path d="M 190,60 L 730,60 L 730,85" fill="none" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></path>
      <line x1="125" y1="230" x2="125" y2="300" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></line>
      <line x1="125" y1="370" x2="125" y2="392" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></line>
      <line x1="145" y1="392" x2="145" y2="370" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></line>
      <path d="M 190,340 L 405,340 L 405,290" fill="none" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></path>
      <path d="M 470,260 L 700,260 L 700,200" fill="none" stroke="#263238" stroke-width="2" marker-end="url(#as-arrow)"></path>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle p-gen-scope" cx="190" cy="60" r="5" style="--tx:540px; --ty:0px; --particle-delay:0.3s; --particle-duration:0.6s"></circle>
        <circle class="flow-particle p-gen-tx" cx="125" cy="100" r="5" style="--tx:0px; --ty:70px; --particle-delay:0.3s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-tx-probe" cx="125" cy="230" r="5" style="--tx:0px; --ty:70px; --particle-delay:1.1s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-out" cx="125" cy="370" r="5" style="--tx:0px; --ty:22px; --particle-delay:1.8s; --particle-duration:0.4s"></circle>
        <circle class="flow-particle p-echo" cx="145" cy="392" r="5" style="--tx:0px; --ty:-22px; --particle-delay:2.4s; --particle-duration:0.4s"></circle>
        <circle class="flow-particle p-probe-rx" cx="190" cy="340" r="5" style="--tx:215px; --ty:-50px; --particle-delay:2.9s; --particle-duration:0.6s"></circle>
        <circle class="flow-particle p-rx-scope" cx="470" cy="260" r="5" style="--tx:230px; --ty:-60px; --particle-delay:3.6s; --particle-duration:0.6s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 4.4s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 520px;
    display: flex;
    justify-content: center;
  }

  .a-scan-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .box-generator { --highlight-delay: 0.1s; --highlight-duration: 0.5s; }
  .box-transmitter { --highlight-delay: 0.8s; --highlight-duration: 0.5s; }
  .box-probe { --highlight-delay: 1.6s; --highlight-duration: 1.3s; }
  .box-receiver { --highlight-delay: 3.4s; --highlight-duration: 0.6s; }
  .scope-screen { --highlight-delay: 3.9s; --highlight-duration: 0.7s; }

  .scope-trace {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes trace-appear {
      0%, 100% { opacity: 0; }
      15%, 85% { opacity: 1; }
    }

    .playing .scope-trace {
      animation: trace-appear 1.2s ease-in-out 3.9s;
    }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".a-scan-diagram");
</script>
