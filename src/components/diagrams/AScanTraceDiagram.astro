---
// Animated Figure 2-14 (الاشارة المرسلة واشارات الصدى المستلمة) —
// printed page 35. Static artwork kept pixel-identical (same baseline,
// transmitted-pulse spike, five echo spikes, leader lines). Animation
// reveals the transmitted pulse first, then the returning echoes in
// their left-to-right time order — teaching that each echo spike is a
// reflection arriving later than the one before it, exactly the process
// the A-scan trace is recording.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram a-scan-trace-diagram">
  <div class="diagram-block-image">
    <svg
      class="ast-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="700"
      height="300"
      viewBox="0 0 700 300"
      role="img"
      aria-label="الاشارة المرسلة واشارات الصدى المستلمة"
    >
      <rect x="0" y="0" width="700" height="300" fill="none"></rect>

      <line x1="30" y1="220" x2="670" y2="220" stroke="#263238" stroke-width="2"></line>

      <path class="flow-highlight tx-pulse" d="M 60,220 q 8,-140 16,-140 t 16,140" fill="none" stroke="#263238" stroke-width="2.5"></path>

      <g class="flow-highlight echoes">
        <path d="M 230,220 q 6,-55 12,-55 t 12,55" fill="none" stroke="#263238" stroke-width="2.5"></path>
        <path d="M 340,220 q 6,-45 12,-45 t 12,45" fill="none" stroke="#263238" stroke-width="2.5"></path>
        <path d="M 415,220 q 5,-60 10,-60 t 10,60" fill="none" stroke="#263238" stroke-width="2.5"></path>
        <path d="M 440,220 q 5,-70 10,-70 t 10,70" fill="none" stroke="#263238" stroke-width="2.5"></path>
        <path d="M 560,220 q 6,-50 12,-50 t 12,50" fill="none" stroke="#263238" stroke-width="2.5"></path>
      </g>

      <g stroke="#263238" stroke-width="1" fill="none">
        <line x1="430" y1="60" x2="242" y2="165"></line>
        <line x1="430" y1="60" x2="352" y2="175"></line>
        <line x1="430" y1="60" x2="425" y2="160"></line>
        <line x1="430" y1="60" x2="450" y2="150"></line>
        <line x1="430" y1="60" x2="572" y2="170"></line>
      </g>

      <text x="90" y="35" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#dc2626" text-anchor="middle" direction="rtl">النبضة المرسلة</text>
      <text x="430" y="45" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#dc2626" text-anchor="middle" direction="rtl">صدى الصوت المستلم</text>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle" cx="30" cy="220" r="5" style="--tx:640px; --ty:0px; --particle-delay:0.1s; --particle-duration:2.3s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.6s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .ast-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .tx-pulse { --highlight-delay: 0.2s; --highlight-duration: 0.5s; }
  .echoes { --highlight-delay: 1.3s; --highlight-duration: 0.9s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".a-scan-trace-diagram");
</script>
