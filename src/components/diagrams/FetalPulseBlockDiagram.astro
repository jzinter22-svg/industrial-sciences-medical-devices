---
// Animated Figure 2-26 (المخطط الكتلوي لجهاز نبض الجنين المختبري) —
// printed page 43. Same educational shape as Figure 2-23 but drawn as the
// source draws it here: an explicit Receiver/Transmitter pair straddling
// the probe, feeding an HF amplifier, detector, audio filter and
// amplifier out to the loudspeaker — plus the separate DC power-supply
// block that feeds every other stage, drawn apart from the signal chain
// because it isn't part of the signal path itself. Same flow-particle /
// highlight-pulse conventions as Chapter 1.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram fetal-pulse-diagram">
  <div class="diagram-block-image">
    <svg
      class="fetal-pulse-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="900"
      height="380"
      viewBox="0 0 900 380"
      role="img"
      aria-label="المخطط الكتلوي لجهاز نبض الجنين المختبري"
    >
      <defs>
        <marker id="fp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="900" height="380" fill="none"></rect>

      <rect class="flow-highlight box-rx" x="220" y="70" width="110" height="55" rx="6" fill="#fdba74" stroke="#263238" stroke-width="2"></rect>
      <text x="275" y="93" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مستقبلة</text>
      <text x="275" y="110" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Receiver</text>

      <rect class="flow-highlight box-tx" x="220" y="150" width="110" height="55" rx="6" fill="#fde68a" stroke="#263238" stroke-width="2"></rect>
      <text x="275" y="173" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مرسلة</text>
      <text x="275" y="190" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Transmitter</text>

      <rect x="60" y="110" width="90" height="55" rx="6" fill="#94a3b8" stroke="#263238" stroke-width="2"></rect>
      <text x="105" y="133" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجس</text>
      <text x="105" y="150" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Probe</text>

      <path class="flow-highlight amp1" d="M 380,80 L 380,120 L 420,100 Z" fill="#fca5a5" stroke="#263238" stroke-width="2"></path>
      <text x="400" y="70" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">AMP</text>

      <rect class="flow-highlight box-detector" x="460" y="70" width="110" height="55" rx="6" fill="#86efac" stroke="#263238" stroke-width="2"></rect>
      <text x="515" y="93" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">كاشف</text>
      <text x="515" y="110" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Detector</text>

      <rect class="flow-highlight box-filter" x="610" y="70" width="110" height="55" rx="6" fill="#7dd3fc" stroke="#263238" stroke-width="2"></rect>
      <text x="665" y="93" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مرشح تردد سمعي</text>
      <text x="665" y="110" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Filter</text>

      <path class="flow-highlight amp2" d="M 760,75 L 760,120 L 800,98 Z" fill="#fca5a5" stroke="#263238" stroke-width="2"></path>
      <text x="780" y="65" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">AMP</text>

      <path class="flow-highlight loudspeaker" d="M 850,80 l -24,14 v20 l 24,14 z" fill="#fde047" stroke="#263238" stroke-width="1.5"></path>
      <text x="838" y="145" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهر صوتي</text>

      <!-- power supply block, drawn apart -->
      <rect x="60" y="260" width="150" height="70" rx="6" fill="#e9d5ff" stroke="#263238" stroke-width="2"></rect>
      <text x="135" y="285" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهز قدرة</text>
      <text x="135" y="302" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مستمر (DC)</text>
      <text x="30" y="280" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="end" direction="ltr">220V</text>
      <text x="30" y="298" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="end" direction="ltr">50HZ</text>
      <line x1="60" y1="280" x2="40" y2="280" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <line x1="60" y1="300" x2="40" y2="300" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <line x1="210" y1="280" x2="330" y2="280" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <text x="270" y="273" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الى جميع اجزاء</text>
      <text x="270" y="298" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الدائرة الكهربائية</text>

      <!-- signal-chain connections -->
      <line x1="150" y1="130" x2="220" y2="97" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <line x1="150" y1="150" x2="220" y2="177" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <line x1="330" y1="97" x2="380" y2="97" stroke="#263238" stroke-width="2"></line>
      <line x1="420" y1="100" x2="460" y2="97" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <line x1="570" y1="97" x2="610" y2="97" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>
      <line x1="720" y1="97" x2="760" y2="97" stroke="#263238" stroke-width="2"></line>
      <line x1="800" y1="98" x2="826" y2="90" stroke="#263238" stroke-width="2" marker-end="url(#fp-arrow)"></line>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle p-tx-probe" cx="150" cy="150" r="5" style="--tx:70px; --ty:27px; --particle-delay:0.3s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-probe-rx" cx="150" cy="130" r="5" style="--tx:70px; --ty:-33px; --particle-delay:1.1s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-rx-amp" cx="330" cy="97" r="5" style="--tx:50px; --ty:0px; --particle-delay:1.8s; --particle-duration:0.4s"></circle>
        <circle class="flow-particle p-amp-detector" cx="420" cy="100" r="5" style="--tx:40px; --ty:-3px; --particle-delay:2.3s; --particle-duration:0.4s"></circle>
        <circle class="flow-particle p-detector-filter" cx="570" cy="97" r="5" style="--tx:40px; --ty:0px; --particle-delay:2.8s; --particle-duration:0.4s"></circle>
        <circle class="flow-particle p-filter-amp" cx="720" cy="97" r="5" style="--tx:40px; --ty:0px; --particle-delay:3.3s; --particle-duration:0.4s"></circle>
        <circle class="flow-particle p-amp-speaker" cx="800" cy="98" r="5" style="--tx:26px; --ty:-8px; --particle-delay:3.8s; --particle-duration:0.4s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 4.3s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 560px;
    display: flex;
    justify-content: center;
  }

  .fetal-pulse-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .box-tx { --highlight-delay: 0.1s; --highlight-duration: 0.5s; }
  .box-rx { --highlight-delay: 0.9s; --highlight-duration: 0.5s; }
  .amp1 { --highlight-delay: 1.6s; --highlight-duration: 0.5s; }
  .box-detector { --highlight-delay: 2.1s; --highlight-duration: 0.5s; }
  .box-filter { --highlight-delay: 2.6s; --highlight-duration: 0.5s; }
  .amp2 { --highlight-delay: 3.1s; --highlight-duration: 0.5s; }
  .loudspeaker { --highlight-delay: 3.6s; --highlight-duration: 0.6s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".fetal-pulse-diagram");
</script>
