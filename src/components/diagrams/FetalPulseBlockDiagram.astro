---
// Redesigned Figure 2-26 (المخطط الكتلوي لجهاز نبض الجنين المختبري)
// using the Chapter 1 dark neumorphic simulator system. Reuses the
// shared shell/controller (src/styles/diagram-simulator.css +
// src/scripts/diagramSimulator.js).
//
// Geometry unchanged (block positions/shapes, connection paths, power
// -supply block drawn apart from the signal chain, all labels
// identical to the prior build) — only fill/stroke treatment and the
// interaction/animation layer changed.
//
// Color mapping: a signal-flow block diagram — blue for the receive
// path (receiver + detector), orange for the transmit/amplify path
// (transmitter + both amplifiers), yellow for the probe, purple for
// the audio filter, white for the loudspeaker, green for the DC power
// supply (drawn apart since it isn't part of the signal path itself).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft fetal-pulse-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة جهاز نبض الجنين المختبري</span>
      <span class="simulator-subtitle">شكل 2-26 — سلسلة الاشارة ومجهز القدرة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="fetal-pulse-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="380"
          viewBox="0 0 900 380"
          role="img"
          aria-label="المخطط الكتلوي لجهاز نبض الجنين المختبري"
        >
          <defs>
            <marker id="fp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="fpBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="fpGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="fpGradBlue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="fpGradOrange" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332210"></stop>
              <stop offset="100%" stop-color="#1a1108"></stop>
            </linearGradient>
            <linearGradient id="fpGradYellow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332c10"></stop>
              <stop offset="100%" stop-color="#1a1608"></stop>
            </linearGradient>
            <linearGradient id="fpGradPurple" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </linearGradient>
            <linearGradient id="fpGradGreen" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>

            <filter id="fpElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="fpGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="380" rx="20" fill="url(#fpBgGrad)"></rect>
          <rect x="0" y="0" width="900" height="380" rx="20" fill="url(#fpGrid)"></rect>

          <g class="hotspot" data-component="rx" tabindex="0" role="button" aria-label="مستقبلة">
            <rect class="box-shape" x="220" y="70" width="110" height="55" rx="10" fill="url(#fpGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#fpElevate)"></rect>
            <text x="275" y="93" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مستقبلة</text>
            <text x="275" y="110" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Receiver</text>
          </g>

          <g class="hotspot" data-component="tx" tabindex="0" role="button" aria-label="مرسلة">
            <rect class="box-shape" x="220" y="150" width="110" height="55" rx="10" fill="url(#fpGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#fpElevate)"></rect>
            <text x="275" y="173" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مرسلة</text>
            <text x="275" y="190" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">Transmitter</text>
          </g>

          <g class="hotspot" data-component="probe" tabindex="0" role="button" aria-label="مجس">
            <rect class="box-shape" x="60" y="110" width="90" height="55" rx="10" fill="url(#fpGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#fpElevate)"></rect>
            <text x="105" y="133" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مجس</text>
            <text x="105" y="150" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Probe</text>
          </g>

          <g class="hotspot" data-component="amp1" tabindex="0" role="button" aria-label="مكبر تردد عالي">
            <rect class="hit-area" x="370" y="60" width="60" height="70" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 380,80 L 380,120 L 420,100 Z" fill="url(#fpGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#fpElevate)"></path>
            <text x="400" y="70" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">AMP</text>
          </g>

          <g class="hotspot" data-component="detector" tabindex="0" role="button" aria-label="كاشف">
            <rect class="box-shape" x="460" y="70" width="110" height="55" rx="10" fill="url(#fpGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#fpElevate)"></rect>
            <text x="515" y="93" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">كاشف</text>
            <text x="515" y="110" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Detector</text>
          </g>

          <g class="hotspot" data-component="filter" tabindex="0" role="button" aria-label="مرشح تردد سمعي">
            <rect class="box-shape" x="610" y="70" width="110" height="55" rx="10" fill="url(#fpGradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#fpElevate)"></rect>
            <text x="665" y="93" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مرشح تردد سمعي</text>
            <text x="665" y="110" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Filter</text>
          </g>

          <g class="hotspot" data-component="amp2" tabindex="0" role="button" aria-label="مكبر تردد سمعي">
            <rect class="hit-area" x="750" y="60" width="60" height="70" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 760,75 L 760,120 L 800,98 Z" fill="url(#fpGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#fpElevate)"></path>
            <text x="780" y="65" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">AMP</text>
          </g>

          <g class="hotspot" data-component="loudspeaker" tabindex="0" role="button" aria-label="مجهر صوتي">
            <rect class="hit-area" x="810" y="70" width="60" height="90" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 850,80 l -24,14 v20 l 24,14 z" fill="#332c10" stroke="#eef1f8" stroke-width="1.5" filter="url(#fpElevate)"></path>
            <text x="838" y="145" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مجهر صوتي</text>
          </g>

          <!-- power supply block, drawn apart -->
          <g class="hotspot" data-component="powerSupply" tabindex="0" role="button" aria-label="مجهز قدرة مستمر">
            <rect class="hit-area" x="20" y="255" width="260" height="80" fill="#000" fill-opacity="0"></rect>
            <rect class="box-shape" x="60" y="260" width="150" height="70" rx="10" fill="url(#fpGradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#fpElevate)"></rect>
            <text x="135" y="285" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مجهز قدرة</text>
            <text x="135" y="302" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مستمر (DC)</text>
            <text x="30" y="280" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#4ADE80" text-anchor="end" direction="ltr">220V</text>
            <text x="30" y="298" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#4ADE80" text-anchor="end" direction="ltr">50HZ</text>
            <line x1="60" y1="280" x2="40" y2="280" stroke="#4ADE80" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line x1="60" y1="300" x2="40" y2="300" stroke="#4ADE80" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line x1="210" y1="280" x2="330" y2="280" stroke="#4ADE80" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <text x="270" y="273" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">الى جميع اجزاء</text>
            <text x="270" y="298" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">الدائرة الكهربائية</text>
          </g>

          <!-- signal-chain connections -->
          <g class="link" data-link="probe" data-link-to="rx">
            <line x1="150" y1="130" x2="220" y2="97" stroke="#5b6478" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line class="trail trail-blue" x1="150" y1="130" x2="218" y2="98" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="tx" data-link-to="probe">
            <line x1="150" y1="150" x2="220" y2="177" stroke="#5b6478" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line class="trail trail-orange" x1="152" y1="151" x2="220" y2="177" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <line x1="330" y1="97" x2="380" y2="97" stroke="#5b6478" stroke-width="2"></line>
          <g class="link" data-link="amp1" data-link-to="detector">
            <line x1="420" y1="100" x2="460" y2="97" stroke="#5b6478" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line class="trail trail-orange" x1="420" y1="100" x2="458" y2="97" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="detector" data-link-to="filter">
            <line x1="570" y1="97" x2="610" y2="97" stroke="#5b6478" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line class="trail trail-blue" x1="570" y1="97" x2="608" y2="97" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <line x1="720" y1="97" x2="760" y2="97" stroke="#5b6478" stroke-width="2"></line>
          <g class="link" data-link="amp2" data-link-to="loudspeaker">
            <line x1="800" y1="98" x2="826" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#fp-arrow)"></line>
            <line class="trail trail-orange" x1="800" y1="98" x2="824" y2="91" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle p-tx-probe" cx="150" cy="150" r="5" fill="#FB923C" filter="url(#fpGlow)" style="--tx:70px; --ty:27px; --particle-delay:0.3s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-probe-rx" cx="150" cy="130" r="5" fill="#38BDF8" filter="url(#fpGlow)" style="--tx:70px; --ty:-33px; --particle-delay:1.1s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle p-rx-amp" cx="330" cy="97" r="5" fill="#38BDF8" filter="url(#fpGlow)" style="--tx:50px; --ty:0px; --particle-delay:1.8s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-amp-detector" cx="420" cy="100" r="5" fill="#FB923C" filter="url(#fpGlow)" style="--tx:40px; --ty:-3px; --particle-delay:2.3s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-detector-filter" cx="570" cy="97" r="5" fill="#38BDF8" filter="url(#fpGlow)" style="--tx:40px; --ty:0px; --particle-delay:2.8s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-filter-amp" cx="720" cy="97" r="5" fill="#C084FC" filter="url(#fpGlow)" style="--tx:40px; --ty:0px; --particle-delay:3.3s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-amp-speaker" cx="800" cy="98" r="5" fill="#FB923C" filter="url(#fpGlow)" style="--tx:26px; --ty:-8px; --particle-delay:3.8s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="tx"><span class="status-dot dot-orange"></span><span class="status-label">المرسلة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="probe"><span class="status-dot dot-yellow"></span><span class="status-label">المجس</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="rx"><span class="status-dot dot-blue"></span><span class="status-label">المستقبلة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="amp1"><span class="status-dot dot-orange"></span><span class="status-label">مكبر التردد العالي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="detector"><span class="status-dot dot-blue"></span><span class="status-label">الكاشف</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="filter"><span class="status-dot dot-purple"></span><span class="status-label">المرشح</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="amp2"><span class="status-dot dot-orange"></span><span class="status-label">مكبر التردد السمعي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="loudspeaker"><span class="status-dot dot-white"></span><span class="status-label">المجهر الصوتي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="powerSupply"><span class="status-dot dot-green"></span><span class="status-label">مجهز القدرة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي وحدة لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الاستقبال والكشف</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>الارسال والتكبير</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>المجس</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الترشيح</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>مجهز القدرة</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#fpElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#fpElevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.015);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#fpGlow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes fp-shape-activate { to { filter: url(#fpElevate) saturate(1.35) brightness(1.4); } }
    @keyframes fp-reveal-trail { to { opacity: 0.85; } }
    @keyframes fp-status-value-on { to { opacity: 1; } }
    @keyframes fp-status-value-off { to { opacity: 0; } }
    @keyframes fp-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes fp-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes fp-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes fp-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes fp-dot-on-white { to { background: #eef1f8; box-shadow: 0 0 8px 1px rgba(238, 241, 248, 0.8); } }
    @keyframes fp-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="tx"] .box-shape { animation: fp-shape-activate 0.5s ease-out 0.1s forwards; }
    .playing [data-status="tx"] .status-dot { animation: fp-dot-on-orange 0.4s ease-out 0.1s forwards; }
    .playing [data-status="tx"] .value-on { animation: fp-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="tx"] .value-off { animation: fp-status-value-off 0.4s ease-out 0.1s forwards; }
