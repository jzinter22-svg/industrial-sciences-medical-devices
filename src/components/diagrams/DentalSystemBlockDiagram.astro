---
// Figure 7-1 (المخطط الكتلوي لنظام جهاز الأسنان الحديثة) — system
// architecture block diagram showing all major components and
// connections in a dark neumorphic simulator style matching previous
// chapters. Non-interactive diagram wrapped in the standard
// simulator shell for visual consistency with other chapters.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const diagramSrc = import.meta.env.BASE_URL.replace(/\/$/, "") + "/assets/svg/chapter-07/diagram-01-system-block.svg";
---

<figure class="diagram-block neo-surface-soft dental-system-block-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام جهاز الأسنان</span>
      <span class="simulator-subtitle">شكل 1-7 — المخطط الكتلوي الشامل</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <img
          src={diagramSrc}
          alt="المخطط الكتلوي لنظام جهاز الأسنان الحديثة"
          style="max-width: 100%; height: auto;"
        />
      </div>
      {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}
    </div>
  </div>
</figure>

<style>
  .dental-system-block-diagram {
    margin: 2rem 0;
  }

  .diagram-block-image {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
  }

  .diagram-block-caption {
    text-align: center;
    font-size: 0.95rem;
    color: #94a3b8;
    margin-top: 1rem;
    padding: 0 1rem;
    font-weight: 500;
  }
</style>
