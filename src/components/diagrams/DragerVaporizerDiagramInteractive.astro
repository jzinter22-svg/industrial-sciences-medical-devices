---
// Figure 9-12 (مبخر دريجر بالتحكم الحراري اليدوي) — the simplest of the
// chapter's vaporizer family: a single throttle/thermal-control valve
// that the operator adjusts BY HAND, reading a thermometer mounted
// inside the vaporizer body (its graduated dial is readable from
// outside). This is the manual baseline the next diagram (9-12-أ,
// bimetallic/automatic) is contrasted against, so the info text leans
// on "يدويا" / "manual" throughout.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft drager-vaporizer-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة مبخر دريجر بالتحكم الحراري اليدوي</span>
      <span class="simulator-subtitle">شكل 9-12 — الصمام الخانق والثرمومتر</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="vp12-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="300"
          viewBox="0 0 900 300"
          role="img"
          aria-label="مبخر دريجر بالتحكم الحراري اليدوي"
        >
          <defs>
            <marker id="vp12-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="vp12BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="vp12Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="vp12GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="vp12GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="vp12GradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1414"></stop><stop offset="100%" stop-color="#1a0a0a"></stop></linearGradient>
            <linearGradient id="vp12GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>

            <filter id="vp12Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="vp12Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="300" rx="20" fill="url(#vp12BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="300" rx="20" fill="url(#vp12Grid)"></rect>

          <text x="450" y="18" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">مبخر دريجر (Drager) بالتحكم الحراري اليدوي</text>

          <!-- gas inlet -->
          <g class="hotspot" data-component="gas-inlet" tabindex="0" role="button" aria-label="دخول الغاز">
            <rect class="box-shape" x="30" y="155" width="95" height="70" rx="10" fill="url(#vp12GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#vp12Elevate)"></rect>
            <path d="M 55,190 L 95,190 M 82,178 L 98,190 L 82,202" fill="none" stroke="#38BDF8" stroke-width="1.6"></path>
            <text x="77" y="215" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">دخول الغاز</text>
          </g>

          <g class="link" data-link="gas-inlet" data-link-to="thermal-control-valve">
            <line id="vp12-wire-1" x1="125" y1="190" x2="228" y2="190" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp12-arrow)"></line>
            <line class="trail" x1="125" y1="190" x2="226" y2="190" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#vp12Glow)" style="offset-path: url(#vp12-wire-1); --flow-delay:0.2s; --flow-duration:0.8s;"></circle>
          </g>

          <!-- thermal control valve (body of the vaporizer) -->
          <g class="hotspot" data-component="thermal-control-valve" tabindex="0" role="button" aria-label="صمام التحكم الحراري (خانق)">
            <rect class="box-shape" x="230" y="130" width="150" height="120" rx="12" fill="url(#vp12GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#vp12Elevate)"></rect>
            <circle cx="305" cy="180" r="16" fill="none" stroke="#FB923C" stroke-width="1.6"></circle>
            <path d="M 305,164 L 305,196 M 289,180 L 321,180" stroke="#FB923C" stroke-width="1.4"></path>
            <text x="305" y="225" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">صمام التحكم الحراري</text>
            <text x="305" y="238" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#fcd9b6" direction="ltr">Thermal control valve</text>
          </g>

          <!-- dashed "reads" connector to the thermometer, no particle -->
          <g class="link" data-link="thermal-control-valve" data-link-to="thermometer">
            <line class="trail" x1="320" y1="130" x2="320" y2="112" stroke="#EF4444" stroke-width="2" stroke-dasharray="3 5"></line>
          </g>

          <!-- thermometer, mounted inside, graduated dial readable from outside -->
          <g class="hotspot" data-component="thermometer" tabindex="0" role="button" aria-label="ثرمومتر">
            <rect class="box-shape" x="290" y="15" width="60" height="95" rx="18" fill="url(#vp12GradRed)" stroke="#EF4444" stroke-width="2" filter="url(#vp12Elevate)"></rect>
            <line x1="320" y1="26" x2="320" y2="90" stroke="#EF4444" stroke-width="1.4"></line>
            <line x1="308" y1="34" x2="316" y2="34" stroke="#EF4444" stroke-width="1"></line>
            <line x1="308" y1="50" x2="316" y2="50" stroke="#EF4444" stroke-width="1"></line>
            <line x1="308" y1="66" x2="316" y2="66" stroke="#EF4444" stroke-width="1"></line>
            <line x1="308" y1="82" x2="316" y2="82" stroke="#EF4444" stroke-width="1"></line>
            <circle cx="320" cy="94" r="7" fill="#EF4444"></circle>
            <text x="320" y="8" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#f7c9c9" direction="rtl">ثرمومتر</text>
          </g>

          <g class="link" data-link="thermal-control-valve" data-link-to="gas-outlet">
            <line id="vp12-wire-2" x1="380" y1="190" x2="648" y2="190" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp12-arrow)"></line>
            <line class="trail" x1="380" y1="190" x2="646" y2="190" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FB923C" filter="url(#vp12Glow)" style="offset-path: url(#vp12-wire-2); --flow-delay:1.1s; --flow-duration:0.9s;"></circle>
          </g>

          <!-- gas outlet -->
          <g class="hotspot" data-component="gas-outlet" tabindex="0" role="button" aria-label="خروج الغاز">
            <rect class="box-shape" x="650" y="155" width="95" height="70" rx="10" fill="url(#vp12GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#vp12Elevate)"></rect>
            <path d="M 675,190 L 715,190 M 702,178 L 718,190 L 702,202" fill="none" stroke="#FBBF24" stroke-width="1.6"></path>
            <text x="697" y="215" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">خروج الغاز</text>
          </g>

          <text x="450" y="278" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">يضبط المشغّل الصمام الخانق يدويا وفق تدريج الثرمومتر الذي يُقرأ من خارج المبخر</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة المبخر</h3>
        <ul class="status-list">
          <li class="status-row" data-status="gas-inlet"><span class="status-dot dot-blue"></span><span class="status-label">دخول الغاز</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يدخل المبخر</span></span></li>
          <li class="status-row" data-status="thermal-control-valve"><span class="status-dot dot-orange"></span><span class="status-label">صمام التحكم الحراري</span><span class="status-value"><span class="value-off">مضبوط يدويا</span><span class="value-on">يوزّع الخليط</span></span></li>
          <li class="status-row" data-status="thermometer"><span class="status-dot dot-red"></span><span class="status-label">الثرمومتر</span><span class="status-value"><span class="value-off">يُقرأ يدويا</span><span class="value-on">يُقرأ الآن</span></span></li>
          <li class="status-row" data-status="gas-outlet"><span class="status-dot dot-yellow"></span><span class="status-label">خروج الغاز</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">خليط مخدّر</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>دخول الغاز</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>الصمام الخانق (يدوي)</li>
      <li class="legend-item"><span class="legend-swatch legend-red"></span>الثرمومتر</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>خروج الغاز</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-red { background: #EF4444; }

  .hotspot .box-shape {
    filter: url(#vp12Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#vp12Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#vp12Glow); }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes vp12-shape-activate { to { filter: url(#vp12Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes vp12-reveal-trail { to { opacity: 0.85; } }
    @keyframes vp12-status-value-on { to { opacity: 1; } }
    @keyframes vp12-status-value-off { to { opacity: 0; } }
    @keyframes vp12-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes vp12-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes vp12-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes vp12-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }

    .playing [data-component="gas-inlet"] .box-shape { animation: vp12-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-inlet"] .status-dot { animation: vp12-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-inlet"] .value-on { animation: vp12-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-inlet"] .value-off { animation: vp12-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="gas-inlet"] .trail { animation: vp12-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="thermal-control-valve"] .box-shape { animation: vp12-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="thermal-control-valve"] .status-dot { animation: vp12-dot-on-orange 0.4s ease-out 0.6s forwards; }
    .playing [data-status="thermal-control-valve"] .value-on { animation: vp12-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="thermal-control-valve"] .value-off { animation: vp12-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-link="thermal-control-valve"][data-link-to="thermometer"] .trail { animation: vp12-reveal-trail 0.3s ease-out 0.9s forwards; }
    .playing [data-component="thermometer"] .box-shape { animation: vp12-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="thermometer"] .status-dot { animation: vp12-dot-on-red 0.4s ease-out 1.1s forwards; }
    .playing [data-status="thermometer"] .value-on { animation: vp12-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="thermometer"] .value-off { animation: vp12-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-link="thermal-control-valve"][data-link-to="gas-outlet"] .trail { animation: vp12-reveal-trail 0.3s ease-out 1.4s forwards; }
    .playing [data-component="gas-outlet"] .box-shape { animation: vp12-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="gas-outlet"] .status-dot { animation: vp12-dot-on-yellow 0.4s ease-out 1.6s forwards; }
    .playing [data-status="gas-outlet"] .value-on { animation: vp12-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="gas-outlet"] .value-off { animation: vp12-status-value-off 0.4s ease-out 1.6s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes vp12-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: vp12-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "gas-inlet": {
      title: "دخول الغاز",
      text: "دخول خليط الغازات القادم من العمود الخلفي إلى مبخر دريجر (Drager) ذي التحكم الحراري اليدوي.",
    },
    "thermal-control-valve": {
      title: "الصمام الخانق (التحكم الحراري اليدوي)",
      text: "صمام خانق أو صمام تحكم حراري يضبطه المشغّل يدويا، بحسب ما يقرأه على تدريج الثرمومتر المثبت داخل المبخر، لتعويض تغيّر معدل التبخر مع تغيّر درجة الحرارة.",
    },
    thermometer: {
      title: "الثرمومتر",
      text: "ثرمومتر مثبت بداخل المبخر، لكن تدريجه يُقرأ من خارج الجهاز، ليعرف المشغّل درجة حرارة السائل المخدر فيعدّل صمام التحكم الحراري يدويا وفقا لها.",
    },
    "gas-outlet": {
      title: "خروج الغاز",
      text: "خروج خليط الغازات بعد إضافة نسبة بخار المادة المخدرة المضبوطة يدويا، متجها إلى بقية أجزاء الجهاز ثم إلى المريض.",
    },
  };

  wireDiagramSimulator(".drager-vaporizer-diagram", { cycleMs: 2200, componentInfo: COMPONENT_INFO });
</script>
