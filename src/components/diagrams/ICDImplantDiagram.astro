---
// Figure 4-16 (c4-fig-4-16) — موضع جهاز الرجة المزروع (ICD). Built as a
// dark neumorphic interactive simulator following the exact Chapter 3/4
// "anatomical placement" system (ChestElectrodeDiagram.astro /
// LimbElectrodeDiagram.astro): a simplified upper-body/chest outline in
// muted skin/gray-blue tones with a crimson heart shape (matching
// DemandPacemakerBlockDiagram.astro's cardiac convention), the ICD
// generator implanted subcutaneously near the collarbone, and a lead
// wire running down into the heart to two sensing/pacing points — one
// atrial, one ventricular — since the source text specifies the device
// senses both chambers ("متحسس للانقباض الأذيني والبطيني"). All SVG ids
// are prefixed "icd16" to stay unique site-wide.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft icd-implant-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة موضع جهاز الرجة المزروع</span>
      <span class="simulator-subtitle">شكل 4-16 — جهاز الرجة المزروع (ICD) وموضع أقطابه على عضلة القلب</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="icd16-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="520"
          height="420"
          viewBox="0 0 520 420"
          role="img"
          aria-label="موضع جهاز الرجة المزروع (ICD)"
        >
          <defs>
            <marker id="icd16-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="icd16BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="icd16Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="icd16GradSkin" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#2a3348"></stop><stop offset="100%" stop-color="#1a2032"></stop></linearGradient>
            <linearGradient id="icd16GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="icd16GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="icd16GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="icd16GradRose" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a141c"></stop><stop offset="100%" stop-color="#180a0d"></stop></linearGradient>

            <filter id="icd16Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="7" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="7" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="5" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-3" dy="-3" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha"><feFuncA type="table" tableValues="1 0"></feFuncA></feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="2.5" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="1.5" dy="2.5" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="2" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-1.5" dy="-2" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.3" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode><feMergeNode in="haloOuter"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode><feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="icd16Glow" x="-220%" y="-220%" width="540%" height="540%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="520" height="420" rx="20" fill="url(#icd16BgGrad)"></rect>
          <rect x="0" y="0" width="520" height="420" rx="20" fill="url(#icd16Grid)"></rect>

          <!-- upper-body / chest outline (not a hotspot): shoulders, neck, torso -->
          <path
            d="M 210,45 Q 260,25 310,45 L 320,80 Q 380,95 405,150 L 415,340 Q 260,375 105,340 L 115,150 Q 140,95 200,80 Z"
            fill="url(#icd16GradSkin)"
            stroke="#3a4258"
            stroke-width="2"
          ></path>
          <path d="M 210,45 Q 260,60 310,45" fill="none" stroke="#3a4258" stroke-width="1.5"></path>
          <path d="M 150,150 Q 260,175 370,150" fill="none" stroke="rgba(148,163,184,0.18)" stroke-width="1.5"></path>
          <path d="M 140,220 Q 260,242 380,220" fill="none" stroke="rgba(148,163,184,0.14)" stroke-width="1.5"></path>

          <!-- heart, inside the chest (Chapter 3 cardiac-anatomy convention) -->
          <path
            class="heart-shape"
            d="M 260,255 C 220,205 165,205 165,250 C 165,290 210,320 260,355 C 310,320 355,290 355,250 C 355,205 300,205 260,255 Z"
            fill="url(#icd16GradRose)"
            stroke="#FB7185"
            stroke-width="2"
            filter="url(#icd16Elevate)"
          ></path>
          <text x="260" y="390" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#dbe0ec" text-anchor="middle" direction="rtl">عضلة القلب</text>

          <!-- ICD generator device (implanted subcutaneously near the collarbone) -->
          <g class="hotspot" data-component="generatorDevice" tabindex="0" role="button" aria-label="جهاز الرجة المزروع (Generator)">
            <rect class="box-shape" x="330" y="95" width="70" height="52" rx="10" fill="url(#icd16GradPurple)" stroke="#C084FC" stroke-width="2.5" filter="url(#icd16Elevate)"></rect>
            <text x="365" y="117" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الجهاز المزروع</text>
            <text x="365" y="132" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Generator</text>
          </g>

          <!-- lead wire: device -> heart -->
          <g class="link" data-link="generatorDevice" data-link-to="atrialSensor">
            <path d="M 330,140 Q 300,165 280,200" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#icd16-arrow)"></path>
            <path class="trail trail-blue" d="M 330,140 Q 300,165 280,198" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="hotspot" data-component="leadWire" tabindex="0" role="button" aria-label="السلك الموصل">
            <rect class="hit-area" x="272" y="150" width="60" height="45" fill="#000" fill-opacity="0"></rect>
            <text x="345" y="170" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="rtl">السلك الموصل</text>
          </g>

          <!-- atrial sensor -->
          <g class="hotspot" data-component="atrialSensor" tabindex="0" role="button" aria-label="متحسس الأذين">
            <rect class="hit-area" x="197" y="207" width="105" height="50" fill="#000" fill-opacity="0"></rect>
            <circle class="box-shape" cx="272" cy="232" r="13" fill="url(#icd16GradGreen)" stroke="#4ADE80" stroke-width="2.5" filter="url(#icd16Elevate)"></circle>
            <text x="272" y="236" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">A</text>
            <text x="205" y="228" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="rtl">متحسس الأذين</text>
          </g>

          <!-- lead continues down to the ventricle -->
          <g class="link" data-link="atrialSensor" data-link-to="ventricularElectrode">
            <path d="M 272,245 Q 268,285 262,315" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#icd16-arrow)"></path>
            <path class="trail trail-red" d="M 272,245 Q 268,285 262,313" fill="none" stroke="#F87171" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <!-- ventricular electrode: the primary discharge site -->
          <g class="hotspot" data-component="ventricularElectrode" tabindex="0" role="button" aria-label="قطب البطين">
            <rect class="hit-area" x="237" y="303" width="110" height="50" fill="#000" fill-opacity="0"></rect>
            <circle class="box-shape" cx="262" cy="328" r="15" fill="url(#icd16GradRose)" stroke="#F87171" stroke-width="2.5" filter="url(#icd16Elevate)"></circle>
            <text x="262" y="333" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">V</text>
            <text x="335" y="332" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#F87171" text-anchor="middle" direction="rtl">قطب البطين</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="330" cy="140" r="5" fill="#38BDF8" filter="url(#icd16Glow)" style="--tx:-50px; --ty:60px; --particle-delay:0.6s; --particle-duration:0.5s"></circle>
            <circle class="flow-particle" cx="272" cy="245" r="5" fill="#F87171" filter="url(#icd16Glow)" style="--tx:-10px; --ty:70px; --particle-delay:1.3s; --particle-duration:0.5s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="generatorDevice"><span class="status-dot dot-purple"></span><span class="status-label">الجهاز المزروع</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="leadWire"><span class="status-dot dot-blue"></span><span class="status-label">السلك الموصل</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">ناقل</span></span></li>
          <li class="status-row" data-status="atrialSensor"><span class="status-dot dot-green"></span><span class="status-label">متحسس الأذين</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يتحسس</span></span></li>
          <li class="status-row" data-status="ventricularElectrode"><span class="status-dot" style="background:#F87171"></span><span class="status-label">قطب البطين</span><span class="status-value"><span class="value-off">مستقر</span><span class="value-on">تفريغ!</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الجهاز المزروع</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>السلك الموصل</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>متحسس الأذين</li>
      <li class="legend-item"><span class="legend-swatch" style="background:#F87171"></span>قطب البطين</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape,
  .heart-shape {
    filter: url(#icd16Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#icd16Elevate) saturate(1.4) brightness(1.5);
    transform: scale(1.1);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#icd16Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes icd16-shape-activate { to { filter: url(#icd16Elevate) saturate(1.4) brightness(1.45); } }
    @keyframes icd16-shape-pulse {
      0%, 100% { filter: url(#icd16Elevate) saturate(1.4) brightness(1.45); }
      50% { filter: url(#icd16Elevate) saturate(1.7) brightness(1.8); }
    }
    @keyframes icd16-reveal-trail { to { opacity: 0.85; } }
    @keyframes icd16-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: icd16-particle-move var(--particle-duration, 0.5s) linear var(--particle-delay, 0s) forwards;
    }
    @keyframes icd16-status-value-on { to { opacity: 1; } }
    @keyframes icd16-status-value-off { to { opacity: 0; } }
    @keyframes icd16-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes icd16-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes icd16-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes icd16-dot-on-red { to { background: #F87171; box-shadow: 0 0 8px 1px rgba(248, 113, 113, 0.8); } }

    /* device pulses gently, then the sensed signal travels down the lead
       to the atrial sensor, then on to the ventricular electrode */
    .playing [data-component="generatorDevice"] .box-shape { animation: icd16-shape-activate 0.4s ease-out 0.1s forwards, icd16-shape-pulse 0.6s ease-in-out 0.5s 1; }
    .playing [data-status="generatorDevice"] .status-dot { animation: icd16-dot-on-purple 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generatorDevice"] .value-on { animation: icd16-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="generatorDevice"] .value-off { animation: icd16-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-link="generatorDevice"] .trail { animation: icd16-reveal-trail 0.35s ease-out 1.1s forwards; }
    .playing [data-status="leadWire"] .status-dot { animation: icd16-dot-on-blue 0.4s ease-out 1.1s forwards; }
    .playing [data-status="leadWire"] .value-on { animation: icd16-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="leadWire"] .value-off { animation: icd16-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-component="atrialSensor"] .box-shape { animation: icd16-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="atrialSensor"] .status-dot { animation: icd16-dot-on-green 0.4s ease-out 1.6s forwards; }
    .playing [data-status="atrialSensor"] .value-on { animation: icd16-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="atrialSensor"] .value-off { animation: icd16-status-value-off 0.4s ease-out 1.6s forwards; }

    .playing [data-link="atrialSensor"] .trail { animation: icd16-reveal-trail 0.35s ease-out 2.0s forwards; }

    .playing [data-component="ventricularElectrode"] .box-shape { animation: icd16-shape-activate 0.4s ease-out 2.5s forwards; }
    .playing [data-status="ventricularElectrode"] .status-dot { animation: icd16-dot-on-red 0.4s ease-out 2.5s forwards; }
    .playing [data-status="ventricularElectrode"] .value-on { animation: icd16-status-value-on 0.4s ease-out 2.5s forwards; }
    .playing [data-status="ventricularElectrode"] .value-off { animation: icd16-status-value-off 0.4s ease-out 2.5s forwards; }

    .playing .heart-shape { animation: icd16-shape-activate 0.4s ease-out 2.5s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    generatorDevice: {
      title: "جهاز الرجة المزروع (Generator)",
      // src/data/chapter-04/page-12.json #icd-p1 (excerpt)
      text: "جهاز الرجة المزروع (ICD) — جهاز متزامن يشبه منظم ضربات القلب، يستخدم لعلاج المرضى المعرضين لخطر توقف القلب المفاجئ، ويجهز طاقة قليلة بحدود (5-30 جول).",
    },
    leadWire: {
      title: "السلك الموصل",
      // src/data/chapter-04/page-12.json #icd-p1 (excerpt)
      text: "السلك الموصل — ينقل الإشارة المتحسسة والطاقة العلاجية بين الجهاز المزروع وعضلة القلب، حيث توضع أقطابه مباشرة على عضلة القلب.",
    },
    atrialSensor: {
      title: "متحسس الأذين",
      // src/data/chapter-04/page-12.json #icd-p1 (excerpt)
      text: "متحسس الانقباض الأذيني — للجهاز متحسس للانقباض الأذيني والبطيني، ويعالج كل من الأذين السريع والبطيء في المريض نفسه.",
    },
    ventricularElectrode: {
      title: "قطب البطين",
      // src/data/chapter-04/page-12.json #icd-p1 (excerpt)
      text: "قطب البطين — يوضع مباشرة على عضلة القلب، وهو موضع التفريغ الرئيس عند حدوث خطر توقف القلب المفاجئ.",
    },
  };

  wireDiagramSimulator(".icd-implant-diagram", { cycleMs: 2600, componentInfo: COMPONENT_INFO });
</script>
