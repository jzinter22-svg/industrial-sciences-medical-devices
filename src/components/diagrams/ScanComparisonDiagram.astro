---
// Animated Figure 2-16 (صور عرض شاشة الاوسيليسكوب للنوعين) — printed
// page 37. Static artwork kept pixel-identical (same A-scan spike
// panel, B-scan brightness-dot band, dashed correspondence guides).
// Animation highlights each A-scan spike and then its corresponding
// B-scan brightness dot directly below it, in left-to-right order —
// teaching how amplitude-mode (A) and brightness-mode (B) display the
// exact same returning echoes in two different ways.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram scan-comparison-diagram">
  <div class="diagram-block-image">
    <svg
      class="sc-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="700"
      height="360"
      viewBox="0 0 700 360"
      role="img"
      aria-label="صور عرض شاشة الاوسيليسكوب للنوعين"
    >
      <rect x="0" y="0" width="700" height="360" fill="none"></rect>

      <rect x="40" y="20" width="620" height="150" fill="#fef9c3" stroke="#263238" stroke-width="2"></rect>
      <line x1="60" y1="150" x2="640" y2="150" stroke="#263238" stroke-width="2"></line>
      <path class="flow-highlight pair-1 a-spike" d="M 90,150 q 8,-100 16,-100 t 16,100" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight pair-2 a-spike" d="M 260,150 q 6,-40 12,-40 t 12,40" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight pair-3 a-spike" d="M 380,150 q 6,-30 12,-30 t 12,30" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight pair-4 a-spike" d="M 470,150 q 5,-45 10,-45 t 10,45" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight pair-4 a-spike" d="M 495,150 q 5,-55 10,-55 t 10,55" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight pair-5 a-spike" d="M 590,150 q 6,-35 12,-35 t 12,35" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <text x="350" y="190" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#dc2626" text-anchor="middle" direction="ltr">(a)</text>

      <rect x="40" y="230" width="620" height="60" fill="#bae6fd" stroke="#263238" stroke-width="2"></rect>
      <ellipse class="flow-highlight pair-1 b-dot" cx="270" cy="260" rx="16" ry="6" fill="#111827"></ellipse>
      <ellipse class="flow-highlight pair-2 b-dot" cx="390" cy="260" rx="10" ry="5" fill="#111827"></ellipse>
      <ellipse class="flow-highlight pair-3 b-dot" cx="478" cy="260" rx="7" ry="4" fill="#111827"></ellipse>
      <ellipse class="flow-highlight pair-4 b-dot" cx="502" cy="260" rx="9" ry="5" fill="#111827"></ellipse>
      <ellipse class="flow-highlight pair-5 b-dot" cx="598" cy="260" rx="11" ry="5" fill="#111827"></ellipse>
      <text x="350" y="320" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#dc2626" text-anchor="middle" direction="ltr">(b)</text>

      <g class="flow-highlight guides" stroke="#57606f" stroke-width="1" stroke-dasharray="3 3">
        <line x1="270" y1="150" x2="270" y2="230"></line>
        <line x1="390" y1="150" x2="390" y2="230"></line>
        <line x1="490" y1="150" x2="490" y2="230"></line>
        <line x1="598" y1="150" x2="598" y2="230"></line>
      </g>

      <g class="flow-layer" aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.9s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .sc-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .guides { --highlight-delay: 0.1s; --highlight-duration: 0.5s; }
  .pair-1 { --highlight-delay: 0.4s; --highlight-duration: 0.5s; }
  .pair-2 { --highlight-delay: 0.9s; --highlight-duration: 0.5s; }
  .pair-3 { --highlight-delay: 1.4s; --highlight-duration: 0.5s; }
  .pair-4 { --highlight-delay: 1.9s; --highlight-duration: 0.5s; }
  .pair-5 { --highlight-delay: 2.4s; --highlight-duration: 0.4s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".scan-comparison-diagram");
</script>
