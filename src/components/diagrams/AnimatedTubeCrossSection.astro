---
// Animated version of Figure 1-2 (أنبوبة الاشعة السينية).
//
// Rebuilt against the original textbook page (page 11 / PDF index 10) for
// fidelity: the tube is a three-layer capsule — an outer teal metal
// envelope (#8DC2BE), an inset light-gray oil layer, and an octagonal
// (chamfered) glass-envelope wall drawn in light blue — instead of the
// previous plain single rounded rectangle. The anode is a wheat-colored
// rod ending in an angled beveled target wedge (not a filled triangle);
// the cathode is a small nook of the same glass-envelope wall holding a
// coiled-filament icon with two lead wires, not a plain yellow square.
// The window is a stepped channel with ridge/seal lines that pierces
// through the oil and metal layers at the bottom-center, matching the
// original's tiered plug shape, instead of a small floating rounded rect.
//
// class hooks (.anode-shape / .cathode-shape / .xray-beam / .window-shape)
// and the electron-beam dashed line are kept on the equivalent rebuilt
// elements so the existing highlight-pulse / stroke-dashoffset animation
// timing (see cathode -> electron flow -> anode -> x-ray -> window, total
// ~3.9s cycle) is unchanged — only the shapes being animated were made
// faithful to the source figure.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram tube-diagram">
  <div class="diagram-block-image">
    <svg
      class="tube-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="900"
      height="420"
      viewBox="0 0 900 420"
      role="img"
      aria-label="أنبوبة الاشعة السينية"
    >
      <defs>
        <marker id="arrow-tube" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="900" height="420" fill="none"></rect>

      <!-- Metal envelope (outer teal shell) -->
      <rect x="30" y="40" width="840" height="280" rx="55" fill="#8DC2BE" stroke="#263238" stroke-width="3"></rect>
      <!-- Oil layer (inset gray band) -->
      <rect x="55" y="63" width="790" height="234" rx="45" fill="#D6DCD3" stroke="#263238" stroke-width="2"></rect>

      <!-- Glass envelope (octagonal capsule wall) -->
      <polygon points="175,95 725,95 770,140 770,210 725,255 175,255 130,210 130,140"
        fill="#ffffff" stroke="#C6E6FB" stroke-width="10"></polygon>
      <polygon points="175,95 725,95 770,140 770,210 725,255 175,255 130,210 130,140"
        fill="none" stroke="#263238" stroke-width="1.5"></polygon>

      <!-- Window channel: pierces the oil + metal layers at bottom-center -->
      <rect x="395" y="255" width="110" height="24" fill="#ffffff" stroke="#263238" stroke-width="2"></rect>
      <rect x="415" y="279" width="70" height="42" fill="#ffffff" stroke="#263238" stroke-width="2"></rect>
      <g class="flow-highlight window-shape">
        <line x1="415" y1="292" x2="485" y2="292" stroke="#263238" stroke-width="2"></line>
        <line x1="415" y1="300" x2="485" y2="300" stroke="#263238" stroke-width="2"></line>
        <line x1="415" y1="308" x2="485" y2="308" stroke="#263238" stroke-width="2"></line>
        <line x1="415" y1="316" x2="485" y2="316" stroke="#263238" stroke-width="2"></line>
      </g>

      <!-- Anode: wheat rod entering from the left, ending in a beveled wedge target -->
      <line x1="0" y1="165" x2="130" y2="165" stroke="#F9E0A9" stroke-width="30"></line>
      <g class="flow-highlight anode-shape">
        <rect x="130" y="150" width="330" height="30" fill="#F9E0A9" stroke="#263238" stroke-width="2"></rect>
        <polygon points="460,150 500,150 470,180 430,180" fill="#EBC988" stroke="#263238" stroke-width="2"></polygon>
      </g>

      <!-- Cathode: a nook of the glass-envelope wall holding the filament coil + two leads -->
      <g class="flow-highlight cathode-shape">
        <rect x="590" y="140" width="90" height="60" fill="#C6E6FB" stroke="#263238" stroke-width="2"></rect>
        <path d="M 610,160 q 6,-8 12,0 q 6,8 12,0 q 6,-8 12,0" fill="none" stroke="#263238" stroke-width="2"></path>
        <line x1="622" y1="155" x2="622" y2="185" stroke="#263238" stroke-width="1.5"></line>
      </g>
      <line x1="640" y1="155" x2="900" y2="155" stroke="#F9E0A9" stroke-width="10"></line>
      <line x1="640" y1="185" x2="900" y2="185" stroke="#F9E0A9" stroke-width="10"></line>

      <!-- Electron beam: cathode -> anode target -->
      <line class="electron-beam" x1="620" y1="170" x2="470" y2="165" stroke="#c2410c" stroke-width="2" stroke-dasharray="4 4"></line>

      <!-- X-ray beam exiting through the window -->
      <line class="flow-highlight xray-beam" x1="450" y1="255" x2="450" y2="380" stroke="#c2410c" stroke-width="3" marker-end="url(#arrow-tube)"></line>

      <!-- Labels + leader lines -->
      <text x="330" y="105" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الأنود</text>
      <text x="330" y="123" font-family="Cairo, sans-serif" font-size="12" font-weight="600" fill="#1d4ed8" text-anchor="middle" direction="ltr">Anode</text>
      <line x1="370" y1="115" x2="400" y2="140" stroke="#263238" stroke-width="2" marker-end="url(#arrow-tube)"></line>

      <text x="630" y="105" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الكاثود</text>
      <text x="630" y="123" font-family="Cairo, sans-serif" font-size="12" font-weight="600" fill="#1d4ed8" text-anchor="middle" direction="ltr">Cathode</text>
      <line x1="640" y1="127" x2="630" y2="140" stroke="#263238" stroke-width="2" marker-end="url(#arrow-tube)"></line>

      <text x="230" y="350" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الغلاف الزجاجي</text>
      <text x="230" y="368" font-family="Cairo, sans-serif" font-size="11" font-weight="600" fill="#1d4ed8" text-anchor="middle" direction="ltr">Glass Envelope</text>
      <line x1="270" y1="340" x2="330" y2="255" stroke="#263238" stroke-width="1.5"></line>

      <text x="450" y="398" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">النافذة</text>
      <text x="450" y="415" font-family="Cairo, sans-serif" font-size="11" font-weight="600" fill="#1d4ed8" text-anchor="middle" direction="ltr">Window</text>
      <line x1="450" y1="388" x2="450" y2="321" stroke="#263238" stroke-width="1.5"></line>

      <text x="640" y="350" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الزيت</text>
      <text x="640" y="368" font-family="Cairo, sans-serif" font-size="11" font-weight="600" fill="#1d4ed8" text-anchor="middle" direction="ltr">Oil</text>
      <line x1="620" y1="340" x2="560" y2="270" stroke="#263238" stroke-width="1.5"></line>

      <text x="790" y="350" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الغلاف المعدني</text>
      <text x="790" y="368" font-family="Cairo, sans-serif" font-size="11" font-weight="600" fill="#1d4ed8" text-anchor="middle" direction="ltr">Metal Envelope</text>
      <line x1="790" y1="340" x2="760" y2="230" stroke="#263238" stroke-width="1.5"></line>

      <g aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 3.9s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .tube-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .cathode-shape {
    --highlight-delay: 0.1s;
    --highlight-duration: 0.7s;
  }

  .anode-shape {
    --highlight-delay: 2.5s;
    --highlight-duration: 0.6s;
  }

  .xray-beam {
    --highlight-delay: 2.9s;
    --highlight-duration: 0.9s;
  }

  .window-shape {
    --highlight-delay: 3.1s;
    --highlight-duration: 0.7s;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes electron-flow {
      0% {
        stroke-dashoffset: 0;
      }
      100% {
        stroke-dashoffset: -32;
      }
    }

    .playing .electron-beam {
      animation: electron-flow 0.5s linear 4;
      animation-delay: 0.6s;
    }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".tube-diagram");
</script>
