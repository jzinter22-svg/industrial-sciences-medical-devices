---
// Animated Figure 2-3 (مخطط الضوء في السقوط والانعكاس والانكسار) —
// printed page 25. Static artwork kept pixel-identical (same rays,
// angle arcs, viewBox, proportions). Animation sequence follows the
// physical order the text describes: an incident ray strikes the
// boundary at O, then splits simultaneously into a reflected ray
// (staying in the upper medium) and a refracted ray (bent toward the
// normal as it enters the lower medium) — the two angle arcs for the
// reflected/refracted rays appear together with their own ray, exactly
// like Chapter 1's cause->effect timer-circuit sequencing.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram reflection-refraction-diagram">
  <div class="diagram-block-image">
    <svg
      class="rr-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="700"
      height="460"
      viewBox="0 0 700 460"
      role="img"
      aria-label="مخطط الضوء في السقوط والانعكاس والانكسار"
    >
      <defs>
        <marker id="rr-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#dc2626"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="700" height="460" fill="none"></rect>

      <rect x="60" y="190" width="580" height="200" fill="#bfdbfe"></rect>
      <line x1="60" y1="190" x2="640" y2="190" stroke="#263238" stroke-width="2"></line>
      <text x="120" y="170" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Air</text>

      <line x1="350" y1="60" x2="350" y2="420" stroke="#57606f" stroke-width="1.5"></line>

      <g class="flow-highlight incident-ray">
        <line x1="180" y1="90" x2="350" y2="190" stroke="#dc2626" stroke-width="3" marker-end="url(#rr-arrow)"></line>
        <text x="185" y="80" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">I</text>
        <rect x="120" y="105" width="90" height="26" fill="#fde047"></rect>
        <text x="165" y="123" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">شعاع ساقط</text>
      </g>

      <g class="flow-highlight reflected-ray">
        <line x1="350" y1="190" x2="520" y2="90" stroke="#dc2626" stroke-width="3" marker-end="url(#rr-arrow)"></line>
        <text x="530" y="80" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">R¹</text>
        <rect x="490" y="105" width="100" height="26" fill="#fde047"></rect>
        <text x="540" y="123" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">شعاع منعكس</text>
      </g>

      <g class="flow-highlight refracted-ray">
        <line x1="350" y1="190" x2="420" y2="400" stroke="#dc2626" stroke-width="3" marker-end="url(#rr-arrow)"></line>
        <text x="430" y="415" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">R</text>
        <rect x="200" y="235" width="100" height="26" fill="#fde047"></rect>
        <text x="250" y="253" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">شعاع منكسر</text>
      </g>

      <g class="flow-highlight angle-i">
        <path d="M 320,190 A 30,30 0 0 1 335,163" fill="none" stroke="#ea580c" stroke-width="2"></path>
        <text x="315" y="172" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#ea580c" text-anchor="middle" direction="ltr">i</text>
      </g>
      <g class="flow-highlight angle-r1">
        <path d="M 365,163 A 30,30 0 0 1 380,190" fill="none" stroke="#ea580c" stroke-width="2"></path>
        <text x="378" y="172" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#ea580c" text-anchor="middle" direction="ltr">r¹</text>
      </g>
      <g class="flow-highlight angle-r">
        <path d="M 350,225 A 35,35 0 0 0 373,213" fill="none" stroke="#ea580c" stroke-width="2"></path>
        <text x="375" y="235" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#ea580c" text-anchor="middle" direction="ltr">r</text>
      </g>

      <circle class="flow-highlight point-o" cx="350" cy="190" r="3" fill="#263238"></circle>
      <text x="360" y="205" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="start" direction="ltr">O</text>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle p-incident" cx="180" cy="90" r="5" style="--tx:170px; --ty:100px; --particle-delay:0.1s; --particle-duration:0.8s"></circle>
        <circle class="flow-particle p-reflected" cx="350" cy="190" r="5" style="--tx:170px; --ty:-100px; --particle-delay:1.1s; --particle-duration:0.7s"></circle>
        <circle class="flow-particle p-refracted" cx="350" cy="190" r="5" style="--tx:70px; --ty:210px; --particle-delay:1.1s; --particle-duration:0.8s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.1s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 420px;
    display: flex;
    justify-content: center;
  }

  .rr-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .incident-ray { --highlight-delay: 0.1s; --highlight-duration: 0.8s; }
  .point-o { --highlight-delay: 0.9s; --highlight-duration: 0.3s; }
  .reflected-ray, .angle-r1 { --highlight-delay: 1.1s; --highlight-duration: 0.7s; }
  .refracted-ray, .angle-r { --highlight-delay: 1.1s; --highlight-duration: 0.8s; }
  .angle-i { --highlight-delay: 0.7s; --highlight-duration: 0.4s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".reflection-refraction-diagram");
</script>
