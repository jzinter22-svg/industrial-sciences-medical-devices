---
// Figure 7-3 (نظام كرسي الأسنان الهيدروليكي) — Interactive Scientific Simulator.
// Phase 2 implementation using approved Phase 1 architecture.
//
// Demonstrates hydraulic chair system components:
// - Patient chair, lift cylinders, control systems
// - Interactive hotspots with component descriptions
// - Status panel and control buttons
// - Responsive design with RTL support

import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;

// Component information from textbook definitions
const componentInfo: Record<string, { ar: string; en: string; description: string }> = {
  "patient-chair": {
    ar: "كرسي المريض",
    en: "Patient Chair",
    description: "كرسي مريح مصمم بهندسة صحيحة يحتوي على مسند الرأس والظهر وذراعين وقاعدة قابلة للحركة لتوفير أقصى درجات الراحة.",
  },
  "lift-cylinder": {
    ar: "أسطوانة الرفع",
    en: "Lift Cylinder",
    description: "أسطوانة هيدروليكية تتحكم برفع وخفض الكرسي بسلاسة وأماناً. تستخدم السائل الهيدروليكي لإنتاج قوة كافية للحركة.",
  },
  "tilt-system": {
    ar: "نظام الإمالة",
    en: "Tilt System",
    description: "يتحكم بإمالة ظهر الكرسي وتعديل زاوية استقبال المريض. يوفر راحة إضافية ويسهل الوصول إلى مناطق مختلفة من الفم.",
  },
  "footrest": {
    ar: "مسند القدمين",
    en: "Footrest",
    description: "جزء قابل للتحريك يدعم قدمي المريض. يمكن رفعه أو خفضه أو إمالته حسب الحاجة لراحة المريض.",
  },
  "hydraulic-pump": {
    ar: "المضخة الهيدروليكية",
    en: "Hydraulic Pump",
    description: "تضخ السائل الهيدروليكي إلى الأسطوانات لتوليد القوة المطلوبة لتحريك الكرسي بجميع اتجاهاته.",
  },
  "control-panel": {
    ar: "لوحة التحكم",
    en: "Control Panel",
    description: "لوحة كهربائية تحتوي على مفاتيح ومنظمات للتحكم في جميع حركات الكرسي بسهولة وأمان.",
  },
  "reservoir": {
    ar: "خزان السائل",
    en: "Reservoir",
    description: "خزان يخزن السائل الهيدروليكي ويحافظ على درجة حرارته وينقيه من الشوائب.",
  },
};
---

<figure class="diagram-block neo-surface-soft chair-hydraulic-interactive">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام الكرسي الهيدروليكي</span>
      <span class="simulator-subtitle">شكل 9-7 و 10-7 — التحكم والحركة</span>
    </div>

    <div class="simulator-content">
      <!-- Status Panel -->
      <div class="status-panel">
        <div class="status-header">حالة النظام</div>
        <div class="status-items">
          <div class="status-item">
            <span class="status-dot" style="background-color: #fbbf24;"></span>
            <span class="status-label">الكهرباء</span>
          </div>
          <div class="status-item">
            <span class="status-dot" style="background-color: #22d3ee;"></span>
            <span class="status-label">السائل الهيدروليكي</span>
          </div>
          <div class="status-item">
            <span class="status-dot" style="background-color: #c084fc;"></span>
            <span class="status-label">الحركة</span>
          </div>
        </div>
      </div>

      <!-- Main Diagram Area -->
      <div class="diagram-main">
        <svg
          class="chair-diagram-svg"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 600 500"
          role="img"
          aria-label="نظام كرسي الأسنان الهيدروليكي"
        >
          <defs>
            <style>
              .chair-diagram-svg .text { fill: #e8eef2; font-family: Arial, sans-serif; font-size: 12px; font-weight: 600; }
              .chair-diagram-svg .label { fill: #b8c5d1; font-family: Arial, sans-serif; font-size: 10px; }
              .chair-diagram-svg .hotspot { cursor: pointer; transition: opacity 0.2s ease; }
              .chair-diagram-svg .hotspot:hover ellipse,
              .chair-diagram-svg .hotspot:hover rect,
              .chair-diagram-svg .hotspot:hover circle {
                opacity: 0.9;
                filter: brightness(1.2);
              }
              .chair-diagram-svg .hotspot.active ellipse,
              .chair-diagram-svg .hotspot.active rect,
              .chair-diagram-svg .hotspot.active circle {
                filter: drop-shadow(0 0 12px rgba(192, 132, 252, 0.6));
              }
              @media (prefers-reduced-motion: reduce) {
                .chair-diagram-svg .hotspot {
                  transition: none;
                }
              }
            </style>
          </defs>

          <rect width="600" height="500" fill="#0f1419"/>

          <!-- Title -->
          <text x="300" y="25" text-anchor="middle" class="text" font-size="16" font-weight="700">نظام كرسي الأسنان الهيدروليكي</text>

          <!-- Patient Chair (Hotspot) -->
          <g class="hotspot" data-component="patient-chair" tabindex="0" role="button">
            <!-- Backrest -->
            <ellipse cx="150" cy="140" rx="25" ry="45" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="2"/>
            <!-- Seat -->
            <ellipse cx="150" cy="200" rx="35" ry="30" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="2"/>
            <!-- Headrest -->
            <ellipse cx="170" cy="100" rx="18" ry="25" fill="#2a3f4d" stroke="#4a6578" stroke-width="1.5"/>
            <!-- Arm support left -->
            <rect x="100" y="180" width="40" height="15" rx="7" fill="#445a6d" stroke="#6a7f8f" stroke-width="1"/>
            <!-- Arm support right -->
            <rect x="200" y="180" width="40" height="15" rx="7" fill="#445a6d" stroke="#6a7f8f" stroke-width="1"/>
            <!-- Base -->
            <ellipse cx="150" cy="245" rx="50" ry="15" fill="#4a6578" stroke="#6a7f8f" stroke-width="1.5"/>
            <text x="250" y="180" class="text" font-size="11">كرسي المريض</text>
            <text x="250" y="193" class="label">Patient Chair</text>
          </g>

          <!-- Lift Cylinder (Hotspot) -->
          <g class="hotspot" data-component="lift-cylinder" tabindex="0" role="button">
            <rect x="180" y="230" width="20" height="80" rx="3" fill="#4a6578" stroke="#6a7f8f" stroke-width="1.5"/>
            <line x1="190" y1="245" x2="190" y2="300" stroke="#8fa5b8" stroke-width="3"/>
            <text x="215" y="270" class="text" font-size="10">رفع</text>
            <text x="215" y="283" class="label" font-size="9">Lift</text>
          </g>

          <!-- Tilt System (Hotspot) -->
          <g class="hotspot" data-component="tilt-system" tabindex="0" role="button">
            <line x1="130" y1="90" x2="100" y2="60" stroke="#6a8fa5" stroke-width="4"/>
            <circle cx="125" cy="85" r="6" fill="#8fa5b8" stroke="#6a8fa5" stroke-width="1"/>
            <circle cx="105" cy="65" r="6" fill="#8fa5b8" stroke="#6a8fa5" stroke-width="1"/>
            <text x="70" y="70" class="text" font-size="10">إمالة</text>
            <text x="70" y="83" class="label" font-size="9">Tilt</text>
          </g>

          <!-- Footrest (Hotspot) -->
          <g class="hotspot" data-component="footrest" tabindex="0" role="button">
            <rect x="160" y="300" width="60" height="15" rx="3" fill="#445a6d" stroke="#6a7f8f" stroke-width="1.5"/>
            <text x="190" y="330" text-anchor="middle" class="text" font-size="10">مسند القدمين</text>
            <text x="190" y="343" text-anchor="middle" class="label" font-size="9">Footrest</text>
          </g>

          <!-- Hydraulic Pump (Hotspot) -->
          <g class="hotspot" data-component="hydraulic-pump" tabindex="0" role="button">
            <rect x="360" y="100" width="80" height="70" rx="5" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="2"/>
            <circle cx="400" cy="135" r="20" fill="none" stroke="#8fa5b8" stroke-width="2"/>
            <text x="400" y="160" text-anchor="middle" class="text" font-size="10">المضخة</text>
            <text x="400" y="173" text-anchor="middle" class="label" font-size="9">Pump</text>
          </g>

          <!-- Connection lines -->
          <line x1="280" y1="270" x2="360" y2="170" stroke="#22d3ee" stroke-width="2" fill="none"/>
          <line x1="190" y1="300" x2="350" y2="200" stroke="#22d3ee" stroke-width="2" fill="none"/>

          <!-- Control Panel (Hotspot) -->
          <g class="hotspot" data-component="control-panel" tabindex="0" role="button">
            <rect x="480" y="120" width="90" height="100" rx="5" fill="#2a3f4d" stroke="#4a6578" stroke-width="2"/>
            <rect x="495" y="140" width="15" height="15" fill="#fbbf24" stroke="#e0ac00" stroke-width="1"/>
            <circle cx="500" cy="165" r="5" fill="#4ade80" stroke="#22c55e" stroke-width="1"/>
            <circle cx="520" cy="165" r="5" fill="#22d3ee" stroke="#06b6d4" stroke-width="1"/>
            <rect x="495" y="185" width="30" height="12" fill="#94a3b8" stroke="#6a7f8f" stroke-width="1"/>
            <text x="525" y="170" class="text" font-size="10">التحكم</text>
            <text x="525" y="183" class="label" font-size="9">Control</text>
          </g>

          <!-- Reservoir (Hotspot) -->
          <g class="hotspot" data-component="reservoir" tabindex="0" role="button">
            <rect x="360" y="200" width="80" height="80" rx="5" fill="#2a3f4d" stroke="#4a6578" stroke-width="2"/>
            <rect x="375" y="215" width="50" height="40" fill="none" stroke="#22d3ee" stroke-width="2" opacity="0.7"/>
            <text x="400" y="280" text-anchor="middle" class="text" font-size="10">الخزان</text>
            <text x="400" y="293" text-anchor="middle" class="label" font-size="9">Reservoir</text>
          </g>

          <defs>
            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
              <polygon points="0 0, 10 3, 0 6" fill="#6a8fa5"/>
            </marker>
          </defs>
        </svg>
      </div>

      <!-- Info Panel -->
      <div class="info-panel">
        <div class="info-header">معلومات المكون</div>
        <div id="info-content" class="info-content">
          <p class="info-empty">انقر على أي مكون للحصول على معلومات تفصيلية</p>
        </div>
      </div>
    </div>

    <!-- Legend Panel -->
    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>الطاقة الكهربائية</li>
      <li class="legend-item"><span class="legend-swatch" style="background: #22d3ee;"></span>الزيت الهيدروليكي</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الحركة</li>
    </ul>

    <!-- Controls -->
    <div class="diagram-controls">
      <button id="btn-play" class="diagram-replay-button play-button" aria-label="تشغيل المحاكاة">▶ تشغيل</button>
      <button id="btn-pause" class="diagram-replay-button pause-button" aria-label="إيقاف المحاكاة" style="display: none;">⏸ إيقاف</button>
      <button id="btn-reset" class="diagram-replay-button reset-button" aria-label="إعادة تعيين المحاكاة">⟲ إعادة تعيين</button>
    </div>

    {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}
  </div>
</figure>

<style>
  .chair-hydraulic-interactive {
    margin: 2rem 0;
  }

  .simulator-content {
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    gap: 1rem;
    padding: 1.5rem;
    align-items: start;
  }

  .status-panel {
    background: rgba(26, 35, 50, 0.6);
    border: 1px solid #4a6578;
    border-radius: 8px;
    padding: 1rem;
    backdrop-filter: blur(10px);
  }

  .status-header {
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    text-align: right;
    direction: rtl;
  }

  .status-items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #cbd5e1;
    direction: rtl;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-label {
    text-align: right;
  }

  .diagram-main {
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(15, 20, 25, 0.5);
    border: 1px solid #2a3f4d;
    border-radius: 12px;
    padding: 1rem;
    overflow: auto;
    max-height: 600px;
  }

  .chair-diagram-svg {
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  .info-panel {
    background: rgba(26, 35, 50, 0.6);
    border: 1px solid #4a6578;
    border-radius: 8px;
    padding: 1rem;
    backdrop-filter: blur(10px);
    overflow-y: auto;
    max-height: 600px;
  }

  .info-header {
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    text-align: right;
    direction: rtl;
  }

  .info-content {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #cbd5e1;
    direction: rtl;
    text-align: right;
  }

  .info-empty {
    color: #64748b;
    font-style: italic;
  }

  .info-title {
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
  }

  .info-description {
    color: #cbd5e1;
  }

  .simulator-controls {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid #2a3f4d;
  }

  .control-btn {
    background: #1e293b;
    border: 1px solid #4a6578;
    color: #94a3b8;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .control-btn:hover {
    background: #334155;
    color: #e2e8f0;
  }

  .control-btn:active {
    transform: scale(0.95);
  }

  .diagram-block-caption {
    text-align: center;
    font-size: 0.95rem;
    color: #94a3b8;
    margin-top: 1rem;
    padding: 0 1rem;
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .simulator-content {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }

    .status-panel,
    .info-panel {
      max-height: 300px;
    }
  }

  @media (max-width: 768px) {
    .status-panel,
    .info-panel {
      padding: 0.75rem;
      font-size: 0.8rem;
    }

    .simulator-controls {
      padding: 0.75rem;
    }

    .control-btn {
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-panel,
    .info-panel,
    .control-btn {
      transition: none;
    }
  }
</style>

<script>
  const componentInfo: Record<string, { ar: string; en: string; description: string }> = {
    "patient-chair": {
      ar: "كرسي المريض",
      en: "Patient Chair",
      description: "كرسي مريح مصمم بهندسة صحيحة يحتوي على مسند الرأس والظهر وذراعين وقاعدة قابلة للحركة لتوفير أقصى درجات الراحة.",
    },
    "lift-cylinder": {
      ar: "أسطوانة الرفع",
      en: "Lift Cylinder",
      description: "أسطوانة هيدروليكية تتحكم برفع وخفض الكرسي بسلاسة وأماناً. تستخدم السائل الهيدروليكي لإنتاج قوة كافية للحركة.",
    },
    "tilt-system": {
      ar: "نظام الإمالة",
      en: "Tilt System",
      description: "يتحكم بإمالة ظهر الكرسي وتعديل زاوية استقبال المريض. يوفر راحة إضافية ويسهل الوصول إلى مناطق مختلفة من الفم.",
    },
    "footrest": {
      ar: "مسند القدمين",
      en: "Footrest",
      description: "جزء قابل للتحريك يدعم قدمي المريض. يمكن رفعه أو خفضه أو إمالته حسب الحاجة لراحة المريض.",
    },
    "hydraulic-pump": {
      ar: "المضخة الهيدروليكية",
      en: "Hydraulic Pump",
      description: "تضخ السائل الهيدروليكي إلى الأسطوانات لتوليد القوة المطلوبة لتحريك الكرسي بجميع اتجاهاته.",
    },
    "control-panel": {
      ar: "لوحة التحكم",
      en: "Control Panel",
      description: "لوحة كهربائية تحتوي على مفاتيح ومنظمات للتحكم في جميع حركات الكرسي بسهولة وأمان.",
    },
    "reservoir": {
      ar: "خزان السائل",
      en: "Reservoir",
      description: "خزان يخزن السائل الهيدروليكي ويحافظ على درجة حرارته وينقيه من الشوائب.",
    },
  };

  let isAnimating = false;

  document.querySelectorAll(".hotspot").forEach((hotspot) => {
    hotspot.addEventListener("click", () => {
      const componentId = hotspot.getAttribute("data-component");
      if (componentId && componentInfo[componentId]) {
        const info = componentInfo[componentId];
        const content = document.getElementById("info-content");
        if (content) {
          content.innerHTML = `
            <div class="info-title">${info.ar}</div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.5rem;">${info.en}</div>
            <div class="info-description">${info.description}</div>
          `;
        }

        document.querySelectorAll(".hotspot").forEach((h) => h.classList.remove("active"));
        hotspot.classList.add("active");
      }
    });

    hotspot.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        (hotspot as HTMLElement).click();
      }
    });
  });

  document.getElementById("btn-play")?.addEventListener("click", () => {
    isAnimating = true;
    const playBtn = document.getElementById("btn-play");
    const pauseBtn = document.getElementById("btn-pause");
    if (playBtn && pauseBtn) {
      playBtn.style.display = "none";
      pauseBtn.style.display = "inline-block";
    }
  });

  document.getElementById("btn-pause")?.addEventListener("click", () => {
    isAnimating = false;
    const playBtn = document.getElementById("btn-play");
    const pauseBtn = document.getElementById("btn-pause");
    if (playBtn && pauseBtn) {
      playBtn.style.display = "inline-block";
      pauseBtn.style.display = "none";
    }
  });

  document.getElementById("btn-reset")?.addEventListener("click", () => {
    isAnimating = false;
    const playBtn = document.getElementById("btn-play");
    const pauseBtn = document.getElementById("btn-pause");
    if (playBtn && pauseBtn) {
      playBtn.style.display = "inline-block";
      pauseBtn.style.display = "none";
    }
    document.querySelectorAll(".hotspot").forEach((h) => h.classList.remove("active"));
    const content = document.getElementById("info-content");
    if (content) {
      content.innerHTML = '<p class="info-empty">انقر على أي مكون للحصول على معلومات تفصيلية</p>';
    }
  });
</script>
