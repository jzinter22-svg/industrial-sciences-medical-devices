---
// Figures 7-9 and 7-10 (نظام كرسي الأسنان الهيدروليكي) built as a dark
// neumorphic interactive simulator, following the exact Chapter 1-6
// system (see IncubatorBlockDiagram.astro). Uses the shared
// wireDiagramSimulator() engine and diagram-simulator.css shell — no
// bespoke panel markup, CSS, or animation loop.
//
// Geometry: the control panel commands the hydraulic pump, which draws
// from / recirculates through the reservoir and drives the lift
// cylinder; the cylinder raises the patient chair, which in turn carries
// the tilt mechanism and the footrest as its two sub-mechanisms.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft chair-hydraulic-system-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام الكرسي الهيدروليكي</span>
      <span class="simulator-subtitle">شكل 9-7 و 10-7 — التحكم والحركة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="chs1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="800"
          height="560"
          viewBox="0 0 800 560"
          role="img"
          aria-label="نظام كرسي الأسنان الهيدروليكي"
        >
          <defs>
            <marker id="chs1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="chs1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="chs1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="chs1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="chs1GradCyan" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="chs1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="chs1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="chs1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="800" height="560" rx="20" fill="url(#chs1BgGrad)"></rect>
          <rect x="0" y="0" width="800" height="560" rx="20" fill="url(#chs1Grid)"></rect>

          <text x="400" y="34" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">نظام كرسي الأسنان الهيدروليكي</text>

          <!-- Row 1: control + hydraulic supply -->
          <g class="hotspot" data-component="control-panel" tabindex="0" role="button" aria-label="لوحة التحكم">
            <rect class="box-shape" x="50" y="90" width="150" height="100" rx="10" fill="url(#chs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#chs1Elevate)"></rect>
            <rect x="95" y="115" width="18" height="18" fill="#FBBF24" opacity="0.6"></rect>
            <circle cx="140" cy="124" r="5" fill="#FBBF24" opacity="0.7"></circle>
            <circle cx="160" cy="124" r="5" fill="#FBBF24" opacity="0.4"></circle>
            <text x="125" y="164" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">لوحة التحكم</text>
            <text x="125" y="182" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Control Panel</text>
          </g>

          <g class="link" data-link="control-panel" data-link-to="hydraulic-pump">
            <line x1="200" y1="140" x2="245" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#chs1-arrow)"></line>
            <line class="trail" x1="200" y1="140" x2="243" y2="140" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="hydraulic-pump" tabindex="0" role="button" aria-label="المضخة الهيدروليكية">
            <rect class="box-shape" x="245" y="90" width="150" height="100" rx="10" fill="url(#chs1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#chs1Elevate)"></rect>
            <circle cx="320" cy="130" r="20" fill="none" stroke="#22D3EE" stroke-width="1.4" opacity="0.7"></circle>
            <text x="320" y="164" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">المضخة</text>
            <text x="320" y="182" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#22D3EE" direction="ltr">Hydraulic Pump</text>
          </g>

          <g class="link" data-link="hydraulic-pump" data-link-to="reservoir">
            <line x1="395" y1="140" x2="440" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#chs1-arrow)"></line>
            <line class="trail" x1="395" y1="140" x2="438" y2="140" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="reservoir" tabindex="0" role="button" aria-label="خزان السائل">
            <rect class="box-shape" x="440" y="90" width="150" height="100" rx="10" fill="url(#chs1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#chs1Elevate)"></rect>
            <rect x="465" y="115" width="100" height="55" fill="none" stroke="#22D3EE" stroke-width="1.4" opacity="0.6"></rect>
            <text x="515" y="164" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">خزان السائل</text>
            <text x="515" y="182" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#22D3EE" direction="ltr">Reservoir</text>
          </g>

          <!-- Row 1 -> Row 2 -->
          <g class="link" data-link="hydraulic-pump" data-link-to="lift-cylinder">
            <path d="M 320,190 L 320,225 L 225,225 L 225,280" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#chs1-arrow)"></path>
            <path class="trail" d="M 320,190 L 320,225 L 225,225 L 225,278" fill="none" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <!-- Row 2: mechanical motion -->
          <g class="hotspot" data-component="lift-cylinder" tabindex="0" role="button" aria-label="أسطوانة الرفع">
            <rect class="box-shape" x="150" y="280" width="150" height="100" rx="10" fill="url(#chs1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#chs1Elevate)"></rect>
            <rect x="180" y="300" width="20" height="60" fill="none" stroke="#22D3EE" stroke-width="1.4" opacity="0.6"></rect>
            <text x="225" y="354" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">أسطوانة الرفع</text>
            <text x="225" y="372" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#22D3EE" direction="ltr">Lift Cylinder</text>
          </g>

          <g class="link" data-link="lift-cylinder" data-link-to="patient-chair">
            <line x1="300" y1="330" x2="345" y2="330" stroke="#5b6478" stroke-width="2.5" marker-end="url(#chs1-arrow)"></line>
            <line class="trail" x1="300" y1="330" x2="343" y2="330" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="patient-chair" tabindex="0" role="button" aria-label="كرسي المريض">
            <rect class="box-shape" x="345" y="280" width="200" height="100" rx="10" fill="url(#chs1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#chs1Elevate)"></rect>
            <ellipse cx="405" cy="330" rx="16" ry="30" fill="none" stroke="#C084FC" stroke-width="1.4" opacity="0.7"></ellipse>
            <ellipse cx="445" cy="345" rx="26" ry="18" fill="none" stroke="#C084FC" stroke-width="1.4" opacity="0.7"></ellipse>
            <text x="445" y="364" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">كرسي المريض</text>
            <text x="445" y="279" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#C084FC" direction="ltr" dy="-0.3em">Patient Chair</text>
          </g>

          <g class="link" data-link="patient-chair" data-link-to="tilt-system">
            <path d="M 545,300 L 590,270" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#chs1-arrow)"></path>
            <path class="trail" d="M 545,300 L 588,272" fill="none" stroke="#C084FC" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="hotspot" data-component="tilt-system" tabindex="0" role="button" aria-label="نظام الإمالة">
            <circle class="box-shape" cx="620" cy="245" r="45" fill="url(#chs1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#chs1Elevate)"></circle>
            <text x="620" y="242" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">نظام الإمالة</text>
            <text x="620" y="260" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#C084FC" direction="ltr">Tilt System</text>
          </g>

          <g class="link" data-link="patient-chair" data-link-to="footrest">
            <path d="M 545,360 L 590,395" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#chs1-arrow)"></path>
            <path class="trail" d="M 545,360 L 588,393" fill="none" stroke="#C084FC" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="hotspot" data-component="footrest" tabindex="0" role="button" aria-label="مسند القدمين">
            <circle class="box-shape" cx="620" cy="430" r="45" fill="url(#chs1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#chs1Elevate)"></circle>
            <text x="620" y="427" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">مسند القدمين</text>
            <text x="620" y="445" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#C084FC" direction="ltr">Footrest</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="200" cy="140" r="4.5" fill="#FBBF24" filter="url(#chs1Glow)" style="--tx:43px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="300" cy="330" r="4.5" fill="#C084FC" filter="url(#chs1Glow)" style="--tx:43px; --ty:0px; --particle-delay:1.6s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="control-panel"><span class="status-dot dot-yellow"></span><span class="status-label">لوحة التحكم</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="hydraulic-pump"><span class="status-dot dot-cyan"></span><span class="status-label">المضخة الهيدروليكية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="reservoir"><span class="status-dot dot-cyan"></span><span class="status-label">خزان السائل</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="lift-cylinder"><span class="status-dot dot-cyan"></span><span class="status-label">أسطوانة الرفع</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يرفع</span></span></li>
          <li class="status-row" data-status="patient-chair"><span class="status-dot dot-purple"></span><span class="status-label">كرسي المريض</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يتحرك</span></span></li>
          <li class="status-row" data-status="tilt-system"><span class="status-dot dot-purple"></span><span class="status-label">نظام الإمالة</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يميل</span></span></li>
          <li class="status-row" data-status="footrest"><span class="status-dot dot-purple"></span><span class="status-label">مسند القدمين</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يتحرك</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مرحلة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>الطاقة الكهربائية</li>
      <li class="legend-item"><span class="legend-swatch legend-cyan"></span>السائل الهيدروليكي</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الحركة الميكانيكية</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-cyan { background: #22D3EE; }
  .status-dot.dot-cyan { background: #3a4258; }

  .hotspot .box-shape {
    filter: url(#chs1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#chs1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#chs1Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes chs1-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: chs1-particle-move var(--particle-duration, 0.4s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes chs1-shape-activate { to { filter: url(#chs1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes chs1-reveal-trail { to { opacity: 0.85; } }
    @keyframes chs1-status-value-on { to { opacity: 1; } }
    @keyframes chs1-status-value-off { to { opacity: 0; } }
    @keyframes chs1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes chs1-dot-on-cyan { to { background: #22D3EE; box-shadow: 0 0 8px 1px rgba(34, 211, 238, 0.8); } }
    @keyframes chs1-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="control-panel"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="control-panel"] .status-dot { animation: chs1-dot-on-yellow 0.4s ease-out 0.1s forwards; }
    .playing [data-status="control-panel"] .value-on { animation: chs1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="control-panel"] .value-off { animation: chs1-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="control-panel"] .trail { animation: chs1-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="hydraulic-pump"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="hydraulic-pump"] .status-dot { animation: chs1-dot-on-cyan 0.4s ease-out 0.6s forwards; }
    .playing [data-status="hydraulic-pump"] .value-on { animation: chs1-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="hydraulic-pump"] .value-off { animation: chs1-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="hydraulic-pump"][data-link-to="reservoir"] .trail { animation: chs1-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="reservoir"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="reservoir"] .status-dot { animation: chs1-dot-on-cyan 0.4s ease-out 1.1s forwards; }
    .playing [data-status="reservoir"] .value-on { animation: chs1-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="reservoir"] .value-off { animation: chs1-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-link="hydraulic-pump"][data-link-to="lift-cylinder"] .trail { animation: chs1-reveal-trail 0.3s ease-out 1.5s forwards; }
    .playing [data-component="lift-cylinder"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="lift-cylinder"] .status-dot { animation: chs1-dot-on-cyan 0.4s ease-out 1.6s forwards; }
    .playing [data-status="lift-cylinder"] .value-on { animation: chs1-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="lift-cylinder"] .value-off { animation: chs1-status-value-off 0.4s ease-out 1.6s forwards; }
    .playing [data-link="lift-cylinder"] .trail { animation: chs1-reveal-trail 0.3s ease-out 1.9s forwards; }

    .playing [data-component="patient-chair"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 2.1s forwards; }
    .playing [data-status="patient-chair"] .status-dot { animation: chs1-dot-on-purple 0.4s ease-out 2.1s forwards; }
    .playing [data-status="patient-chair"] .value-on { animation: chs1-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="patient-chair"] .value-off { animation: chs1-status-value-off 0.4s ease-out 2.1s forwards; }

    .playing [data-link="patient-chair"][data-link-to="tilt-system"] .trail { animation: chs1-reveal-trail 0.3s ease-out 2.5s forwards; }
    .playing [data-component="tilt-system"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 2.6s forwards; }
    .playing [data-status="tilt-system"] .status-dot { animation: chs1-dot-on-purple 0.4s ease-out 2.6s forwards; }
    .playing [data-status="tilt-system"] .value-on { animation: chs1-status-value-on 0.4s ease-out 2.6s forwards; }
    .playing [data-status="tilt-system"] .value-off { animation: chs1-status-value-off 0.4s ease-out 2.6s forwards; }

    .playing [data-link="patient-chair"][data-link-to="footrest"] .trail { animation: chs1-reveal-trail 0.3s ease-out 3.0s forwards; }
    .playing [data-component="footrest"] .box-shape { animation: chs1-shape-activate 0.4s ease-out 3.1s forwards; }
    .playing [data-status="footrest"] .status-dot { animation: chs1-dot-on-purple 0.4s ease-out 3.1s forwards; }
    .playing [data-status="footrest"] .value-on { animation: chs1-status-value-on 0.4s ease-out 3.1s forwards; }
    .playing [data-status="footrest"] .value-off { animation: chs1-status-value-off 0.4s ease-out 3.1s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "control-panel": {
      title: "لوحة التحكم (Control Panel)",
