---
// Redesigned Figure 2-1 (مخطط الموجات الصوتية والفوق صوتية والتحت صوتية)
// using the Chapter 1 dark neumorphic simulator system. First of the 21
// Chapter 2 diagrams converted; reuses the shared shell/controller
// (src/styles/diagram-simulator.css + src/scripts/diagramSimulator.js).
//
// Geometry unchanged (axis, tick marks, band widths, labels, frequency
// values all identical to the prior build) — only fill/stroke treatment
// and the interaction/animation layer changed.
//
// Color mapping: this is an acoustic frequency spectrum, not an
// electrical circuit, so the yellow/orange/green/blue/purple power
// -system meaning doesn't apply here. Kept the diagram's own established
// three-band palette (green=infrasound, blue=acoustic/audible,
// amber=ultrasound) as its own local legend, matching how diagram-06 and
// diagram-11 handled non-electrical Chapter 1 diagrams.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft spectrum-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة الطيف الترددي للموجات الصوتية</span>
      <span class="simulator-subtitle">شكل 2-1 — تحت صوتية / سمعية / فوق صوتية</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="spectrum-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="280"
          viewBox="0 0 820 280"
          role="img"
          aria-label="مخطط الموجات الصوتية والفوق صوتية والتحت صوتية"
        >
          <defs>
            <marker id="sp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="spBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="spGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>

            <filter id="spElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="spGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="280" rx="20" fill="url(#spBgGrad)"></rect>
          <rect x="0" y="0" width="820" height="280" rx="20" fill="url(#spGrid)"></rect>

          <g class="hotspot" data-component="infrasound" tabindex="0" role="button" aria-label="الموجات تحت الصوتية">
            <rect class="hit-area" x="95" y="35" width="225" height="200" fill="#000" fill-opacity="0"></rect>
            <text x="150" y="60" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">تحت صوتية</text>
            <line x1="150" y1="70" x2="130" y2="110" stroke="#8b94aa" stroke-width="2" marker-end="url(#sp-arrow)"></line>
            <line x1="120" y1="140" x2="120" y2="160" stroke="#4ADE80" stroke-width="4"></line>
            <rect class="box-shape" x="120" y="146" width="190" height="8" rx="3" fill="#4ADE80" filter="url(#spElevate)"></rect>
            <text x="120" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">20Hz</text>
            <text x="215" y="220" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Infrasound</text>
          </g>

          <line x1="60" y1="150" x2="760" y2="150" stroke="#5b6478" stroke-width="2" marker-end="url(#sp-arrow)" marker-start="url(#sp-arrow)"></line>

          <g class="hotspot" data-component="acoustic" tabindex="0" role="button" aria-label="الموجات الصوتية السمعية">
            <rect class="hit-area" x="280" y="35" width="230" height="200" fill="#000" fill-opacity="0"></rect>
            <text x="330" y="60" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">السمعية</text>
            <line x1="330" y1="70" x2="310" y2="110" stroke="#8b94aa" stroke-width="2" marker-end="url(#sp-arrow)"></line>
            <line x1="310" y1="140" x2="310" y2="160" stroke="#38BDF8" stroke-width="4"></line>
            <rect class="box-shape" x="310" y="146" width="190" height="8" rx="3" fill="#38BDF8" filter="url(#spElevate)"></rect>
            <text x="310" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">20kHz</text>
            <text x="405" y="220" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Acoustic</text>
          </g>

          <g class="hotspot" data-component="ultrasound" tabindex="0" role="button" aria-label="الموجات فوق الصوتية">
            <rect class="hit-area" x="475" y="35" width="245" height="160" fill="#000" fill-opacity="0"></rect>
            <text x="600" y="60" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الموجات فوق الصوتية</text>
            <line x1="600" y1="70" x2="500" y2="110" stroke="#8b94aa" stroke-width="2" marker-end="url(#sp-arrow)"></line>
            <line x1="500" y1="140" x2="500" y2="160" stroke="#FBBF24" stroke-width="4"></line>
            <rect class="box-shape" x="500" y="146" width="220" height="8" rx="3" fill="#FBBF24" filter="url(#spElevate)"></rect>
            <line x1="720" y1="140" x2="720" y2="160" stroke="#FBBF24" stroke-width="4"></line>
            <text x="500" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">2MHz</text>
            <text x="720" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">200MHz</text>
            <text x="610" y="220" font-family="Cairo, sans-serif" font-size="16" font-weight="800" fill="#FBBF24" text-anchor="middle" direction="ltr">Ultrasound</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="90" cy="150" r="6" fill="#eef1f8" filter="url(#spGlow)" style="--tx:640px; --ty:0px; --particle-delay:0.1s; --particle-duration:2.1s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة العرض</h3>
        <ul class="status-list">
          <li class="status-row" data-status="infrasound"><span class="status-dot dot-green"></span><span class="status-label">تحت صوتية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="acoustic"><span class="status-dot dot-blue"></span><span class="status-label">سمعية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="ultrasound"><span class="status-dot dot-yellow"></span><span class="status-label">فوق صوتية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي نطاق في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>تحت صوتية</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>سمعية</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>فوق صوتية</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#spElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#spElevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.05);
  }

  .flow-particle {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes sp-particle-sweep {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: sp-particle-sweep var(--particle-duration, 2s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes sp-shape-activate { to { filter: url(#spElevate) saturate(1.35) brightness(1.4); } }
    @keyframes sp-status-value-on { to { opacity: 1; } }
    @keyframes sp-status-value-off { to { opacity: 0; } }
    @keyframes sp-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes sp-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes sp-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }

    .playing [data-component="infrasound"] .box-shape { animation: sp-shape-activate 0.5s ease-out 0.1s forwards; }
    .playing [data-status="infrasound"] .status-dot { animation: sp-dot-on-green 0.4s ease-out 0.1s forwards; }
    .playing [data-status="infrasound"] .value-on { animation: sp-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="infrasound"] .value-off { animation: sp-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-component="acoustic"] .box-shape { animation: sp-shape-activate 0.5s ease-out 0.9s forwards; }
    .playing [data-status="acoustic"] .status-dot { animation: sp-dot-on-blue 0.4s ease-out 0.9s forwards; }
    .playing [data-status="acoustic"] .value-on { animation: sp-status-value-on 0.4s ease-out 0.9s forwards; }
    .playing [data-status="acoustic"] .value-off { animation: sp-status-value-off 0.4s ease-out 0.9s forwards; }

    .playing [data-component="ultrasound"] .box-shape { animation: sp-shape-activate 0.5s ease-out 1.7s forwards; }
    .playing [data-status="ultrasound"] .status-dot { animation: sp-dot-on-yellow 0.4s ease-out 1.7s forwards; }
    .playing [data-status="ultrasound"] .value-on { animation: sp-status-value-on 0.4s ease-out 1.7s forwards; }
    .playing [data-status="ultrasound"] .value-off { animation: sp-status-value-off 0.4s ease-out 1.7s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    infrasound: {
      title: "الموجات تحت الصوتية (Infrasound)",
      // src/data/chapter-02/page-01.json #intro-p1 (excerpt)
      text: "الأصوات التي ترددها اقل من مستوى سمع الإنسان تسمى تحت الصوتية (Infrasound).",
    },
    acoustic: {
      title: "الموجات الصوتية السمعية (Acoustic)",
      // src/data/chapter-02/page-01.json #intro-p1 (excerpt)
      text: "الصوت (Acoustic) هو موجات طولية تتولد نتيجة لاهتزازات ميكانيكية، والإذن البشرية تستطيع أن تميز أو تسمع الصوت ذو التردد من (20Hz) والى (20KHz).",
    },
    ultrasound: {
      title: "الموجات فوق الصوتية (Ultrasound)",
      // src/data/chapter-02/page-01.json #intro-p1 (excerpt)
      text: "الأصوات التي ترددها أعلى من السمع البشري تسمى بالفوق صوتية (Ultrasound)، وهذه الأنواع الثلاثة متشابهة بخواصها الفيزيائية ومختلفة فقط بالطول الموجي.",
    },
  };

  wireDiagramSimulator(".spectrum-diagram", { cycleMs: 2600, componentInfo: COMPONENT_INFO });
</script>
