---
// Animated Figure 2-1 (مخطط الموجات الصوتية والفوق صوتية والتحت صوتية) —
// printed page 23. Static artwork kept pixel-identical (same paths,
// viewBox, proportions); animation sweeps a marker across the frequency
// axis left-to-right so the three bands (infrasound -> acoustic ->
// ultrasound) light up in their natural reading order, guiding the eye
// the same way Chapter 1's timer-types comparison figure demonstrates
// each of its icons in turn.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram spectrum-diagram">
  <div class="diagram-block-image">
    <svg
      class="spectrum-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="820"
      height="280"
      viewBox="0 0 820 280"
      role="img"
      aria-label="مخطط الموجات الصوتية والفوق صوتية والتحت صوتية"
    >
      <defs>
        <marker id="sp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="820" height="280" fill="none"></rect>

      <g class="flow-highlight band-infrasound-label">
        <text x="150" y="60" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">تحت صوتية</text>
        <line x1="150" y1="70" x2="130" y2="110" stroke="#263238" stroke-width="2" marker-end="url(#sp-arrow)"></line>
      </g>

      <g class="flow-highlight band-acoustic-label">
        <text x="330" y="60" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">السمعية</text>
        <line x1="330" y1="70" x2="310" y2="110" stroke="#263238" stroke-width="2" marker-end="url(#sp-arrow)"></line>
      </g>

      <g class="flow-highlight band-ultrasound-label">
        <text x="600" y="60" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الموجات فوق الصوتية</text>
        <line x1="600" y1="70" x2="500" y2="110" stroke="#263238" stroke-width="2" marker-end="url(#sp-arrow)"></line>
      </g>

      <line x1="60" y1="150" x2="760" y2="150" stroke="#263238" stroke-width="2" marker-end="url(#sp-arrow)" marker-start="url(#sp-arrow)"></line>
      <line x1="120" y1="140" x2="120" y2="160" stroke="#15803d" stroke-width="4"></line>
      <rect class="flow-highlight band-infrasound" x="120" y="146" width="190" height="8" fill="#22c55e"></rect>
      <rect class="flow-highlight band-acoustic" x="310" y="146" width="190" height="8" fill="#1d4ed8"></rect>
      <rect class="flow-highlight band-ultrasound" x="500" y="146" width="220" height="8" fill="#eab308"></rect>
      <line x1="310" y1="140" x2="310" y2="160" stroke="#1d4ed8" stroke-width="4"></line>
      <line x1="500" y1="140" x2="500" y2="160" stroke="#eab308" stroke-width="4"></line>
      <line x1="720" y1="140" x2="720" y2="160" stroke="#eab308" stroke-width="4"></line>

      <text x="120" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">20Hz</text>
      <text x="310" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">20kHz</text>
      <text x="500" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">2MHz</text>
      <text x="720" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">200MHz</text>

      <text x="215" y="220" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#15803d" text-anchor="middle" direction="ltr">Infrasound</text>
      <text x="405" y="220" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="ltr">Acoustic</text>
      <text x="610" y="220" font-family="Cairo, sans-serif" font-size="16" font-weight="800" fill="#a16207" text-anchor="middle" direction="ltr">Ultrasound</text>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle" cx="90" cy="150" r="6" fill="#263238" style="--tx:640px; --ty:0px; --particle-delay:0.1s; --particle-duration:2.1s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.6s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 520px;
    display: flex;
    justify-content: center;
  }

  .spectrum-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .band-infrasound-label, .band-infrasound { --highlight-delay: 0.1s; --highlight-duration: 0.7s; }
  .band-acoustic-label, .band-acoustic { --highlight-delay: 0.9s; --highlight-duration: 0.7s; }
  .band-ultrasound-label, .band-ultrasound { --highlight-delay: 1.7s; --highlight-duration: 0.7s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".spectrum-diagram");
</script>
