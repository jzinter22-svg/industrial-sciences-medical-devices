---
// Figures 7-22 and 7-23 (محقنة الرش الثلاثية) built as a dark neumorphic
// interactive simulator, following the exact Chapter 1-6 system (see
// IncubatorBlockDiagram.astro) and modeled directly on
// HandpiecesComparisonDiagramInteractive.astro — the closest existing
// diagram in nature (three parallel channels compared side by side,
// converging on one shared output), reused here as the base template per
// the master-diagram pattern established for Chapter 7.
//
// Geometry: three parallel supply channels (water / air / powder) feed a
// shared manifold with one selector valve per channel, which combines
// them into the mixed spray released at the tip; the usage-modes panel
// summarizes which channel combination produces each clinical function.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft triple-syringe-system-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة محقنة الرش الثلاثية</span>
      <span class="simulator-subtitle">شكل 22-7 و 23-7 — الماء والهواء والبودرة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="tsy1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="800"
          height="600"
          viewBox="0 0 800 600"
          role="img"
          aria-label="محقنة الرش الثلاثية ومسار المزج"
        >
          <defs>
            <marker id="tsy1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="tsy1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="tsy1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="tsy1GradCyan" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="tsy1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="tsy1GradGray" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#232b36"></stop><stop offset="100%" stop-color="#12161c"></stop></linearGradient>
            <linearGradient id="tsy1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="tsy1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="tsy1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="tsy1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="800" height="600" rx="20" fill="url(#tsy1BgGrad)"></rect>
          <rect x="0" y="0" width="800" height="600" rx="20" fill="url(#tsy1Grid)"></rect>

          <text x="400" y="32" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">محقنة الرش الثلاثية</text>

          <!-- Water channel -->
          <g class="hotspot" data-component="water-channel" tabindex="0" role="button" aria-label="قناة الماء">
            <g transform="translate(150, 100)">
              <rect class="box-shape" x="-24" y="0" width="48" height="130" rx="8" fill="url(#tsy1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#tsy1Elevate)"></rect>
              <rect x="-16" y="70" width="32" height="52" fill="#22D3EE" opacity="0.35"></rect>
              <circle cx="0" cy="45" r="16" fill="none" stroke="#22D3EE" stroke-width="1.4" opacity="0.6"></circle>
              <text x="0" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">الماء</text>
              <text x="0" y="166" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#22D3EE" direction="ltr">Water</text>
            </g>
          </g>

          <!-- Air channel -->
          <g class="hotspot" data-component="air-channel" tabindex="0" role="button" aria-label="قناة الهواء">
            <g transform="translate(400, 100)">
              <rect class="box-shape" x="-24" y="0" width="48" height="130" rx="8" fill="url(#tsy1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#tsy1Elevate)"></rect>
              <rect x="-16" y="30" width="32" height="92" fill="#38BDF8" opacity="0.18"></rect>
              <circle cx="0" cy="45" r="16" fill="none" stroke="#38BDF8" stroke-width="1.4" opacity="0.6"></circle>
              <text x="0" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">الهواء</text>
              <text x="0" y="166" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#38BDF8" direction="ltr">Air</text>
            </g>
          </g>

          <!-- Powder / slurry channel -->
          <g class="hotspot" data-component="powder-channel" tabindex="0" role="button" aria-label="قناة البودرة">
            <g transform="translate(650, 100)">
              <rect class="box-shape" x="-24" y="0" width="48" height="130" rx="8" fill="url(#tsy1GradGray)" stroke="#94A3B8" stroke-width="2" filter="url(#tsy1Elevate)"></rect>
              <rect x="-16" y="55" width="32" height="67" fill="#94A3B8" opacity="0.3"></rect>
              <circle cx="0" cy="45" r="16" fill="none" stroke="#94A3B8" stroke-width="1.4" opacity="0.6"></circle>
              <text x="0" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">بودرة/سائل</text>
              <text x="0" y="166" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#94A3B8" direction="ltr">Powder</text>
            </g>
          </g>

          <g class="link" data-link="water-channel" data-link-to="manifold">
            <path d="M 150,230 L 150,270 L 320,270 L 320,300" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#tsy1-arrow)"></path>
            <path class="trail" d="M 150,230 L 150,270 L 320,270 L 320,298" fill="none" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="air-channel" data-link-to="manifold">
            <path d="M 400,230 L 400,300" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#tsy1-arrow)"></path>
            <path class="trail" d="M 400,230 L 400,298" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="powder-channel" data-link-to="manifold">
            <path d="M 650,230 L 650,270 L 480,270 L 480,300" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#tsy1-arrow)"></path>
            <path class="trail" d="M 650,230 L 650,270 L 480,270 L 480,298" fill="none" stroke="#94A3B8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <g class="hotspot" data-component="manifold" tabindex="0" role="button" aria-label="منيفولد المزج">
            <rect class="box-shape" x="230" y="300" width="340" height="80" rx="10" fill="url(#tsy1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#tsy1Elevate)"></rect>
            <circle cx="320" cy="340" r="9" fill="#22D3EE" opacity="0.7"></circle>
            <circle cx="400" cy="340" r="9" fill="#38BDF8" opacity="0.7"></circle>
            <circle cx="480" cy="340" r="9" fill="#94A3B8" opacity="0.7"></circle>
            <text x="400" y="364" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">منيفولد المزج والتحكم</text>
          </g>

          <g class="link" data-link="manifold" data-link-to="output-spray">
            <line x1="400" y1="380" x2="400" y2="425" stroke="#5b6478" stroke-width="2.5" marker-end="url(#tsy1-arrow)"></line>
            <line class="trail" x1="400" y1="380" x2="400" y2="423" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="output-spray" tabindex="0" role="button" aria-label="الرش المختلط">
            <circle class="box-shape" cx="400" cy="460" r="40" fill="url(#tsy1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#tsy1Elevate)"></circle>
            <path d="M 385,450 L 378,470 M 400,448 L 400,472 M 415,450 L 422,470" stroke="#C084FC" stroke-width="1.6" fill="none" opacity="0.8"></path>
            <text x="400" y="500" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">الرش المختلط</text>
          </g>

          <g class="hotspot" data-component="usage-modes" tabindex="0" role="button" aria-label="أوضاع الاستخدام">
            <rect class="box-shape" x="60" y="530" width="680" height="55" rx="10" fill="url(#tsy1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#tsy1Elevate)"></rect>
            <circle cx="120" cy="557" r="5" fill="#38BDF8"></circle>
            <text x="135" y="562" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#dbe0ec" direction="rtl">تجفيف: هواء فقط</text>
            <circle cx="360" cy="557" r="5" fill="#22D3EE"></circle>
            <text x="375" y="562" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#dbe0ec" direction="rtl">تنظيف: ماء وهواء</text>
            <circle cx="580" cy="557" r="5" fill="#94A3B8"></circle>
            <text x="595" y="562" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#dbe0ec" direction="rtl">تلميع: الثلاثة معاً</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="400" cy="380" r="4.5" fill="#C084FC" filter="url(#tsy1Glow)" style="--tx:0px; --ty:38px; --particle-delay:1.6s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="water-channel"><span class="status-dot dot-cyan"></span><span class="status-label">قناة الماء</span><span class="status-value"><span class="value-off">مغلقة</span><span class="value-on">مفتوحة</span></span></li>
          <li class="status-row" data-status="air-channel"><span class="status-dot dot-blue"></span><span class="status-label">قناة الهواء</span><span class="status-value"><span class="value-off">مغلقة</span><span class="value-on">مفتوحة</span></span></li>
          <li class="status-row" data-status="powder-channel"><span class="status-dot dot-gray"></span><span class="status-label">قناة البودرة</span><span class="status-value"><span class="value-off">مغلقة</span><span class="value-on">مفتوحة</span></span></li>
          <li class="status-row" data-status="manifold"><span class="status-dot dot-yellow"></span><span class="status-label">منيفولد المزج</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="output-spray"><span class="status-dot dot-purple"></span><span class="status-label">الرش المختلط</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يرش</span></span></li>
          <li class="status-row" data-status="usage-modes"><span class="status-dot dot-blue"></span><span class="status-label">أوضاع الاستخدام</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي قناة أو جزء في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-cyan"></span>الماء</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الهواء</li>
      <li class="legend-item"><span class="legend-swatch legend-gray"></span>البودرة</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الرش المختلط</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-cyan { background: #22D3EE; }
  .legend-gray { background: #94A3B8; }
  .status-dot.dot-cyan { background: #3a4258; }
  .status-dot.dot-gray { background: #3a4258; }

  .hotspot .box-shape {
    filter: url(#tsy1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#tsy1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#tsy1Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes tsy1-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: tsy1-particle-move var(--particle-duration, 0.4s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes tsy1-shape-activate { to { filter: url(#tsy1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes tsy1-reveal-trail { to { opacity: 0.85; } }
    @keyframes tsy1-status-value-on { to { opacity: 1; } }
    @keyframes tsy1-status-value-off { to { opacity: 0; } }
    @keyframes tsy1-dot-on-cyan { to { background: #22D3EE; box-shadow: 0 0 8px 1px rgba(34, 211, 238, 0.8); } }
    @keyframes tsy1-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes tsy1-dot-on-gray { to { background: #94A3B8; box-shadow: 0 0 8px 1px rgba(148, 163, 184, 0.8); } }
    @keyframes tsy1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes tsy1-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="water-channel"] .box-shape { animation: tsy1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="water-channel"] .status-dot { animation: tsy1-dot-on-cyan 0.4s ease-out 0.1s forwards; }
    .playing [data-status="water-channel"] .value-on { animation: tsy1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="water-channel"] .value-off { animation: tsy1-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-component="air-channel"] .box-shape { animation: tsy1-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="air-channel"] .status-dot { animation: tsy1-dot-on-blue 0.4s ease-out 0.6s forwards; }
    .playing [data-status="air-channel"] .value-on { animation: tsy1-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="air-channel"] .value-off { animation: tsy1-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-component="powder-channel"] .box-shape { animation: tsy1-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="powder-channel"] .status-dot { animation: tsy1-dot-on-gray 0.4s ease-out 1.1s forwards; }
    .playing [data-status="powder-channel"] .value-on { animation: tsy1-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="powder-channel"] .value-off { animation: tsy1-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-link="water-channel"] .trail,
    .playing [data-link="air-channel"] .trail,
    .playing [data-link="powder-channel"] .trail { animation: tsy1-reveal-trail 0.3s ease-out 1.5s forwards; }
    .playing [data-component="manifold"] .box-shape { animation: tsy1-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="manifold"] .status-dot { animation: tsy1-dot-on-yellow 0.4s ease-out 1.6s forwards; }
    .playing [data-status="manifold"] .value-on { animation: tsy1-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="manifold"] .value-off { animation: tsy1-status-value-off 0.4s ease-out 1.6s forwards; }

    .playing [data-link="manifold"] .trail { animation: tsy1-reveal-trail 0.3s ease-out 2.0s forwards; }
    .playing [data-component="output-spray"] .box-shape { animation: tsy1-shape-activate 0.4s ease-out 2.1s forwards; }
    .playing [data-status="output-spray"] .status-dot { animation: tsy1-dot-on-purple 0.4s ease-out 2.1s forwards; }
    .playing [data-status="output-spray"] .value-on { animation: tsy1-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="output-spray"] .value-off { animation: tsy1-status-value-off 0.4s ease-out 2.1s forwards; }

    .playing [data-component="usage-modes"] .box-shape { animation: tsy1-shape-activate 0.4s ease-out 2.6s forwards; }
    .playing [data-status="usage-modes"] .status-dot { animation: tsy1-dot-on-blue 0.4s ease-out 2.6s forwards; }
    .playing [data-status="usage-modes"] .value-on { animation: tsy1-status-value-on 0.4s ease-out 2.6s forwards; }
    .playing [data-status="usage-modes"] .value-off { animation: tsy1-status-value-off 0.4s ease-out 2.6s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "water-channel": {
      title: "قناة الماء (Water Channel)",
      text: "تُوصل الماء من مصدر تجهيز العيادة إلى المحقنة لأغراض التنظيف وتبريد موقع العمل.",
    },
    "air-channel": {
      title: "قناة الهواء (Air Channel)",
      text: "تُوصل الهواء المضغوط من وحدة الضاغط إلى المحقنة، وتُستخدم بمفردها لتجفيف السن قبل الفحص أو الحشو.",
    },
    "powder-channel": {
      title: "قناة البودرة/السائل (Powder Channel)",
      text: "تُضيف مسحوقاً ناعماً ممزوجاً بالماء لأغراض التلميع وإزالة البقع السطحية عن مينا الأسنان.",
    },
    manifold: {
      title: "منيفولد المزج والتحكم (Mixing Manifold)",
      text: "يجمع القنوات الثلاث عبر صمامات فردية يتحكم بها الطبيب بواسطة أزرار المحقنة، بحيث يمكن تفعيل قناة واحدة أو أكثر معاً.",
    },
    "output-spray": {
      title: "الرش المختلط (Mixed Spray)",
      text: "المخرج النهائي من طرف المحقنة، حيث تخرج المواد المفعّلة كرذاذ موجّه نحو موقع العمل داخل الفم.",
    },
    "usage-modes": {
      title: "أوضاع الاستخدام (Usage Modes)",
      text: "الهواء فقط للتجفيف، الماء والهواء معاً للتنظيف، والقنوات الثلاث معاً لتلميع السن بمزيج من البودرة والماء والهواء.",
