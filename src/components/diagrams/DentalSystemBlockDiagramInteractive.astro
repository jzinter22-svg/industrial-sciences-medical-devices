---
// Figure 7-1 (المخطط الكتلوي لنظام جهاز الأسنان المتكامل) built as a dark
// neumorphic interactive simulator, following the exact Chapter 1-6 system
// (see IncubatorBlockDiagram.astro / ECGDeviceBlockDiagram.astro). Uses the
// shared wireDiagramSimulator() engine and diagram-simulator.css shell —
// no bespoke panel markup, CSS, or animation loop.
//
// Geometry: three rows. Row 1 (input/supply chain) power-supply ->
// compressor -> storage-tank -> distribution. Row 2 (conditioning stages,
// one under each Row 1 stage) filtration / dryer / control-system /
// regulation. Row 3 (clinic output devices, one elbow-connected under
// each Row 2 stage) turbines / motors / chair / suction.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft dental-system-block-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام جهاز الأسنان المتكامل</span>
      <span class="simulator-subtitle">شكل 1-7 — من مصدر الطاقة الى أدوات العلاج</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="dsb1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="620"
          viewBox="0 0 900 620"
          role="img"
          aria-label="المخطط الكتلوي لنظام جهاز الأسنان المتكامل"
        >
          <defs>
            <marker id="dsb1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="dsb1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="dsb1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="dsb1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="dsb1GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="dsb1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="dsb1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="dsb1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="dsb1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="620" rx="20" fill="url(#dsb1BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="620" rx="20" fill="url(#dsb1Grid)"></rect>

          <text x="450" y="34" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">نظام جهاز الأسنان المتكامل</text>

          <!-- Row 1: supply chain -->
          <g class="hotspot" data-component="power-supply" tabindex="0" role="button" aria-label="مصدر الطاقة">
            <rect class="box-shape" x="40" y="70" width="150" height="100" rx="10" fill="url(#dsb1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="115" y="110" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">مصدر الطاقة</text>
            <text x="115" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" direction="ltr">Power Supply</text>
          </g>

          <g class="link" data-link="power-supply" data-link-to="compressor">
            <line x1="190" y1="120" x2="235" y2="120" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></line>
            <line class="trail" x1="190" y1="120" x2="233" y2="120" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="compressor" tabindex="0" role="button" aria-label="وحدة الضاغط">
            <rect class="box-shape" x="235" y="70" width="150" height="100" rx="10" fill="url(#dsb1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="310" y="110" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">وحدة الضاغط</text>
            <text x="310" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#4ADE80" direction="ltr">Compressor</text>
          </g>

          <g class="link" data-link="compressor" data-link-to="storage-tank">
            <line x1="385" y1="120" x2="430" y2="120" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></line>
            <line class="trail" x1="385" y1="120" x2="428" y2="120" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="storage-tank" tabindex="0" role="button" aria-label="خزان التخزين">
            <rect class="box-shape" x="430" y="70" width="150" height="100" rx="10" fill="url(#dsb1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="505" y="110" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">خزان التخزين</text>
            <text x="505" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" direction="ltr">Storage Tank</text>
          </g>

          <g class="link" data-link="storage-tank" data-link-to="distribution">
            <line x1="580" y1="120" x2="625" y2="120" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></line>
            <line class="trail" x1="580" y1="120" x2="623" y2="120" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="distribution" tabindex="0" role="button" aria-label="التوزيع">
            <circle class="box-shape" cx="700" cy="120" r="60" fill="url(#dsb1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#dsb1Elevate)"></circle>
            <text x="700" y="115" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">التوزيع</text>
            <text x="700" y="134" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#C084FC" direction="ltr">Distribution</text>
          </g>

          <!-- Row 1 -> Row 2 vertical drops -->
          <g class="link" data-link="power-supply" data-link-to="control-system">
            <path d="M 115,170 L 115,220" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 115,170 L 115,218" fill="none" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="compressor" data-link-to="filtration">
            <path d="M 310,170 L 310,220" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 310,170 L 310,218" fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="storage-tank" data-link-to="dryer">
            <path d="M 505,170 L 505,220" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 505,170 L 505,218" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="distribution" data-link-to="regulation">
            <path d="M 700,180 L 700,220" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 700,180 L 700,218" fill="none" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <!-- Row 2: conditioning stages -->
          <g class="hotspot" data-component="control-system" tabindex="0" role="button" aria-label="نظام التحكم">
            <rect class="box-shape" x="40" y="220" width="150" height="90" rx="10" fill="url(#dsb1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="115" y="258" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">نظام التحكم</text>
            <text x="115" y="277" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Control System</text>
          </g>

          <g class="hotspot" data-component="filtration" tabindex="0" role="button" aria-label="نظام التنقية">
            <rect class="box-shape" x="235" y="220" width="150" height="90" rx="10" fill="url(#dsb1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="310" y="258" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">نظام التنقية</text>
            <text x="310" y="277" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#4ADE80" direction="ltr">Filtration</text>
          </g>

          <g class="hotspot" data-component="dryer" tabindex="0" role="button" aria-label="مجفف الهواء">
            <rect class="box-shape" x="430" y="220" width="150" height="90" rx="10" fill="url(#dsb1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="505" y="258" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">مجفف الهواء</text>
            <text x="505" y="277" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#38BDF8" direction="ltr">Air Dryer</text>
          </g>

          <g class="hotspot" data-component="regulation" tabindex="0" role="button" aria-label="نظام التنظيم">
            <rect class="box-shape" x="625" y="220" width="150" height="90" rx="10" fill="url(#dsb1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#dsb1Elevate)"></rect>
            <text x="700" y="258" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">نظام التنظيم</text>
            <text x="700" y="277" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#C084FC" direction="ltr">Regulation</text>
          </g>

          <!-- Row 2 -> Row 3 elbow connectors -->
          <g class="link" data-link="control-system" data-link-to="suction">
            <path d="M 115,310 L 115,345 L 115,345" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 115,310 L 115,343" fill="none" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="filtration" data-link-to="turbines">
            <path d="M 310,310 L 310,345" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 310,310 L 310,343" fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="dryer" data-link-to="motors">
            <path d="M 505,310 L 505,345" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 505,310 L 505,343" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="regulation" data-link-to="chair">
            <path d="M 700,310 L 700,345" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#dsb1-arrow)"></path>
            <path class="trail" d="M 700,310 L 700,343" fill="none" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <!-- Row 3: clinic output devices -->
          <g class="hotspot" data-component="suction" tabindex="0" role="button" aria-label="نظام الشفط">
            <circle class="box-shape" cx="115" cy="400" r="55" fill="url(#dsb1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#dsb1Elevate)"></circle>
            <text x="115" y="396" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" direction="rtl">الشفط</text>
            <text x="115" y="415" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Suction</text>
          </g>

          <g class="hotspot" data-component="turbines" tabindex="0" role="button" aria-label="التوربينات">
            <circle class="box-shape" cx="310" cy="400" r="55" fill="url(#dsb1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#dsb1Elevate)"></circle>
            <text x="310" y="396" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" direction="rtl">التوربينات</text>
            <text x="310" y="415" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#4ADE80" direction="ltr">Turbines</text>
          </g>

          <g class="hotspot" data-component="motors" tabindex="0" role="button" aria-label="المحركات البطيئة">
            <circle class="box-shape" cx="505" cy="400" r="55" fill="url(#dsb1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#dsb1Elevate)"></circle>
            <text x="505" y="396" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" direction="rtl">المحركات</text>
            <text x="505" y="415" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#38BDF8" direction="ltr">Slow Motors</text>
          </g>

          <g class="hotspot" data-component="chair" tabindex="0" role="button" aria-label="نظام الكرسي الهيدروليكي">
            <circle class="box-shape" cx="700" cy="400" r="55" fill="url(#dsb1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#dsb1Elevate)"></circle>
            <text x="700" y="393" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">نظام الكرسي</text>
            <text x="700" y="412" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#C084FC" direction="ltr">Chair System</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="190" cy="120" r="4.5" fill="#FBBF24" filter="url(#dsb1Glow)" style="--tx:40px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="385" cy="120" r="4.5" fill="#4ADE80" filter="url(#dsb1Glow)" style="--tx:40px; --ty:0px; --particle-delay:1.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="580" cy="120" r="4.5" fill="#38BDF8" filter="url(#dsb1Glow)" style="--tx:40px; --ty:0px; --particle-delay:2.1s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="power-supply"><span class="status-dot dot-yellow"></span><span class="status-label">مصدر الطاقة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="compressor"><span class="status-dot dot-green"></span><span class="status-label">وحدة الضاغط</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="storage-tank"><span class="status-dot dot-blue"></span><span class="status-label">خزان التخزين</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="distribution"><span class="status-dot dot-purple"></span><span class="status-label">التوزيع</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="control-system"><span class="status-dot dot-yellow"></span><span class="status-label">نظام التحكم</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="filtration"><span class="status-dot dot-green"></span><span class="status-label">نظام التنقية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="dryer"><span class="status-dot dot-blue"></span><span class="status-label">مجفف الهواء</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="regulation"><span class="status-dot dot-purple"></span><span class="status-label">نظام التنظيم</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="suction"><span class="status-dot dot-yellow"></span><span class="status-label">الشفط</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="turbines"><span class="status-dot dot-green"></span><span class="status-label">التوربينات</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="motors"><span class="status-dot dot-blue"></span><span class="status-label">المحركات البطيئة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="chair"><span class="status-dot dot-purple"></span><span class="status-label">نظام الكرسي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مرحلة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>الطاقة الكهربائية</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الهواء المضغوط</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>التخزين والتوزيع</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الحركة الميكانيكية</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#dsb1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#dsb1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#dsb1Glow);
  }

