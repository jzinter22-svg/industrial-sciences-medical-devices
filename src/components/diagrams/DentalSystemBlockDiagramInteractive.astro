---
// Figure 7-1 (المخطط الكتلوي لنظام جهاز الأسنان الحديثة) — Interactive
// Scientific Simulator. PHASE 1 PROOF OF CONCEPT.
//
// Demonstrates new interactive simulator architecture:
// - Interactive hotspots with component descriptions
// - Status panel showing system state
// - Energy/flow animation
// - Control buttons (play/pause/reset)
// - Reduced motion support
// - Responsive design

import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const diagramSrc = import.meta.env.BASE_URL.replace(/\/$/, "") + "/assets/svg/chapter-07/diagram-01-system-block-interactive.svg";

// Component information from textbook definitions
const componentInfo: Record<string, { ar: string; en: string; description: string }> = {
  "power-supply": {
    ar: "مصدر الطاقة",
    en: "Power Supply",
    description: "يتم تجهيز جهاز الأسنان من مصدر تجهيز الطاقة الرئيسي (220V أو 380V) الذي يزود جميع الأجهزة بالكهرباء اللازمة.",
  },
  "compressor": {
    ar: "وحدة الضاغط",
    en: "Compressor",
    description: "وحدة الضاغط هي القلب النابض للعيادة، تقوم بضغط الهواء الجوي إلى درجات عالية (3-8 بار) لتشغيل جميع الأدوات الهوائية.",
  },
  "storage-tank": {
    ar: "خزان التخزين",
    en: "Storage Tank",
    description: "خزان معدني يخزن الهواء المضغوط لضمان توفر ضغط ثابت ومستقر لجميع أدوات العيادة بغض النظر عن الطلب المتغير.",
  },
  "distribution": {
    ar: "التوزيع",
    en: "Distribution",
    description: "نظام توزيع الهواء المضغوط إلى جميع أجهزة وأدوات العيادة من خلال أنابيب ومفاتيح تحكم.",
  },
  "filtration": {
    ar: "نظام التنقية",
    en: "Filtration",
    description: "يزيل الشوائب والرطوبة من الهواء المضغوط لحماية الأدوات وضمان جودة الهواء المستخدم.",
  },
  "dryer": {
    ar: "مجفف الهواء",
    en: "Air Dryer",
    description: "يزيل الرطوبة المتبقية من الهواء لمنع تلف الأدوات والمحركات من الصدأ والتآكل.",
  },
  "control-system": {
    ar: "نظام التحكم",
    en: "Control System",
    description: "يتحكم بتشغيل وإيقاف جميع أجهزة العيادة ويضمن سلامة التشغيل والحماية من الأعطال.",
  },
  "regulation": {
    ar: "نظام التنظيم",
    en: "Regulation",
    description: "ينظم ضغط الهواء والماء والكهرباء إلى المستويات المطلوبة لكل جهاز تشغيلي.",
  },
  "turbines": {
    ar: "التوربينات",
    en: "Turbines",
    description: "أدوات حفر سريعة جداً تدور بسرعات عالية (300,000-400,000 دورة/دقيقة) تستخدم لحفر وإزالة الأسنان المصابة.",
  },
  "motors": {
    ar: "المحركات البطيئة",
    en: "Slow Motors",
    description: "محركات كهربائية أو هوائية بطيئة (10,000-60,000 دورة/دقيقة) تستخدم لأغراض مختلفة مثل الصقل والتنظيف.",
  },
  "chair": {
    ar: "نظام الكرسي الهيدروليكي",
    en: "Chair System",
    description: "نظام هيدروليكي يتحكم برفع وخفض وتحريك كرسي المريض لتوفير أقصى درجات الراحة والسلامة.",
  },
  "suction": {
    ar: "نظام الشفط",
    en: "Suction System",
    description: "يسحب اللعاب والماء من فم المريض أثناء العلاج، ويتكون من مضخة شفط وأنابيب توزيع.",
  },
};

const statusStates: Record<string, { ar: string; color: string }> = {
  active: { ar: "نشط", color: "#4ade80" },
  ready: { ar: "جاهز", color: "#fbbf24" },
  offline: { ar: "معطل", color: "#ef4444" },
};
---

<figure class="diagram-block neo-surface-soft dental-simulator-interactive">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام جهاز الأسنان المتكامل</span>
      <span class="simulator-subtitle">شكل 1-7 — المخطط الكتلوي التفاعلي</span>
    </div>

    <div class="simulator-content">
      <!-- Status Panel -->
      <div class="status-panel">
        <div class="status-header">حالة النظام</div>
        <div class="status-items">
          <div class="status-item">
            <span class="status-dot" style="background-color: #fbbf24;"></span>
            <span class="status-label">الطاقة</span>
          </div>
          <div class="status-item">
            <span class="status-dot" style="background-color: #4ade80;"></span>
            <span class="status-label">الهواء</span>
          </div>
          <div class="status-item">
            <span class="status-dot" style="background-color: #22d3ee;"></span>
            <span class="status-label">الماء</span>
          </div>
          <div class="status-item">
            <span class="status-dot" style="background-color: #c084fc;"></span>
            <span class="status-label">الحركة</span>
          </div>
        </div>
      </div>

      <!-- Main Diagram Area -->
      <div class="diagram-main">
        <svg
          class="dental-diagram-svg"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 900 600"
          role="img"
          aria-label="المخطط الكتلوي لنظام جهاز الأسنان المتكامل"
        >
          <defs>
            <style>
              .dental-diagram-svg .text-ar { fill: #eef1f8; font-family: 'Cairo', sans-serif; font-weight: 600; }
              .dental-diagram-svg .text-en { fill: #b7bfd1; font-family: Arial, sans-serif; font-weight: 500; }
              .dental-diagram-svg .link { pointer-events: none; }
              .dental-diagram-svg .flow-layer { pointer-events: none; }

              .dental-diagram-svg .box-shape { transition: opacity 0.25s ease; }
              .dental-diagram-svg .box-active-glow { transition: opacity 0.25s ease; }

              .dental-diagram-svg .hotspot { cursor: pointer; outline: none; }
              .dental-diagram-svg .hotspot:hover .box-shape {
                opacity: 0.85;
                filter: brightness(1.15);
              }
              .dental-diagram-svg .hotspot.is-selected .box-shape {
                filter: brightness(1.2);
              }
              .dental-diagram-svg .hotspot.is-selected .box-active-glow {
                opacity: 1;
              }
              .dental-diagram-svg .hotspot .box-active-glow {
                opacity: 0;
              }

              .dental-diagram-svg .trail { stroke-dasharray: 8 10; animation: flowDash 0.6s linear infinite; }
              @keyframes flowDash { to { stroke-dashoffset: 18; } }

              .dental-diagram-svg .particle { animation: particleFloat 2s ease-in-out infinite; }
              @keyframes particleFloat { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

              @media (prefers-reduced-motion: reduce) {
                .dental-diagram-svg .trail { animation: none; stroke-dasharray: none; }
                .dental-diagram-svg .particle { animation: none; }
              }
            </style>

            <linearGradient id="grad-power" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a2f10"/>
              <stop offset="100%" stop-color="#18140a"/>
            </linearGradient>
            <linearGradient id="grad-control" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"/>
              <stop offset="100%" stop-color="#0a1712"/>
            </linearGradient>
            <linearGradient id="grad-storage" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1a2540"/>
              <stop offset="100%" stop-color="#0d131f"/>
            </linearGradient>
            <linearGradient id="grad-distribution" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2a1540"/>
              <stop offset="100%" stop-color="#140a20"/>
            </linearGradient>

            <filter id="elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"/>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"/>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"/>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"/>

              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"/>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"/>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"/>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"/>

              <feMerge>
                <feMergeNode in="shadowOuter"/>
                <feMergeNode in="haloOuter"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>

            <filter id="softGlow" x="-140%" y="-140%" width="380%" height="380%">
              <feGaussianBlur stdDeviation="9"/>
            </filter>

            <filter id="lineGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.4" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>

            <marker id="arrow-right" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#B9C3D6"/>
            </marker>
          </defs>

          <!-- Background -->
          <rect width="900" height="600" fill="#0f1419"/>

          <!-- Title -->
          <text x="450" y="30" text-anchor="middle" class="text-ar" font-size="18">نظام جهاز الأسنان المتكامل</text>

          <!-- ROW 1: Power Supply System -->
          <g class="hotspot" data-component="power-supply" tabindex="0" role="button">
            <rect class="box-shape" x="40" y="70" width="120" height="100" rx="8" fill="url(#grad-power)" stroke="#fbbf24" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="40" y="70" width="120" height="100" rx="8" fill="none" stroke="#fbbf24" stroke-width="3"/>
            <text x="100" y="110" text-anchor="middle" class="text-ar" font-size="13">مصدر</text>
            <text x="100" y="130" text-anchor="middle" class="text-ar" font-size="13">الطاقة</text>
            <text x="100" y="155" text-anchor="middle" class="text-en" font-size="10">Power</text>
          </g>

          <g class="link" data-link="power-supply">
            <line x1="160" y1="120" x2="200" y2="120" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="160" y1="120" x2="200" y2="120" stroke="#FBBF24" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="170" cy="120" r="3" fill="#FBBF24"/>
          </g>

          <g class="hotspot" data-component="compressor" tabindex="0" role="button">
            <rect class="box-shape" x="200" y="70" width="120" height="100" rx="8" fill="url(#grad-control)" stroke="#4ade80" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="200" y="70" width="120" height="100" rx="8" fill="none" stroke="#4ade80" stroke-width="3"/>
            <text x="260" y="110" text-anchor="middle" class="text-ar" font-size="13">وحدة</text>
            <text x="260" y="130" text-anchor="middle" class="text-ar" font-size="13">الضاغط</text>
            <text x="260" y="155" text-anchor="middle" class="text-en" font-size="10">Compressor</text>
          </g>

          <g class="link" data-link="compressor">
            <line x1="320" y1="120" x2="360" y2="120" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="320" y1="120" x2="360" y2="120" stroke="#4ADE80" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="330" cy="120" r="3" fill="#4ADE80"/>
          </g>

          <g class="hotspot" data-component="storage-tank" tabindex="0" role="button">
            <rect class="box-shape" x="360" y="70" width="120" height="100" rx="8" fill="url(#grad-storage)" stroke="#22d3ee" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="360" y="70" width="120" height="100" rx="8" fill="none" stroke="#22d3ee" stroke-width="3"/>
            <text x="420" y="110" text-anchor="middle" class="text-ar" font-size="13">خزان</text>
            <text x="420" y="130" text-anchor="middle" class="text-ar" font-size="13">التخزين</text>
            <text x="420" y="155" text-anchor="middle" class="text-en" font-size="10">Tank</text>
          </g>

          <g class="link" data-link="storage-tank">
            <line x1="480" y1="120" x2="520" y2="120" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="480" y1="120" x2="520" y2="120" stroke="#22D3EE" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="490" cy="120" r="3" fill="#22D3EE"/>
          </g>

          <g class="hotspot" data-component="distribution" tabindex="0" role="button">
            <circle class="box-shape" cx="580" cy="120" r="50" fill="url(#grad-distribution)" stroke="#c084fc" stroke-width="2" filter="url(#elevate)"/>
            <circle class="box-active-glow" cx="580" cy="120" r="50" fill="none" stroke="#c084fc" stroke-width="3"/>
            <text x="580" y="115" text-anchor="middle" class="text-ar" font-size="12">توزيع</text>
            <text x="580" y="135" text-anchor="middle" class="text-en" font-size="10">Distribution</text>
          </g>

          <!-- Vertical flow arrows -->
          <line x1="100" y1="170" x2="100" y2="220" class="arrow-line" marker-end="url(#arrow-right)"/>
          <line x1="260" y1="170" x2="260" y2="220" class="arrow-line" marker-end="url(#arrow-right)"/>
          <line x1="420" y1="170" x2="420" y2="220" class="arrow-line" marker-end="url(#arrow-right)"/>
          <line x1="580" y1="170" x2="580" y2="220" class="arrow-line" marker-end="url(#arrow-right)"/>

          <!-- ROW 2: Processing Systems -->
          <!-- Vertical input flows from Row 1 -->
          <g class="link" data-link="filtration-input">
            <line x1="100" y1="170" x2="100" y2="220" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="100" y1="170" x2="100" y2="220" stroke="#4ADE80" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="100" cy="190" r="3" fill="#4ADE80"/>
          </g>

          <g class="link" data-link="dryer-input">
            <line x1="260" y1="170" x2="260" y2="220" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="260" y1="170" x2="260" y2="220" stroke="#22D3EE" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="260" cy="190" r="3" fill="#22D3EE"/>
          </g>

          <g class="link" data-link="control-input">
            <line x1="420" y1="170" x2="420" y2="220" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="420" y1="170" x2="420" y2="220" stroke="#FBBF24" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="420" cy="190" r="3" fill="#FBBF24"/>
          </g>

          <g class="link" data-link="regulation-input">
            <line x1="580" y1="170" x2="580" y2="220" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="580" y1="170" x2="580" y2="220" stroke="#C084FC" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="580" cy="190" r="3" fill="#C084FC"/>
          </g>

          <g class="hotspot" data-component="filtration" tabindex="0" role="button">
            <rect class="box-shape" x="40" y="220" width="110" height="90" rx="8" fill="url(#grad-control)" stroke="#4ade80" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="40" y="220" width="110" height="90" rx="8" fill="none" stroke="#4ade80" stroke-width="3"/>
            <text x="95" y="255" text-anchor="middle" class="text-ar" font-size="12">التنقية</text>
            <text x="95" y="275" text-anchor="middle" class="text-en" font-size="9">Filtration</text>
          </g>

          <g class="link" data-link="filtration">
            <line x1="150" y1="265" x2="190" y2="265" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="150" y1="265" x2="190" y2="265" stroke="#4ADE80" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="170" cy="265" r="3" fill="#4ADE80"/>
          </g>

          <g class="hotspot" data-component="dryer" tabindex="0" role="button">
            <rect class="box-shape" x="190" y="220" width="110" height="90" rx="8" fill="url(#grad-storage)" stroke="#22d3ee" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="190" y="220" width="110" height="90" rx="8" fill="none" stroke="#22d3ee" stroke-width="3"/>
            <text x="245" y="255" text-anchor="middle" class="text-ar" font-size="12">مجفف</text>
            <text x="245" y="275" text-anchor="middle" class="text-en" font-size="9">Dryer</text>
          </g>

          <g class="link" data-link="dryer">
            <line x1="300" y1="265" x2="340" y2="265" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="300" y1="265" x2="340" y2="265" stroke="#22D3EE" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="320" cy="265" r="3" fill="#22D3EE"/>
          </g>

          <g class="hotspot" data-component="control-system" tabindex="0" role="button">
            <rect class="box-shape" x="340" y="220" width="110" height="90" rx="8" fill="url(#grad-power)" stroke="#fbbf24" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="340" y="220" width="110" height="90" rx="8" fill="none" stroke="#fbbf24" stroke-width="3"/>
            <text x="395" y="255" text-anchor="middle" class="text-ar" font-size="12">التحكم</text>
            <text x="395" y="275" text-anchor="middle" class="text-en" font-size="9">Control</text>
          </g>

          <g class="link" data-link="control">
            <line x1="450" y1="265" x2="490" y2="265" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="450" y1="265" x2="490" y2="265" stroke="#FBBF24" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="470" cy="265" r="3" fill="#FBBF24"/>
          </g>

          <g class="hotspot" data-component="regulation" tabindex="0" role="button">
            <rect class="box-shape" x="490" y="220" width="110" height="90" rx="8" fill="url(#grad-distribution)" stroke="#c084fc" stroke-width="2" filter="url(#elevate)"/>
            <rect class="box-active-glow" x="490" y="220" width="110" height="90" rx="8" fill="none" stroke="#c084fc" stroke-width="3"/>
            <text x="545" y="255" text-anchor="middle" class="text-ar" font-size="12">التنظيم</text>
            <text x="545" y="275" text-anchor="middle" class="text-en" font-size="9">Regulation</text>
          </g>

          <!-- Output flow to Row 3 -->
          <g class="link" data-link="regulation-output">
            <line x1="545" y1="310" x2="545" y2="360" stroke="#5b6478" stroke-width="3"/>
            <line class="trail" x1="545" y1="310" x2="545" y2="360" stroke="#C084FC" stroke-width="3" filter="url(#lineGlow)"/>
            <circle class="particle" cx="545" cy="335" r="3" fill="#C084FC"/>
          </g>

          <!-- ROW 3: Output Devices -->
          <g class="hotspot" data-component="turbines" tabindex="0" role="button">
            <circle class="box-shape" cx="150" cy="410" r="40" fill="url(#grad-control)" stroke="#4ade80" stroke-width="2" filter="url(#elevate)"/>
            <circle class="box-active-glow" cx="150" cy="410" r="40" fill="none" stroke="#4ade80" stroke-width="3"/>
            <text x="150" y="405" text-anchor="middle" class="text-ar" font-size="11">التوربينات</text>
            <text x="150" y="425" text-anchor="middle" class="text-en" font-size="9">Turbines</text>
          </g>

          <g class="hotspot" data-component="motors" tabindex="0" role="button">
            <circle class="box-shape" cx="310" cy="410" r="40" fill="url(#grad-storage)" stroke="#22d3ee" stroke-width="2" filter="url(#elevate)"/>
            <circle class="box-active-glow" cx="310" cy="410" r="40" fill="none" stroke="#22d3ee" stroke-width="3"/>
            <text x="310" y="405" text-anchor="middle" class="text-ar" font-size="11">المحركات</text>
            <text x="310" y="425" text-anchor="middle" class="text-en" font-size="9">Motors</text>
          </g>

          <g class="hotspot" data-component="chair" tabindex="0" role="button">
            <circle class="box-shape" cx="470" cy="410" r="40" fill="url(#grad-distribution)" stroke="#c084fc" stroke-width="2" filter="url(#elevate)"/>
            <circle class="box-active-glow" cx="470" cy="410" r="40" fill="none" stroke="#c084fc" stroke-width="3"/>
            <text x="470" y="405" text-anchor="middle" class="text-ar" font-size="11">نظام الكرسي</text>
            <text x="470" y="425" text-anchor="middle" class="text-en" font-size="9">Chair</text>
          </g>

          <g class="hotspot" data-component="suction" tabindex="0" role="button">
            <circle class="box-shape" cx="630" cy="410" r="40" fill="url(#grad-power)" stroke="#fbbf24" stroke-width="2" filter="url(#elevate)"/>
            <circle class="box-active-glow" cx="630" cy="410" r="40" fill="none" stroke="#fbbf24" stroke-width="3"/>
            <text x="630" y="405" text-anchor="middle" class="text-ar" font-size="11">الشفط</text>
            <text x="630" y="425" text-anchor="middle" class="text-en" font-size="9">Suction</text>
          </g>

          <!-- Legend -->
          <rect x="40" y="490" width="820" height="90" rx="8" fill="#1a2332" stroke="#4a6578" stroke-width="1.5"/>
          <text x="60" y="515" class="text-ar" font-size="12" font-weight="700">وسائل النقل:</text>

          <rect x="220" y="505" width="12" height="12" fill="#fbbf24"/>
          <text x="240" y="515" class="text-ar" font-size="11">الطاقة الكهربائية</text>

          <rect x="430" y="505" width="12" height="12" fill="#4ade80"/>
          <text x="450" y="515" class="text-ar" font-size="11">الهواء المضغوط</text>

          <rect x="640" y="505" width="12" height="12" fill="#22d3ee"/>
          <text x="660" y="515" class="text-ar" font-size="11">الماء</text>

          <rect x="220" y="540" width="12" height="12" fill="#c084fc"/>
          <text x="240" y="550" class="text-ar" font-size="11">الحركة الميكانيكية</text>
        </svg>
      </div>

      <!-- Info Panel -->
      <div class="info-panel">
        <div class="info-header">معلومات المكون</div>
        <div id="info-content" class="info-content">
          <p class="info-empty">انقر على أي مكون للحصول على معلومات تفصيلية</p>
        </div>
      </div>
    </div>

    <!-- Legend Panel -->
    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>الطاقة الكهربائية</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الهواء المضغوط</li>
      <li class="legend-item"><span class="legend-swatch" style="background: #22d3ee;"></span>الماء</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الحركة</li>
    </ul>

    <!-- Controls -->
    <div class="diagram-controls">
      <button id="btn-play" class="diagram-replay-button play-button" aria-label="تشغيل المحاكاة">▶ تشغيل</button>
      <button id="btn-pause" class="diagram-replay-button pause-button" aria-label="إيقاف المحاكاة" style="display: none;">⏸ إيقاف</button>
      <button id="btn-reset" class="diagram-replay-button reset-button" aria-label="إعادة تعيين المحاكاة">⟲ إعادة تعيين</button>
    </div>

    {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}
  </div>
</figure>

<style>
  .dental-simulator-interactive {
    margin: 2rem 0;
  }

  .simulator-content {
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    gap: 1rem;
    padding: 1.5rem;
    align-items: start;
  }

  /* Status Panel */
  .status-panel {
    background: rgba(26, 35, 50, 0.6);
    border: 1px solid #4a6578;
    border-radius: 8px;
    padding: 1rem;
    backdrop-filter: blur(10px);
  }

  .status-header {
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    text-align: right;
    direction: rtl;
  }

  .status-items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #cbd5e1;
    direction: rtl;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-label {
    text-align: right;
  }

  /* Main Diagram */
  .diagram-main {
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(15, 20, 25, 0.5);
    border: 1px solid #2a3f4d;
    border-radius: 12px;
    padding: 1rem;
    overflow: auto;
    max-height: 600px;
  }

  .dental-diagram-svg {
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  /* Info Panel */
  .info-panel {
    background: rgba(26, 35, 50, 0.6);
    border: 1px solid #4a6578;
    border-radius: 8px;
    padding: 1rem;
    backdrop-filter: blur(10px);
    overflow-y: auto;
    max-height: 600px;
  }

  .info-header {
    font-size: 0.9rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    text-align: right;
    direction: rtl;
  }

  .info-content {
    font-size: 0.85rem;
    line-height: 1.6;
    color: #cbd5e1;
    direction: rtl;
    text-align: right;
  }

  .info-empty {
    color: #64748b;
    font-style: italic;
  }

  .info-title {
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
  }

  .info-description {
    color: #cbd5e1;
  }

  /* Controls */
  .simulator-controls {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid #2a3f4d;
  }

  .control-btn {
    background: #1e293b;
    border: 1px solid #4a6578;
    color: #94a3b8;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .control-btn:hover {
    background: #334155;
    color: #e2e8f0;
  }

  .control-btn:active {
    transform: scale(0.95);
  }

  .diagram-block-caption {
    text-align: center;
    font-size: 0.95rem;
    color: #94a3b8;
    margin-top: 1rem;
    padding: 0 1rem;
    font-weight: 500;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .simulator-content {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }

    .status-panel,
    .info-panel {
      max-height: 300px;
    }
  }

  @media (max-width: 768px) {
    .status-panel,
    .info-panel {
      padding: 0.75rem;
      font-size: 0.8rem;
    }

    .simulator-controls {
      padding: 0.75rem;
    }

    .control-btn {
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .status-panel,
    .info-panel,
    .control-btn {
      transition: none;
    }
  }
</style>

<script>
  // Component interaction logic
  const componentInfo: Record<string, { ar: string; en: string; description: string }> = {
    "power-supply": {
      ar: "مصدر الطاقة",
      en: "Power Supply",
      description: "يتم تجهيز جهاز الأسنان من مصدر تجهيز الطاقة الرئيسي (220V أو 380V) الذي يزود جميع الأجهزة بالكهرباء اللازمة.",
    },
    "compressor": {
      ar: "وحدة الضاغط",
      en: "Compressor",
      description: "وحدة الضاغط هي القلب النابض للعيادة، تقوم بضغط الهواء الجوي إلى درجات عالية (3-8 بار) لتشغيل جميع الأدوات الهوائية.",
    },
    "storage-tank": {
      ar: "خزان التخزين",
      en: "Storage Tank",
      description: "خزان معدني يخزن الهواء المضغوط لضمان توفر ضغط ثابت ومستقر لجميع أدوات العيادة بغض النظر عن الطلب المتغير.",
    },
    "distribution": {
      ar: "التوزيع",
      en: "Distribution",
      description: "نظام توزيع الهواء المضغوط إلى جميع أجهزة وأدوات العيادة من خلال أنابيب ومفاتيح تحكم.",
    },
    "filtration": {
      ar: "نظام التنقية",
      en: "Filtration",
      description: "يزيل الشوائب والرطوبة من الهواء المضغوط لحماية الأدوات وضمان جودة الهواء المستخدم.",
    },
    "dryer": {
      ar: "مجفف الهواء",
      en: "Air Dryer",
      description: "يزيل الرطوبة المتبقية من الهواء لمنع تلف الأدوات والمحركات من الصدأ والتآكل.",
    },
    "control-system": {
      ar: "نظام التحكم",
      en: "Control System",
      description: "يتحكم بتشغيل وإيقاف جميع أجهزة العيادة ويضمن سلامة التشغيل والحماية من الأعطال.",
    },
    "regulation": {
      ar: "نظام التنظيم",
      en: "Regulation",
      description: "ينظم ضغط الهواء والماء والكهرباء إلى المستويات المطلوبة لكل جهاز تشغيلي.",
    },
    "turbines": {
      ar: "التوربينات",
      en: "Turbines",
      description: "أدوات حفر سريعة جداً تدور بسرعات عالية (300,000-400,000 دورة/دقيقة) تستخدم لحفر وإزالة الأسنان المصابة.",
    },
    "motors": {
      ar: "المحركات البطيئة",
      en: "Slow Motors",
      description: "محركات كهربائية أو هوائية بطيئة (10,000-60,000 دورة/دقيقة) تستخدم لأغراض مختلفة مثل الصقل والتنظيف.",
    },
    "chair": {
      ar: "نظام الكرسي الهيدروليكي",
      en: "Chair System",
      description: "نظام هيدروليكي يتحكم برفع وخفض وتحريك كرسي المريض لتوفير أقصى درجات الراحة والسلامة.",
    },
    "suction": {
      ar: "نظام الشفط",
      en: "Suction System",
      description: "يسحب اللعاب والماء من فم المريض أثناء العلاج، ويتكون من مضخة شفط وأنابيب توزيع.",
    },
  };

  let isAnimating = false;

  // Setup hotspot interactions
  document.querySelectorAll(".hotspot").forEach((hotspot) => {
    hotspot.addEventListener("click", () => {
      const componentId = hotspot.getAttribute("data-component");
      if (componentId && componentInfo[componentId]) {
        const info = componentInfo[componentId];
        const content = document.getElementById("info-content");
        if (content) {
          content.innerHTML = `
            <div class="info-title">${info.ar}</div>
            <div style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 0.5rem;">${info.en}</div>
            <div class="info-description">${info.description}</div>
          `;
        }

        // Update active state
        document.querySelectorAll(".hotspot").forEach((h) => h.classList.remove("active"));
        hotspot.classList.add("active");
      }
    });

    hotspot.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        (hotspot as HTMLElement).click();
      }
    });
  });

  // Control button handlers
  document.getElementById("btn-play")?.addEventListener("click", () => {
    isAnimating = true;
    const playBtn = document.getElementById("btn-play");
    const pauseBtn = document.getElementById("btn-pause");
    if (playBtn && pauseBtn) {
      playBtn.style.display = "none";
      pauseBtn.style.display = "inline-block";
    }
  });

  document.getElementById("btn-pause")?.addEventListener("click", () => {
    isAnimating = false;
    const playBtn = document.getElementById("btn-play");
    const pauseBtn = document.getElementById("btn-pause");
    if (playBtn && pauseBtn) {
      playBtn.style.display = "inline-block";
      pauseBtn.style.display = "none";
    }
  });

  document.getElementById("btn-reset")?.addEventListener("click", () => {
    isAnimating = false;
    const playBtn = document.getElementById("btn-play");
    const pauseBtn = document.getElementById("btn-pause");
    if (playBtn && pauseBtn) {
      playBtn.style.display = "inline-block";
      pauseBtn.style.display = "none";
    }
    document.querySelectorAll(".hotspot").forEach((h) => h.classList.remove("active"));
    const content = document.getElementById("info-content");
    if (content) {
      content.innerHTML = '<p class="info-empty">انقر على أي مكون للحصول على معلومات تفصيلية</p>';
    }
  });
</script>
