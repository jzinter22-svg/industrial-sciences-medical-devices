---
// Animated Figure 2-11 (النمط النبضي للامواج الفوق صوتية) — printed page
// 33. Static artwork kept pixel-identical (same axes, three pulse
// bursts, spacing/duty-cycle annotations). Animation reveals the three
// short bursts in left-to-right time order, exactly as an oscilloscope
// trace would draw them — teaching the pulsed (burst-then-silence) duty
// cycle that distinguishes this mode from Figure 2-12's continuous wave.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram pulsed-ultrasound-diagram">
  <div class="diagram-block-image">
    <svg
      class="pu-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="700"
      height="280"
      viewBox="0 0 700 280"
      role="img"
      aria-label="النمط النبضي للامواج الفوق صوتية"
    >
      <defs>
        <marker id="pu-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="700" height="280" fill="none"></rect>

      <line x1="60" y1="140" x2="660" y2="140" stroke="#263238" stroke-width="2" marker-end="url(#pu-arrow)"></line>
      <line x1="60" y1="230" x2="60" y2="50" stroke="#263238" stroke-width="2" marker-end="url(#pu-arrow)"></line>
      <text x="30" y="60" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">السعة</text>
      <text x="640" y="160" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">الزمن</text>

      <g fill="none" stroke="#1d4ed8" stroke-width="2.5">
        <path class="flow-highlight burst-1" d="M 100,140 q 8,-45 16,0 t 16,0 t 16,0 t 16,0"></path>
        <path class="flow-highlight burst-2" d="M 270,140 q 8,-45 16,0 t 16,0 t 16,0 t 16,0"></path>
        <path class="flow-highlight burst-3" d="M 440,140 q 8,-45 16,0 t 16,0 t 16,0 t 16,0"></path>
      </g>

      <line x1="100" y1="185" x2="164" y2="185" stroke="#263238" stroke-width="1.5" marker-end="url(#pu-arrow)" marker-start="url(#pu-arrow)"></line>
      <text x="132" y="205" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">1 μsec.</text>

      <line x1="164" y1="60" x2="270" y2="60" stroke="#263238" stroke-width="1.2" stroke-dasharray="4 3"></line>
      <text x="480" y="65" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">f=1KHz-12KHz</text>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle" cx="60" cy="140" r="5" style="--tx:590px; --ty:0px; --particle-delay:0.1s; --particle-duration:1.8s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.2s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .pu-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .burst-1 { --highlight-delay: 0.2s; --highlight-duration: 0.5s; }
  .burst-2 { --highlight-delay: 0.9s; --highlight-duration: 0.5s; }
  .burst-3 { --highlight-delay: 1.6s; --highlight-duration: 0.5s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".pulsed-ultrasound-diagram");
</script>
