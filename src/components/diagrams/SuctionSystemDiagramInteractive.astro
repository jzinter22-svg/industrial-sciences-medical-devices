---
// Figures 7-24, 7-25 and 7-28 (نظام الشفط والتفريغ) built as a dark
// neumorphic interactive simulator, following the exact Chapter 1-6
// system (see IncubatorBlockDiagram.astro) and modeled directly on
// AirCompressorSystemDiagramInteractive.astro — the closest existing
// diagram in nature (a linear pneumatic chain with a small accessory at
// the end), reused here as the base template per the master-diagram
// pattern established for Chapter 7.
//
// Geometry: the suction tip draws fluid into the collection container,
// which the vacuum pump pulls through; the filter and trap condition the
// airstream before it vents, and the vacuum gauge / drain valve are
// accessories on the container and pump respectively.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft suction-system-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام الشفط والتفريغ</span>
      <span class="simulator-subtitle">شكل 24-7 و 25-7 و 28-7 — من طرف الشفط إلى التفريغ الخارجي</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="scs1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="800"
          height="560"
          viewBox="0 0 800 560"
          role="img"
          aria-label="نظام الشفط والتفريغ المتكامل"
        >
          <defs>
            <marker id="scs1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="scs1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="scs1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="scs1GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="scs1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="scs1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="scs1GradGray" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#232b36"></stop><stop offset="100%" stop-color="#12161c"></stop></linearGradient>
            <linearGradient id="scs1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="scs1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="scs1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="800" height="560" rx="20" fill="url(#scs1BgGrad)"></rect>
          <rect x="0" y="0" width="800" height="560" rx="20" fill="url(#scs1Grid)"></rect>

          <text x="400" y="34" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">نظام الشفط والتفريغ</text>

          <g class="hotspot" data-component="suction-tip" tabindex="0" role="button" aria-label="طرف الشفط">
            <circle class="box-shape" cx="80" cy="140" r="30" fill="url(#scs1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#scs1Elevate)"></circle>
            <text x="80" y="123" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">طرف</text>
            <text x="80" y="188" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">الشفط</text>
            <text x="80" y="204" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#4ADE80" direction="ltr">Suction Tip</text>
          </g>

          <g class="link" data-link="suction-tip" data-link-to="collection-container">
            <line x1="110" y1="140" x2="150" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#scs1-arrow)"></line>
            <line class="trail" x1="110" y1="140" x2="148" y2="140" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="collection-container" tabindex="0" role="button" aria-label="حاوية التجميع">
            <rect class="box-shape" x="150" y="90" width="140" height="110" rx="10" fill="url(#scs1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#scs1Elevate)"></rect>
            <rect x="170" y="112" width="100" height="72" fill="none" stroke="#38BDF8" stroke-width="1.4" opacity="0.5"></rect>
            <circle cx="200" cy="150" r="2.4" fill="#38BDF8" opacity="0.6"></circle>
            <circle cx="225" cy="165" r="2" fill="#38BDF8" opacity="0.6"></circle>
            <circle cx="240" cy="140" r="2.2" fill="#38BDF8" opacity="0.6"></circle>
            <text x="220" y="184" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">حاوية التجميع</text>
          </g>

          <g class="hotspot" data-component="vacuum-gauge" tabindex="0" role="button" aria-label="مقياس التفريغ">
            <circle class="box-shape" cx="235" cy="65" r="20" fill="url(#scs1GradPurple)" stroke="#EF4444" stroke-width="2" filter="url(#scs1Elevate)"></circle>
            <line x1="235" y1="65" x2="245" y2="53" stroke="#EF4444" stroke-width="1.6" stroke-linecap="round"></line>
            <circle cx="235" cy="65" r="2.2" fill="#EF4444"></circle>
            <text x="235" y="35" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#EF4444" direction="rtl">مقياس التفريغ</text>
          </g>
          <g class="link" data-link="collection-container" data-link-to="vacuum-gauge">
            <path d="M 225,90 L 232,84" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#scs1-arrow)"></path>
            <path class="trail" d="M 225,90 L 231,85" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="link" data-link="collection-container" data-link-to="vacuum-pump">
            <line x1="290" y1="145" x2="335" y2="145" stroke="#5b6478" stroke-width="2.5" marker-end="url(#scs1-arrow)"></line>
            <line class="trail" x1="290" y1="145" x2="333" y2="145" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="vacuum-pump" tabindex="0" role="button" aria-label="مضخة الشفط">
            <rect class="box-shape" x="335" y="90" width="140" height="110" rx="10" fill="url(#scs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#scs1Elevate)"></rect>
            <circle cx="405" cy="140" r="24" fill="none" stroke="#FBBF24" stroke-width="1.4" opacity="0.7"></circle>
            <circle cx="405" cy="140" r="13" fill="#FBBF24" opacity="0.35"></circle>
            <text x="405" y="184" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">مضخة الشفط</text>
          </g>

          <g class="link" data-link="vacuum-pump" data-link-to="filter">
            <line x1="475" y1="145" x2="520" y2="145" stroke="#5b6478" stroke-width="2.5" marker-end="url(#scs1-arrow)"></line>
            <line class="trail" x1="475" y1="145" x2="518" y2="145" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="filter" tabindex="0" role="button" aria-label="الفلتر">
            <rect class="box-shape" x="520" y="90" width="120" height="110" rx="10" fill="url(#scs1GradGray)" stroke="#94A3B8" stroke-width="2" filter="url(#scs1Elevate)"></rect>
            <circle cx="580" cy="130" r="16" fill="none" stroke="#94A3B8" stroke-width="1.4" opacity="0.7"></circle>
            <circle cx="580" cy="168" r="9" fill="#94A3B8" opacity="0.35"></circle>
            <text x="580" y="192" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">الفلتر</text>
          </g>

          <g class="link" data-link="filter" data-link-to="trap">
            <line x1="640" y1="145" x2="680" y2="145" stroke="#5b6478" stroke-width="2.5" marker-end="url(#scs1-arrow)"></line>
            <line class="trail" x1="640" y1="145" x2="678" y2="145" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="trap" tabindex="0" role="button" aria-label="مصيدة الرواسب">
            <rect class="box-shape" x="680" y="90" width="90" height="110" rx="10" fill="url(#scs1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#scs1Elevate)"></rect>
            <rect x="695" y="115" width="60" height="55" fill="none" stroke="#38BDF8" stroke-width="1.4" opacity="0.6"></rect>
            <text x="725" y="184" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">مصيدة</text>
          </g>

          <g class="hotspot" data-component="drain-valve" tabindex="0" role="button" aria-label="صمام التفريغ">
            <circle class="box-shape" cx="405" cy="270" r="26" fill="url(#scs1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#scs1Elevate)"></circle>
            <text x="405" y="266" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">صمام</text>
            <text x="405" y="279" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">التفريغ</text>
          </g>
          <g class="link" data-link="vacuum-pump" data-link-to="drain-valve">
            <path d="M 405,200 L 405,238" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#scs1-arrow)"></path>
            <path class="trail" d="M 405,200 L 405,237" fill="none" stroke="#C084FC" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="110" cy="140" r="4.5" fill="#4ADE80" filter="url(#scs1Glow)" style="--tx:38px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="475" cy="145" r="4.5" fill="#FBBF24" filter="url(#scs1Glow)" style="--tx:43px; --ty:0px; --particle-delay:1.6s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="suction-tip"><span class="status-dot dot-green"></span><span class="status-label">طرف الشفط</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="collection-container"><span class="status-dot dot-blue"></span><span class="status-label">حاوية التجميع</span><span class="status-value"><span class="value-off">فارغة</span><span class="value-on">تمتلئ</span></span></li>
          <li class="status-row" data-status="vacuum-gauge"><span class="status-dot dot-red"></span><span class="status-label">مقياس التفريغ</span><span class="status-value"><span class="value-off">صفر</span><span class="value-on">يقرأ</span></span></li>
          <li class="status-row" data-status="vacuum-pump"><span class="status-dot dot-yellow"></span><span class="status-label">مضخة الشفط</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="filter"><span class="status-dot dot-gray"></span><span class="status-label">الفلتر</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="trap"><span class="status-dot dot-blue"></span><span class="status-label">مصيدة الرواسب</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="drain-valve"><span class="status-dot dot-purple"></span><span class="status-label">صمام التفريغ</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">مفتوح</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مرحلة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الشفط من الفم</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>مسار الشفط</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>التفريغ الميكانيكي</li>
      <li class="legend-item"><span class="legend-swatch legend-gray"></span>التنقية</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الحركة الميكانيكية</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-gray { background: #94A3B8; }
  .status-dot.dot-gray { background: #3a4258; }
  .status-dot.dot-red { background: #3a4258; }

  .hotspot .box-shape {
    filter: url(#scs1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#scs1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#scs1Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes scs1-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: scs1-particle-move var(--particle-duration, 0.4s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes scs1-shape-activate { to { filter: url(#scs1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes scs1-reveal-trail { to { opacity: 0.85; } }
    @keyframes scs1-status-value-on { to { opacity: 1; } }
    @keyframes scs1-status-value-off { to { opacity: 0; } }
    @keyframes scs1-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes scs1-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes scs1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes scs1-dot-on-gray { to { background: #94A3B8; box-shadow: 0 0 8px 1px rgba(148, 163, 184, 0.8); } }
    @keyframes scs1-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes scs1-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="suction-tip"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="suction-tip"] .status-dot { animation: scs1-dot-on-green 0.4s ease-out 0.1s forwards; }
    .playing [data-status="suction-tip"] .value-on { animation: scs1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="suction-tip"] .value-off { animation: scs1-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="suction-tip"] .trail { animation: scs1-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="collection-container"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="collection-container"] .status-dot { animation: scs1-dot-on-blue 0.4s ease-out 0.6s forwards; }
    .playing [data-status="collection-container"] .value-on { animation: scs1-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="collection-container"] .value-off { animation: scs1-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-link="collection-container"][data-link-to="vacuum-gauge"] .trail { animation: scs1-reveal-trail 0.3s ease-out 1.0s forwards; }
    .playing [data-component="vacuum-gauge"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="vacuum-gauge"] .status-dot { animation: scs1-dot-on-red 0.4s ease-out 1.1s forwards; }
    .playing [data-status="vacuum-gauge"] .value-on { animation: scs1-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="vacuum-gauge"] .value-off { animation: scs1-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-link="collection-container"][data-link-to="vacuum-pump"] .trail { animation: scs1-reveal-trail 0.3s ease-out 1.5s forwards; }
    .playing [data-component="vacuum-pump"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="vacuum-pump"] .status-dot { animation: scs1-dot-on-yellow 0.4s ease-out 1.6s forwards; }
    .playing [data-status="vacuum-pump"] .value-on { animation: scs1-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="vacuum-pump"] .value-off { animation: scs1-status-value-off 0.4s ease-out 1.6s forwards; }

    .playing [data-link="vacuum-pump"][data-link-to="filter"] .trail { animation: scs1-reveal-trail 0.3s ease-out 2.0s forwards; }
    .playing [data-component="filter"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 2.1s forwards; }
    .playing [data-status="filter"] .status-dot { animation: scs1-dot-on-gray 0.4s ease-out 2.1s forwards; }
    .playing [data-status="filter"] .value-on { animation: scs1-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="filter"] .value-off { animation: scs1-status-value-off 0.4s ease-out 2.1s forwards; }

    .playing [data-link="filter"] .trail { animation: scs1-reveal-trail 0.3s ease-out 2.5s forwards; }
    .playing [data-component="trap"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 2.6s forwards; }
    .playing [data-status="trap"] .status-dot { animation: scs1-dot-on-blue 0.4s ease-out 2.6s forwards; }
    .playing [data-status="trap"] .value-on { animation: scs1-status-value-on 0.4s ease-out 2.6s forwards; }
    .playing [data-status="trap"] .value-off { animation: scs1-status-value-off 0.4s ease-out 2.6s forwards; }

    .playing [data-link="vacuum-pump"][data-link-to="drain-valve"] .trail { animation: scs1-reveal-trail 0.3s ease-out 3.0s forwards; }
    .playing [data-component="drain-valve"] .box-shape { animation: scs1-shape-activate 0.4s ease-out 3.1s forwards; }
    .playing [data-status="drain-valve"] .status-dot { animation: scs1-dot-on-purple 0.4s ease-out 3.1s forwards; }
    .playing [data-status="drain-valve"] .value-on { animation: scs1-status-value-on 0.4s ease-out 3.1s forwards; }
