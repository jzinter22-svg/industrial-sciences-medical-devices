---
// Reusable numbered legend for the Educational Diagram System.
//
// Labels live here as normal HTML text (not SVG text), so Arabic shaping,
// wrapping, and sizing use the browser's ordinary text layout instead of
// viewBox-scaled SVG coordinates. Each entry's number is the only thing
// that connects it back to the illustration (a matching numbered marker),
// which avoids leader lines needing to reach across the diagram entirely.
interface LegendItem {
  region: string;
  number: number | string;
  label: string;
}

interface Props {
  items: LegendItem[];
}

const { items } = Astro.props;
---

<ul class="diagram-legend">
  {items.map((item) => (
    <li>
      <button type="button" class="diagram-legend-item" data-region={item.region} aria-pressed="false">
        <span class="diagram-legend-badge" aria-hidden="true">{item.number}</span>
        <span class="diagram-legend-text">{item.label}</span>
      </button>
    </li>
  ))}
</ul>

<style>
  .diagram-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--neo-space-xs);
  }

  .diagram-legend-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--neo-space-xs);
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    text-align: start;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-legend-badge {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--neo-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .diagram-legend-text {
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--neo-text);
    line-height: 1.4;
  }

  .diagram-legend-item:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  .diagram-legend-item.is-active {
    background: color-mix(in srgb, var(--neo-primary) 14%, var(--neo-surface));
  }

  .diagram-legend-item.is-active .diagram-legend-text {
    color: var(--neo-primary);
    font-weight: 700;
  }
</style>
