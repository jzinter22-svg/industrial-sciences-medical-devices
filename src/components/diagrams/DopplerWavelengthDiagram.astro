---
// Animated Figure 2-6 (تاثير دوبلر على الجسم المتحرك وعلاقته بالطول
// الموجي) — printed page 29. Static artwork kept pixel-identical (same
// arcs, sine trace, object, viewBox). Animation pulses the trailing
// (stretched, lower-frequency) arcs first, then the moving object and
// its velocity arrow, then the leading (compressed, higher-frequency)
// arcs, then the sine trace — teaching that motion toward the leading
// side compresses the wave and motion away from the trailing side
// stretches it, matching the two frequency labels already on the page.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram doppler-wavelength-diagram">
  <div class="diagram-block-image">
    <svg
      class="dw-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="760"
      height="300"
      viewBox="0 0 760 300"
      role="img"
      aria-label="تاثير دوبلر على الجسم المتحرك وعلاقته بالطول الموجي"
    >
      <defs>
        <marker id="dw-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#dc2626"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="760" height="300" fill="none"></rect>

      <g class="ripple-ring trailing-arcs" stroke="#8a8f98" stroke-width="6" fill="none">
        <path d="M 40,150 A 100,100 0 0 1 40,300"></path>
        <path d="M 40,80 A 170,170 0 0 1 40,370"></path>
        <path d="M 40,20 A 230,230 0 0 1 40,430"></path>
      </g>
      <g class="ripple-ring leading-arc" stroke="#8a8f98" stroke-width="6" fill="none">
        <path d="M 40,150 A 60,60 0 0 0 40,270" transform="translate(0,-100)"></path>
      </g>

      <path class="flow-highlight sine-trace" d="M 60,150 q 22,-45 44,0 t 40,0 t 36,-45 32,0 t 26,-45 22,0 t 16,-45 14,0 t 10,-45 8,0"
            fill="none" stroke="#1d4ed8" stroke-width="4"></path>

      <g class="flow-highlight moving-object">
        <circle cx="590" cy="150" r="16" fill="#dc2626" stroke="#263238" stroke-width="2"></circle>
        <line x1="610" y1="150" x2="660" y2="150" stroke="#dc2626" stroke-width="4" marker-end="url(#dw-arrow)"></line>
      </g>

      <g class="flow-highlight leading-label">
        <text x="700" y="120" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">تردد اعلى</text>
        <text x="700" y="140" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">(طول موجي اقصر)</text>
      </g>

      <g class="flow-highlight trailing-label">
        <text x="90" y="90" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">تردد اقل</text>
        <text x="90" y="70" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">(طول موجي اطول)</text>
      </g>

      <g class="flow-layer" aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.9s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .dw-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .trailing-label { --highlight-delay: 0.1s; --highlight-duration: 0.6s; }
  .moving-object { --highlight-delay: 1.1s; --highlight-duration: 0.6s; }
  .leading-label { --highlight-delay: 2.1s; --highlight-duration: 0.6s; }
  .sine-trace { --highlight-delay: 0.6s; --highlight-duration: 2.0s; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes ripple-fade {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }

    .playing .trailing-arcs { animation: ripple-fade 0.9s ease-in-out 0.1s; }
    .playing .leading-arc { animation: ripple-fade 0.6s ease-in-out 2.1s; }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".doppler-wavelength-diagram");
</script>
