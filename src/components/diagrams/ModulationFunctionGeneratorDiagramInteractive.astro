---
// Figure 8-17 (المخطط الكتلوي لوحدة الجراحة الكهربائية باستعمال مضمّن
// ومولد الدالة) — the smallest block diagram in the chapter: in Cut mode
// only the RF Oscillator drives the Modulator (pass-through, continuous
// output); in Coagulation mode the Function Generator also feeds the
// Modulator, so the continuous RF gets modulated into an intermittent
// wave before reaching the Power Amp. Same Cut/Coagulation toggle
// pattern as the other multi-mode diagrams in this chapter.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft modulation-function-generator-diagram">
  <div class="simulator-shell" data-mode="cut">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة وحدة الجراحة باستعمال مضمّن ومولد دالة</span>
      <span class="simulator-subtitle">شكل 8-17 — مذبذب RF، مضمّن، مولد دالة، مكبر قدرة</span>
    </div>

    <div class="mode-toggle-row">
      <button type="button" class="mode-toggle-button" data-mode-button="cut" aria-pressed="true">قطع (Cut)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="coag" aria-pressed="false">تخثر (Coagulation)</button>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es17-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="740"
          height="300"
          viewBox="0 0 740 300"
          role="img"
          aria-label="المخطط الكتلوي لوحدة الجراحة باستعمال مضمّن ومولد دالة"
        >
          <defs>
            <marker id="es17-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="es17BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es17Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es17GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="es17GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="es17GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>

            <filter id="es17Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es17Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="740" height="300" rx="20" fill="url(#es17BgGrad)"></rect>
          <rect x="0" y="0" width="740" height="300" rx="20" fill="url(#es17Grid)"></rect>

          <text x="370" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">وحدة الجراحة باستعمال مضمّن ومولد دالة</text>

          <g class="hotspot" data-component="rf-oscillator" tabindex="0" role="button" aria-label="مذبذب التردد الراديوي">
            <rect class="box-shape" x="40" y="100" width="150" height="90" rx="10" fill="url(#es17GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#es17Elevate)"></rect>
            <text x="115" y="138" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">مذبذب التردد</text>
            <text x="115" y="154" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#C084FC" direction="ltr">RF Oscillator</text>
          </g>

          <g class="link" data-link="rf-oscillator" data-link-to="modulator">
            <line id="es17-wire-1" x1="190" y1="145" x2="245" y2="145" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es17-arrow)"></line>
            <line class="trail" x1="190" y1="145" x2="243" y2="145" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#C084FC" filter="url(#es17Glow)" style="offset-path: url(#es17-wire-1); --flow-delay:0.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="modulator" tabindex="0" role="button" aria-label="المضمّن">
            <rect class="box-shape" x="245" y="90" width="150" height="110" rx="10" fill="url(#es17GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#es17Elevate)"></rect>
            <text x="320" y="140" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="rtl">المضمّن</text>
            <text x="320" y="156" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#38BDF8" direction="ltr">Modulator</text>
          </g>

          <g class="link" data-link="modulator" data-link-to="power-amp">
            <line id="es17-wire-2" x1="395" y1="145" x2="440" y2="145" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es17-arrow)"></line>
            <line class="trail" x1="395" y1="145" x2="438" y2="145" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle output-particle" r="3.6" fill="#4ADE80" filter="url(#es17Glow)" style="offset-path: url(#es17-wire-2); --flow-delay:1.4s; --flow-duration:0.9s;"></circle>
          </g>

          <g class="hotspot" data-component="power-amp" tabindex="0" role="button" aria-label="مكبر القدرة">
            <rect class="box-shape" x="440" y="100" width="150" height="90" rx="10" fill="url(#es17GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es17Elevate)"></rect>
            <text class="cut-only" x="515" y="138" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">مكبر القدرة</text>
            <text class="cut-only" x="515" y="154" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#FB923C" direction="ltr">(موجة مستمرة)</text>
            <text class="coag-only" x="515" y="138" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">مكبر القدرة</text>
            <text class="coag-only" x="515" y="154" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#FB923C" direction="ltr">(موجة متقطعة)</text>
          </g>

          <!-- Function Generator: only feeds the modulator in Coag mode -->
          <g class="hotspot coag-only" data-component="function-generator" tabindex="0" role="button" aria-label="مولد الدالة">
            <rect class="box-shape" x="245" y="220" width="150" height="70" rx="10" fill="url(#es17GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es17Elevate)"></rect>
            <text x="320" y="248" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">مولد الدالة</text>
            <text x="320" y="264" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#FB923C" direction="ltr">Function Generator</text>
          </g>
          <g class="link coag-only" data-link="function-generator" data-link-to="modulator">
            <line id="es17-wire-3" x1="320" y1="220" x2="320" y2="205" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es17-arrow)"></line>
            <line class="trail" x1="320" y1="220" x2="320" y2="207" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="rf-oscillator"><span class="status-dot dot-purple"></span><span class="status-label">مذبذب RF</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">مستمر دوما</span></span></li>
          <li class="status-row" data-status="function-generator"><span class="status-dot dot-orange"></span><span class="status-label">مولد الدالة</span><span class="status-value"><span class="value-off">غير مستخدم</span><span class="value-on">يولّد موجة مربعة</span></span></li>
          <li class="status-row" data-status="modulator"><span class="status-dot dot-blue"></span><span class="status-label">المضمّن</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on value-cut">تمرير مباشر</span><span class="value-on value-coag">تضمين بموجة مربعة</span></span></li>
          <li class="status-row" data-status="power-amp"><span class="status-dot dot-orange"></span><span class="status-label">مكبر القدرة</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on value-cut">يكبّر موجة مستمرة</span><span class="value-on value-coag">يكبّر موجة متقطعة</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>بدّل بين القطع والتخثر من الأزرار أعلاه، أو انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>مذبذب RF</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>المضمّن</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>مولد الدالة / المكبر</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .mode-toggle-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0 var(--neo-space-md) var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .mode-toggle-button {
    font-family: "Cairo", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #c3c9dc;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .mode-toggle-button:hover { background: rgba(255, 255, 255, 0.08); }

  .mode-toggle-button[aria-pressed="true"] {
    background: #38BDF8;
    border-color: #38BDF8;
    color: #081826;
  }

  .coag-only { opacity: 0; pointer-events: none; }
  .simulator-shell[data-mode="coag"] .coag-only { opacity: 1; pointer-events: auto; }
  .value-cut, .value-coag { opacity: 0; }
  .simulator-shell[data-mode="coag"] .value-cut { display: none; }
  .simulator-shell[data-mode="coag"] text.cut-only { display: none; }
  .simulator-shell:not([data-mode="coag"]) .value-coag { display: none; }
  .simulator-shell:not([data-mode="coag"]) text.coag-only { display: none; }

  .hotspot .box-shape {
    filter: url(#es17Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es17Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#es17Glow); }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es17-shape-activate { to { filter: url(#es17Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es17-reveal-trail { to { opacity: 0.85; } }
    @keyframes es17-status-value-on { to { opacity: 1; } }
    @keyframes es17-status-value-off { to { opacity: 0; } }
    @keyframes es17-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes es17-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes es17-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }

    .playing [data-component="rf-oscillator"] .box-shape { animation: es17-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="rf-oscillator"] .status-dot { animation: es17-dot-on-purple 0.4s ease-out 0.1s forwards; }
    .playing [data-status="rf-oscillator"] .value-on { animation: es17-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="rf-oscillator"] .value-off { animation: es17-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="rf-oscillator"] .trail { animation: es17-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="function-generator"] .box-shape { animation: es17-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="function-generator"] .status-dot { animation: es17-dot-on-orange 0.4s ease-out 0.1s forwards; }
    .playing [data-status="function-generator"] .value-on { animation: es17-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="function-generator"] .value-off { animation: es17-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="function-generator"] .trail { animation: es17-reveal-trail 0.3s ease-out 0.6s forwards; }

    .playing [data-component="modulator"] .box-shape { animation: es17-shape-activate 0.4s ease-out 1.0s forwards; }
    .playing [data-status="modulator"] .status-dot { animation: es17-dot-on-blue 0.4s ease-out 1.0s forwards; }
    .playing [data-status="modulator"] .value-on { animation: es17-status-value-on 0.4s ease-out 1.0s forwards; }
    .playing [data-status="modulator"] .value-off { animation: es17-status-value-off 0.4s ease-out 1.0s forwards; }
    .playing [data-link="modulator"] .trail { animation: es17-reveal-trail 0.3s ease-out 1.4s forwards; }

    .playing [data-component="power-amp"] .box-shape { animation: es17-shape-activate 0.4s ease-out 1.8s forwards; }
    .playing [data-status="power-amp"] .status-dot { animation: es17-dot-on-orange 0.4s ease-out 1.8s forwards; }
    .playing [data-status="power-amp"] .value-on { animation: es17-status-value-on 0.4s ease-out 1.8s forwards; }
    .playing [data-status="power-amp"] .value-off { animation: es17-status-value-off 0.4s ease-out 1.8s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes es17-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: es17-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
    @keyframes es17-output-flow-coag {
      0%, 100% { offset-distance: 0%; opacity: 0; }
      6% { opacity: 1; }
      22% { opacity: 1; }
      28% { opacity: 0; }
      34% { opacity: 1; }
      50% { opacity: 1; }
      56% { opacity: 0; }
      62% { opacity: 1; }
      78% { opacity: 1; }
      84% { offset-distance: 100%; opacity: 0; }
    }
    .simulator-shell[data-mode="coag"] .playing .output-particle { animation: es17-output-flow-coag 1.6s linear var(--flow-delay, 0s) infinite; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "rf-oscillator": {
      title: "مذبذب التردد الراديوي (RF Oscillator)",
      text: "يعمل باستمرار على توليد الموجات المستمرة، سواء في نمط القطع أو التخثر.",
    },
    "function-generator": {
      title: "مولد الدالة (Function Generator)",
      text: "لا يُستخدم إلا في نمط التخثر: يولّد موجات مربعة ذات تردد واطئ تُغذّى إلى المضمّن.",
    },
    modulator: {
      title: "المضمّن (Modulator)",
      text: "في نمط القطع يمرر موجة مذبذب RF كما هي (مستمرة). في نمط التخثر يُضمّن تلك الموجة بموجات مولد الدالة المربعة، فيكون الخرج موجة متقطعة تُوصل إلى مكبر القدرة.",
    },
    "power-amp": {
      title: "مكبر القدرة (Power Amp)",
      text: "يكبّر خرج المضمّن — موجة مستمرة في نمط القطع، أو موجة متقطعة في نمط التخثر — قبل وصولها إلى قطبي الجهاز.",
    },
  };

  wireDiagramSimulator(".modulation-function-generator-diagram", { cycleMs: 2800, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".modulation-function-generator-diagram .mode-toggle-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".modulation-function-generator-diagram")?.querySelector(".simulator-shell");
      const mode = btn.getAttribute("data-mode-button");
      if (!(shell instanceof HTMLElement) || !mode) return;
      shell.dataset.mode = mode;
      shell.querySelectorAll(".mode-toggle-button").forEach((b) => {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
    });
  });
</script>
