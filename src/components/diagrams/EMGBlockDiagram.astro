---
// Figure 5-5 (المخطط الكتلوي لجهاز تخطيط العضلات) rebuilt as a dark
// neumorphic interactive simulator, following the exact Chapter 1-4
// system. Geometry mirrors the book's own block diagram: the trigger/
// stimulation branch driving surface electrodes on the patient's hand
// (with an earth-ground reference), and the two parallel readout
// branches from the same electrode signal — the visual/recording chain
// (amplifier -> oscilloscope -> camera) and the audio-monitoring chain
// (audio amplifier -> earphone/speaker).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft emg-block-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة المخطط الكتلوي لجهاز تخطيط العضلات</span>
      <span class="simulator-subtitle">شكل 5-5 — من القادح والتحفيز الى تسجيل الإشارة ومراقبتها صوتيا</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="emgb-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="1000"
          height="440"
          viewBox="0 0 1000 440"
          role="img"
          aria-label="المخطط الكتلوي لجهاز تخطيط العضلات"
        >
          <defs>
            <marker id="emgb5-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="emgb5BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="emgb5Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="emgb5GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="emgb5GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="emgb5GradRose" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1420"></stop><stop offset="100%" stop-color="#1c0a10"></stop></linearGradient>
            <linearGradient id="emgb5GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332210"></stop><stop offset="100%" stop-color="#1a1108"></stop></linearGradient>
            <linearGradient id="emgb5GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="emgb5GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="emgb5GradGray" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#232a3a"></stop><stop offset="100%" stop-color="#12161f"></stop></linearGradient>

            <filter id="emgb5Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="9" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="9" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="7" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3.5" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="3" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.3" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="emgb5Glow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="1000" height="440" rx="20" fill="url(#emgb5BgGrad)"></rect>
          <rect x="0" y="0" width="1000" height="440" rx="20" fill="url(#emgb5Grid)"></rect>

          <!-- stimulation branch: top row -->
          <g class="hotspot" data-component="trigger" tabindex="0" role="button" aria-label="القادح">
            <rect class="box-shape" x="800" y="40" width="130" height="60" rx="10" fill="url(#emgb5GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#emgb5Elevate)"></rect>
            <text x="865" y="65" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">القادح</text>
            <text x="865" y="82" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Trigger</text>
          </g>

          <g class="hotspot" data-component="pulseGenerator" tabindex="0" role="button" aria-label="مولد نبضة التحفيز">
            <rect class="box-shape" x="600" y="40" width="150" height="60" rx="10" fill="url(#emgb5GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#emgb5Elevate)"></rect>
            <text x="675" y="63" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مولد نبضة التحفيز</text>
            <text x="675" y="82" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Pulse Generator</text>
          </g>

          <!-- patient hand with surface electrodes -->
          <g class="hotspot" data-component="handElectrode" tabindex="0" role="button" aria-label="اليد وأقطاب السطح">
            <rect class="hit-area" x="290" y="140" width="150" height="140" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 300,270 Q 300,200 340,175 Q 360,160 400,165 L 420,175 L 415,195 Q 400,190 385,195 Q 400,205 405,220 L 400,235 Q 385,225 375,215 L 375,270 Z" fill="url(#emgb5GradRose)" stroke="#FB7185" stroke-width="2.2" filter="url(#emgb5Elevate)"></path>
            <circle cx="365" cy="185" r="4.5" fill="#F43F5E" filter="url(#emgb5Glow)"></circle>
            <circle cx="345" cy="225" r="4.5" fill="#F43F5E" filter="url(#emgb5Glow)"></circle>
            <text x="355" y="140" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">اليد</text>
            <text x="355" y="156" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FB7185" text-anchor="middle" direction="ltr">Hand</text>
            <text x="230" y="215" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FB7185" text-anchor="middle" direction="rtl">قطب سطح الجسم</text>
            <text x="230" y="230" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#FB7185" text-anchor="middle" direction="ltr">Surface Electrode</text>
          </g>

          <!-- earth ground reference -->
          <g class="hotspot" data-component="earth" tabindex="0" role="button" aria-label="أرضي">
            <rect class="hit-area" x="120" y="160" width="90" height="80" fill="#000" fill-opacity="0"></rect>
            <line class="box-shape" x1="165" y1="185" x2="165" y2="215" stroke="#9aa4bd" stroke-width="2.5" filter="url(#emgb5Glow)"></line>
            <line class="box-shape" x1="145" y1="215" x2="185" y2="215" stroke="#9aa4bd" stroke-width="3" filter="url(#emgb5Glow)"></line>
            <line class="box-shape" x1="153" y1="223" x2="177" y2="223" stroke="#9aa4bd" stroke-width="2.5" filter="url(#emgb5Glow)"></line>
            <line class="box-shape" x1="160" y1="230" x2="170" y2="230" stroke="#9aa4bd" stroke-width="2" filter="url(#emgb5Glow)"></line>
            <text x="165" y="175" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#9aa4bd" text-anchor="middle" direction="rtl">أرضي</text>
            <text x="165" y="248" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#9aa4bd" text-anchor="middle" direction="ltr">Earth</text>
          </g>

          <!-- visual/recording chain -->
          <g class="hotspot" data-component="amplifier" tabindex="0" role="button" aria-label="المكبر">
            <path class="box-shape" d="M 460,205 L 460,265 L 525,235 Z" fill="url(#emgb5GradOrange)" stroke="#FB923C" stroke-width="2.2" filter="url(#emgb5Elevate)"></path>
            <text x="480" y="240" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="ltr">AMP.</text>
          </g>

          <g class="hotspot" data-component="oscilloscope" tabindex="0" role="button" aria-label="راسم الأشارة">
            <rect class="box-shape" x="575" y="200" width="130" height="70" rx="10" fill="url(#emgb5GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#emgb5Elevate)"></rect>
            <text x="640" y="228" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">راسم الأشارة</text>
            <text x="640" y="246" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Oscilloscope</text>
            <polyline points="600,258 612,250 622,262 632,246 644,258 656,252 668,258" fill="none" stroke="#38BDF8" stroke-width="1.5"></polyline>
          </g>

          <g class="hotspot" data-component="camera" tabindex="0" role="button" aria-label="الكاميرا">
            <rect class="box-shape" x="745" y="200" width="130" height="70" rx="10" fill="url(#emgb5GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#emgb5Elevate)"></rect>
            <text x="810" y="228" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الكاميرا</text>
            <text x="810" y="246" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Camera</text>
            <circle cx="810" cy="258" r="6" fill="none" stroke="#C084FC" stroke-width="1.5"></circle>
          </g>

          <!-- audio monitoring chain -->
          <g class="hotspot" data-component="audioAmp" tabindex="0" role="button" aria-label="المكبر الصوتي">
            <rect class="box-shape" x="575" y="330" width="140" height="65" rx="10" fill="url(#emgb5GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#emgb5Elevate)"></rect>
            <text x="645" y="357" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المكبر الصوتي</text>
            <text x="645" y="375" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">Audio Amp.</text>
          </g>

          <g class="hotspot" data-component="speaker" tabindex="0" role="button" aria-label="سماعة الاذن والسماعة الخارجية">
            <rect class="hit-area" x="755" y="325" width="145" height="75" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 780,360 L 795,360 L 815,345 L 815,395 L 795,380 L 780,380 Z" fill="url(#emgb5GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#emgb5Elevate)"></path>
            <path d="M 825,350 Q 835,362 825,374" fill="none" stroke="#C084FC" stroke-width="2"></path>
            <path d="M 835,342 Q 852,362 835,382" fill="none" stroke="#C084FC" stroke-width="2"></path>
            <text x="860" y="358" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">سماعة</text>
            <text x="860" y="374" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Speaker</text>
          </g>

          <!-- connections -->
          <g class="link" data-link="trigger" data-link-to="pulseGenerator">
            <line x1="800" y1="70" x2="750" y2="70" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></line>
            <line class="trail trail-green" x1="798" y1="70" x2="752" y2="70" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="pulseGenerator" data-link-to="handElectrode">
            <path d="M 600,70 L 440,70 L 440,175 L 420,180" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></path>
            <path class="trail trail-yellow" d="M 598,70 L 440,70 L 440,175 L 422,180" fill="none" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="earth" data-link-to="handElectrode">
            <path d="M 165,185 L 165,160 L 310,160 L 310,190" fill="none" stroke="#5b6478" stroke-width="2"></path>
            <path class="trail" style="stroke:#9aa4bd" d="M 165,183 L 165,158 L 310,158 L 310,188" fill="none" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="handElectrode" data-link-to="amplifier">
            <line x1="415" y1="235" x2="460" y2="235" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></line>
            <line class="trail trail-rose" x1="415" y1="235" x2="458" y2="235" stroke="#FB7185" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="amplifier" data-link-to="oscilloscope">
            <line x1="525" y1="235" x2="575" y2="235" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></line>
            <line class="trail trail-orange" x1="527" y1="235" x2="573" y2="235" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="oscilloscope" data-link-to="camera">
            <line x1="705" y1="235" x2="745" y2="235" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></line>
            <line class="trail trail-blue" x1="707" y1="235" x2="743" y2="235" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="handElectrode" data-link-to="audioAmp">
            <path d="M 400,280 L 400,362 L 575,362" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></path>
            <path class="trail trail-rose" d="M 400,280 L 400,362 L 573,362" fill="none" stroke="#FB7185" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="audioAmp" data-link-to="speaker">
            <line x1="715" y1="362" x2="755" y2="362" stroke="#5b6478" stroke-width="2" marker-end="url(#emgb5-arrow)"></line>
            <line class="trail trail-orange" x1="717" y1="362" x2="753" y2="362" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="800" cy="70" r="5" fill="#4ADE80" filter="url(#emgb5Glow)" style="--tx:-44px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="596" cy="70" r="5" fill="#FBBF24" filter="url(#emgb5Glow)" style="--tx:-140px; --ty:0px; --particle-delay:0.6s; --particle-duration:0.55s"></circle>
            <circle class="flow-particle" cx="440" cy="170" r="5" fill="#FBBF24" filter="url(#emgb5Glow)" style="--tx:-22px; --ty:15px; --particle-delay:1.15s; --particle-duration:0.3s"></circle>
            <circle class="flow-particle" cx="415" cy="235" r="5" fill="#FB7185" filter="url(#emgb5Glow)" style="--tx:40px; --ty:0px; --particle-delay:1.7s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="525" cy="235" r="5" fill="#FB923C" filter="url(#emgb5Glow)" style="--tx:45px; --ty:0px; --particle-delay:2.2s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="705" cy="235" r="5" fill="#38BDF8" filter="url(#emgb5Glow)" style="--tx:35px; --ty:0px; --particle-delay:2.7s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="400" cy="300" r="5" fill="#FB7185" filter="url(#emgb5Glow)" style="--tx:0px; --ty:55px; --particle-delay:3.2s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="715" cy="362" r="5" fill="#FB923C" filter="url(#emgb5Glow)" style="--tx:35px; --ty:0px; --particle-delay:4s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="trigger"><span class="status-dot dot-green"></span><span class="status-label">القادح</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="pulseGenerator"><span class="status-dot dot-yellow"></span><span class="status-label">مولد نبضة التحفيز</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يحفز</span></span></li>
          <li class="status-row" data-status="handElectrode"><span class="status-dot" style="background:#FB7185"></span><span class="status-label">اليد وأقطاب السطح</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يتحسس</span></span></li>
          <li class="status-row" data-status="earth"><span class="status-dot" style="background:#9aa4bd"></span><span class="status-label">أرضي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">مرجع</span></span></li>
          <li class="status-row" data-status="amplifier"><span class="status-dot dot-orange"></span><span class="status-label">المكبر</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="oscilloscope"><span class="status-dot dot-blue"></span><span class="status-label">راسم الأشارة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يعرض</span></span></li>
          <li class="status-row" data-status="camera"><span class="status-dot dot-purple"></span><span class="status-label">الكاميرا</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يسجل</span></span></li>
          <li class="status-row" data-status="audioAmp"><span class="status-dot dot-orange"></span><span class="status-label">المكبر الصوتي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="speaker"><span class="status-dot dot-purple"></span><span class="status-label">السماعة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">يصدر صوت</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مرحلة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>التحكم والقدح</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>نبضة التحفيز</li>
      <li class="legend-item"><span class="legend-swatch" style="background:#FB7185"></span>الإشارة الحيوية</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>التكبير</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>العرض</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>التسجيل والصوت</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
