---
// Redesigned Figure 2-29 (المخطط الكتلوي لجهاز مراقبة الولادة /
// Delivery Monitor) using the Chapter 1 dark neumorphic simulator
// system. Last of the 21 Chapter 2 diagrams converted; reuses the
// shared shell/controller (src/styles/diagram-simulator.css +
// src/scripts/diagramSimulator.js).
//
// Geometry unchanged (all block positions/sizes, connection paths, the
// two symmetric channels, paper roll + motor, all labels identical to
// the prior build) — only fill/stroke treatment and the interaction/
// animation layer changed. Each of the source's own 10 numbered parts
// becomes its own hotspot (the two channels share the same per-stage
// color, since they are literally the same circuit duplicated).
//
// Color mapping: a signal-flow block diagram — green for the shared
// crystal oscillator, yellow for the two probes, orange for the HF
// amplifiers and power amplifiers, blue for the detectors, purple for
// the filters, cyan for the mixers, indigo for the integrator sets,
// white for the speaker branch, yellow for the paper/motor recorder.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft delivery-monitor-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة جهاز مراقبة الولادة</span>
      <span class="simulator-subtitle">شكل 2-29 — قناتا التقلصات ونبض الجنين</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="delivery-monitor-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="1000"
          height="480"
          viewBox="0 0 1000 480"
          role="img"
          aria-label="المخطط الكتلوي لجهاز مراقبة الولادة"
        >
          <defs>
            <marker id="dv-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="dvBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="dvGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="dvGradGreen" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>
            <linearGradient id="dvGradYellow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332c10"></stop>
              <stop offset="100%" stop-color="#1a1608"></stop>
            </linearGradient>
            <linearGradient id="dvGradOrange" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332210"></stop>
              <stop offset="100%" stop-color="#1a1108"></stop>
            </linearGradient>
            <linearGradient id="dvGradBlue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="dvGradPurple" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </linearGradient>
            <linearGradient id="dvGradCyan" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0c2e33"></stop>
              <stop offset="100%" stop-color="#06181b"></stop>
            </linearGradient>
            <linearGradient id="dvGradIndigo" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1e1f3d"></stop>
              <stop offset="100%" stop-color="#100f22"></stop>
            </linearGradient>

            <filter id="dvElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.55" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="dvGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="1000" height="480" rx="20" fill="url(#dvBgGrad)"></rect>
          <rect x="0" y="0" width="1000" height="480" rx="20" fill="url(#dvGrid)"></rect>

          <!-- shared oscillator + probes -->
          <g class="hotspot" data-component="oscillator" tabindex="0" role="button" aria-label="المذبذب البلوري">
            <rect class="box-shape" x="20" y="210" width="100" height="60" rx="10" fill="url(#dvGradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#dvElevate)"></rect>
            <text x="70" y="235" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المذبذب البلوري</text>
            <text x="70" y="252" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">2.3MHz</text>
          </g>

          <g class="hotspot" data-component="probe1" tabindex="0" role="button" aria-label="مجس 1 — تقلصات الرحم">
            <rect class="box-shape" x="150" y="90" width="80" height="45" rx="10" fill="url(#dvGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#dvElevate)"></rect>
            <text x="190" y="118" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="rtl">مجس 1</text>
          </g>

          <g class="hotspot" data-component="probe2" tabindex="0" role="button" aria-label="مجس 2 — نبض الجنين">
            <rect class="box-shape" x="150" y="335" width="80" height="45" rx="10" fill="url(#dvGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#dvElevate)"></rect>
            <text x="190" y="363" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="rtl">مجس 2</text>
          </g>

          <!-- top channel: contractions -->
          <g>
            <g class="hotspot" data-component="ampTop" tabindex="0" role="button" aria-label="مكبر تردد عالي — تقلصات">
              <rect class="box-shape" x="270" y="90" width="80" height="45" rx="10" fill="url(#dvGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="310" y="117" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مكبر تردد عالي</text>
            </g>
            <g class="hotspot" data-component="detectorTop" tabindex="0" role="button" aria-label="كاشف — تقلصات">
              <rect class="box-shape" x="380" y="90" width="80" height="45" rx="10" fill="url(#dvGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="420" y="117" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">كاشف</text>
            </g>
            <g class="hotspot" data-component="filterTop" tabindex="0" role="button" aria-label="مرشح — تقلصات">
              <rect class="box-shape" x="490" y="90" width="80" height="45" rx="10" fill="url(#dvGradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="530" y="117" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مرشح</text>
            </g>
            <g class="hotspot" data-component="mixerTop" tabindex="0" role="button" aria-label="مازج — تقلصات">
              <rect class="box-shape" x="600" y="90" width="80" height="45" rx="10" fill="url(#dvGradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="640" y="117" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مازج</text>
            </g>
            <g class="hotspot" data-component="integralTop" tabindex="0" role="button" aria-label="مجموعة المكامل — تقلصات">
              <rect class="box-shape" x="710" y="90" width="90" height="45" rx="10" fill="url(#dvGradIndigo)" stroke="#818CF8" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="755" y="117" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مجموعة المكامل</text>
            </g>
            <g class="hotspot" data-component="powerTop" tabindex="0" role="button" aria-label="مكبر قدرة — تقلصات">
              <rect class="box-shape" x="830" y="90" width="80" height="45" rx="10" fill="url(#dvGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="870" y="117" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مكبر قدرة</text>
            </g>

            <g class="link" data-link="probe1" data-link-to="ampTop">
              <line x1="230" y1="112" x2="270" y2="112" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-yellow" x1="230" y1="112" x2="268" y2="112" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="ampTop" data-link-to="detectorTop">
              <line x1="350" y1="112" x2="380" y2="112" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-orange" x1="350" y1="112" x2="378" y2="112" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="detectorTop" data-link-to="filterTop">
              <line x1="460" y1="112" x2="490" y2="112" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-blue" x1="460" y1="112" x2="488" y2="112" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="filterTop" data-link-to="mixerTop">
              <line x1="570" y1="112" x2="600" y2="112" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-purple" x1="570" y1="112" x2="598" y2="112" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="mixerTop" data-link-to="integralTop">
              <line x1="680" y1="112" x2="710" y2="112" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail" x1="680" y1="112" x2="708" y2="112" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="integralTop" data-link-to="powerTop">
              <line x1="800" y1="112" x2="830" y2="112" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail" x1="800" y1="112" x2="828" y2="112" stroke="#818CF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
          </g>

          <!-- bottom channel: fetal heart rate -->
          <g>
            <g class="hotspot" data-component="ampBottom" tabindex="0" role="button" aria-label="مكبر تردد عالي — نبض الجنين">
              <rect class="box-shape" x="270" y="335" width="80" height="45" rx="10" fill="url(#dvGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="310" y="362" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مكبر تردد عالي</text>
            </g>
            <g class="hotspot" data-component="detectorBottom" tabindex="0" role="button" aria-label="كاشف — نبض الجنين">
              <rect class="box-shape" x="380" y="335" width="80" height="45" rx="10" fill="url(#dvGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="420" y="362" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">كاشف</text>
            </g>
            <g class="hotspot" data-component="filterBottom" tabindex="0" role="button" aria-label="مرشح — نبض الجنين">
              <rect class="box-shape" x="490" y="335" width="80" height="45" rx="10" fill="url(#dvGradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="530" y="362" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مرشح</text>
            </g>

            <g class="hotspot" data-component="speakerBranch" tabindex="0" role="button" aria-label="سماعة / مجهر صوتي">
              <rect class="hit-area" x="480" y="405" width="100" height="80" fill="#000" fill-opacity="0"></rect>
              <path class="box-shape" d="M 490,410 L 490,450 L 530,430 Z" fill="#332c10" stroke="#eef1f8" stroke-width="2" filter="url(#dvElevate)"></path>
              <path class="box-shape" d="M 560,420 l -20,10 v20 l 20,10 z" fill="#332c10" stroke="#eef1f8" stroke-width="1.5" filter="url(#dvElevate)"></path>
              <text x="530" y="475" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">سماعة / مجهر</text>
            </g>

            <g class="hotspot" data-component="mixerBottom" tabindex="0" role="button" aria-label="مازج — نبض الجنين">
              <rect class="box-shape" x="600" y="335" width="80" height="45" rx="10" fill="url(#dvGradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="640" y="362" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مازج</text>
            </g>
            <g class="hotspot" data-component="integralBottom" tabindex="0" role="button" aria-label="مجموعة المكامل — نبض الجنين">
              <rect class="box-shape" x="710" y="335" width="90" height="45" rx="10" fill="url(#dvGradIndigo)" stroke="#818CF8" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="755" y="362" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مجموعة المكامل</text>
            </g>
            <g class="hotspot" data-component="powerBottom" tabindex="0" role="button" aria-label="مكبر قدرة — نبض الجنين">
              <rect class="box-shape" x="830" y="335" width="80" height="45" rx="10" fill="url(#dvGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#dvElevate)"></rect>
              <text x="870" y="362" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مكبر قدرة</text>
            </g>

            <g class="link" data-link="probe2" data-link-to="ampBottom">
              <line x1="230" y1="357" x2="270" y2="357" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-yellow" x1="230" y1="357" x2="268" y2="357" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="ampBottom" data-link-to="detectorBottom">
              <line x1="350" y1="357" x2="380" y2="357" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-orange" x1="350" y1="357" x2="378" y2="357" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="detectorBottom" data-link-to="filterBottom">
              <line x1="460" y1="357" x2="490" y2="357" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-blue" x1="460" y1="357" x2="488" y2="357" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="filterBottom" data-link-to="speakerBranch">
              <line x1="510" y1="380" x2="510" y2="410" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-purple" x1="510" y1="380" x2="510" y2="408" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="filterBottom" data-link-to="mixerBottom">
              <line x1="570" y1="357" x2="600" y2="357" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail trail-purple" x1="570" y1="357" x2="598" y2="357" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="mixerBottom" data-link-to="integralBottom">
              <line x1="680" y1="357" x2="710" y2="357" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail" x1="680" y1="357" x2="708" y2="357" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
            <g class="link" data-link="integralBottom" data-link-to="powerBottom">
              <line x1="800" y1="357" x2="830" y2="357" stroke="#5b6478" stroke-width="2" marker-end="url(#dv-arrow)"></line>
              <line class="trail" x1="800" y1="357" x2="828" y2="357" stroke="#818CF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            </g>
          </g>

          <!-- oscillator to both probes and both detectors -->
          <g class="link" data-link="oscillator" data-link-to="probe1">
            <line x1="120" y1="230" x2="190" y2="230" stroke="#5b6478" stroke-width="1.5"></line>
            <line x1="190" y1="230" x2="190" y2="135" stroke="#5b6478" stroke-width="1.5" marker-end="url(#dv-arrow)"></line>
            <path class="trail trail-green" d="M 120,230 L 190,230 L 190,137" fill="none" stroke="#4ADE80" stroke-width="2" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="oscillator" data-link-to="probe2">
            <line x1="190" y1="230" x2="190" y2="335" stroke="#5b6478" stroke-width="1.5" marker-end="url(#dv-arrow)"></line>
            <path class="trail trail-green" d="M 190,232 L 190,333" fill="none" stroke="#4ADE80" stroke-width="2" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="oscillator" data-link-to="detectorTop">
            <line x1="120" y1="240" x2="420" y2="240" stroke="#5b6478" stroke-width="1.2" stroke-dasharray="3 3"></line>
            <line x1="420" y1="240" x2="420" y2="90" stroke="#5b6478" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#dv-arrow)"></line>
          </g>
          <g class="link" data-link="oscillator" data-link-to="detectorBottom">
            <line x1="420" y1="240" x2="420" y2="335" stroke="#5b6478" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#dv-arrow)"></line>
          </g>

          <!-- pens + paper roll + motor -->
          <g class="hotspot" data-component="recorder" tabindex="0" role="button" aria-label="ورق التسجيل والمحرك">
            <rect class="hit-area" x="860" y="120" width="130" height="220" fill="#000" fill-opacity="0"></rect>
            <rect class="box-shape" x="920" y="200" width="18" height="80" rx="3" fill="#332c10" stroke="#FBBF24" stroke-width="2" filter="url(#dvElevate)"></rect>
            <text x="929" y="195" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="rtl">ورق</text>
            <line x1="870" y1="135" x2="929" y2="200" stroke="#8b94aa" stroke-width="1.5" marker-end="url(#dv-arrow)"></line>
            <line x1="870" y1="380" x2="929" y2="280" stroke="#8b94aa" stroke-width="1.5" marker-end="url(#dv-arrow)"></line>
            <circle class="box-shape" cx="960" cy="240" r="20" fill="#332c10" stroke="#FBBF24" stroke-width="2" filter="url(#dvElevate)"></circle>
            <text x="960" y="245" font-family="Cairo, sans-serif" font-size="12" font-weight="800" fill="#FBBF24" text-anchor="middle" direction="ltr">M</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle p-t1" cx="230" cy="112" r="5" fill="#FBBF24" filter="url(#dvGlow)" style="--tx:40px; --ty:0px; --particle-delay:0.5s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-t2" cx="350" cy="112" r="5" fill="#FB923C" filter="url(#dvGlow)" style="--tx:30px; --ty:0px; --particle-delay:1.0s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-t3" cx="460" cy="112" r="5" fill="#38BDF8" filter="url(#dvGlow)" style="--tx:30px; --ty:0px; --particle-delay:1.5s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle p-t4" cx="570" cy="112" r="5" fill="#C084FC" filter="url(#dvGlow)" style="--tx:30px; --ty:0px; --particle-delay:2.0s; --particle-duration:0.4s"></circle>
