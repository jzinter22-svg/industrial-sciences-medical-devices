---
// Animated Figure 1-6 (بعض أنواع المؤقتات).
//
// The source figure is a photo collage of three real devices (page 14 /
// PDF index 13), so pixel-photographic reproduction isn't the goal —
// instead each icon was redrawn with the distinguishing features visible
// in that device's own photo, rather than a generic placeholder shape:
// the mechanical timer gets its dial tick marks, pointer and status LED
// (its photo is a white body with a graduated clock-face dial); the
// synchronous timer gets a cylindrical motor body with a wound-coil
// texture, a drive gear, and two lead wires (its photo is a brass
// cylindrical motor with visible gear teeth and wires) instead of the
// previous abstract 8-spoke asterisk, which read as a compass/fan and
// didn't communicate "motor"; the digital timer keeps its LCD readout
// and gains a small keypad grid (its photo is a keypad digital timer).
//
// Comparison of three device types, not a single process — each icon
// keeps the one motion that explains its own operating principle: the
// mechanical dial's hand sweeps, the synchronous motor's rotor spins,
// the digital display's reading pulses. Level 2 — restrained, no card
// interaction.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram timer-types-diagram">
  <div class="diagram-block-image">
    <svg
      class="timer-types-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="780"
      height="300"
      viewBox="0 0 780 300"
      role="img"
      aria-label="بعض أنواع المؤقتات"
    >
      <defs>
        <marker id="arrow-tt" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="780" height="300" fill="none"></rect>

      <!-- Mechanical timer: dial with tick marks, pointer, status LED -->
      <rect x="60" y="40" width="180" height="140" rx="14" fill="#f1f5f9" stroke="#263238" stroke-width="2"></rect>
      <circle cx="150" cy="105" r="45" fill="#fff" stroke="#263238" stroke-width="3"></circle>
      <g stroke="#263238" stroke-width="2">
        <line x1="150" y1="64" x2="150" y2="72" />
        <line x1="189" y1="105" x2="181" y2="105" />
        <line x1="150" y1="146" x2="150" y2="138" />
        <line x1="111" y1="105" x2="119" y2="105" />
        <line x1="177.6" y1="77.4" x2="172" y2="83" />
        <line x1="177.6" y1="132.6" x2="172" y2="127" />
        <line x1="122.4" y1="132.6" x2="128" y2="127" />
        <line x1="122.4" y1="77.4" x2="128" y2="83" />
      </g>
      <circle cx="205" cy="55" r="5" fill="#dc2626"></circle>
      <g class="dial-hand-group" style="transform-origin: 150px 105px;">
        <line x1="150" y1="105" x2="150" y2="70" stroke="#263238" stroke-width="3"></line>
        <line x1="150" y1="105" x2="175" y2="115" stroke="#263238" stroke-width="3"></line>
      </g>
      <circle cx="150" cy="105" r="4" fill="#263238"></circle>
      <text x="150" y="210" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مؤقت ميكانيكي</text>

      <!-- Synchronous timer: cylindrical motor, wound-coil texture, drive gear, leads -->
      <rect x="300" y="40" width="180" height="140" rx="14" fill="#f1f5f9" stroke="#263238" stroke-width="2"></rect>
      <line x1="345" y1="90" x2="330" y2="78" stroke="#57606f" stroke-width="2"></line>
      <line x1="345" y1="120" x2="330" y2="132" stroke="#57606f" stroke-width="2"></line>
      <rect x="345" y="80" width="60" height="50" rx="4" fill="#eab308" stroke="#263238" stroke-width="2.5"></rect>
      <line x1="357" y1="80" x2="357" y2="130" stroke="#a16207" stroke-width="1.5"></line>
      <line x1="369" y1="80" x2="369" y2="130" stroke="#a16207" stroke-width="1.5"></line>
      <line x1="381" y1="80" x2="381" y2="130" stroke="#a16207" stroke-width="1.5"></line>
      <line x1="393" y1="80" x2="393" y2="130" stroke="#a16207" stroke-width="1.5"></line>
      <g class="motor-rotor-group" style="transform-origin: 435px 105px;">
        <circle cx="435" cy="105" r="24" fill="#fde68a" stroke="#263238" stroke-width="2.5"></circle>
        <path d="M 435,81 L 439,73 L 443,81 M 459,105 L 467,101 L 467,109 M 435,129 L 439,137 L 431,137 M 411,105 L 403,109 L 403,101 M 452,88 L 460,82 L 456,90 M 452,122 L 460,128 L 456,120 M 418,122 L 410,128 L 414,120 M 418,88 L 410,82 L 414,90" fill="#263238"></path>
        <circle cx="435" cy="105" r="6" fill="#263238"></circle>
      </g>
      <text x="390" y="210" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مؤقت تزامني</text>

      <!-- Digital timer: LCD readout + keypad -->
      <rect x="540" y="40" width="180" height="140" rx="14" fill="#f1f5f9" stroke="#263238" stroke-width="2"></rect>
      <rect x="565" y="52" width="130" height="42" rx="4" fill="#0f172a" stroke="#263238" stroke-width="2"></rect>
      <text class="digital-readout" x="630" y="80" font-family="Cairo, sans-serif" font-size="18" font-weight="700" fill="#4ade80" text-anchor="middle" direction="ltr">45:30</text>
      <g fill="#334155" stroke="#263238" stroke-width="1">
        <rect x="567" y="100" width="18" height="14" rx="2"></rect>
        <rect x="589" y="100" width="18" height="14" rx="2"></rect>
        <rect x="611" y="100" width="18" height="14" rx="2"></rect>
        <rect x="633" y="100" width="18" height="14" rx="2"></rect>
        <rect x="655" y="100" width="18" height="14" rx="2"></rect>
        <rect x="567" y="118" width="18" height="14" rx="2"></rect>
        <rect x="589" y="118" width="18" height="14" rx="2"></rect>
        <rect x="611" y="118" width="18" height="14" rx="2"></rect>
        <rect x="633" y="118" width="18" height="14" rx="2"></rect>
        <rect x="655" y="118" width="18" height="14" rx="2"></rect>
      </g>
      <text x="630" y="210" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مؤقتات الكترونية - رقمية</text>

      <g aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.6s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .timer-types-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .dial-hand-group,
  .motor-rotor-group {
    transform-box: view-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes dial-sweep {
      0%,
      100% {
        transform: rotate(0deg);
      }
      80% {
        transform: rotate(300deg);
      }
    }

    .playing .dial-hand-group {
      animation: dial-sweep 2.2s ease-in-out 0.2s;
    }

    @keyframes rotor-spin {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    .playing .motor-rotor-group {
      animation: rotor-spin 1.6s linear 0.2s 1;
    }

    @keyframes readout-pulse {
      0%,
      100% {
        opacity: 1;
      }
      25%,
      75% {
        opacity: 0.35;
      }
    }

    .playing .digital-readout {
      animation: readout-pulse 0.6s ease-in-out 0.2s 3;
    }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".timer-types-diagram");
</script>
