---
// Figure 8-6 (عملية قطع النسيج) — the Cut process as a 4-stage
// animated sequence: electrode touches tissue -> a small continuous-RF
// spark forms -> cellular water flashes to steam -> the tissue separates
// (cut). Each stage is a hotspot so a student can also click through them
// individually, but Play traces the whole physical sequence in order,
// which is the actual educational point of this figure (cause -> process
// -> result, per the "Cutting" caption pair in the source: a = waveform,
// b = mechanism).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft electrosurgery-cutting-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة عملية القطع بالجراحة الكهربائية</span>
      <span class="simulator-subtitle">شكل 8-6 — من ملامسة القطب إلى انفصال النسيج</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es6-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="700"
          height="360"
          viewBox="0 0 700 360"
          role="img"
          aria-label="عملية قطع النسيج"
        >
          <defs>
            <linearGradient id="es6BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es6Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es6GradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1414"></stop><stop offset="100%" stop-color="#1a0a0a"></stop></linearGradient>
            <linearGradient id="es6GradTissue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2419"></stop><stop offset="100%" stop-color="#1a120c"></stop></linearGradient>

            <filter id="es6Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es6Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="700" height="360" rx="20" fill="url(#es6BgGrad)"></rect>
          <rect x="0" y="0" width="700" height="360" rx="20" fill="url(#es6Grid)"></rect>

          <text x="350" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">عملية قطع النسيج بالقطب الفعال</text>

          <!-- Electrode -->
          <g class="hotspot" data-component="electrode" tabindex="0" role="button" aria-label="القطب">
            <rect class="box-shape" x="326" y="60" width="48" height="90" rx="8" fill="url(#es6GradRed)" stroke="#EF4444" stroke-width="2" filter="url(#es6Elevate)"></rect>
            <line x1="350" y1="150" x2="350" y2="188" stroke="#EF4444" stroke-width="4" stroke-linecap="round"></line>
            <text x="350" y="99" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">القطب</text>
            <text x="350" y="114" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7.5" font-weight="700" fill="#EF4444" direction="ltr">Electrode</text>
          </g>

          <!-- Tissue block, split down the middle to reveal the cut -->
          <g class="hotspot" data-component="tissue" tabindex="0" role="button" aria-label="النسيج">
            <path class="tissue-left" d="M 150,225 L 340,225 L 340,320 L 150,320 Z" fill="url(#es6GradTissue)" stroke="#8a6b4a" stroke-width="1.5"></path>
            <path class="tissue-right" d="M 360,225 L 550,225 L 550,320 L 360,320 Z" fill="url(#es6GradTissue)" stroke="#8a6b4a" stroke-width="1.5"></path>
            <text x="350" y="345" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">النسيج</text>
          </g>

          <!-- Spark at contact point -->
          <g class="spark-group" aria-hidden="true">
            <path d="M 335,205 L 350,222 L 365,205" fill="none" stroke="#FFE08A" stroke-width="2.4" stroke-linecap="round"></path>
            <path d="M 340,196 L 350,214 L 360,196" fill="none" stroke="#FFE08A" stroke-width="1.6" stroke-linecap="round" opacity="0.7"></path>
          </g>

          <!-- Steam wisps -->
          <g class="steam-group" aria-hidden="true">
            <path class="steam-wisp steam-1" d="M 330,215 q -8,-14 0,-26 q 8,-12 0,-24" fill="none" stroke="#c9d3e8" stroke-width="2.4" stroke-linecap="round" opacity="0.8"></path>
            <path class="steam-wisp steam-2" d="M 350,215 q 8,-14 0,-26 q -8,-12 0,-24" fill="none" stroke="#c9d3e8" stroke-width="2.4" stroke-linecap="round" opacity="0.8"></path>
            <path class="steam-wisp steam-3" d="M 370,215 q -6,-14 2,-26 q 8,-12 -2,-24" fill="none" stroke="#c9d3e8" stroke-width="2.4" stroke-linecap="round" opacity="0.8"></path>
          </g>

          <text x="605" y="270" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">تبخّر الماء الخلوي</text>
          <text x="605" y="288" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">يُدمّر الخلايا فورا</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">مراحل القطع</h3>
        <ul class="status-list">
          <li class="status-row" data-status="electrode"><span class="status-dot dot-red"></span><span class="status-label">القطب</span><span class="status-value"><span class="value-off">بارد</span><span class="value-on">تيار RF مستمر</span></span></li>
          <li class="status-row" data-status="spark"><span class="status-dot dot-yellow"></span><span class="status-label">الشرارة</span><span class="status-value"><span class="value-off">لا توجد</span><span class="value-on">مستمرة</span></span></li>
          <li class="status-row" data-status="steam"><span class="status-dot dot-blue"></span><span class="status-label">تبخر الماء</span><span class="status-value"><span class="value-off">لا يوجد</span><span class="value-on">سريع</span></span></li>
          <li class="status-row" data-status="tissue"><span class="status-dot dot-orange"></span><span class="status-label">النسيج</span><span class="status-value"><span class="value-off">متصل</span><span class="value-on">مقطوع</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على القطب أو النسيج لعرض شرحهما</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>القطب</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>الشرارة</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>البخار</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#es6Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es6Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .spark-group, .steam-group { opacity: 0; }
  .tissue-left, .tissue-right {
    transition: transform 0.6s ease;
    transform-box: fill-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es6-shape-activate { to { filter: url(#es6Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es6-status-value-on { to { opacity: 1; } }
    @keyframes es6-status-value-off { to { opacity: 0; } }
    @keyframes es6-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes es6-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes es6-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes es6-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes es6-spark-flicker {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }
    @keyframes es6-steam-rise {
      0% { opacity: 0; transform: translateY(0); }
      20% { opacity: 0.9; }
      100% { opacity: 0; transform: translateY(-16px); }
    }
    @keyframes es6-tissue-split-left { to { transform: translateX(-10px); } }
    @keyframes es6-tissue-split-right { to { transform: translateX(10px); } }

    .playing [data-component="electrode"] .box-shape { animation: es6-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="electrode"] .status-dot { animation: es6-dot-on-red 0.4s ease-out 0.1s forwards; }
    .playing [data-status="electrode"] .value-on { animation: es6-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="electrode"] .value-off { animation: es6-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing .spark-group { animation: es6-spark-flicker 0.35s ease-in-out 0.7s infinite; }
    .playing [data-status="spark"] .status-dot { animation: es6-dot-on-yellow 0.4s ease-out 0.7s forwards; }
    .playing [data-status="spark"] .value-on { animation: es6-status-value-on 0.4s ease-out 0.7s forwards; }
    .playing [data-status="spark"] .value-off { animation: es6-status-value-off 0.4s ease-out 0.7s forwards; }

    .playing .steam-wisp.steam-1 { animation: es6-steam-rise 1.1s ease-out 1.3s infinite; }
    .playing .steam-wisp.steam-2 { animation: es6-steam-rise 1.1s ease-out 1.55s infinite; }
    .playing .steam-wisp.steam-3 { animation: es6-steam-rise 1.1s ease-out 1.8s infinite; }
    .playing .steam-group { opacity: 1; }
    .playing [data-status="steam"] .status-dot { animation: es6-dot-on-blue 0.4s ease-out 1.3s forwards; }
    .playing [data-status="steam"] .value-on { animation: es6-status-value-on 0.4s ease-out 1.3s forwards; }
    .playing [data-status="steam"] .value-off { animation: es6-status-value-off 0.4s ease-out 1.3s forwards; }

    .playing [data-component="tissue"] .box-shape { animation: es6-shape-activate 0.4s ease-out 2.6s forwards; }
    .playing .tissue-left { animation: es6-tissue-split-left 0.5s ease-out 2.6s forwards; }
    .playing .tissue-right { animation: es6-tissue-split-right 0.5s ease-out 2.6s forwards; }
    .playing [data-status="tissue"] .status-dot { animation: es6-dot-on-orange 0.4s ease-out 2.6s forwards; }
    .playing [data-status="tissue"] .value-on { animation: es6-status-value-on 0.4s ease-out 2.6s forwards; }
    .playing [data-status="tissue"] .value-off { animation: es6-status-value-off 0.4s ease-out 2.6s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    electrode: {
      title: "القطب (Electrode)",
      text: "يحمل تيارا مستمرا عالي التردد (RF)، ويتماس مع النسيج ليبدأ عملية القطع.",
    },
    tissue: {
      title: "النسيج (Tissue)",
      text: "الحرارة الناتجة عن الشرارة وعن مرور التيار خلال النسيج تعملان معا على تبخّر الماء الخلوي بسرعة، مما يسبب تدميرا لحظيا للخلايا وانفصال النسيج (القطع).",
    },
  };

  wireDiagramSimulator(".electrosurgery-cutting-diagram", { cycleMs: 3800, componentInfo: COMPONENT_INFO });
</script>
