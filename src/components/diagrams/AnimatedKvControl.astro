---
// Animated Figure 1-3 (السيطرة على kV). Markup matches
// diagram-03-kv-control.svg exactly (same viewBox/positions/colors/
// labels); only class hooks + an additive particle/marker layer were
// added. Teaches: current enters the autotransformer's single winding,
// the kV-select tap draws off a variable point on that winding, and the
// tapped voltage feeds the secondary output rails. Level 2 — one clear
// pass, no card interaction.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram kv-diagram">
  <div class="diagram-block-image">
    <svg
      class="kv-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="640"
      height="340"
      viewBox="0 0 640 340"
      role="img"
      aria-label="السيطرة على kV"
    >
      <defs>
        <marker id="arrow-kv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="640" height="340" fill="none"></rect>
      <text x="90" y="150" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهز القدرة</text>
      <text x="90" y="170" font-family="Cairo, sans-serif" font-size="13" font-weight="600" fill="#57606f" text-anchor="middle" direction="ltr">AC</text>
      <line x1="60" y1="200" x2="140" y2="200" stroke="#263238" stroke-width="2" marker-end="url(#arrow-kv)"></line>
      <line x1="60" y1="260" x2="140" y2="260" stroke="#263238" stroke-width="2"></line>
      <line x1="140" y1="120" x2="140" y2="280" stroke="#263238" stroke-width="2"></line>
      <path class="flow-highlight coil-path" d="M 140,120 a 10,10 0 1 1 0,20 M 140,140 a 10,10 0 1 1 0,20 M 140,160 a 10,10 0 1 1 0,20 M 140,180 a 10,10 0 1 1 0,20 M 140,200 a 10,10 0 1 1 0,20 M 140,220 a 10,10 0 1 1 0,20 M 140,240 a 10,10 0 1 1 0,20 M 140,260 a 10,10 0 1 1 0,20" fill="none" stroke="#263238" stroke-width="2.2"></path>
      <line x1="140" y1="280" x2="200" y2="280" stroke="#263238" stroke-width="2"></line>
      <line x1="140" y1="120" x2="200" y2="120" stroke="#263238" stroke-width="2"></line>
      <path d="M 145,150 L 230,180" stroke="#1d4ed8" stroke-width="3" marker-end="url(#arrow-kv)"></path>
      <circle class="flow-highlight tap-dot" cx="230" cy="180" r="7" fill="#1d4ed8"></circle>
      <text x="300" y="165" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">السيطرة</text>
      <text x="300" y="185" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">على kV</text>
      <text x="140" y="100" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الابتدائي</text>
      <line x1="230" y1="180" x2="420" y2="180" stroke="#263238" stroke-width="2"></line>
      <line class="flow-highlight secondary-bus" x1="420" y1="120" x2="420" y2="280" stroke="#263238" stroke-width="2"></line>
      <line x1="420" y1="120" x2="470" y2="120" stroke="#263238" stroke-width="2" marker-end="url(#arrow-kv)"></line>
      <line x1="420" y1="280" x2="470" y2="280" stroke="#263238" stroke-width="2"></line>
      <text x="430" y="100" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الثانوي</text>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle p1" cx="60" cy="200" r="5" style="--tx:80px; --ty:0px; --particle-delay:0.2s; --particle-duration:0.6s"></circle>
        <circle class="flow-particle p2" cx="145" cy="150" r="5" style="--tx:85px; --ty:30px; --particle-delay:1.1s; --particle-duration:0.6s"></circle>
        <circle class="flow-particle p3" cx="230" cy="180" r="5" style="--tx:190px; --ty:0px; --particle-delay:1.7s; --particle-duration:0.9s"></circle>
        <circle class="flow-particle p4" cx="420" cy="120" r="5" style="--tx:50px; --ty:0px; --particle-delay:2.6s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p5" cx="420" cy="280" r="5" style="--tx:50px; --ty:0px; --particle-delay:2.6s; --particle-duration:0.5s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 3.2s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .kv-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .coil-path {
    --highlight-delay: 0.7s;
    --highlight-duration: 0.6s;
  }

  .tap-dot {
    --highlight-delay: 1.6s;
    --highlight-duration: 0.6s;
  }

  .secondary-bus {
    --highlight-delay: 2.5s;
    --highlight-duration: 0.6s;
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".kv-diagram");
</script>
