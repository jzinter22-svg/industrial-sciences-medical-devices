---
// Redesigned Figure 1-3 (السيطرة على kV — autotransformer voltage
// selector) using the diagram-01/02 visual system. Third of 8 Chapter 1
// diagrams being converted; uses the shared shell/controller extracted
// after diagram-02 (src/styles/diagram-simulator.css +
// src/scripts/diagramSimulator.js) instead of re-duplicating that
// boilerplate.
//
// Geometry unchanged (every line/path/circle coordinate, every label
// identical to the prior build) — only fill/stroke treatment and the
// interaction/animation layer changed.
//
// Color mapping: AC supply + the winding it feeds are the current path
// (blue). The wiper is the control action — selecting which tap sets
// the output voltage (green, matching diagram-01's control-signal
// meaning). The secondary output, which carries the selected voltage
// onward to the HV generator (per diagram-01's topology), is orange
// (HV domain).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft kv-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة السيطرة على kV</span>
      <span class="simulator-subtitle">شكل 1-3 — المحول الذاتي</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="kv-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="720"
          height="340"
          viewBox="0 0 720 340"
          role="img"
          aria-label="السيطرة على kV"
        >
          <defs>
            <marker id="arrow-kv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#B9C3D6"></path>
            </marker>
            <marker id="arrow-kv-green" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#4ADE80"></path>
            </marker>

            <linearGradient id="kvBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="kvGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="kvGradCurrent" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="kvGradControl" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>
            <linearGradient id="kvGradHv" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a2210"></stop>
              <stop offset="100%" stop-color="#1a0f08"></stop>
            </linearGradient>

            <filter id="kvElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="kvSoftGlow" x="-140%" y="-140%" width="380%" height="380%">
              <feGaussianBlur stdDeviation="9"></feGaussianBlur>
            </filter>
            <filter id="kvLineGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="720" height="340" rx="20" fill="url(#kvBgGrad)"></rect>
          <rect x="0" y="0" width="720" height="340" rx="20" fill="url(#kvGrid)"></rect>

          <!-- ============ AC supply ============ -->
          <g class="hotspot" data-component="supply" tabindex="0" role="button" aria-label="مجهز القدرة">
            <line x1="170" y1="70" x2="60" y2="70" stroke="#5b6478" stroke-width="2.5" marker-end="url(#arrow-kv)"></line>
            <line x1="170" y1="270" x2="60" y2="270" stroke="#5b6478" stroke-width="2.5" marker-end="url(#arrow-kv)"></line>
            <line class="trail trail-blue" x1="170" y1="70" x2="60" y2="70" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="7 9"></line>
            <line class="trail trail-blue" x1="170" y1="270" x2="60" y2="270" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="7 9"></line>
            <text x="110" y="160" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مجهز القدرة</text>
            <text x="110" y="178" font-family="Cairo, sans-serif" font-size="12" font-weight="600" fill="#38BDF8" text-anchor="middle" direction="ltr">AC</text>
          </g>

          <!-- ============ Winding (primary span + autotransformer coil + taps) ============ -->
          <g class="hotspot" data-component="winding" tabindex="0" role="button" aria-label="ملف المحول الذاتي">
            <line x1="230" y1="82" x2="230" y2="258" stroke="#5b6478" stroke-width="2.5" marker-start="url(#arrow-kv)" marker-end="url(#arrow-kv)"></line>
            <text x="230" y="165" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الابتدائي</text>

            <line x1="280" y1="60" x2="280" y2="70" stroke="#8b94aa" stroke-width="2"></line>
            <path class="box-shape" d="M 280,70 a8,10 0 1 1 0,20 M 280,90 a8,10 0 1 1 0,20 M 280,110 a8,10 0 1 1 0,20 M 280,130 a8,10 0 1 1 0,20 M 280,150 a8,10 0 1 1 0,20 M 280,170 a8,10 0 1 1 0,20 M 280,190 a8,10 0 1 1 0,20 M 280,210 a8,10 0 1 1 0,20 M 280,230 a8,10 0 1 1 0,20 M 280,250 a8,10 0 1 1 0,20" fill="none" stroke="#38BDF8" stroke-width="2.6" filter="url(#kvElevate)"></path>
            <line x1="280" y1="270" x2="280" y2="280" stroke="#8b94aa" stroke-width="2"></line>
            <line x1="170" y1="70" x2="280" y2="70" stroke="#8b94aa" stroke-width="2"></line>
            <line x1="170" y1="270" x2="280" y2="270" stroke="#8b94aa" stroke-width="2"></line>

            <g class="taps">
              <line x1="280" y1="95" x2="330" y2="95" stroke="#8b94aa" stroke-width="2"></line>
              <circle cx="330" cy="95" r="4" fill="#1c2436" stroke="#8b94aa" stroke-width="1.5"></circle>
              <line x1="280" y1="115" x2="330" y2="115" stroke="#8b94aa" stroke-width="2"></line>
              <circle cx="330" cy="115" r="4" fill="#1c2436" stroke="#8b94aa" stroke-width="1.5"></circle>
              <line x1="280" y1="135" x2="330" y2="135" stroke="#8b94aa" stroke-width="2"></line>
              <circle cx="330" cy="135" r="4" fill="#1c2436" stroke="#8b94aa" stroke-width="1.5"></circle>
              <line x1="280" y1="155" x2="330" y2="155" stroke="#8b94aa" stroke-width="2"></line>
              <circle cx="330" cy="155" r="4" fill="#1c2436" stroke="#8b94aa" stroke-width="1.5"></circle>
              <line x1="280" y1="175" x2="330" y2="175" stroke="#8b94aa" stroke-width="2"></line>
              <circle cx="330" cy="175" r="4" fill="#1c2436" stroke="#8b94aa" stroke-width="1.5"></circle>
              <line x1="280" y1="195" x2="330" y2="195" stroke="#8b94aa" stroke-width="2"></line>
              <circle class="box-shape tap-dot" cx="330" cy="195" r="5" fill="url(#kvGradControl)" stroke="#4ADE80" stroke-width="1.6" filter="url(#kvElevate)"></circle>
            </g>
          </g>

          <!-- ============ Wiper (control: selects the tap) ============ -->
          <g class="hotspot" data-component="wiper" tabindex="0" role="button" aria-label="مفتاح اختيار kV">
            <circle class="box-shape" cx="400" cy="135" r="7" fill="url(#kvGradControl)" stroke="#4ADE80" stroke-width="2" filter="url(#kvElevate)"></circle>
            <path class="trail trail-green" d="M 394,140 L 335,192" stroke="#4ADE80" stroke-width="3" marker-end="url(#arrow-kv-green)"></path>
          </g>

          <!-- ============ Secondary (output toward the HV generator) ============ -->
          <g class="hotspot" data-component="secondary" tabindex="0" role="button" aria-label="الثانوي">
            <path class="box-shape secondary-bus" d="M 406,135 L 450,135 L 450,70 L 620,70" fill="none" stroke="#FB923C" stroke-width="2.6" filter="url(#kvElevate)"></path>
            <circle cx="620" cy="70" r="5" fill="#1c2436" stroke="#FB923C" stroke-width="2"></circle>
            <line x1="280" y1="270" x2="620" y2="270" stroke="#8b94aa" stroke-width="2"></line>
            <circle cx="620" cy="270" r="5" fill="#1c2436" stroke="#8b94aa" stroke-width="2"></circle>
            <line x1="520" y1="82" x2="520" y2="258" stroke="#5b6478" stroke-width="2.5" marker-start="url(#arrow-kv)" marker-end="url(#arrow-kv)"></line>
            <text x="520" y="165" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الثانوي</text>
          </g>

          <text x="400" y="228" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="rtl">السيطرة على</text>
          <text x="400" y="246" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="rtl">kV</text>

          <g class="link" data-link="supply" data-link-to="winding" aria-hidden="true">
            <circle class="particle p1" cx="60" cy="70" r="4.5"></circle>
          </g>
          <g class="link" data-link="winding" data-link-to="wiper" aria-hidden="true">
            <circle class="particle p2" cx="330" cy="195" r="4.5"></circle>
          </g>
          <g class="link" data-link="wiper" data-link-to="secondary" aria-hidden="true">
            <circle class="particle p3" cx="406" cy="135" r="4.5"></circle>
            <circle class="particle p4" cx="450" cy="135" r="4.5"></circle>
            <circle class="particle p5" cx="450" cy="70" r="4.5"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="supply"><span class="status-dot dot-blue"></span><span class="status-label">القدرة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="winding"><span class="status-dot dot-blue"></span><span class="status-label">الملف</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="wiper"><span class="status-dot dot-green"></span><span class="status-label">مفتاح الاختيار</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="secondary"><span class="status-dot dot-orange"></span><span class="status-label">الخرج الثانوي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>التيار</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>إشارة السيطرة</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>الضغط العالي</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#kvElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, stroke-width 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#kvElevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.015);
  }

  .hotspot:focus-visible .box-shape {
    stroke-width: 3.2;
  }

  .trail {
    opacity: 0;
    stroke-width: 3px;
    filter: url(#kvLineGlow);
  }

  .particle {
    fill: #eef1f8;
    opacity: 0;
    filter: url(#kvLineGlow);
  }

  .p2, .p3, .p4, .p5 {
    fill: #4ADE80;
  }

  .p5 {
    fill: #FB923C;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes kv-reveal-trail { 0% { opacity: 0; } 100% { opacity: 0.85; } }
    @keyframes kv-scroll-dash { to { stroke-dashoffset: -36; } }
    @keyframes kv-shape-activate { to { filter: url(#kvElevate) saturate(1.35) brightness(1.45); } }
    @keyframes kv-status-value-on { to { opacity: 1; } }
    @keyframes kv-status-value-off { to { opacity: 0; } }
    @keyframes kv-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes kv-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes kv-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }

    /* Stage 1 — AC supply energizes (0.0s -> ~0.7s) */
    .playing [data-component="supply"] .trail-blue { animation: kv-reveal-trail 0.4s ease-out 0s forwards, kv-scroll-dash 0.7s linear 0s 3; }
    .playing [data-status="supply"] .status-dot { animation: kv-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="supply"] .value-on { animation: kv-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="supply"] .value-off { animation: kv-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing .p1 { animation: kv-move-p1 0.6s ease-in-out 0.1s 3; }
    @keyframes kv-move-p1 { 0% { transform: translate(0,0); opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(110px,0); opacity: 0; } }

    /* Stage 2 — current descends through the winding (0.7s -> ~1.6s) */
    .playing [data-component="winding"] .box-shape { animation: kv-shape-activate 0.5s ease-out 0.7s forwards; }
    .playing [data-status="winding"] .status-dot { animation: kv-dot-on-blue 0.4s ease-out 0.8s forwards; }
    .playing [data-status="winding"] .value-on { animation: kv-status-value-on 0.4s ease-out 0.8s forwards; }
    .playing [data-status="winding"] .value-off { animation: kv-status-value-off 0.4s ease-out 0.8s forwards; }
    .playing .p2 { animation: kv-move-p2 0.7s ease-in-out 0.9s 2; }
    @keyframes kv-move-p2 { 0% { transform: translate(0,0); opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(70px,-60px); opacity: 0; } }

    /* Stage 3 — wiper selects the tap (1.6s -> ~2.3s) */
    .playing [data-component="wiper"] .box-shape { animation: kv-shape-activate 0.5s ease-out 1.6s forwards; }
    .playing [data-component="wiper"] .trail-green { animation: kv-reveal-trail 0.4s ease-out 1.6s forwards; }
    .playing [data-status="wiper"] .status-dot { animation: kv-dot-on-green 0.4s ease-out 1.7s forwards; }
    .playing [data-status="wiper"] .value-on { animation: kv-status-value-on 0.4s ease-out 1.7s forwards; }
    .playing [data-status="wiper"] .value-off { animation: kv-status-value-off 0.4s ease-out 1.7s forwards; }
    .playing .p3 { animation: kv-move-p3 0.5s ease-in-out 1.7s 2; }
    @keyframes kv-move-p3 { 0% { transform: translate(0,0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(44px,0); opacity: 0; } }

    /* Stage 4 — secondary carries the selected voltage onward (2.3s -> ~3.1s) */
    .playing [data-component="secondary"] .box-shape { animation: kv-shape-activate 0.5s ease-out 2.3s forwards; }
    .playing [data-status="secondary"] .status-dot { animation: kv-dot-on-orange 0.4s ease-out 2.4s forwards; }
    .playing [data-status="secondary"] .value-on { animation: kv-status-value-on 0.4s ease-out 2.4s forwards; }
    .playing [data-status="secondary"] .value-off { animation: kv-status-value-off 0.4s ease-out 2.4s forwards; }
    .playing .p4 { animation: kv-move-p4 0.5s ease-in-out 2.4s 2; }
    @keyframes kv-move-p4 { 0% { transform: translate(0,0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(0,-65px); opacity: 0; } }
    .playing .p5 { animation: kv-move-p5 0.6s ease-in-out 2.7s 2; }
    @keyframes kv-move-p5 { 0% { transform: translate(0,0); opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(170px,0); opacity: 0; } }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    supply: {
      title: "مجهز القدرة",
      // src/data/chapter-01/page-04.json #definition-hv-control (excerpt)
      text: "يتم السيطرة على طاقة الاشعة السينية التي تخترق الجسم المراد تصويره من خلال السيطرة على الفولتية العالية التي تجهز أنبوبة الاشعة السينية.",
    },
    winding: {
      title: "ملف المحول الذاتي",
      // src/data/chapter-01/page-04.json #definition-hv-control (excerpt)
      text: "للسيطرة على الفولتية وكذلك يستخدم المحول الذاتي (Autotransformer) ويتكون المحول الذاتي من ملف واحد ويعمل على مبدأ الحث الذاتي…",
    },
    wiper: {
      title: "مفتاح اختيار kV",
      // src/data/chapter-01/page-04.json #definition-hv-control (excerpt)
      text: "ويستعمل المحول الذاتي لرفع الفولتية او لخفضها من مجهز القدرة الرئيسي، ويمتاز بصغر حجمه ورخص ثمنه.",
    },
    secondary: {
      title: "الثانوي",
      // src/data/chapter-01/page-04.json #definition-hv-control (excerpt)
      text: "ان تغيير الفولتية العالية عبر أنبوبة الاشعة السينية تؤثر في الطاقة التي تخترق الجسم وكذلك تؤثر في شدة الإشعاع.",
    },
  };

  wireDiagramSimulator(".kv-diagram", { cycleMs: 3600, componentInfo: COMPONENT_INFO });
</script>
