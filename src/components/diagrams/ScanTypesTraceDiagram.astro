---
// Animated Figure 2-18 (الاثر الذي تخلفه الانواع الثلاثة للتصوير فوق
// الصوتي) — printed page 39. Static artwork kept pixel-identical (same
// M-scan panel with transmitted-pulse bar, moving-target wavy trace,
// stationary-target straight trace, and the corresponding A-scan strip
// below). Animation highlights the transmitted pulse, then the two
// M-scan traces (moving vs. stationary target — the wavy line is the
// whole teaching point of M-mode, so it draws in with a visible
// wobble), then the matching A-scan spikes underneath, tying the two
// display modes to the same three signal events.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram scan-types-trace-diagram">
  <div class="diagram-block-image">
    <svg
      class="stt-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="700"
      height="380"
      viewBox="0 0 700 380"
      role="img"
      aria-label="الاثر الذي تخلفه الانواع الثلاثة للتصوير فوق الصوتي"
    >
      <rect x="0" y="0" width="700" height="380" fill="none"></rect>
      <rect x="30" y="20" width="640" height="230" fill="#fef9c3" stroke="#263238" stroke-width="2"></rect>

      <g class="flow-highlight tx-bar">
        <rect x="90" y="40" width="14" height="190" fill="#111827"></rect>
        <text x="97" y="255" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Transmitted pulse</text>
      </g>

      <g class="flow-highlight moving-trace">
        <path d="M 350,40 q 20,20 0,40 t 0,40 t 0,40 t 0,40 t 0,30"
              fill="none" stroke="#263238" stroke-width="3"></path>
        <text x="350" y="255" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Echo, moving target</text>
      </g>

      <g class="flow-highlight stationary-trace">
        <line x1="560" y1="40" x2="560" y2="230" stroke="#263238" stroke-width="3"></line>
        <text x="560" y="255" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Echo, stationary target</text>
      </g>

      <text x="220" y="30" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#dc2626" text-anchor="middle" direction="ltr">M-scan</text>

      <line x1="60" y1="330" x2="640" y2="330" stroke="#263238" stroke-width="2"></line>
      <path class="flow-highlight a-scan-1" d="M 90,330 q 7,-70 14,-70 t 14,70" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight a-scan-2" d="M 343,330 q 7,-70 14,-70 t 14,70" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <path class="flow-highlight a-scan-3" d="M 553,330 q 7,-70 14,-70 t 14,70" fill="none" stroke="#263238" stroke-width="2.5"></path>
      <line x1="104" y1="330" x2="350" y2="330" stroke="#263238" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#s18-arrow)"></line>
      <line x1="350" y1="330" x2="560" y2="330" stroke="#263238" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#s18-arrow)"></line>
      <text x="360" y="360" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">Corresponding A-scan</text>

      <defs>
        <marker id="s18-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <g class="flow-layer" aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 3.2s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .stt-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .tx-bar { --highlight-delay: 0.1s; --highlight-duration: 0.5s; }
  .moving-trace { --highlight-delay: 0.7s; --highlight-duration: 0.7s; }
  .stationary-trace { --highlight-delay: 1.5s; --highlight-duration: 0.5s; }
  .a-scan-1 { --highlight-delay: 2.1s; --highlight-duration: 0.4s; }
  .a-scan-2 { --highlight-delay: 2.5s; --highlight-duration: 0.4s; }
  .a-scan-3 { --highlight-delay: 2.8s; --highlight-duration: 0.4s; }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".scan-types-trace-diagram");
</script>
