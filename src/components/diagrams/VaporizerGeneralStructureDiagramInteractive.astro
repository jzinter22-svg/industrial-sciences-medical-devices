---
// Figure 9-10 (البنية العامة للمبخر). The vaporizer body has two internal
// channels: a direct passage straight from inlet to outlet, gated by a
// diverter valve, and a second path that dips down into the vaporizing
// chamber where the anesthetic liquid sits. In the Closed position all
// incoming gas takes the direct passage and never touches the liquid, so
// no vapor is added. In the Open position the diverter blocks the direct
// passage instead, forcing gas down through the chamber (picking up
// anesthetic vapor from the liquid surface) before it rejoins the outlet.
// Built with the same data-mode toggle mechanism as Chapter 8's Cut/Coag
// selector.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft vaporizer-general-structure-diagram">
  <div class="simulator-shell" data-mode="closed">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة البنية العامة للمبخر</span>
      <span class="simulator-subtitle">شكل 9-10 — الممر المباشر مقابل غرفة التبخير</span>
    </div>

    <div class="mode-toggle-row">
      <button type="button" class="mode-toggle-button" data-mode-button="closed" aria-pressed="true">مغلق (Closed)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="open" aria-pressed="false">مفتوح (Open)</button>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="vp10-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="440"
          viewBox="0 0 900 440"
          role="img"
          aria-label="البنية العامة للمبخر"
        >
          <defs>
            <marker id="vp10-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="vp10BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="vp10Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="vp10GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="vp10GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="vp10GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="vp10GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="vp10Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="vp10Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="440" rx="20" fill="url(#vp10BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="440" rx="20" fill="url(#vp10Grid)"></rect>

          <text x="450" y="26" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">البنية العامة للمبخر</text>

          <!-- gas inlet -->
          <g class="hotspot" data-component="gas-inlet" tabindex="0" role="button" aria-label="دخول الغاز">
            <rect class="box-shape" x="30" y="95" width="110" height="80" rx="10" fill="url(#vp10GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#vp10Elevate)"></rect>
            <text x="85" y="140" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">دخول الغاز</text>
          </g>

          <g class="link" data-link="gas-inlet" data-link-to="direct-path">
            <line id="vp10-wire-1" x1="140" y1="135" x2="205" y2="135" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp10-arrow)"></line>
            <line class="trail" x1="140" y1="135" x2="203" y2="135" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#vp10Glow)" style="offset-path: url(#vp10-wire-1); --flow-delay:0.4s; --flow-duration:0.6s;"></circle>
          </g>

          <!-- direct path (top pipe with diverter valve) -->
          <g class="hotspot" data-component="direct-path" tabindex="0" role="button" aria-label="الممر المباشر (القناة الثانية)">
            <rect class="box-shape" x="205" y="118" width="490" height="34" rx="10" fill="url(#vp10GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#vp10Elevate)"></rect>
            <g class="valve-symbol">
              <circle cx="450" cy="135" r="14" fill="#1a1608" stroke="#FBBF24" stroke-width="2"></circle>
              <path d="M 442,127 L 458,143 M 458,127 L 442,143" stroke="#FBBF24" stroke-width="2"></path>
            </g>
            <text x="450" y="105" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#fbe9b8" direction="rtl">الممر المباشر (صمام تحويل)</text>
          </g>

          <!-- bypass path: direct-path -> gas-outlet, live only when closed -->
          <g class="link bypass-path" data-link="direct-path" data-link-to="gas-outlet">
            <line id="vp10-wire-2" x1="220" y1="135" x2="760" y2="135" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp10-arrow)"></line>
            <line class="trail" x1="220" y1="135" x2="758" y2="135" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FBBF24" filter="url(#vp10Glow)" style="offset-path: url(#vp10-wire-2); --flow-delay:0.9s; --flow-duration:1.4s;"></circle>
          </g>

          <!-- chamber path: direct-path -> channel-one -->
          <g class="link chamber-path" data-link="direct-path" data-link-to="channel-one">
            <line id="vp10-wire-3" x1="220" y1="135" x2="220" y2="295" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp10-arrow)"></line>
            <line class="trail" x1="220" y1="135" x2="220" y2="293" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FB923C" filter="url(#vp10Glow)" style="offset-path: url(#vp10-wire-3); --flow-delay:0.9s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- channel one -->
          <g class="hotspot" data-component="channel-one" tabindex="0" role="button" aria-label="القناة الأولى">
            <rect class="box-shape" x="200" y="150" width="40" height="150" rx="8" fill="url(#vp10GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#vp10Elevate)"></rect>
          </g>
          <text x="150" y="230" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#fcd9b6" direction="rtl">القناة الأولى</text>

          <g class="link chamber-path" data-link="channel-one" data-link-to="vaporizing-chamber">
            <line id="vp10-wire-4" x1="220" y1="300" x2="220" y2="320" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp10-arrow)"></line>
            <line class="trail" x1="220" y1="300" x2="220" y2="318" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3" fill="#FB923C" filter="url(#vp10Glow)" style="offset-path: url(#vp10-wire-4); --flow-delay:1.6s; --flow-duration:0.4s;"></circle>
          </g>

          <!-- vaporizing chamber -->
          <g class="hotspot" data-component="vaporizing-chamber" tabindex="0" role="button" aria-label="غرفة التبخير">
            <rect class="box-shape" x="220" y="320" width="460" height="90" rx="10" fill="url(#vp10GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#vp10Elevate)"></rect>
            <path d="M 240,395 Q 260,385 280,395 Q 300,405 320,395 Q 340,385 360,395 Q 380,405 400,395 Q 420,385 440,395 Q 460,405 480,395 Q 500,385 520,395 Q 540,405 560,395 Q 580,385 600,395 Q 620,405 640,395 Q 650,391 660,395" fill="none" stroke="#4ADE80" stroke-width="1.6"></path>
            <circle cx="270" cy="380" r="1.6" fill="#4ADE80"></circle>
            <circle cx="330" cy="386" r="1.6" fill="#4ADE80"></circle>
            <circle cx="400" cy="378" r="1.6" fill="#4ADE80"></circle>
            <circle cx="470" cy="388" r="1.6" fill="#4ADE80"></circle>
            <circle cx="540" cy="380" r="1.6" fill="#4ADE80"></circle>
            <circle cx="610" cy="386" r="1.6" fill="#4ADE80"></circle>
            <text x="450" y="345" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">غرفة التبخير</text>
            <text x="450" y="360" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" fill="#bcf5d1" direction="rtl">سائل التخدير</text>
            <g class="vapor-particles">
              <circle class="vapor-dot" cx="300" cy="392" r="2.4" fill="#c9fbe0"></circle>
              <circle class="vapor-dot" cx="420" cy="392" r="2.4" fill="#c9fbe0"></circle>
              <circle class="vapor-dot" cx="560" cy="392" r="2.4" fill="#c9fbe0"></circle>
            </g>
          </g>

          <g class="link chamber-path" data-link="vaporizing-chamber" data-link-to="channel-two">
            <line id="vp10-wire-5" x1="680" y1="320" x2="680" y2="300" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vp10-arrow)"></line>
            <line class="trail" x1="680" y1="320" x2="680" y2="302" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3" fill="#4ADE80" filter="url(#vp10Glow)" style="offset-path: url(#vp10-wire-5); --flow-delay:2.2s; --flow-duration:0.4s;"></circle>
          </g>

          <!-- channel two -->
          <g class="hotspot" data-component="channel-two" tabindex="0" role="button" aria-label="القناة الثانية">
            <rect class="box-shape" x="660" y="150" width="40" height="150" rx="8" fill="url(#vp10GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#vp10Elevate)"></rect>
          </g>
          <text x="750" y="230" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#fcd9b6" direction="rtl">القناة الثانية</text>

          <g class="link chamber-path" data-link="channel-two" data-link-to="gas-outlet">
            <line id="vp10-wire-6" x1="680" y1="150" x2="680" y2="135" stroke="#5b6478" stroke-width="2.5"></line>
            <line class="trail" x1="680" y1="150" x2="680" y2="137" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FB923C" filter="url(#vp10Glow)" style="offset-path: url(#vp10-wire-6); --flow-delay:2.8s; --flow-duration:0.3s;"></circle>
          </g>

          <!-- gas outlet -->
          <g class="hotspot" data-component="gas-outlet" tabindex="0" role="button" aria-label="خروج الغاز">
            <rect class="box-shape" x="760" y="95" width="110" height="80" rx="10" fill="url(#vp10GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#vp10Elevate)"></rect>
            <text x="815" y="140" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">خروج الغاز</text>
          </g>

          <text x="450" y="435" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">مغلق: يمر كل الغاز مباشرة من الدخول إلى الخروج. مفتوح: يمر الغاز عبر غرفة التبخير فيحمل معه بخار المخدر</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة المبخر</h3>
        <ul class="status-list">
          <li class="status-row" data-status="gas-inlet"><span class="status-dot dot-blue"></span><span class="status-label">دخول الغاز</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يدخل الغاز</span></span></li>
          <li class="status-row" data-status="direct-path"><span class="status-dot dot-yellow"></span><span class="status-label">الممر المباشر</span><span class="status-value"><span class="value-off">—</span><span class="value-on value-closed">مفتوح (يمر الغاز)</span><span class="value-on value-open">مغلق (يُحوَّل الغاز)</span></span></li>
          <li class="status-row" data-status="channel-one"><span class="status-dot dot-orange"></span><span class="status-label">القناة الأولى</span><span class="status-value"><span class="value-off">غير مستخدمة</span><span class="value-on">تُغذّي الغرفة</span></span></li>
          <li class="status-row" data-status="vaporizing-chamber"><span class="status-dot dot-green"></span><span class="status-label">غرفة التبخير</span><span class="status-value"><span class="value-off">لا تبخّر</span><span class="value-on">يتصاعد البخار</span></span></li>
          <li class="status-row" data-status="channel-two"><span class="status-dot dot-orange"></span><span class="status-label">القناة الثانية</span><span class="status-value"><span class="value-off">غير مستخدمة</span><span class="value-on">تُعيد الخليط</span></span></li>
          <li class="status-row" data-status="gas-outlet"><span class="status-dot dot-blue"></span><span class="status-label">خروج الغاز</span><span class="status-value"><span class="value-off">لا خرج</span><span class="value-on value-closed">غاز بلا بخار</span><span class="value-on value-open">غاز محمّل بالبخار</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي جزء لعرض شرحه — أو بدّل بين وضعي مغلق ومفتوح من الأزرار أعلاه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>دخول وخروج الغاز</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>الممر المباشر والصمام</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>القناتان الأولى والثانية</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>غرفة التبخير</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .mode-toggle-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0 var(--neo-space-md) var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .mode-toggle-button {
    font-family: "Cairo", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #c3c9dc;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .mode-toggle-button:hover { background: rgba(255, 255, 255, 0.08); }

  .mode-toggle-button[aria-pressed="true"] {
    background: #FBBF24;
    border-color: #FBBF24;
    color: #1a1608;
  }

  .hotspot .box-shape {
    filter: url(#vp10Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#vp10Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#vp10Glow); }

  .value-closed, .value-open { opacity: 0; }
  .simulator-shell[data-mode="open"] .value-closed { display: none; }
  .simulator-shell:not([data-mode="open"]) .value-open { display: none; }

  /* Only one internal route is physically live per mode. */
  .chamber-path { opacity: 0.2; transition: opacity 0.3s ease; }
  .bypass-path { opacity: 1; transition: opacity 0.3s ease; }
  .simulator-shell[data-mode="open"] .bypass-path { opacity: 0.2; }
  .simulator-shell[data-mode="open"] .chamber-path { opacity: 1; }

  .valve-symbol circle { transition: fill 0.3s ease, stroke 0.3s ease; }
  .simulator-shell[data-mode="open"] .valve-symbol circle { fill: rgba(239, 68, 68, 0.28); stroke: #EF4444; }
  .simulator-shell[data-mode="open"] .valve-symbol path { stroke: #EF4444; }

  .vapor-dot { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes vp10-shape-activate { to { filter: url(#vp10Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes vp10-reveal-trail { to { opacity: 0.85; } }
    @keyframes vp10-status-value-on { to { opacity: 1; } }
    @keyframes vp10-status-value-off { to { opacity: 0; } }
    @keyframes vp10-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes vp10-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes vp10-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes vp10-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="gas-inlet"] .box-shape { animation: vp10-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-inlet"] .status-dot { animation: vp10-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-inlet"] .value-on { animation: vp10-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="gas-inlet"] .value-off { animation: vp10-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="gas-inlet"] .trail { animation: vp10-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="direct-path"] .box-shape { animation: vp10-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="direct-path"] .status-dot { animation: vp10-dot-on-yellow 0.4s ease-out 0.6s forwards; }
    .playing [data-status="direct-path"] .value-on { animation: vp10-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="direct-path"] .value-off { animation: vp10-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="direct-path"] .trail { animation: vp10-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="channel-one"] .box-shape { animation: vp10-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="channel-one"] .status-dot { animation: vp10-dot-on-orange 0.4s ease-out 1.1s forwards; }
    .playing [data-status="channel-one"] .value-on { animation: vp10-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="channel-one"] .value-off { animation: vp10-status-value-off 0.4s ease-out 1.1s forwards; }
    .playing [data-link="channel-one"] .trail { animation: vp10-reveal-trail 0.3s ease-out 1.6s forwards; }

    .playing [data-component="vaporizing-chamber"] .box-shape { animation: vp10-shape-activate 0.4s ease-out 1.7s forwards; }
    .playing [data-status="vaporizing-chamber"] .status-dot { animation: vp10-dot-on-green 0.4s ease-out 1.7s forwards; }
    .playing [data-status="vaporizing-chamber"] .value-on { animation: vp10-status-value-on 0.4s ease-out 1.7s forwards; }
    .playing [data-status="vaporizing-chamber"] .value-off { animation: vp10-status-value-off 0.4s ease-out 1.7s forwards; }
    .playing [data-link="vaporizing-chamber"] .trail { animation: vp10-reveal-trail 0.3s ease-out 2.2s forwards; }

    .playing [data-component="channel-two"] .box-shape { animation: vp10-shape-activate 0.4s ease-out 2.3s forwards; }
    .playing [data-status="channel-two"] .status-dot { animation: vp10-dot-on-orange 0.4s ease-out 2.3s forwards; }
    .playing [data-status="channel-two"] .value-on { animation: vp10-status-value-on 0.4s ease-out 2.3s forwards; }
    .playing [data-status="channel-two"] .value-off { animation: vp10-status-value-off 0.4s ease-out 2.3s forwards; }
    .playing [data-link="channel-two"] .trail { animation: vp10-reveal-trail 0.3s ease-out 2.8s forwards; }

    .playing [data-component="gas-outlet"] .box-shape { animation: vp10-shape-activate 0.4s ease-out 2.9s forwards; }
    .playing [data-status="gas-outlet"] .status-dot { animation: vp10-dot-on-blue 0.4s ease-out 2.9s forwards; }
    .playing [data-status="gas-outlet"] .value-on { animation: vp10-status-value-on 0.4s ease-out 2.9s forwards; }
    .playing [data-status="gas-outlet"] .value-off { animation: vp10-status-value-off 0.4s ease-out 2.9s forwards; }

    /* channel-one / chamber / channel-two only really "activate" in open mode */
    .simulator-shell:not([data-mode="open"]) [data-component="channel-one"] .box-shape,
    .simulator-shell:not([data-mode="open"]) [data-component="vaporizing-chamber"] .box-shape,
    .simulator-shell:not([data-mode="open"]) [data-component="channel-two"] .box-shape {
      animation: none !important;
      filter: url(#vp10Elevate) saturate(0.6) brightness(0.8) !important;
    }
    .simulator-shell:not([data-mode="open"]) [data-status="channel-one"] .status-dot,
    .simulator-shell:not([data-mode="open"]) [data-status="channel-one"] .value-on,
    .simulator-shell:not([data-mode="open"]) [data-status="channel-one"] .value-off,
    .simulator-shell:not([data-mode="open"]) [data-status="vaporizing-chamber"] .status-dot,
    .simulator-shell:not([data-mode="open"]) [data-status="vaporizing-chamber"] .value-on,
    .simulator-shell:not([data-mode="open"]) [data-status="vaporizing-chamber"] .value-off,
    .simulator-shell:not([data-mode="open"]) [data-status="channel-two"] .status-dot,
    .simulator-shell:not([data-mode="open"]) [data-status="channel-two"] .value-on,
    .simulator-shell:not([data-mode="open"]) [data-status="channel-two"] .value-off {
      animation: none !important;
    }

    @keyframes vp10-vapor-rise {
      0% { transform: translateY(0); opacity: 0; }
      15% { opacity: 0.9; }
      100% { transform: translateY(-46px); opacity: 0; }
    }
    .simulator-shell[data-mode="open"].playing .vapor-dot {
      animation: vp10-vapor-rise 1.8s ease-in infinite;
    }
    .vapor-dot:nth-of-type(2) { animation-delay: 0.5s !important; }
    .vapor-dot:nth-of-type(3) { animation-delay: 1.0s !important; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes vp10-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: vp10-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
    .simulator-shell[data-mode="open"] .bypass-path .current-particle,
    .simulator-shell:not([data-mode="open"]) .chamber-path .current-particle {
      animation: none !important;
      opacity: 0 !important;
    }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "gas-inlet": {
      title: "دخول الغاز",
      text: "من هنا يدخل خليط الغازات القادم من مشعب التجميع إلى جسم المبخر.",
    },
    "direct-path": {
      title: "الممر المباشر (صمام التحويل)",
      text: "قناة ذات مسار مباشر بين الدخول والخروج، دون أن تلامس الغازات سائل التخدير. عندما يكون المبخر في الوضع المغلق فإن كل الغازات المتدفقة من فتحة الدخول ستمر عبر هذا الممر مباشرة إلى فتحة الخروج.",
    },
    "channel-one": {
      title: "القناة الأولى",
      text: "تؤدي إلى غرفة التبخير. عندما يكون المبخر في الوضع المفتوح فإن كل أو بعض الغازات ستمر عبر هذه القناة نحو غرفة التبخير.",
    },
    "vaporizing-chamber": {
      title: "غرفة التبخير",
      text: "وعاء معدني بداخله سائل التخدير؛ يمر الغاز فوق سطح السائل (أو خلاله) فيحمل معه جزءا من بخار المخدر في الوضع المفتوح فقط.",
    },
    "channel-two": {
      title: "القناة الثانية",
      text: "تعيد الغاز المحمّل ببخار المخدر من غرفة التبخير ليلتقي بفتحة الخروج، وذلك في الوضع المفتوح فقط.",
    },
    "gas-outlet": {
      title: "خروج الغاز",
      text: "الغاز الخارج من هنا إما خالٍ من بخار المخدر (وضع مغلق) أو محمّل بنسبة من بخار المخدر (وضع مفتوح)، متجها نحو دائرة المريض.",
    },
  };

  wireDiagramSimulator(".vaporizer-general-structure-diagram", { cycleMs: 3400, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".vaporizer-general-structure-diagram .mode-toggle-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".vaporizer-general-structure-diagram")?.querySelector(".simulator-shell");
      const mode = btn.getAttribute("data-mode-button");
      if (!(shell instanceof HTMLElement) || !mode) return;
      shell.dataset.mode = mode;
      shell.querySelectorAll(".mode-toggle-button").forEach((b) => {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
    });
  });
</script>
