---
// Figure 8-9 (دائرة مجهز القدرة والحماية والسيطرة) — the transformer ->
// bridge rectifier -> filter capacitor chain feeding an NTC thermistor
// (R1) and a thyristor-based latching Start/Stop control. This is the one
// schematic in the chapter that is itself an interactive control circuit
// (not just a signal path), so — like Chapter 7's breaker/emergency-stop
// toggles — the Start (S2) and Stop (S1) push-buttons are real controls:
// Start closes the thyristor (device stays on), Stop short-circuits it
// (device turns off), exactly as the source text describes.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft power-supply-protection-diagram">
  <div class="simulator-shell" data-thyristor="blocked">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة دائرة مجهز القدرة والحماية والسيطرة</span>
      <span class="simulator-subtitle">شكل 8-9 — من المحولة إلى الثايرستور ومفتاحي التشغيل</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es9-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="380"
          viewBox="0 0 900 380"
          role="img"
          aria-label="دائرة مجهز القدرة والحماية والسيطرة"
        >
          <defs>
            <marker id="es9-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="es9BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es9Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es9GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="es9GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="es9GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="es9Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es9Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="380" rx="20" fill="url(#es9BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="380" rx="20" fill="url(#es9Grid)"></rect>

          <text x="450" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">دائرة مجهز القدرة والحماية والسيطرة</text>

          <g class="hotspot" data-component="transformer" tabindex="0" role="button" aria-label="المحولة الخافضة">
            <rect class="box-shape" x="30" y="120" width="110" height="80" rx="10" fill="url(#es9GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <path d="M 60,150 a6,9 0 1 1 0,-18 M 74,150 a6,9 0 1 1 0,-18 M 88,150 a6,9 0 1 1 0,-18" fill="none" stroke="#FBBF24" stroke-width="1.6"></path>
            <text x="85" y="180" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">محولة خافضة</text>
          </g>

          <g class="link" data-link="transformer" data-link-to="rectifier">
            <line id="es9-wire-1" x1="140" y1="160" x2="185" y2="160" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es9-arrow)"></line>
            <line class="trail" x1="140" y1="160" x2="183" y2="160" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FBBF24" filter="url(#es9Glow)" style="offset-path: url(#es9-wire-1); --flow-delay:0.4s; --flow-duration:0.9s;"></circle>
          </g>

          <g class="hotspot" data-component="rectifier" tabindex="0" role="button" aria-label="دائرة القنطرة المقوّمة">
            <rect class="box-shape" x="185" y="120" width="100" height="80" rx="10" fill="url(#es9GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <path d="M 215,145 L 255,175 M 255,145 L 215,175" stroke="#FB923C" stroke-width="1.4"></path>
            <text x="235" y="190" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">قنطرة تقويم</text>
          </g>

          <g class="link" data-link="rectifier" data-link-to="filter-cap">
            <line id="es9-wire-2" x1="285" y1="160" x2="330" y2="160" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es9-arrow)"></line>
            <line class="trail" x1="285" y1="160" x2="328" y2="160" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FB923C" filter="url(#es9Glow)" style="offset-path: url(#es9-wire-2); --flow-delay:0.9s; --flow-duration:0.9s;"></circle>
          </g>

          <g class="hotspot" data-component="filter-cap" tabindex="0" role="button" aria-label="متسعة الترشيح C1">
            <rect class="box-shape" x="330" y="120" width="90" height="80" rx="10" fill="url(#es9GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <text x="375" y="155" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" direction="ltr">C1</text>
            <text x="375" y="185" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#FBBF24" direction="rtl">ترشيح</text>
          </g>

          <g class="link" data-link="filter-cap" data-link-to="ntc">
            <line id="es9-wire-3" x1="420" y1="160" x2="465" y2="160" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es9-arrow)"></line>
            <line class="trail" x1="420" y1="160" x2="463" y2="160" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FBBF24" filter="url(#es9Glow)" style="offset-path: url(#es9-wire-3); --flow-delay:1.4s; --flow-duration:0.9s;"></circle>
          </g>

          <g class="hotspot" data-component="ntc" tabindex="0" role="button" aria-label="المقاومة الحرارية R1">
            <rect class="box-shape" x="465" y="120" width="90" height="80" rx="10" fill="url(#es9GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <path d="M 480,155 l 6,-14 8,20 8,-20 8,20 8,-14" fill="none" stroke="#FB923C" stroke-width="1.6"></path>
            <text x="510" y="185" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="ltr">R1 (NTC)</text>
          </g>

          <g class="link" data-link="ntc" data-link-to="thyristor">
            <line id="es9-wire-4" x1="555" y1="160" x2="600" y2="160" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es9-arrow)"></line>
            <line class="trail" x1="555" y1="160" x2="598" y2="160" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="thyristor" tabindex="0" role="button" aria-label="الثايرستور">
            <rect class="box-shape" x="600" y="110" width="110" height="100" rx="10" fill="url(#es9GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <path class="thyristor-symbol" d="M 630,160 L 680,140 L 680,180 Z" fill="none" stroke="#4ADE80" stroke-width="1.8"></path>
            <text x="655" y="195" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">الثايرستور</text>
          </g>

          <g class="link" data-link="thyristor" data-link-to="output">
            <line id="es9-wire-5" x1="710" y1="160" x2="755" y2="160" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es9-arrow)"></line>
            <line class="trail" x1="710" y1="160" x2="753" y2="160" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#4ADE80" filter="url(#es9Glow)" style="offset-path: url(#es9-wire-5); --flow-delay:2.0s; --flow-duration:0.8s;"></circle>
          </g>

          <g class="hotspot" data-component="output" tabindex="0" role="button" aria-label="الخرج إلى مكبر القدرة ومنظم الفولتية">
            <rect class="box-shape" x="755" y="120" width="115" height="80" rx="10" fill="url(#es9GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <text x="812" y="152" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">إلى مكبر القدرة</text>
            <text x="812" y="168" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">ومنظم الفولتية</text>
          </g>

          <!-- Start/Stop control buttons feeding the thyristor gate -->
          <g class="hotspot control-button" data-component="start-button" tabindex="0" role="button" aria-label="مفتاح البوش Start">
            <rect class="box-shape" x="600" y="250" width="90" height="60" rx="10" fill="url(#es9GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <text x="645" y="277" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">تشغيل</text>
            <text x="645" y="293" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#4ADE80" direction="ltr">Start (S2)</text>
          </g>
          <g class="hotspot control-button" data-component="stop-button" tabindex="0" role="button" aria-label="مفتاح البوش Stop">
            <rect class="box-shape" x="710" y="250" width="90" height="60" rx="10" fill="url(#es9GradOrange)" stroke="#EF4444" stroke-width="2" filter="url(#es9Elevate)"></rect>
            <text x="755" y="277" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">إيقاف</text>
            <text x="755" y="293" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#EF4444" direction="ltr">Stop (S1)</text>
          </g>
          <path d="M 645,250 L 645,210 L 655,210" fill="none" stroke="#4ADE80" stroke-width="1.6" marker-end="url(#es9-arrow)"></path>
          <path d="M 755,250 L 755,210 L 700,210" fill="none" stroke="#EF4444" stroke-width="1.6" marker-end="url(#es9-arrow)"></path>

          <text x="450" y="345" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" fill="#dbe0ec" direction="rtl">عند ارتفاع التيار (حمل زائد) تخفض R1 الفولتية لحظيا فيُقطع الثايرستور تلقائيا ويُطفأ الجهاز</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة الدائرة</h3>
        <ul class="status-list">
          <li class="status-row" data-status="transformer"><span class="status-dot dot-yellow"></span><span class="status-label">المحولة الخافضة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="rectifier"><span class="status-dot dot-orange"></span><span class="status-label">دائرة التقويم</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">تقوّم الموجة</span></span></li>
          <li class="status-row" data-status="filter-cap"><span class="status-dot dot-yellow"></span><span class="status-label">متسعة الترشيح</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">ترشّح</span></span></li>
          <li class="status-row" data-status="ntc"><span class="status-dot dot-orange"></span><span class="status-label">المقاومة الحرارية R1</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">تراقب التيار</span></span></li>
          <li class="status-row" data-status="thyristor"><span class="status-dot dot-green"></span><span class="status-label">الثايرستور</span><span class="status-value"><span class="value-off">مقطوع</span><span class="value-on">موصول</span></span></li>
          <li class="status-row" data-status="output"><span class="status-dot dot-green"></span><span class="status-label">الخرج</span><span class="status-value"><span class="value-off">لا خرج</span><span class="value-on">فولتية مستقرة</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه — أو جرّب زرّي التشغيل والإيقاف</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>مسار الفولتية</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>عناصر الحماية</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الثايرستور والخرج</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#es9Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es9Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .control-button .box-shape { cursor: pointer; }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#es9Glow); }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es9-shape-activate { to { filter: url(#es9Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es9-reveal-trail { to { opacity: 0.85; } }
    @keyframes es9-status-value-on { to { opacity: 1; } }
    @keyframes es9-status-value-off { to { opacity: 0; } }
    @keyframes es9-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes es9-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes es9-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="transformer"] .box-shape { animation: es9-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="transformer"] .status-dot { animation: es9-dot-on-yellow 0.4s ease-out 0.1s forwards; }
    .playing [data-status="transformer"] .value-on { animation: es9-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="transformer"] .value-off { animation: es9-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="transformer"] .trail { animation: es9-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="rectifier"] .box-shape { animation: es9-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="rectifier"] .status-dot { animation: es9-dot-on-orange 0.4s ease-out 0.6s forwards; }
    .playing [data-status="rectifier"] .value-on { animation: es9-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="rectifier"] .value-off { animation: es9-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="rectifier"] .trail { animation: es9-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="filter-cap"] .box-shape { animation: es9-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="filter-cap"] .status-dot { animation: es9-dot-on-yellow 0.4s ease-out 1.1s forwards; }
    .playing [data-status="filter-cap"] .value-on { animation: es9-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="filter-cap"] .value-off { animation: es9-status-value-off 0.4s ease-out 1.1s forwards; }
    .playing [data-link="filter-cap"] .trail { animation: es9-reveal-trail 0.3s ease-out 1.4s forwards; }

    .playing [data-component="ntc"] .box-shape { animation: es9-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="ntc"] .status-dot { animation: es9-dot-on-orange 0.4s ease-out 1.6s forwards; }
    .playing [data-status="ntc"] .value-on { animation: es9-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="ntc"] .value-off { animation: es9-status-value-off 0.4s ease-out 1.6s forwards; }
    .playing [data-link="ntc"] .trail { animation: es9-reveal-trail 0.3s ease-out 1.9s forwards; }

    /* Thyristor + everything downstream of it only shows as "on" once
       Start has been pressed (data-thyristor="conducting"). */
    .simulator-shell[data-thyristor="conducting"] [data-component="thyristor"] .box-shape { animation: es9-shape-activate 0.4s ease-out 0.1s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-status="thyristor"] .status-dot { animation: es9-dot-on-green 0.4s ease-out 0.1s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-status="thyristor"] .value-on { animation: es9-status-value-on 0.4s ease-out 0.1s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-status="thyristor"] .value-off { animation: es9-status-value-off 0.4s ease-out 0.1s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-link="thyristor"] .trail { animation: es9-reveal-trail 0.3s ease-out 0.3s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-component="output"] .box-shape { animation: es9-shape-activate 0.4s ease-out 0.5s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-status="output"] .status-dot { animation: es9-dot-on-green 0.4s ease-out 0.5s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-status="output"] .value-on { animation: es9-status-value-on 0.4s ease-out 0.5s forwards; }
    .simulator-shell[data-thyristor="conducting"] [data-status="output"] .value-off { animation: es9-status-value-off 0.4s ease-out 0.5s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes es9-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: es9-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
    .simulator-shell:not([data-thyristor="conducting"]) [data-link="thyristor"] .current-particle {
      animation: none !important;
      opacity: 0 !important;
    }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    transformer: {
      title: "المحولة الخافضة",
      text: "تخفض فولتية التغذية الرئيسية (220V) إلى قيمة مناسبة لدوائر الجهاز الداخلية.",
    },
    rectifier: {
      title: "دائرة القنطرة",
      text: "تُقوّم الموجة المتناوبة الخارجة من المحولة تقويما كاملا (Full-wave).",
    },
    "filter-cap": {
      title: "متسعة الترشيح (C1)",
      text: "تُرشّح التيار وتزيل التعرجات في موجة الخرج بعد التقويم، فتعطي فولتية مستمرة أكثر استقرارا.",
    },
    ntc: {
      title: "المقاومة الحرارية (R1)",
      text: "ذات معامل حراري سالب. عند ارتفاع التيار (Over Load) بسبب انخفاض ممانعة الجهاز، تمتص هذه المقاومة التيار العالي وتخفض الفولتية لحظيا بمقدار (3–5)V.",
    },
    thyristor: {
      title: "الثايرستور (مفتاح السيطرة الالكترونية)",
      text: "ينقطع تلقائيا عند انخفاض الفولتية بسبب R1، فيُطفأ الجهاز نهائيا لحمايته. جرّب زرّي التشغيل (Start) والإيقاف (Stop) أدناه.",
    },
    output: {
      title: "الخرج",
      text: "فولتيتان للخرج: الأولى عبر R1 لتغذية مكبر القدرة، والثانية عبر الثايرستور لتغذية بقية الدوائر بفولتية مستقرة.",
    },
    "start-button": {
      title: "مفتاح البوش Start (S2)",
      text: "بالضغط عليه يبدأ عمل الثايرستور ويصبح في حالة توصيل، فيعاد تشغيل الجهاز.",
    },
    "stop-button": {
      title: "مفتاح البوش Stop (S1)",
      text: "بالضغط عليه تتكوّن دائرة قصيرة على طرفي الثايرستور فينقطع التيار خلاله ويتوقف عمل الجهاز.",
    },
  };

  wireDiagramSimulator(".power-supply-protection-diagram", { cycleMs: 2400, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".power-supply-protection-diagram [data-component=\"start-button\"]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".simulator-shell");
      if (shell instanceof HTMLElement) shell.dataset.thyristor = "conducting";
    });
  });
  document.querySelectorAll(".power-supply-protection-diagram [data-component=\"stop-button\"]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".simulator-shell");
      if (shell instanceof HTMLElement) shell.dataset.thyristor = "blocked";
    });
  });
</script>
