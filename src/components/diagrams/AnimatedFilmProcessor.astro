---
// Animated Figure 1-11 (الاجزاء الرئيسة لجهاز معالجة الافلام الشعاعية
// الالي).
//
// The source (page 19 / PDF index 18) is a labeled cutaway of the real
// machine (roller racks inside each tank, air tubes in the dryer, a
// control box, an entry tray/flap, a film-receiving bin) — the previous
// build's six boxes were plain empty rectangles with no internal detail,
// which read as a generic flow diagram rather than the machine the
// source actually draws. Each stage now carries the detail that
// distinguishes it in the source: the developer/fixer tanks show their
// paired roller racks (small circles, matching the source's cyan
// rollers), the wash tank keeps a lighter single roller pair, the dryer
// shows vertical air tubes instead of rollers, the entry stage gets the
// film-entry tray wedge, and the exit stage is a bin shape instead of a
// plain box. The control box (صندوق السيطرة), a real labeled component
// in the source with no place in the left-to-right process row, is
// added as a separate additive element beneath the transport path.
//
// Teaches (unchanged sequence): a film indicator travels left to right
// through every stage in the same order the text describes them (entry
// -> developer -> fixer -> wash -> dryer -> output), each stage
// highlighting only while the film is "in" it. Level 1.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram film-processor-diagram">
  <div class="diagram-block-image">
    <svg
      class="film-processor-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="940"
      height="360"
      viewBox="0 0 940 360"
      role="img"
      aria-label="الاجزاء الرئيسة لجهاز معالجة الافلام الشعاعية الالي"
    >
      <defs>
        <marker id="arrow-film" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="940" height="360" fill="none"></rect>

      <!-- Stage 1: film entry (tray wedge + slot) -->
      <rect class="flow-highlight stage-1" x="30" y="100" width="130" height="120" rx="6" fill="#dbeafe" stroke="#263238" stroke-width="2"></rect>
      <polygon points="30,150 2,138 2,182 30,170" fill="#a3e635" stroke="#263238" stroke-width="1.5"></polygon>
      <rect x="34" y="145" width="20" height="30" fill="#c4b5fd" stroke="#263238" stroke-width="1.5"></rect>
      <text x="95.0" y="155.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">فتحة إدخال</text>
      <text x="95.0" y="177.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الفلم</text>
      <line x1="160" y1="160.0" x2="180" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <!-- Stage 2: developer tank with roller racks -->
      <rect class="flow-highlight stage-2" x="180" y="100" width="130" height="120" rx="6" fill="#bbf7d0" stroke="#263238" stroke-width="2"></rect>
      <g fill="#22d3ee" stroke="#263238" stroke-width="1.2">
        <circle cx="205" cy="120" r="6"></circle>
        <circle cx="225" cy="120" r="6"></circle>
        <circle cx="205" cy="136" r="6"></circle>
        <circle cx="225" cy="136" r="6"></circle>
        <circle cx="205" cy="152" r="6"></circle>
        <circle cx="225" cy="152" r="6"></circle>
      </g>
      <text x="255.0" y="150.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">خزان</text>
      <text x="255.0" y="172.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المظهر</text>
      <line x1="310" y1="160.0" x2="330" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <!-- Stage 3: fixer tank with roller racks -->
      <rect class="flow-highlight stage-3" x="330" y="100" width="130" height="120" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <g fill="#22d3ee" stroke="#263238" stroke-width="1.2">
        <circle cx="355" cy="120" r="6"></circle>
        <circle cx="375" cy="120" r="6"></circle>
        <circle cx="355" cy="136" r="6"></circle>
        <circle cx="375" cy="136" r="6"></circle>
        <circle cx="355" cy="152" r="6"></circle>
        <circle cx="375" cy="152" r="6"></circle>
      </g>
      <text x="405.0" y="150.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">خزان</text>
      <text x="405.0" y="172.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المثبت</text>
      <line x1="460" y1="160.0" x2="480" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <!-- Stage 4: wash tank, single roller pair -->
      <rect class="flow-highlight stage-4" x="480" y="100" width="130" height="120" rx="6" fill="#bae6fd" stroke="#263238" stroke-width="2"></rect>
      <g fill="#f1f5f9" stroke="#263238" stroke-width="1.2">
        <circle cx="505" cy="130" r="7"></circle>
        <circle cx="525" cy="130" r="7"></circle>
        <circle cx="505" cy="150" r="7"></circle>
        <circle cx="525" cy="150" r="7"></circle>
      </g>
      <text x="565.0" y="150.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">خزان</text>
      <text x="565.0" y="172.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الغسيل</text>
      <line x1="610" y1="160.0" x2="630" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <!-- Stage 5: dryer with air tubes -->
      <rect class="flow-highlight stage-5" x="630" y="100" width="130" height="120" rx="6" fill="#fde68a" stroke="#263238" stroke-width="2"></rect>
      <g stroke="#b45309" stroke-width="2">
        <line x1="650" y1="112" x2="650" y2="168"></line>
        <line x1="662" y1="112" x2="662" y2="168"></line>
        <line x1="674" y1="112" x2="674" y2="168"></line>
      </g>
      <circle cx="695" cy="140" r="12" fill="#fff7ed" stroke="#263238" stroke-width="1.5"></circle>
      <path d="M 695,132 L 699,140 L 695,148 L 691,140 Z" fill="#b45309"></path>
      <text x="695.0" y="115.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">وحدة</text>
      <text x="695.0" y="200.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">التجفيف</text>
      <line x1="760" y1="160.0" x2="780" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <!-- Stage 6: film-receiving bin -->
      <rect class="flow-highlight stage-6" x="780" y="100" width="130" height="120" rx="6" fill="#dbeafe" stroke="#263238" stroke-width="2"></rect>
      <polygon points="805,190 855,190 845,210 815,210" fill="#94a3b8" stroke="#263238" stroke-width="1.5"></polygon>
      <text x="845.0" y="140.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">حاوية استلام</text>
      <text x="845.0" y="162.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الفلم</text>

      <!-- Control box: a real labeled component, added beneath the row -->
      <rect x="30" y="260" width="90" height="60" rx="4" fill="#fdba74" stroke="#263238" stroke-width="2"></rect>
      <rect x="45" y="272" width="18" height="14" fill="#fff" stroke="#263238" stroke-width="1"></rect>
      <circle cx="90" cy="280" r="6" fill="#fff" stroke="#263238" stroke-width="1"></circle>
      <text x="75.0" y="245.0" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">صندوق السيطرة</text>
      <line x1="120" y1="290" x2="160" y2="230" stroke="#57606f" stroke-width="1.5" stroke-dasharray="3 3"></line>

      <text x="470.0" y="40" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مسار الفلم عبر وحدات جهاز معالجة الأفلام الشعاعية الآلي</text>

      <g class="flow-layer" aria-hidden="true">
        <rect class="film-indicator" x="80" y="195" width="30" height="10" rx="3" fill="#1d4ed8"></rect>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 4.9s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 560px;
    display: flex;
    justify-content: center;
  }

  .film-processor-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .stage-1 { --highlight-delay: 0.2s; --highlight-duration: 0.65s; }
  .stage-2 { --highlight-delay: 0.9s; --highlight-duration: 0.65s; }
  .stage-3 { --highlight-delay: 1.6s; --highlight-duration: 0.65s; }
  .stage-4 { --highlight-delay: 2.3s; --highlight-duration: 0.65s; }
  .stage-5 { --highlight-delay: 3.0s; --highlight-duration: 0.65s; }
  .stage-6 { --highlight-delay: 3.7s; --highlight-duration: 0.8s; }

  .film-indicator {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Travels through the six box centers (95, 245, 395, 545, 695, 845 —
       each 150px apart) with a short dwell inside each box, matching the
       highlight timing above. */
    @keyframes film-travel {
      0%,
      14% {
        transform: translate(0, 0);
      }
      18%,
      32% {
        transform: translate(150px, 0);
      }
      36%,
      50% {
        transform: translate(300px, 0);
      }
      54%,
      68% {
        transform: translate(450px, 0);
      }
      72%,
      86% {
        transform: translate(600px, 0);
      }
      90%,
      100% {
        transform: translate(750px, 0);
      }
    }

    @keyframes film-fade {
      0%,
      4% {
        opacity: 0;
      }
      8%,
      92% {
        opacity: 1;
      }
      96%,
      100% {
        opacity: 0;
      }
    }

    .playing .film-indicator {
      animation:
        film-travel 4.5s ease-in-out 0.2s,
        film-fade 4.5s linear 0.2s;
    }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".film-processor-diagram");
</script>
