---
// Redesigned Figure 1-11 (الاجزاء الرئيسة لجهاز معالجة الافلام الشعاعية
// الالي) using the diagram-01..10 dark neumorphic simulator system.
// Last of the 11 Chapter 1 diagrams converted; uses the shared
// shell/controller (src/styles/diagram-simulator.css +
// src/scripts/diagramSimulator.js).
//
// Geometry unchanged (every stage box, roller/tube/tray/bin detail,
// label and the film-travel keyframe timing identical to the prior
// build) — only fill/stroke treatment and the interaction/animation
// layer changed.
//
// Color mapping: this diagram isn't an electrical energy-flow circuit
// (it's a film transported sequentially through six process stations),
// so the yellow/orange/purple power-system colors don't apply. Every
// transport stage uses the same blue "active" accent (matching how
// diagram-06 handles its own non-energy-flow comparison); the control
// box (صندوق السيطرة) is a genuine control unit, so it keeps the
// green control color established in every other diagram.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft film-processor-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة جهاز معالجة الأفلام الشعاعية</span>
      <span class="simulator-subtitle">شكل 1-11 — مسار الفلم عبر الوحدات</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="film-processor-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="940"
          height="360"
          viewBox="0 0 940 360"
          role="img"
          aria-label="الاجزاء الرئيسة لجهاز معالجة الافلام الشعاعية الالي"
        >
          <defs>
            <marker id="arrow-film" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="filmBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="filmGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="filmGradStage" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#132038"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <linearGradient id="filmGradControl" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>

            <filter id="filmElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="filmGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="940" height="360" rx="20" fill="url(#filmBgGrad)"></rect>
          <rect x="0" y="0" width="940" height="360" rx="20" fill="url(#filmGrid)"></rect>

          <text x="470.0" y="40" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مسار الفلم عبر وحدات جهاز معالجة الأفلام الشعاعية الآلي</text>

          <!-- Stage 1: film entry (tray wedge + slot) -->
          <g class="hotspot" data-component="entry" tabindex="0" role="button" aria-label="فتحة إدخال الفلم">
            <rect class="box-shape" x="30" y="100" width="130" height="120" rx="10" fill="url(#filmGradStage)" stroke="#38BDF8" stroke-width="2" filter="url(#filmElevate)"></rect>
            <polygon points="30,150 2,138 2,182 30,170" fill="#4ADE80" stroke="#8b94aa" stroke-width="1.5"></polygon>
            <rect x="34" y="145" width="20" height="30" fill="#C084FC" stroke="#8b94aa" stroke-width="1.5"></rect>
            <text x="95.0" y="155.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">فتحة إدخال</text>
            <text x="95.0" y="177.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الفلم</text>
          </g>
          <g class="link" data-link="entry" data-link-to="developer">
            <line x1="160" y1="160.0" x2="180" y2="160.0" stroke="#5b6478" stroke-width="2" marker-end="url(#arrow-film)"></line>
            <line class="trail trail-blue" x1="160" y1="160.0" x2="178" y2="160.0" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <!-- Stage 2: developer tank with roller racks -->
          <g class="hotspot" data-component="developer" tabindex="0" role="button" aria-label="خزان المظهر">
            <rect class="box-shape" x="180" y="100" width="130" height="120" rx="10" fill="url(#filmGradStage)" stroke="#38BDF8" stroke-width="2" filter="url(#filmElevate)"></rect>
            <g fill="#7dd3fc" stroke="#8b94aa" stroke-width="1.2">
              <circle cx="205" cy="120" r="6"></circle>
              <circle cx="225" cy="120" r="6"></circle>
              <circle cx="205" cy="136" r="6"></circle>
              <circle cx="225" cy="136" r="6"></circle>
              <circle cx="205" cy="152" r="6"></circle>
              <circle cx="225" cy="152" r="6"></circle>
            </g>
            <text x="255.0" y="150.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">خزان</text>
            <text x="255.0" y="172.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المظهر</text>
          </g>
          <g class="link" data-link="developer" data-link-to="fixer">
            <line x1="310" y1="160.0" x2="330" y2="160.0" stroke="#5b6478" stroke-width="2" marker-end="url(#arrow-film)"></line>
            <line class="trail trail-blue" x1="310" y1="160.0" x2="328" y2="160.0" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <!-- Stage 3: fixer tank with roller racks -->
          <g class="hotspot" data-component="fixer" tabindex="0" role="button" aria-label="خزان المثبت">
            <rect class="box-shape" x="330" y="100" width="130" height="120" rx="10" fill="url(#filmGradStage)" stroke="#38BDF8" stroke-width="2" filter="url(#filmElevate)"></rect>
            <g fill="#7dd3fc" stroke="#8b94aa" stroke-width="1.2">
              <circle cx="355" cy="120" r="6"></circle>
              <circle cx="375" cy="120" r="6"></circle>
              <circle cx="355" cy="136" r="6"></circle>
              <circle cx="375" cy="136" r="6"></circle>
              <circle cx="355" cy="152" r="6"></circle>
              <circle cx="375" cy="152" r="6"></circle>
            </g>
            <text x="405.0" y="150.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">خزان</text>
            <text x="405.0" y="172.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المثبت</text>
          </g>
          <g class="link" data-link="fixer" data-link-to="wash">
            <line x1="460" y1="160.0" x2="480" y2="160.0" stroke="#5b6478" stroke-width="2" marker-end="url(#arrow-film)"></line>
            <line class="trail trail-blue" x1="460" y1="160.0" x2="478" y2="160.0" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <!-- Stage 4: wash tank, single roller pair -->
          <g class="hotspot" data-component="wash" tabindex="0" role="button" aria-label="خزان الغسيل">
            <rect class="box-shape" x="480" y="100" width="130" height="120" rx="10" fill="url(#filmGradStage)" stroke="#38BDF8" stroke-width="2" filter="url(#filmElevate)"></rect>
            <g fill="#e2e8f0" stroke="#8b94aa" stroke-width="1.2">
              <circle cx="505" cy="130" r="7"></circle>
              <circle cx="525" cy="130" r="7"></circle>
              <circle cx="505" cy="150" r="7"></circle>
              <circle cx="525" cy="150" r="7"></circle>
            </g>
            <text x="565.0" y="150.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">خزان</text>
            <text x="565.0" y="172.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الغسيل</text>
          </g>
          <g class="link" data-link="wash" data-link-to="dryer">
            <line x1="610" y1="160.0" x2="630" y2="160.0" stroke="#5b6478" stroke-width="2" marker-end="url(#arrow-film)"></line>
            <line class="trail trail-blue" x1="610" y1="160.0" x2="628" y2="160.0" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <!-- Stage 5: dryer with air tubes -->
          <g class="hotspot" data-component="dryer" tabindex="0" role="button" aria-label="وحدة التجفيف">
            <rect class="box-shape" x="630" y="100" width="130" height="120" rx="10" fill="url(#filmGradStage)" stroke="#38BDF8" stroke-width="2" filter="url(#filmElevate)"></rect>
            <g stroke="#fb923c" stroke-width="2">
              <line x1="650" y1="112" x2="650" y2="168"></line>
              <line x1="662" y1="112" x2="662" y2="168"></line>
              <line x1="674" y1="112" x2="674" y2="168"></line>
            </g>
            <circle cx="695" cy="140" r="12" fill="#0d1420" stroke="#8b94aa" stroke-width="1.5"></circle>
            <path d="M 695,132 L 699,140 L 695,148 L 691,140 Z" fill="#fb923c"></path>
            <text x="695.0" y="115.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">وحدة</text>
            <text x="695.0" y="200.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">التجفيف</text>
          </g>
          <g class="link" data-link="dryer" data-link-to="output">
            <line x1="760" y1="160.0" x2="780" y2="160.0" stroke="#5b6478" stroke-width="2" marker-end="url(#arrow-film)"></line>
            <line class="trail trail-blue" x1="760" y1="160.0" x2="778" y2="160.0" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <!-- Stage 6: film-receiving bin -->
          <g class="hotspot" data-component="output" tabindex="0" role="button" aria-label="حاوية استلام الفلم">
            <rect class="box-shape" x="780" y="100" width="130" height="120" rx="10" fill="url(#filmGradStage)" stroke="#38BDF8" stroke-width="2" filter="url(#filmElevate)"></rect>
            <polygon points="805,190 855,190 845,210 815,210" fill="#94a3b8" stroke="#8b94aa" stroke-width="1.5"></polygon>
            <text x="845.0" y="140.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">حاوية استلام</text>
            <text x="845.0" y="162.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الفلم</text>
          </g>

          <!-- Control box: a real labeled component, added beneath the row -->
          <g class="hotspot" data-component="controlBox" tabindex="0" role="button" aria-label="صندوق السيطرة">
            <rect class="box-shape" x="30" y="260" width="90" height="60" rx="8" fill="url(#filmGradControl)" stroke="#4ADE80" stroke-width="2" filter="url(#filmElevate)"></rect>
            <rect x="45" y="272" width="18" height="14" fill="#0d1420" stroke="#4ADE80" stroke-width="1"></rect>
            <circle cx="90" cy="280" r="6" fill="#0d1420" stroke="#4ADE80" stroke-width="1"></circle>
            <text x="75.0" y="245.0" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="rtl">صندوق السيطرة</text>
            <line x1="120" y1="290" x2="160" y2="230" stroke="#8b94aa" stroke-width="1.5" stroke-dasharray="3 3"></line>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <rect class="film-indicator" x="80" y="195" width="30" height="10" rx="3" fill="#eef1f8" filter="url(#filmGlow)"></rect>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="entry"><span class="status-dot dot-blue"></span><span class="status-label">فتحة الإدخال</span><span class="status-value"><span class="value-off">لم يصل</span><span class="value-on">وصل الفلم</span></span></li>
          <li class="status-row" data-status="developer"><span class="status-dot dot-blue"></span><span class="status-label">خزان المظهر</span><span class="status-value"><span class="value-off">لم يصل</span><span class="value-on">وصل الفلم</span></span></li>
          <li class="status-row" data-status="fixer"><span class="status-dot dot-blue"></span><span class="status-label">خزان المثبت</span><span class="status-value"><span class="value-off">لم يصل</span><span class="value-on">وصل الفلم</span></span></li>
          <li class="status-row" data-status="wash"><span class="status-dot dot-blue"></span><span class="status-label">خزان الغسيل</span><span class="status-value"><span class="value-off">لم يصل</span><span class="value-on">وصل الفلم</span></span></li>
          <li class="status-row" data-status="dryer"><span class="status-dot dot-blue"></span><span class="status-label">وحدة التجفيف</span><span class="status-value"><span class="value-off">لم يصل</span><span class="value-on">وصل الفلم</span></span></li>
          <li class="status-row" data-status="output"><span class="status-dot dot-blue"></span><span class="status-label">حاوية الاستلام</span><span class="status-value"><span class="value-off">لم يصل</span><span class="value-on">وصل الفلم</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>مسار نقل الفلم</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>وحدة السيطرة</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#filmElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#filmElevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.015);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#filmGlow);
  }

  .film-indicator {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes film-travel {
      0%, 14% { transform: translate(0, 0); }
      18%, 32% { transform: translate(150px, 0); }
      36%, 50% { transform: translate(300px, 0); }
      54%, 68% { transform: translate(450px, 0); }
      72%, 86% { transform: translate(600px, 0); }
      90%, 100% { transform: translate(750px, 0); }
    }
    @keyframes film-fade {
      0%, 4% { opacity: 0; }
      8%, 92% { opacity: 1; }
      96%, 100% { opacity: 0; }
    }
    .playing .film-indicator {
      animation: film-travel 4.5s ease-in-out 0.2s, film-fade 4.5s linear 0.2s;
    }

    @keyframes film-shape-activate { to { filter: url(#filmElevate) saturate(1.35) brightness(1.4); } }
    @keyframes film-reveal-trail { to { opacity: 0.85; } }
    @keyframes film-status-value-on { to { opacity: 1; } }
    @keyframes film-status-value-off { to { opacity: 0; } }
    @keyframes film-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes film-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="entry"] .box-shape { animation: film-shape-activate 0.55s ease-out 0.2s forwards; }
    .playing [data-status="entry"] .status-dot { animation: film-dot-on-blue 0.4s ease-out 0.3s forwards; }
    .playing [data-status="entry"] .value-on { animation: film-status-value-on 0.4s ease-out 0.3s forwards; }
    .playing [data-status="entry"] .value-off { animation: film-status-value-off 0.4s ease-out 0.3s forwards; }
    .playing [data-link="entry"] .trail { animation: film-reveal-trail 0.3s ease-out 0.85s forwards; }
    .playing [data-component="controlBox"] .box-shape { animation: film-shape-activate 0.55s ease-out 0.2s forwards; }
    .playing [data-status="controlBox"] .status-dot { animation: film-dot-on-green 0.4s ease-out 0.3s forwards; }

    .playing [data-component="developer"] .box-shape { animation: film-shape-activate 0.55s ease-out 0.9s forwards; }
    .playing [data-status="developer"] .status-dot { animation: film-dot-on-blue 0.4s ease-out 1.0s forwards; }
    .playing [data-status="developer"] .value-on { animation: film-status-value-on 0.4s ease-out 1.0s forwards; }
    .playing [data-status="developer"] .value-off { animation: film-status-value-off 0.4s ease-out 1.0s forwards; }
    .playing [data-link="developer"] .trail { animation: film-reveal-trail 0.3s ease-out 1.55s forwards; }

    .playing [data-component="fixer"] .box-shape { animation: film-shape-activate 0.55s ease-out 1.6s forwards; }
    .playing [data-status="fixer"] .status-dot { animation: film-dot-on-blue 0.4s ease-out 1.7s forwards; }
    .playing [data-status="fixer"] .value-on { animation: film-status-value-on 0.4s ease-out 1.7s forwards; }
    .playing [data-status="fixer"] .value-off { animation: film-status-value-off 0.4s ease-out 1.7s forwards; }
    .playing [data-link="fixer"] .trail { animation: film-reveal-trail 0.3s ease-out 2.25s forwards; }

    .playing [data-component="wash"] .box-shape { animation: film-shape-activate 0.55s ease-out 2.3s forwards; }
    .playing [data-status="wash"] .status-dot { animation: film-dot-on-blue 0.4s ease-out 2.4s forwards; }
    .playing [data-status="wash"] .value-on { animation: film-status-value-on 0.4s ease-out 2.4s forwards; }
    .playing [data-status="wash"] .value-off { animation: film-status-value-off 0.4s ease-out 2.4s forwards; }
    .playing [data-link="wash"] .trail { animation: film-reveal-trail 0.3s ease-out 2.95s forwards; }

    .playing [data-component="dryer"] .box-shape { animation: film-shape-activate 0.55s ease-out 3.0s forwards; }
    .playing [data-status="dryer"] .status-dot { animation: film-dot-on-blue 0.4s ease-out 3.1s forwards; }
