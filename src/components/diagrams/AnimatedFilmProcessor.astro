---
// Animated Figure 1-11 (الاجزاء الرئيسة لجهاز معالجة الافلام الشعاعية
// الالي). Markup matches diagram-11-film-processor.svg exactly — same
// six boxes, positions, colors, arrows, labels. Teaches the process
// itself: a film indicator travels left to right through every stage in
// the same order the text describes them (entry -> developer -> fixer ->
// wash -> dryer -> output), with each stage box highlighting only while
// the film is "in" it. Level 1 — this figure exists specifically to show
// a sequential process, the clearest possible fit for that treatment.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram film-processor-diagram">
  <div class="diagram-block-image">
    <svg
      class="film-processor-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="940"
      height="320"
      viewBox="0 0 940 320"
      role="img"
      aria-label="الاجزاء الرئيسة لجهاز معالجة الافلام الشعاعية الالي"
    >
      <defs>
        <marker id="arrow-film" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="940" height="320" fill="none"></rect>

      <rect class="flow-highlight stage-1" x="30" y="100" width="130" height="120" rx="6" fill="#dbeafe" stroke="#263238" stroke-width="2"></rect>
      <text x="95.0" y="155.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">فتحة إدخال</text>
      <text x="95.0" y="177.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الفلم</text>
      <line x1="160" y1="160.0" x2="180" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <rect class="flow-highlight stage-2" x="180" y="100" width="130" height="120" rx="6" fill="#bbf7d0" stroke="#263238" stroke-width="2"></rect>
      <text x="245.0" y="155.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">خزان</text>
      <text x="245.0" y="177.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المظهر</text>
      <line x1="310" y1="160.0" x2="330" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <rect class="flow-highlight stage-3" x="330" y="100" width="130" height="120" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <text x="395.0" y="155.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">خزان</text>
      <text x="395.0" y="177.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المثبت</text>
      <line x1="460" y1="160.0" x2="480" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <rect class="flow-highlight stage-4" x="480" y="100" width="130" height="120" rx="6" fill="#bae6fd" stroke="#263238" stroke-width="2"></rect>
      <text x="545.0" y="155.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">خزان</text>
      <text x="545.0" y="177.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الغسيل</text>
      <line x1="610" y1="160.0" x2="630" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <rect class="flow-highlight stage-5" x="630" y="100" width="130" height="120" rx="6" fill="#fde68a" stroke="#263238" stroke-width="2"></rect>
      <text x="695.0" y="155.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">وحدة</text>
      <text x="695.0" y="177.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">التجفيف</text>
      <line x1="760" y1="160.0" x2="780" y2="160.0" stroke="#263238" stroke-width="2" marker-end="url(#arrow-film)"></line>

      <rect class="flow-highlight stage-6" x="780" y="100" width="130" height="120" rx="6" fill="#dbeafe" stroke="#263238" stroke-width="2"></rect>
      <text x="845.0" y="155.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">حاوية استلام</text>
      <text x="845.0" y="177.0" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الفلم</text>

      <text x="470.0" y="40" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مسار الفلم عبر وحدات جهاز معالجة الأفلام الشعاعية الآلي</text>

      <g class="flow-layer" aria-hidden="true">
        <rect class="film-indicator" x="80" y="195" width="30" height="10" rx="3" fill="#1d4ed8"></rect>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 4.9s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 560px;
    display: flex;
    justify-content: center;
  }

  .film-processor-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .stage-1 { --highlight-delay: 0.2s; --highlight-duration: 0.65s; }
  .stage-2 { --highlight-delay: 0.9s; --highlight-duration: 0.65s; }
  .stage-3 { --highlight-delay: 1.6s; --highlight-duration: 0.65s; }
  .stage-4 { --highlight-delay: 2.3s; --highlight-duration: 0.65s; }
  .stage-5 { --highlight-delay: 3.0s; --highlight-duration: 0.65s; }
  .stage-6 { --highlight-delay: 3.7s; --highlight-duration: 0.8s; }

  .film-indicator {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Travels through the six box centers (95, 245, 395, 545, 695, 845 —
       each 150px apart) with a short dwell inside each box, matching the
       highlight timing above. */
    @keyframes film-travel {
      0%,
      14% {
        transform: translate(0, 0);
      }
      18%,
      32% {
        transform: translate(150px, 0);
      }
      36%,
      50% {
        transform: translate(300px, 0);
      }
      54%,
      68% {
        transform: translate(450px, 0);
      }
      72%,
      86% {
        transform: translate(600px, 0);
      }
      90%,
      100% {
        transform: translate(750px, 0);
      }
    }

    @keyframes film-fade {
      0%,
      4% {
        opacity: 0;
      }
      8%,
      92% {
        opacity: 1;
      }
      96%,
      100% {
        opacity: 0;
      }
    }

    .playing .film-indicator {
      animation:
        film-travel 4.5s ease-in-out 0.2s,
        film-fade 4.5s linear 0.2s;
    }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".film-processor-diagram");
</script>
