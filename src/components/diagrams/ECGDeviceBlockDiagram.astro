---
// Figure 21-3 (المخطط الكتلوي لجهاز تخطيط القلب) rebuilt as the
// chapter's flagship dark neumorphic interactive simulator, following
// the exact Chapter 1/2 system (mirrors the role of Figure 1-1 in
// Chapter 1 and the block diagrams of Chapter 2).
//
// Geometry mirrors the book's own block diagram exactly: signal path
// (input stage -> lead selector -> pre-amp -> main amp -> driver ->
// galvanometer -> paper drive/motor), the patient RL voltage-equalizer
// feedback loop, and the power chain (power supply -> voltage regulator
// -> stylus heat).
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft ecg-device-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة المخطط الكتلوي لجهاز تخطيط القلب</span>
      <span class="simulator-subtitle">شكل 21-3 — من قابلو المريض الى رسم الإشارة على الورق</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="ed-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="1000"
          height="480"
          viewBox="0 0 1000 480"
          role="img"
          aria-label="المخطط الكتلوي لجهاز تخطيط القلب"
        >
          <defs>
            <marker id="ed-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="edBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="edGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="edGradGreen" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>
            <linearGradient id="edGradOrange" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332210"></stop>
              <stop offset="100%" stop-color="#1a1108"></stop>
            </linearGradient>
            <linearGradient id="edGradYellow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332c10"></stop>
              <stop offset="100%" stop-color="#1a1608"></stop>
            </linearGradient>
            <linearGradient id="edGradBlue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="edGradPurple" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </linearGradient>

            <filter id="edElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="9" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="9" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="7" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3.5" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="3" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.3" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="edGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="1000" height="480" rx="20" fill="url(#edBgGrad)"></rect>
          <rect x="0" y="0" width="1000" height="480" rx="20" fill="url(#edGrid)"></rect>

          <!-- signal chain: top row -->
          <g class="hotspot" data-component="inputStage" tabindex="0" role="button" aria-label="مرحلة إدخال الإشارة">
            <rect class="box-shape" x="30" y="60" width="110" height="60" rx="10" fill="url(#edGradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="85" y="85" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">إدخال الإشارة</text>
            <text x="85" y="102" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Input Stage</text>
          </g>

          <g class="hotspot" data-component="leadSelector" tabindex="0" role="button" aria-label="مفتاح اختيار الليدات">
            <rect class="box-shape" x="175" y="60" width="105" height="60" rx="10" fill="url(#edGradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="227" y="85" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">اختيار الليدات</text>
            <text x="227" y="102" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Lead Selector</text>
          </g>

          <g class="hotspot" data-component="preAmp" tabindex="0" role="button" aria-label="المكبر الأولي">
            <rect class="box-shape" x="315" y="60" width="100" height="60" rx="10" fill="url(#edGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="365" y="85" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المكبر الأولي</text>
            <text x="365" y="102" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">Pre-Amp</text>
          </g>

          <g class="hotspot" data-component="mainAmp" tabindex="0" role="button" aria-label="المكبر الرئيسي">
            <rect class="box-shape" x="450" y="60" width="100" height="60" rx="10" fill="url(#edGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="500" y="85" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المكبر الرئيسي</text>
            <text x="500" y="102" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FB923C" text-anchor="middle" direction="ltr">Main Amp</text>
          </g>

          <g class="hotspot" data-component="driver" tabindex="0" role="button" aria-label="مسوق الإشارة القلبية">
            <rect class="box-shape" x="585" y="60" width="100" height="60" rx="10" fill="url(#edGradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="635" y="80" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مسوق الإشارة</text>
            <text x="635" y="97" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">القلبية</text>
            <text x="635" y="112" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Driver</text>
          </g>

          <g class="hotspot" data-component="galvanometer" tabindex="0" role="button" aria-label="الكلفانوميتر">
            <rect class="box-shape" x="720" y="55" width="110" height="70" rx="10" fill="url(#edGradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="775" y="85" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الكلفانوميتر</text>
            <text x="775" y="103" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Galvanometer</text>
          </g>

          <g class="hotspot" data-component="paperDrive" tabindex="0" role="button" aria-label="محرك الورق">
            <rect class="box-shape" x="870" y="55" width="100" height="70" rx="10" fill="url(#edGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="920" y="80" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">محرك الورق</text>
            <text x="920" y="97" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Paper Drive</text>
            <circle cx="920" cy="112" r="8" fill="#0a0f1a" stroke="#38BDF8" stroke-width="1.5"></circle>
            <text x="920" y="115" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">M</text>
          </g>

          <!-- patient RL equalizer feedback -->
          <g class="hotspot" data-component="rlEqualizer" tabindex="0" role="button" aria-label="معادلة فولتية المريض">
            <rect class="box-shape" x="30" y="180" width="110" height="55" rx="10" fill="url(#edGradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="85" y="202" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">معادلة فولتية</text>
            <text x="85" y="217" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">المريض (RL)</text>
          </g>

          <!-- power chain: bottom row -->
          <g class="hotspot" data-component="powerSupply" tabindex="0" role="button" aria-label="تجهيز القدرة">
            <rect class="box-shape" x="280" y="330" width="120" height="60" rx="10" fill="url(#edGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="340" y="355" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">تجهيز القدرة</text>
            <text x="340" y="372" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Power Supply</text>
          </g>

          <g class="hotspot" data-component="voltageRegulator" tabindex="0" role="button" aria-label="منظم الفولتية">
            <rect class="box-shape" x="440" y="330" width="120" height="60" rx="10" fill="url(#edGradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="500" y="355" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">منظم الفولتية</text>
            <text x="500" y="372" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Voltage Regulator</text>
          </g>

          <g class="hotspot" data-component="stylus" tabindex="0" role="button" aria-label="القلم الحراري">
            <rect class="box-shape" x="600" y="330" width="110" height="60" rx="10" fill="url(#edGradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#edElevate)"></rect>
            <text x="655" y="355" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">القلم الحراري</text>
            <text x="655" y="372" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Stylus</text>
          </g>

          <!-- connections -->
          <g class="link" data-link="inputStage" data-link-to="leadSelector">
            <line x1="140" y1="90" x2="175" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-green" x1="140" y1="90" x2="173" y2="90" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="leadSelector" data-link-to="preAmp">
            <line x1="280" y1="90" x2="315" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-green" x1="280" y1="90" x2="313" y2="90" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="preAmp" data-link-to="mainAmp">
            <line x1="415" y1="90" x2="450" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-orange" x1="415" y1="90" x2="448" y2="90" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="mainAmp" data-link-to="driver">
            <line x1="550" y1="90" x2="585" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-orange" x1="550" y1="90" x2="583" y2="90" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="driver" data-link-to="galvanometer">
            <line x1="685" y1="90" x2="720" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-purple" x1="685" y1="90" x2="718" y2="90" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="galvanometer" data-link-to="paperDrive">
            <line x1="830" y1="90" x2="870" y2="90" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-purple" x1="830" y1="90" x2="868" y2="90" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="rlEqualizer" data-link-to="inputStage">
            <path d="M 85,180 L 85,120" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></path>
            <path class="trail trail-green" d="M 85,180 L 85,122" fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="powerSupply" data-link-to="voltageRegulator">
            <line x1="400" y1="360" x2="440" y2="360" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-yellow" x1="400" y1="360" x2="438" y2="360" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="voltageRegulator" data-link-to="stylus">
            <line x1="560" y1="360" x2="600" y2="360" stroke="#5b6478" stroke-width="2" marker-end="url(#ed-arrow)"></line>
            <line class="trail trail-yellow" x1="560" y1="360" x2="598" y2="360" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <path d="M 655,330 L 655,180 L 775,180 L 775,125" fill="none" stroke="#3a4258" stroke-width="1.5" stroke-dasharray="3 5" marker-end="url(#ed-arrow)"></path>
          <text x="700" y="175" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">تسخين قلم الرسم</text>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="140" cy="90" r="5" fill="#4ADE80" filter="url(#edGlow)" style="--tx:35px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="280" cy="90" r="5" fill="#4ADE80" filter="url(#edGlow)" style="--tx:35px; --ty:0px; --particle-delay:0.6s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="415" cy="90" r="5" fill="#FB923C" filter="url(#edGlow)" style="--tx:35px; --ty:0px; --particle-delay:1.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="550" cy="90" r="5" fill="#FB923C" filter="url(#edGlow)" style="--tx:35px; --ty:0px; --particle-delay:1.6s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="685" cy="90" r="5" fill="#C084FC" filter="url(#edGlow)" style="--tx:35px; --ty:0px; --particle-delay:2.1s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="830" cy="90" r="5" fill="#C084FC" filter="url(#edGlow)" style="--tx:40px; --ty:0px; --particle-delay:2.6s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="inputStage"><span class="status-dot dot-green"></span><span class="status-label">إدخال الإشارة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="rlEqualizer"><span class="status-dot dot-green"></span><span class="status-label">معادلة الرجل اليمنى</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="leadSelector"><span class="status-dot dot-green"></span><span class="status-label">اختيار الليدات</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="preAmp"><span class="status-dot dot-orange"></span><span class="status-label">المكبر الأولي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="mainAmp"><span class="status-dot dot-orange"></span><span class="status-label">المكبر الرئيسي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="driver"><span class="status-dot dot-purple"></span><span class="status-label">مسوق الإشارة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="galvanometer"><span class="status-dot dot-purple"></span><span class="status-label">الكلفانوميتر</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="paperDrive"><span class="status-dot dot-blue"></span><span class="status-label">محرك الورق</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="powerSupply"><span class="status-dot dot-yellow"></span><span class="status-label">تجهيز القدرة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="voltageRegulator"><span class="status-dot dot-yellow"></span><span class="status-label">منظم الفولتية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="stylus"><span class="status-dot dot-blue"></span><span class="status-label">القلم الحراري</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مرحلة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الإشارة القلبية</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>التكبير</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>التسويق والرسم</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>القدرة الكهربائية</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الميكانيكية</li>
    </ul>
  </div>

