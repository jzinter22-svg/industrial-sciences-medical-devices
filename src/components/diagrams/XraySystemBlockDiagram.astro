    @keyframes status-value-off {
      to { opacity: 0; }
    }
    @keyframes dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    /* Stage 1 — power (0.0s -> ~0.9s) */
    .playing .trail-power { animation: reveal-trail 0.5s ease-out 0s forwards, scroll-dash 1.1s linear 0s 3; }
    .playing [data-component="power"] text { animation: box-activate 0.5s ease-out 0s forwards; }
    .playing .p-power-a { animation: move-power-a 1.0s ease-in-out 0.05s 2; }
    .playing .p-power-b { animation: move-power-b 1.0s ease-in-out 0.05s 2; }
    @keyframes move-power-a { 0% { transform: translate(0,0); opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { transform: translate(180px,0); opacity: 0; } }
    @keyframes move-power-b { 0% { transform: translate(0,0); opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { transform: translate(180px,0); opacity: 0; } }
    .playing [data-status="power"] .status-dot { animation: dot-on-yellow 0.4s ease-out 0.1s forwards; }
    .playing [data-status="power"] .value-on { animation: status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="power"] .value-off { animation: status-value-off 0.4s ease-out 0.1s forwards; }

