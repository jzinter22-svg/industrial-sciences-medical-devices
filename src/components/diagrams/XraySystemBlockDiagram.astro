---
// PILOT — 3D interactive redesign of Figure 1-1 (المخطط الكتلوي لجهاز
// الاشعة السينية). Scope: this component only (see
// docs/design/DIAGRAM_ANIMATION_AUDIT.md row 1, which named the prior
// version "the benchmark, not redesigned" — this pass supersedes that
// note for diagram-01 alone; every other diagram is untouched).
//
// Topology (box positions, which block connects to which) is UNCHANGED
// from the prior build and traces exactly to the textbook's own review
// answer at src/data/chapter-01/page-14.json ("intro-exam-q7" block,
// "المخطط الكتلوي (الشكل 1-1) يبين مسار القدرة من مجهز القدرة الرئيسي
// الى السيطرة على KV، ومنها الى مولدة الضغط العالي، ثم الى انبوبة
// الاشعة السينية، مع دائرتين مرتبطتين بهذا المسار: دائرة السيطرة على
// زمن الاشعاع ... ودائرة السيطرة mA ..."), which is itself a direct
// textual description of this exact diagram and explicitly tells the
// student to watch the animated version step by step. Only corner
// radius (6 -> 14, purely cosmetic) and fill/stroke treatment changed;
// no box moved, resized (beyond that radius), or relabeled.
//
// New, additive only: a radiation beam + "المنضدة والبكي" (the fifth
// listed component on this same page, component-05 — not invented)
// target beneath the tube box, in the previously-empty viewBox space
// x:760-890 / y:310-480 (tube box's own width, directly below it).
//
// Color semantics (energy type, not decoration): yellow = mains power,
// green = control signal (exposure-timer + mA/filament circuits, per
// the textbook passage above), orange = high-voltage generation, blue
// = current (the kV/mA meters literally read voltage/current), purple
// = X-ray radiation. Tooltip copy for every hotspot is a verbatim
// excerpt (truncated with "…" where shortened, never reworded) from
// this chapter's own definitions — see the COMPONENT_INFO map below,
// each entry commented with its source block id.
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft xray-block-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة جهاز الاشعة السينية</span>
      <span class="simulator-subtitle">شكل 1-1 — المخطط الكتلوي</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="xray-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="480"
          viewBox="0 0 900 480"
          role="img"
          aria-label="المخطط الكتلوي لجهاز الاشعة السينية"
        >
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#B9C3D6"></path>
            </marker>

            <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>

            <pattern id="techGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>

            <linearGradient id="gradPower" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a2f10"></stop>
              <stop offset="100%" stop-color="#18140a"></stop>
            </linearGradient>
            <linearGradient id="gradControl" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>
            <linearGradient id="gradGenerator" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a2210"></stop>
              <stop offset="100%" stop-color="#1a0f08"></stop>
            </linearGradient>
            <linearGradient id="gradTube" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2e2044"></stop>
              <stop offset="100%" stop-color="#150e22"></stop>
            </linearGradient>
            <linearGradient id="gradMeter" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="gradOutput" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#22293a"></stop>
              <stop offset="100%" stop-color="#12161f"></stop>
            </linearGradient>

            <!-- Neumorphic "raised" emboss: an outer dark shadow (bottom-
                 right) PLUS an outer light halo (top-left, opposite the
                 shadow — this pairing is what actually reads as an
                 extruded/embossed surface rather than a flat card with a
                 drop-shadow) plus a matching inner dark crease + inner
                 light catch along the same diagonal, so the box itself
                 looks domed/beveled, not flat. All in one filter graph
                 (an SVG filter attribute can only reference one
                 <filter>, so every layer lives here). -->
            <filter id="elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>

              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>

              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>

              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.38" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>

              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="softGlow" x="-140%" y="-140%" width="380%" height="380%">
              <feGaussianBlur stdDeviation="9"></feGaussianBlur>
            </filter>
            <!-- Used on the thin energy trails/particles: a blurred halo
                 merged UNDER the crisp original, so the line itself stays
                 thin and readable instead of smearing into a blob (which
                 a bare feGaussianBlur, as used for softGlow above, would
                 do to something this thin). -->
            <filter id="lineGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.4" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="beamGlow" x="-170%" y="-90%" width="440%" height="280%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="5.5" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="480" rx="22" fill="url(#bgGrad)"></rect>
          <rect x="0" y="0" width="900" height="480" rx="22" fill="url(#techGrid)"></rect>

          <!-- ============ Main power feed ============ -->
          <g class="hotspot" data-component="power" tabindex="0" role="button" aria-label="مجهز القدرة الرئيسي">
            <text x="115.0" y="207.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="rtl">مجهز</text>
            <text x="115.0" y="224.0" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="rtl">القدرة</text>
            <line x1="60" y1="225" x2="170" y2="225" stroke="#5b6478" stroke-width="3" stroke-linecap="round" marker-start="url(#arrow)"></line>
            <line x1="60" y1="255" x2="170" y2="255" stroke="#5b6478" stroke-width="3" stroke-linecap="round" marker-start="url(#arrow)"></line>
            <line class="trail trail-power" x1="60" y1="225" x2="170" y2="225" stroke="#FBBF24" stroke-width="3" stroke-linecap="round" stroke-dasharray="8 10"></line>
            <line class="trail trail-power" x1="60" y1="255" x2="170" y2="255" stroke="#FBBF24" stroke-width="3" stroke-linecap="round" stroke-dasharray="8 10"></line>
          </g>

          <!-- ============ Link: power -> kV control ============ -->
          <g class="link" data-link="power" data-link-to="controlKv">
            <line x1="170" y1="225" x2="240" y2="225" stroke="#5b6478" stroke-width="3"></line>
            <line x1="170" y1="255" x2="240" y2="255" stroke="#5b6478" stroke-width="3"></line>
            <line class="trail trail-power" x1="170" y1="225" x2="240" y2="225" stroke="#FBBF24" stroke-width="3" stroke-dasharray="8 10"></line>
            <line class="trail trail-power" x1="170" y1="255" x2="240" y2="255" stroke="#FBBF24" stroke-width="3" stroke-dasharray="8 10"></line>
            <circle class="particle p-power-a" cx="175" cy="225" r="4.5"></circle>
            <circle class="particle p-power-b" cx="175" cy="255" r="4.5"></circle>
          </g>

          <!-- ============ kV control box ============ -->
          <g class="hotspot" data-component="controlKv" tabindex="0" role="button" aria-label="السيطرة على KV">
            <rect class="box-shape" x="240" y="170" width="130" height="140" rx="14" fill="url(#gradControl)" stroke="#FBBF24" stroke-width="2" filter="url(#elevate)"></rect>
            <rect class="box-active-glow glow-yellow" x="240" y="170" width="130" height="140" rx="14" fill="none" stroke="#FBBF24" stroke-width="3"></rect>
            <rect x="250" y="176" width="110" height="8" rx="4" fill="#ffffff" opacity="0.08"></rect>
            <text x="305.0" y="232.0" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">السيطرة</text>
            <text x="305.0" y="252.0" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">على KV</text>
            <text x="305.0" y="292.0" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#FBBF24" text-anchor="middle" direction="rtl" opacity="0.85">kV Control</text>
          </g>

          <!-- ============ High-voltage generator box ============ -->
          <g class="hotspot" data-component="generator" tabindex="0" role="button" aria-label="مولدة الضغط العالي">
            <rect class="box-shape" x="560" y="170" width="130" height="140" rx="14" fill="url(#gradGenerator)" stroke="#FB923C" stroke-width="2" filter="url(#elevate)"></rect>
            <rect class="box-active-glow glow-orange" x="560" y="170" width="130" height="140" rx="14" fill="none" stroke="#FB923C" stroke-width="3"></rect>
            <rect x="570" y="176" width="110" height="8" rx="4" fill="#ffffff" opacity="0.08"></rect>
            <text x="625.0" y="232.0" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">مولدة</text>
            <text x="625.0" y="252.0" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">الضغط العالي</text>
            <text x="625.0" y="292.0" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#FB923C" text-anchor="middle" direction="rtl" opacity="0.85">HV Generator</text>
          </g>

          <!-- ============ X-ray tube box ============ -->
          <g class="hotspot" data-component="tube" tabindex="0" role="button" aria-label="انبوبة الاشعة السينية">
            <rect class="box-shape" x="760" y="170" width="130" height="140" rx="14" fill="url(#gradTube)" stroke="#C084FC" stroke-width="2" filter="url(#elevate)"></rect>
            <rect class="box-active-glow glow-purple" x="760" y="170" width="130" height="140" rx="14" fill="none" stroke="#C084FC" stroke-width="3"></rect>
            <rect x="770" y="176" width="110" height="8" rx="4" fill="#ffffff" opacity="0.08"></rect>
            <text x="825.0" y="232.0" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">انبوبة</text>
            <text x="825.0" y="252.0" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">الاشعة السينية</text>
            <text x="825.0" y="292.0" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#C084FC" text-anchor="middle" direction="rtl" opacity="0.85">X-ray Tube</text>
          </g>

          <!-- ============ Exposure-time control box ============ -->
          <g class="hotspot" data-component="controlExposure" tabindex="0" role="button" aria-label="السيطرة على زمن الاشعاع">
            <rect class="box-shape" x="330" y="40" width="220" height="70" rx="14" fill="url(#gradControl)" stroke="#4ADE80" stroke-width="2" filter="url(#elevate)"></rect>
            <rect class="box-active-glow glow-green" x="330" y="40" width="220" height="70" rx="14" fill="none" stroke="#4ADE80" stroke-width="3"></rect>
            <rect x="338" y="46" width="204" height="6" rx="3" fill="#ffffff" opacity="0.08"></rect>
            <text x="440" y="65" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">السيطرة على</text>
            <text x="440" y="85" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">زمن الاشعاع</text>
            <text x="440" y="103" font-family="Cairo, sans-serif" font-size="9" font-weight="600" fill="#4ADE80" text-anchor="middle" direction="rtl" opacity="0.85">Timer Control</text>
          </g>

          <!-- ============ mA / filament control box ============ -->
          <g class="hotspot" data-component="controlMa" tabindex="0" role="button" aria-label="دائرة السيطرة mA (دائرة الفتيل)">
            <rect class="box-shape" x="420" y="350" width="240" height="70" rx="14" fill="url(#gradControl)" stroke="#4ADE80" stroke-width="2" filter="url(#elevate)"></rect>
            <rect class="box-active-glow glow-green" x="420" y="350" width="240" height="70" rx="14" fill="none" stroke="#4ADE80" stroke-width="3"></rect>
            <rect x="428" y="356" width="224" height="6" rx="3" fill="#ffffff" opacity="0.08"></rect>
            <text x="540" y="378" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#F5F2E8" text-anchor="middle" direction="rtl">دائرة السيطرة mA</text>
            <text x="540" y="397" font-family="Cairo, sans-serif" font-size="11" font-weight="600" fill="#F5F2E8" text-anchor="middle" direction="rtl">(دائرة الفتيل)</text>
            <text x="540" y="413" font-family="Cairo, sans-serif" font-size="9" font-weight="600" fill="#4ADE80" text-anchor="middle" direction="rtl" opacity="0.85">mA / Filament</text>
          </g>

          <!-- ============ Meters ============ -->
          <g class="hotspot" data-component="meterKv" tabindex="0" role="button" aria-label="مبين KV">
            <circle class="box-shape" cx="430" cy="240" r="18" fill="url(#gradMeter)" stroke="#38BDF8" stroke-width="2" filter="url(#elevate)"></circle>
            <line class="meter-needle needle-kv" x1="430" y1="240" x2="440" y2="227" stroke="#38BDF8" stroke-width="2.4" stroke-linecap="round"></line>
            <circle cx="430" cy="240" r="2.4" fill="#e2f3ff"></circle>
            <text x="430" y="277" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="rtl">مبين KV</text>
          </g>
          <g class="hotspot" data-component="meterMa" tabindex="0" role="button" aria-label="مبين mA">
            <circle class="box-shape" cx="710" cy="240" r="18" fill="url(#gradMeter)" stroke="#38BDF8" stroke-width="2" filter="url(#elevate)"></circle>
            <line class="meter-needle needle-ma" x1="710" y1="240" x2="720" y2="227" stroke="#38BDF8" stroke-width="2.4" stroke-linecap="round"></line>
            <circle cx="710" cy="240" r="2.4" fill="#e2f3ff"></circle>
            <text x="710" y="277" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="rtl">مبين mA</text>
          </g>

          <!-- ============ Link: kV control -> HV generator ============ -->
          <g class="link" data-link="controlKv" data-link-to="generator">
            <line x1="370" y1="225" x2="410" y2="225" stroke="#5b6478" stroke-width="3"></line>
            <line x1="370" y1="255" x2="410" y2="255" stroke="#5b6478" stroke-width="3"></line>
            <line x1="450" y1="240" x2="560" y2="240" stroke="#5b6478" stroke-width="3"></line>
            <line class="trail trail-orange" x1="370" y1="225" x2="410" y2="225" stroke="#FB923C" stroke-width="3" stroke-dasharray="8 10"></line>
            <line class="trail trail-orange" x1="370" y1="255" x2="410" y2="255" stroke="#FB923C" stroke-width="3" stroke-dasharray="8 10"></line>
            <line class="trail trail-orange" x1="450" y1="240" x2="560" y2="240" stroke="#FB923C" stroke-width="3" stroke-dasharray="8 10"></line>
            <circle class="particle p-kv-out-a" cx="376" cy="225" r="4.5"></circle>
            <circle class="particle p-kv-out-b" cx="376" cy="255" r="4.5"></circle>
          </g>

          <!-- ============ Link: HV generator -> tube ============ -->
          <g class="link" data-link="generator" data-link-to="tube">
            <line x1="690" y1="225" x2="710" y2="225" stroke="#5b6478" stroke-width="3"></line>
            <line x1="690" y1="255" x2="730" y2="255" stroke="#5b6478" stroke-width="3"></line>
            <line x1="730" y1="225" x2="760" y2="225" stroke="#5b6478" stroke-width="3"></line>
            <line x1="690" y1="240" x2="760" y2="240" stroke="#5b6478" stroke-width="3"></line>
            <line class="trail trail-blue" x1="690" y1="225" x2="710" y2="225" stroke="#38BDF8" stroke-width="3" stroke-dasharray="8 10"></line>
            <line class="trail trail-blue" x1="690" y1="255" x2="730" y2="255" stroke="#38BDF8" stroke-width="3" stroke-dasharray="8 10"></line>
            <line class="trail trail-blue" x1="730" y1="225" x2="760" y2="225" stroke="#38BDF8" stroke-width="3" stroke-dasharray="8 10"></line>
            <line class="trail trail-blue" x1="690" y1="240" x2="760" y2="240" stroke="#38BDF8" stroke-width="3" stroke-dasharray="8 10"></line>
            <circle class="particle p-gen-out-a" cx="696" cy="225" r="4.5"></circle>
            <circle class="particle p-gen-out-b" cx="696" cy="255" r="4.5"></circle>
          </g>

          <!-- ============ Link: exposure-timer -> kV control / generator ============ -->
          <g class="link" data-link="controlExposure" data-link-to="controlKv">
            <line x1="370" y1="110" x2="370" y2="170" stroke="#5b6478" stroke-width="3" marker-end="url(#arrow)"></line>
            <line x1="440" y1="110" x2="440" y2="40" stroke="#5b6478" stroke-width="3"></line>
            <line class="trail trail-green" x1="370" y1="110" x2="370" y2="170" stroke="#4ADE80" stroke-width="3" stroke-dasharray="7 9"></line>
            <circle class="particle p-exposure-direct" cx="370" cy="116" r="4.5"></circle>
          </g>
          <g class="link" data-link="controlExposure" data-link-to="generator">
            <line x1="300" y1="170" x2="300" y2="130" stroke="#5b6478" stroke-width="3"></line>
            <line x1="300" y1="130" x2="625" y2="130" stroke="#5b6478" stroke-width="3"></line>
            <line x1="625" y1="130" x2="625" y2="170" stroke="#5b6478" stroke-width="3" marker-end="url(#arrow)"></line>
            <line class="trail trail-green" x1="300" y1="170" x2="300" y2="130" stroke="#4ADE80" stroke-width="3" stroke-dasharray="7 9"></line>
            <line class="trail trail-green" x1="300" y1="130" x2="625" y2="130" stroke="#4ADE80" stroke-width="3" stroke-dasharray="7 9"></line>
            <line class="trail trail-green" x1="625" y1="130" x2="625" y2="170" stroke="#4ADE80" stroke-width="3" stroke-dasharray="7 9"></line>
            <circle class="particle p-exposure-bus" cx="300" cy="164" r="4.5"></circle>
          </g>

          <!-- ============ Link: mA/filament -> kV control / tube ============ -->
          <g class="link" data-link="controlMa" data-link-to="controlKv">
            <line x1="495" y1="350" x2="495" y2="310" stroke="#5b6478" stroke-width="3"></line>
            <line x1="305" y1="310" x2="495" y2="310" stroke="#5b6478" stroke-width="3"></line>
            <line class="trail trail-green" x1="495" y1="350" x2="495" y2="310" stroke="#4ADE80" stroke-width="3" stroke-dasharray="7 9"></line>
            <line class="trail trail-green" x1="305" y1="310" x2="495" y2="310" stroke="#4ADE80" stroke-width="3" stroke-dasharray="7 9"></line>
            <circle class="particle p-ma-left" cx="489" cy="310" r="4.5"></circle>
          </g>
          <g class="link" data-link="controlMa" data-link-to="tube">
            <line x1="495" y1="310" x2="825" y2="310" stroke="#5b6478" stroke-width="3"></line>
