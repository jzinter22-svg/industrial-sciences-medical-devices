---
// Animated version of Figure 1-1 (المخطط الكتلوي لجهاز الاشعة السينية).
//
// The SVG markup below is byte-for-byte the same figure as
// public/assets/diagrams/chapter-01/diagram-01-block-diagram.svg — same
// viewBox, same box positions/sizes/colors, same arrows, same Arabic
// labels, same caption. Nothing about the approved diagram was
// redesigned. Two additive-only changes make it animatable:
//   1. `class` hooks on the existing boxes/meters (KV control, HV
//      generator, X-ray tube, the two auxiliary control boxes, the two
//      meters) — inert in the resting state, they only matter once
//      `.playing` is toggled on the wrapper.
//   2. A new <g class="flow-layer"> appended AFTER all existing content,
//      holding the moving particles and the tube's glow — purely additive,
//      so it never displaces or hides any original element.
//
// Every particle travels along coordinates taken directly from the
// existing <line> elements it visually follows (see the coordinates
// inline below) rather than a redrawn/approximated path.
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft xray-block-diagram">
  <div class="diagram-block-image">
    <svg
      class="xray-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="900"
      height="480"
      viewBox="0 0 900 480"
      role="img"
      aria-label="المخطط الكتلوي لجهاز الاشعة السينية"
    >
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
        <filter id="tubeGlowBlur" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="10"></feGaussianBlur>
        </filter>
      </defs>

      <rect x="0" y="0" width="900" height="480" fill="none"></rect>

      <text x="115.0" y="241.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهز</text>
      <text x="115.0" y="261.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">القدرة</text>

      <rect class="flow-box flow-box-kv" x="240" y="190" width="130" height="100" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <text x="305.0" y="236.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">السيطرة</text>
      <text x="305.0" y="256.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">على KV</text>

      <rect class="flow-box flow-box-generator" x="560" y="190" width="130" height="100" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <text x="625.0" y="236.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مولدة</text>
      <text x="625.0" y="256.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الضغط العالي</text>

      <rect class="flow-box flow-box-tube" x="760" y="190" width="130" height="100" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <text x="825.0" y="236.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">انبوبة</text>
      <text x="825.0" y="256.0" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الاشعة السينية</text>

      <rect class="flow-box flow-box-exposure" x="330" y="40" width="220" height="70" rx="6" fill="#bbf7d0" stroke="#263238" stroke-width="2"></rect>
      <text x="440" y="68" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">السيطرة على</text>
      <text x="440" y="90" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">زمن الاشعاع</text>

      <rect class="flow-box flow-box-ma-circuit" x="420" y="350" width="240" height="70" rx="6" fill="#bbf7d0" stroke="#263238" stroke-width="2"></rect>
      <text x="540" y="378" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">دائرة السيطرة mA</text>
      <text x="540" y="400" font-family="Cairo, sans-serif" font-size="13" font-weight="600" fill="#263238" text-anchor="middle" direction="rtl">(دائرة الفتيل)</text>

      <circle class="flow-meter flow-meter-kv" cx="430" cy="240" r="20" fill="#fff" stroke="#c2410c" stroke-width="2"></circle>
      <text x="430" y="245" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#c2410c" text-anchor="middle" direction="rtl">KV</text>

      <circle class="flow-meter flow-meter-ma" cx="710" cy="240" r="20" fill="#fff" stroke="#c2410c" stroke-width="2"></circle>
      <text x="710" y="245" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#c2410c" text-anchor="middle" direction="rtl">mA</text>

      <line x1="170" y1="225" x2="240" y2="225" stroke="#263238" stroke-width="2"></line>
      <line x1="170" y1="255" x2="240" y2="255" stroke="#263238" stroke-width="2"></line>
      <line x1="370" y1="225" x2="410" y2="225" stroke="#263238" stroke-width="2"></line>
      <line x1="370" y1="255" x2="410" y2="255" stroke="#263238" stroke-width="2"></line>
      <line x1="450" y1="240" x2="560" y2="240" stroke="#263238" stroke-width="2"></line>
      <line x1="690" y1="225" x2="710" y2="225" stroke="#263238" stroke-width="2"></line>
      <line x1="690" y1="255" x2="730" y2="255" stroke="#263238" stroke-width="2"></line>
      <line x1="730" y1="225" x2="760" y2="225" stroke="#263238" stroke-width="2"></line>
      <line x1="690" y1="240" x2="760" y2="240" stroke="#263238" stroke-width="2"></line>
      <line x1="60" y1="225" x2="170" y2="225" stroke="#263238" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="60" y1="255" x2="170" y2="255" stroke="#263238" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="370" y1="110" x2="370" y2="190" stroke="#263238" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="440" y1="110" x2="440" y2="40" stroke="#263238" stroke-width="2"></line>
      <line x1="300" y1="190" x2="300" y2="130" stroke="#263238" stroke-width="2"></line>
      <line x1="300" y1="130" x2="625" y2="130" stroke="#263238" stroke-width="2"></line>
      <line x1="625" y1="130" x2="625" y2="190" stroke="#263238" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="495" y1="350" x2="495" y2="290" stroke="#263238" stroke-width="2"></line>
      <line x1="305" y1="290" x2="825" y2="290" stroke="#263238" stroke-width="2"></line>

      <!-- Additive animation layer — every element below is new; nothing
           above this comment was altered. aria-hidden because the flow is
           a supplementary visual explanation of a sequence already stated
           in the surrounding text; the diagram's own labels remain the
           accessible content. -->
      <g class="flow-layer" aria-hidden="true">
        <rect class="tube-glow" x="760" y="190" width="130" height="100" rx="10" fill="#1d4ed8" filter="url(#tubeGlowBlur)"></rect>

        <circle class="particle p-power-top" cx="60" cy="225" r="5"></circle>
        <circle class="particle p-power-bottom" cx="60" cy="255" r="5"></circle>

        <circle class="particle p-kv-out-top" cx="370" cy="225" r="5"></circle>
        <circle class="particle p-kv-out-bottom" cx="370" cy="255" r="5"></circle>

        <circle class="particle p-gen-out-top" cx="690" cy="225" r="5"></circle>
        <circle class="particle p-gen-out-bottom" cx="690" cy="255" r="5"></circle>

        <circle class="particle p-ma-rise" cx="495" cy="350" r="5"></circle>
        <circle class="particle p-ma-left" cx="495" cy="290" r="5"></circle>
        <circle class="particle p-ma-right" cx="495" cy="290" r="5"></circle>

        <circle class="particle p-exposure-direct" cx="370" cy="110" r="5"></circle>
        <circle class="particle p-exposure-bus" cx="300" cy="190" r="5"></circle>

        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 480px;
    display: flex;
    justify-content: center;
  }

  .xray-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .diagram-controls {
    display: flex;
    justify-content: center;
    gap: var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .diagram-replay-button {
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    color: var(--neo-primary);
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-replay-button:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  .diagram-replay-button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  /* Resting state: particles and the tube glow are fully inert — zero
     opacity, no animation — so the figure is pixel-identical to the
     unanimated version until the viewer explicitly presses play. */
  .particle {
    fill: var(--neo-primary);
    opacity: 0;
  }

  .tube-glow {
    opacity: 0;
  }

  .flow-box,
  .flow-meter {
    transition: none;
  }

  /* Reduced motion: no timeline exists to opt into, so the controls that
     would start one are removed and the figure simply stays static — the
     same precedent already used for the Tomography diagram's replay
     button. */
  @media (prefers-reduced-motion: reduce) {
    .diagram-controls {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* ---- highlight pulses (box/meter get a temporary glow, then return
       to their exact original fill/stroke — every keyframe's 0% and 100%
       stop is the neutral state) ---- */
    @keyframes box-pulse {
      0%, 100% { filter: none; stroke: #263238; stroke-width: 2px; }
      50% { filter: drop-shadow(0 0 10px rgba(29, 78, 216, 0.85)); stroke: #1d4ed8; stroke-width: 3.5px; }
    }

    @keyframes meter-pulse {
      0%, 100% { filter: none; stroke: #c2410c; }
      50% { filter: drop-shadow(0 0 8px rgba(194, 65, 12, 0.9)); stroke: #ea580c; }
    }

    @keyframes tube-glow-pulse {
      0%, 100% { opacity: 0; }
      50% { opacity: 0.55; }
    }

    @keyframes particle-fade {
      0%, 100% { opacity: 0; }
      10%, 90% { opacity: 1; }
    }

    .playing .flow-box-kv { animation: box-pulse 0.6s ease-in-out 1.1s, box-pulse 0.6s ease-in-out 7.6s; }
    .playing .flow-box-generator { animation: box-pulse 0.6s ease-in-out 2.6s, box-pulse 0.6s ease-in-out 7.9s; }
    .playing .flow-box-tube { animation: box-pulse 0.8s ease-in-out 4.1s, box-pulse 1.0s ease-in-out 8.2s; }
    .playing .flow-box-ma-circuit { animation: box-pulse 1.5s ease-in-out 5.4s; }
    .playing .flow-box-exposure { animation: box-pulse 1.5s ease-in-out 7.2s; }
    .playing .flow-meter-kv { animation: meter-pulse 0.6s ease-in-out 2.0s; }
    .playing .flow-meter-ma { animation: meter-pulse 0.6s ease-in-out 3.5s; }

    .playing .tube-glow { animation: tube-glow-pulse 1.2s ease-in-out 4.1s, tube-glow-pulse 1.2s ease-in-out 8.2s; }

    /* ---- particles: each travels along coordinates taken from the
       existing line it rides (see the <line> elements above). translate,
       not cx/cy, for broad browser support. ---- */
    @keyframes move-power-top { 0% { transform: translate(0, 0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(180px, 0); opacity: 0; } }
    @keyframes move-power-bottom { 0% { transform: translate(0, 0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(180px, 0); opacity: 0; } }
    .playing .p-power-top { animation: move-power-top 1.0s linear 0.3s; }
    .playing .p-power-bottom { animation: move-power-bottom 1.0s linear 0.3s; }

    @keyframes move-kv-out-top {
      0% { transform: translate(0, 0); opacity: 0; }
      10% { opacity: 1; }
      33% { transform: translate(40px, 0); }
      66% { transform: translate(60px, 15px); }
      90% { opacity: 1; }
      100% { transform: translate(190px, 15px); opacity: 0; }
    }
    @keyframes move-kv-out-bottom {
      0% { transform: translate(0, 0); opacity: 0; }
      10% { opacity: 1; }
      33% { transform: translate(40px, 0); }
      66% { transform: translate(60px, -15px); }
      90% { opacity: 1; }
      100% { transform: translate(190px, -15px); opacity: 0; }
    }
    .playing .p-kv-out-top { animation: move-kv-out-top 1.2s ease-in-out 1.6s; }
    .playing .p-kv-out-bottom { animation: move-kv-out-bottom 1.2s ease-in-out 1.6s; }

    @keyframes move-gen-out-top {
      0% { transform: translate(0, 0); opacity: 0; }
      10% { opacity: 1; }
      40% { transform: translate(20px, 0); }
      70% { transform: translate(40px, 15px); }
      90% { opacity: 1; }
      100% { transform: translate(70px, 0); opacity: 0; }
    }
    @keyframes move-gen-out-bottom {
      0% { transform: translate(0, 0); opacity: 0; }
      10% { opacity: 1; }
      40% { transform: translate(20px, 0); }
      70% { transform: translate(40px, -15px); }
      90% { opacity: 1; }
      100% { transform: translate(70px, -30px); opacity: 0; }
    }
    .playing .p-gen-out-top { animation: move-gen-out-top 1.2s ease-in-out 3.1s; }
    .playing .p-gen-out-bottom { animation: move-gen-out-bottom 1.2s ease-in-out 3.1s; }

    @keyframes move-ma-rise { 0% { transform: translate(0, 0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(0, -60px); opacity: 0; } }
    @keyframes move-ma-left { 0% { transform: translate(0, 0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(-190px, 0); opacity: 0; } }
    @keyframes move-ma-right { 0% { transform: translate(0, 0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(330px, 0); opacity: 0; } }
    .playing .p-ma-rise { animation: move-ma-rise 0.3s linear 5.4s; }
    .playing .p-ma-left { animation: move-ma-left 1.2s ease-out 5.7s; fill: #c2410c; }
    .playing .p-ma-right { animation: move-ma-right 1.2s ease-out 5.7s; fill: #c2410c; }

    @keyframes move-exposure-direct { 0% { transform: translate(0, 0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(0, 80px); opacity: 0; } }
    @keyframes move-exposure-bus {
      0% { transform: translate(0, 0); opacity: 0; }
      10% { opacity: 1; }
      35% { transform: translate(0, -60px); }
      75% { transform: translate(325px, -60px); }
      90% { opacity: 1; }
      100% { transform: translate(325px, 0); opacity: 0; }
    }
    .playing .p-exposure-direct { animation: move-exposure-direct 0.7s ease-in 7.4s; fill: #15803d; }
    .playing .p-exposure-bus { animation: move-exposure-bus 1.1s ease-in-out 7.4s; fill: #15803d; }

    /* Silent marker whose sole job is to fire one animationend at the
       exact moment the whole sequence is over, so the script can drop
       .playing and return every element to its neutral resting state
       (Step 7) without guessing which visual animation finishes last. */
    @keyframes cycle-end { to { opacity: 0; } }
    .playing .cycle-end-marker { animation: cycle-end 0.01s linear 9.4s; }
  }
</style>

<script>
  document.querySelectorAll(".xray-block-diagram").forEach((wrapper) => {
    const playButton = wrapper.querySelector(".play-button");
    const resetButton = wrapper.querySelector(".reset-button");
    const marker = wrapper.querySelector(".cycle-end-marker");
    if (!playButton || !resetButton || !marker) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const start = () => {
      if (reducedMotion.matches) return;
      wrapper.classList.add("playing");
      playButton.setAttribute("disabled", "true");
    };

    const stop = () => {
      wrapper.classList.remove("playing");
      playButton.removeAttribute("disabled");
    };

    const restart = () => {
      wrapper.classList.remove("playing");
      // Force reflow so the next class add re-triggers the CSS animations
      // instead of being a no-op (the same technique DiagramFrame uses
      // for its own replay button).
      void (wrapper as HTMLElement).offsetWidth;
      start();
    };

    playButton.addEventListener("click", start);
    resetButton.addEventListener("click", restart);
    marker.addEventListener("animationend", stop);
  });
</script>
