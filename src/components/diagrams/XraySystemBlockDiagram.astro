    .playing [data-link="generator"] .trail-blue { animation: reveal-trail 0.5s ease-out 3.0s forwards, scroll-dash 1.0s linear 3.0s 3; }
    .playing .needle-ma { animation: needle-sweep 0.6s ease-out 3.1s forwards; }
    .playing .p-gen-out-a { animation: move-gen-out 1.0s ease-in-out 3.1s 2; }
    .playing .p-gen-out-b { animation: move-gen-out 1.0s ease-in-out 3.1s 2; }
    @keyframes move-gen-out { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(70px,0); opacity: 0; } }

    /* Stage 5 — tube becomes active (4.1s -> ~5.1s) */
    .playing [data-component="tube"] .box-shape { animation: box-activate 0.6s ease-out 4.1s forwards; }
    .playing [data-component="tube"] .box-active-glow { animation: glow-in 0.6s ease-out 4.1s forwards; }
    .playing [data-status="tube"] .status-dot { animation: dot-on-blue 0.4s ease-out 4.2s forwards; }
    .playing [data-status="tube"] .value-on { animation: status-value-on 0.4s ease-out 4.2s forwards; }
    .playing [data-status="tube"] .value-off { animation: status-value-off 0.4s ease-out 4.2s forwards; }

