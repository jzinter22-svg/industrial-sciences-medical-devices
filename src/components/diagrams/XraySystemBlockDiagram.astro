    .playing .p-radiation-a { animation: move-radiation 0.9s ease-in 5.2s 3; }
    .playing .p-radiation-b { animation: move-radiation 0.9s ease-in 5.55s 3; }
    @keyframes move-radiation { 0% { transform: translate(0,0); opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translate(0,76px); opacity: 0; } }
    @keyframes beam-pulse { 0%, 100% { stroke-width: 4; opacity: 0.85; } 50% { stroke-width: 6; opacity: 1; } }
    .playing [data-component="output"] .box-shape { animation: box-activate 0.5s ease-out 5.9s forwards; }
    .playing [data-component="output"] .box-active-glow { animation: glow-in 0.5s ease-out 5.9s forwards; }
    .playing [data-status="radiation"] .status-dot { animation: dot-on-purple 0.4s ease-out 5.9s forwards; }
    .playing [data-status="radiation"] .value-on { animation: status-value-on 0.4s ease-out 5.9s forwards; }
    .playing [data-status="radiation"] .value-off { animation: status-value-off 0.4s ease-out 5.9s forwards; }

  }
</style>

<script>
  interface ComponentInfo {
    title: string;
    text: string;
  }

  // Verbatim excerpts from this chapter's own definitions — see the
  // block id noted per entry. Truncated with "…" only at natural
  // sentence/clause boundaries; wording is never altered.
  const COMPONENT_INFO: Record<string, ComponentInfo> = {
    power: {
      title: "مجهز القدرة الرئيسي",
      // src/data/chapter-01/page-02.json #definition-main-power-supply
      text: "يتم تجهيز جهاز الاشعة السينية من مصدر تجهيز القدرة الرئيسي اما احادي الطور (220V-50Hz) او ثلاثي الطور (380V-50Hz) اعتمادا على قدرة الاجهزة.",
    },
    controlKv: {
      title: "السيطرة على KV",
      // src/data/chapter-01/page-04.json #definition-hv-control
      text: "يتم السيطرة على طاقة الاشعة السينية التي تخترق الجسم المراد تصويره من خلال السيطرة على الفولتية العالية التي تجهز أنبوبة الاشعة السينية.",
    },
    controlExposure: {
      title: "السيطرة على زمن الاشعاع",
      // src/data/chapter-01/page-05.json definition "ج" (timer circuit)
      text: "يتم السيطرة على فترة اشعاع الاشعة السينية بواسطة دائرة كهربائية تحدد بداية الاشعاع ونهايته والفترة الزمنية للاشعاع.",
    },
    controlMa: {
      title: "دائرة السيطرة mA (دائرة الفتيل)",
      // src/data/chapter-01/page-04.json #definition-tube-current-control
      text: "يتم السيطرة على شدة الإشعاع من خلال التغيير في عدد الالكترونات التي تنبعث من تسخين فتيل أنبوبة الاشعة السينية.",
    },
    generator: {
      title: "مولدة الضغط العالي",
      // src/data/chapter-01/page-07.json #hv-generator-intro
      text: "يمكن الحصول على هذه الفولتية العالية من محولة رافعة تغذى من المصدر الرئيسي للفولتية، وتربط دائرة موحد (Rectifier) على الملف الثانوي لمحولة الضغط العالي…",
    },
    meterKv: {
      title: "مبين KV",
      // src/data/chapter-01/page-06.json #definition (kV-meter)
      text: "وهو مقياس يبين للمصور الشعاعي الفولتية العالية التي يمكن الحصول عليها من المواقع المختلفة لمفتاح اختيار (kV) والتي تغذي بها انبوبة الاشعة.",
    },
    meterMa: {
      title: "مبين mA",
      // src/data/chapter-01/page-06.json #definition (mA-meter)
      text: "وهو مقياس يبين قيمة التيار المار في انبوبة الاشعة، وبالنتيجة يقيس التيار المار في الدائرة الثانوية لمحولة الضغط العالي.",
    },
    tube: {
      title: "انبوبة الاشعة السينية",
      // src/data/chapter-01/page-03.json definition of the Anode
      text: "الانود (المصعد) هو القطب الموجب لانبوبة الاشعة السينية، وهو هدف فلزي تصطدم به الالكترونات السريعة جدا والقادمة من الكاثود…",
    },
    output: {
      title: "المنضدة والبكي",
      // src/data/chapter-01/page-10.json list item "table-c"
      text: "منضدة أشعة أساسية مع منضدة متحركة مزودة ببكي يقبل كافة قياسات الأفلام الشعاعية.",
    },
  };

  document.querySelectorAll(".xray-block-diagram").forEach((wrapper) => {
    const shell = wrapper.querySelector(".simulator-shell");
    const playButton = wrapper.querySelector(".play-button") as HTMLButtonElement | null;
    const pauseButton = wrapper.querySelector(".pause-button") as HTMLButtonElement | null;
    const resetButton = wrapper.querySelector(".reset-button") as HTMLButtonElement | null;
    const speedUpButton = wrapper.querySelector(".speed-up-button") as HTMLButtonElement | null;
    const speedDownButton = wrapper.querySelector(".speed-down-button") as HTMLButtonElement | null;
    if (!shell || !playButton || !pauseButton || !resetButton) return;

    // A plain timer fires stop() once the sequence's hold is over — no
    // SVG element needs to survive as an animationend source. The timer
    // runs in real wall-clock time, so it is re-armed (not just
    // paused/resumed) around every pause, resume, and speed change,
    // tracked against the *nominal* (rate=1) time remaining in the
    // cycle so it always matches wherever the CSS animations actually
    // are via getAnimations().playbackRate.
    const CYCLE_MS = 8200;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let endTimer: number | null = null;
    let playbackRate = 1;
    let isPlaying = false;
    let isPaused = false;
    let remainingNominalMs = CYCLE_MS;
    let timerArmedAt = 0;

    const clearEndTimer = () => {
      if (endTimer !== null) {
        window.clearTimeout(endTimer);
        endTimer = null;
      }
    };

    const armEndTimer = () => {
      clearEndTimer();
      timerArmedAt = performance.now();
      endTimer = window.setTimeout(stop, remainingNominalMs / playbackRate);
    };

    // Call before pausing/clearing/rate-changing an in-flight timer so
    // remainingNominalMs always reflects the true remaining nominal time.
    const captureElapsed = () => {
      if (endTimer === null) return;
      const elapsedRealMs = performance.now() - timerArmedAt;
      remainingNominalMs = Math.max(0, remainingNominalMs - elapsedRealMs * playbackRate);
    };

    const setAllAnimations = (fn: (a: Animation) => void) => {
      wrapper.querySelectorAll("*").forEach((el) => el.getAnimations().forEach(fn));
    };

    const setPlaybackRate = (rate: number) => {
      if (!isPlaying) {
        playbackRate = rate;
        return;
      }
      captureElapsed();
      playbackRate = rate;
      setAllAnimations((a) => { a.playbackRate = playbackRate; });
      if (!isPaused) armEndTimer();
    };

    function stop() {
      isPlaying = false;
      isPaused = false;
      shell?.classList.remove("playing");
      clearEndTimer();
      remainingNominalMs = CYCLE_MS;
      playButton!.removeAttribute("disabled");
      pauseButton!.setAttribute("disabled", "true");
      pauseButton!.dataset.paused = "false";
      pauseButton!.textContent = "⏸ إيقاف مؤقت";
    }

    const start = () => {
      if (reducedMotion.matches) return;
      isPlaying = true;
      isPaused = false;
      remainingNominalMs = CYCLE_MS;
      shell?.classList.add("playing");
      playButton!.setAttribute("disabled", "true");
      pauseButton!.removeAttribute("disabled");
      pauseButton!.dataset.paused = "false";
      pauseButton!.textContent = "⏸ إيقاف مؤقت";
      armEndTimer();
    };

    const restart = () => {
      shell?.classList.remove("playing");
      void (wrapper as HTMLElement).offsetWidth;
      start();
    };

    playButton.addEventListener("click", start);
    resetButton.addEventListener("click", restart);

    pauseButton.addEventListener("click", () => {
      if (!isPlaying) return;
      if (isPaused) {
        isPaused = false;
        setAllAnimations((a) => a.play());
        armEndTimer();
        pauseButton.dataset.paused = "false";
        pauseButton.textContent = "⏸ إيقاف مؤقت";
      } else {
        isPaused = true;
        captureElapsed();
        clearEndTimer();
        setAllAnimations((a) => a.pause());
        pauseButton.dataset.paused = "true";
        pauseButton.textContent = "▶ استئناف";
      }
    });

    speedUpButton?.addEventListener("click", () => setPlaybackRate(Math.min(playbackRate + 0.5, 3)));
    speedDownButton?.addEventListener("click", () => setPlaybackRate(Math.max(playbackRate - 0.5, 0.25)));

    // ---- component focus mode (hover preview + click-to-lock) ----
    const hotspots = Array.from(wrapper.querySelectorAll<HTMLElement>(".hotspot"));
    const links = Array.from(wrapper.querySelectorAll<HTMLElement>(".link"));
    const infoHint = wrapper.querySelector<HTMLElement>("[data-info-hint]");
    const infoContent = wrapper.querySelector<HTMLElement>("[data-info-content]");
    const infoTitle = wrapper.querySelector<HTMLElement>("[data-info-title]");
    const infoText = wrapper.querySelector<HTMLElement>("[data-info-text]");
    let selected: string | null = null;

    const applyFocus = (id: string | null) => {
      shell.classList.toggle("has-selection", !!id);
      hotspots.forEach((h) => h.classList.toggle("is-selected", h.dataset.component === id));
      links.forEach((l) => {
        const related = id !== null && (l.dataset.link === id || l.dataset.linkTo === id);
        l.classList.toggle("is-related", related);
      });

      if (!id || !infoHint || !infoContent || !infoTitle || !infoText) {
        if (infoHint) infoHint.hidden = false;
        if (infoContent) infoContent.hidden = true;
        return;
      }
      const info = COMPONENT_INFO[id];
      if (!info) return;
      infoHint.hidden = true;
      infoContent.hidden = false;
      infoTitle.textContent = info.title;
      infoText.textContent = info.text;
    };

    hotspots.forEach((hotspot) => {
      const id = hotspot.dataset.component ?? null;
      hotspot.addEventListener("mouseenter", () => {
        if (!selected) applyFocus(id);
      });
      hotspot.addEventListener("mouseleave", () => {
        if (!selected) applyFocus(null);
      });
      hotspot.addEventListener("focus", () => applyFocus(id));
      hotspot.addEventListener("blur", () => {
        if (!selected) applyFocus(null);
      });
      hotspot.addEventListener("click", () => {
        selected = selected === id ? null : id;
        applyFocus(selected);
      });
      hotspot.addEventListener("keydown", (event) => {
        const key = (event as KeyboardEvent).key;
        if (key === "Enter" || key === " ") {
          event.preventDefault();
          selected = selected === id ? null : id;
          applyFocus(selected);
        }
      });
    });
  });
</script>
