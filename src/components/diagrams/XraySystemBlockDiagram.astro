  @media (prefers-reduced-motion: no-preference) {
    /* ---- stage timeline — each element transitions once into its
       "active" state and holds there (animation-fill-mode: forwards)
       until .playing is removed at cycle end, so the diagram builds up
       stage by stage instead of pulsing element-by-element. ---- */

    @keyframes reveal-trail {
      0% { opacity: 0; }
      100% { opacity: 0.85; }
