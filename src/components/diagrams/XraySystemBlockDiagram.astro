    .playing [data-component="controlKv"] .box-shape { animation: box-activate 0.5s ease-out 0.9s forwards; }
    .playing [data-component="controlKv"] .box-active-glow { animation: glow-in 0.5s ease-out 0.9s forwards; }
    .playing [data-component="controlExposure"] .box-shape,
    .playing [data-component="controlMa"] .box-shape { animation: box-activate 0.5s ease-out 1.0s forwards; }
