  .diagram-replay-button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  /* ---- hotspot interaction (hover/focus/selected) — always enabled,
     including under reduced-motion, since these are instant state
     toggles driven by user intent, not an ambient/looping animation. ---- */
  .hotspot {
    cursor: pointer;
    outline: none;
  }

  .hotspot .box-shape {
    /* Still subdued relative to the active state (so activation reads
       as a clear focal point), but no longer washed-out at rest —
       colors stay present and readable, not flat/dull. */
    filter: url(#elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, stroke-width 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
