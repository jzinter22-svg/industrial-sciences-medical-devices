    .playing [data-link="controlKv"] .trail-orange { animation: reveal-trail 0.5s ease-out 1.9s forwards, scroll-dash 1.0s linear 1.9s 3; }
    .playing [data-component="generator"] .box-shape { animation: box-activate 0.5s ease-out 2.2s forwards; }
