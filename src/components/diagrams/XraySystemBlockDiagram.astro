    @keyframes move-exp-direct { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(0,54px); opacity: 0; } }
    @keyframes move-exp-bus { 0% { transform: translate(0,0); opacity: 0; } 8% { opacity: 1; } 30% { transform: translate(0,-34px); } 70% { transform: translate(325px,-34px); } 92% { opacity: 1; } 100% { transform: translate(325px,0); opacity: 0; } }
    @keyframes move-ma-left { 0% { transform: translate(0,0); opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { transform: translate(-184px,0); opacity: 0; } }
    @keyframes move-ma-right { 0% { transform: translate(0,0); opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { transform: translate(324px,0); opacity: 0; } }
    .playing [data-status="control"] .status-dot { animation: dot-on-green 0.4s ease-out 1.0s forwards; }
    .playing [data-status="control"] .value-on { animation: status-value-on 0.4s ease-out 1.0s forwards; }
    .playing [data-status="control"] .value-off { animation: status-value-off 0.4s ease-out 1.0s forwards; }

