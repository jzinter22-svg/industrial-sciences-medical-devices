      text: "نقطة التوزيع التي تُغذّي لوحة التحكم ومفتاح الطوارئ وجميع ستارترات المحركات بالتيار الكهربائي.",
    },
    "control-panel": {
      title: "لوحة التحكم (Control Panel)",
      text: "تحتوي على أزرار التشغيل والإيقاف واختيار الجهاز، ويستخدمها الطبيب أو الفني للتحكم بعمل الوحدة.",
    },
    "emergency-stop": {
      title: "مفتاح الطوارئ (Emergency Stop)",
      text: "يقطع التيار عن كامل الجهاز فوراً عند وجود خطر أو عطل مفاجئ، ويُعاد ضبطه يدوياً بعد التأكد من زوال الخطر.",
    },
    "compressor-starter": {
      title: "ستارتر محرك الضاغط (Compressor Starter)",
      text: "يشغّل محرك وحدة الضاغط الهوائي عند الطلب، ويحميه من التيار الزائد أثناء بدء الدوران.",
    },
    "chair-starter": {
      title: "ستارتر مضخة الكرسي (Chair Starter)",
      text: "يشغّل المضخة الهيدروليكية المسؤولة عن حركة كرسي المريض عند الضغط على أزرار التحكم.",
    },
    "suction-starter": {
      title: "ستارتر مضخة الشفط (Suction Starter)",
      text: "يشغّل مضخة نظام الشفط، وغالباً ما يعمل بشكل متواصل أثناء ساعات عمل العيادة.",
    },
    "status-indicators": {
      title: "لوحة مؤشرات الحالة (Status Panel)",
      text: "تعرض حالة التشغيل الطبيعي، وتنبّه الفني إلى أي عطل أو تجاوز في الحمل أو ارتفاع في الضغط أو الحرارة.",
    },
  };

  wireDiagramSimulator(".electrical-control-system-diagram", { cycleMs: 4500, componentInfo: COMPONENT_INFO });

  // LIVING SIMULATION LAYER — a real emergency-stop is a latching fault,
  // not a momentary blip: once tripped, the status panel keeps saying so
  // (system-status + emergency-stop rows switch to a red FAULT badge)
  // until the operator deliberately presses Play or Reset, distinguishing
  // "emergency-tripped" from ordinary idle.
  const setEmergencyTripped = (shell: Element, tripped: boolean) => {
    if (!(shell instanceof HTMLElement)) return;
    shell.dataset.emergencyTripped = tripped ? "true" : "false";
    const badge = shell.querySelector('[data-status="system-status"] [data-fault-badge]');
    if (badge) {
      badge.textContent = tripped
        ? "متوقف — تم الضغط على مفتاح الطوارئ"
        : "معطّل — القاطع مفتوح";
    }
  };

  // Emergency-stop behaviour: clicking the emergency-stop hotspot while the
  // simulation is running performs a hard stop — every running animation is
  // cancelled outright and the shell is left idle, never touching the
  // reset button (which restarts and resumes playback, the opposite of an
  // emergency stop) — plus the red pulse flag, the one interaction in this
  // diagram that is *not* part of the normal play sequence.
  document.querySelectorAll(".electrical-control-system-diagram [data-component=\"emergency-stop\"]").forEach((hotspot) => {
    hotspot.addEventListener("click", () => {
      const shell = hotspot.closest(".simulator-shell");
      if (!shell || !shell.classList.contains("playing")) return;

      shell.querySelectorAll("*").forEach((el) => {
        el.getAnimations().forEach((a) => a.cancel());
      });
      shell.classList.remove("playing");

      const playButton = shell.querySelector(".play-button");
      const pauseButton = shell.querySelector(".pause-button");
      playButton?.removeAttribute("disabled");
      pauseButton?.setAttribute("disabled", "true");
      if (pauseButton instanceof HTMLElement) {
        pauseButton.dataset.paused = "false";
        pauseButton.textContent = "⏸ إيقاف مؤقت";
      }

      setEmergencyTripped(shell, true);

      shell.classList.remove("emergency-flash");
      void shell.offsetWidth;
      shell.classList.add("emergency-flash");
      shell.addEventListener("animationend", () => shell.classList.remove("emergency-flash"), { once: true });
    });
  });

  // Pressing Play after a trip is how the operator clears the fault (per
  // the existing requirement that Play alone can resume after an
  // emergency stop, with no separate interlock button).
  //
  // Note: .play-button/.reset-button live in .diagram-controls, a SIBLING
  // of .simulator-shell (both children of the outer <figure>), not a
  // descendant of it — so `closest(".simulator-shell")` from a button
  // never matches. Go up to the figure, then back down to the shell.
  document.querySelectorAll(".electrical-control-system-diagram .play-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".electrical-control-system-diagram")?.querySelector(".simulator-shell");
      if (shell) setEmergencyTripped(shell, false);
    });
  });

  // LIVING SIMULATION LAYER — circuit-breaker OPEN/CLOSED toggle: clicking
  // the breaker (in addition to the shared engine's own hover/click info
  // behaviour on the same hotspot) flips data-breaker-state, which the CSS
  // above uses to gate every downstream stage's animation and status text.
  // Toggling works whether the simulation is idle or already playing.
  document.querySelectorAll(".electrical-control-system-diagram [data-component=\"circuit-breaker\"]").forEach((hotspot) => {
    hotspot.addEventListener("click", () => {
      const shell = hotspot.closest(".simulator-shell");
      if (!(shell instanceof HTMLElement)) return;
      shell.dataset.breakerState = shell.dataset.breakerState === "open" ? "closed" : "open";
    });
  });

  // Reset should also restore the breaker to its normal closed state, so
  // "إعادة التشغيل" truly returns the whole diagram to its initial state.
  document.querySelectorAll(".electrical-control-system-diagram .reset-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".electrical-control-system-diagram")?.querySelector(".simulator-shell");
      if (shell instanceof HTMLElement) shell.dataset.breakerState = "closed";
      if (shell) setEmergencyTripped(shell, false);
    });
  });
</script>
