---
// Figures 7-21, 7-31 and 7-32 (الدائرة الكهربائية للتحكم) — Version 2:
// upgraded from a sequential-reveal diagram into a living simulation,
// while preserving 100% of the original visual design (colors, layout,
// typography, component structure, dark neumorphic theme, RTL, existing
// controls). Everything added here is a behavior/animation layer on top
// of the same geometry — see the "LIVING SIMULATION LAYER" markers below
// for every addition; nothing above them changed.
//
// New capabilities, all still driven by the shared wireDiagramSimulator
// engine (play/pause/resume/speed/reset) since they are plain CSS
// Animations picked up automatically by that engine's getAnimations()
// based pause/speed logic — no changes to diagramSimulator.js:
// - Continuous current-flow particles travelling the EXISTING wire paths
//   via `offset-path: url(#wireId)` (zero geometry duplication), one per
//   link, starting the moment that link's one-shot reveal completes.
// - A circuit-breaker OPEN/CLOSED toggle (click it a second time to
//   re-close): opening it removes power from everything downstream in
//   real time — exactly how a real breaker interrupts a circuit — via a
//   `data-breaker-state` attribute that gates the downstream timeline
//   selectors and status text, without touching the parts of the diagram
//   upstream of the breaker.
// - Slow rotor spin on the three motor starters once each has powered up.
// - A brief expanding "energy arrival" ring at each major stage the
//   instant it activates.
// - A live top-of-panel "حالة النظام" summary row.
//
// Geometry: power flows from the supply through the main switch and
// circuit breaker to the distribution point, which feeds three parallel
// motor starters (compressor, chair, suction); the control panel and
// emergency stop are accessory branches off the distribution point, the
// same way Incubator's airExit/oxygenMeter and Compressor's safety-valve
// sit beside their main chain.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft electrical-control-system-diagram">
  <div class="simulator-shell" data-breaker-state="closed" data-emergency-tripped="false">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة الدائرة الكهربائية للتحكم</span>
      <span class="simulator-subtitle">شكل 21-7 و 31-7 و 32-7 — من مصدر التيار إلى المحركات ولوحة التحكم</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="ecs1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="620"
          viewBox="0 0 900 620"
          role="img"
          aria-label="الدائرة الكهربائية للتحكم في جهاز الأسنان"
        >
          <defs>
            <marker id="ecs1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="ecs1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="ecs1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="ecs1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="ecs1GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="ecs1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="ecs1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="ecs1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="ecs1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="620" rx="20" fill="url(#ecs1BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="620" rx="20" fill="url(#ecs1Grid)"></rect>

          <text x="450" y="34" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">الدائرة الكهربائية للتحكم</text>

          <!-- Row 1: supply chain -->
          <g class="hotspot" data-component="power-supply" tabindex="0" role="button" aria-label="مصدر التيار الكهربائي">
            <rect class="box-shape" x="40" y="90" width="140" height="100" rx="10" fill="url(#ecs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <text x="110" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">مصدر التيار</text>
            <text x="110" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">220V Supply</text>
          </g>

          <g class="link" data-link="power-supply" data-link-to="main-switch">
            <line id="ecs1-wire-1" x1="180" y1="140" x2="225" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#ecs1-arrow)"></line>
            <line class="trail" x1="180" y1="140" x2="223" y2="140" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#FBBF24" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-1); --flow-delay:0.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="main-switch" tabindex="0" role="button" aria-label="المفتاح الرئيسي">
            <rect class="box-shape" x="225" y="90" width="140" height="100" rx="10" fill="url(#ecs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <text x="295" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">المفتاح الرئيسي</text>
            <text x="295" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Main Switch</text>
          </g>

          <g class="link" data-link="main-switch" data-link-to="circuit-breaker">
            <line id="ecs1-wire-2" x1="365" y1="140" x2="410" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#ecs1-arrow)"></line>
            <line class="trail" x1="365" y1="140" x2="408" y2="140" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#FBBF24" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-2); --flow-delay:0.9s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="circuit-breaker" tabindex="0" role="button" aria-label="قاطع الدائرة، انقر لفتحه أو إغلاقه">
            <rect class="box-shape" x="410" y="90" width="140" height="100" rx="10" fill="url(#ecs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <!-- LIVING SIMULATION LAYER: hidden-by-default open/interrupted indicator -->
            <path class="breaker-open-mark" d="M 462,120 L 498,160 M 498,120 L 462,160" stroke="#EF4444" stroke-width="3" stroke-linecap="round"></path>
            <text x="480" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">قاطع الدائرة</text>
            <text x="480" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Circuit Breaker</text>
          </g>

          <g class="link" data-link="circuit-breaker" data-link-to="distribution">
            <line id="ecs1-wire-3" x1="550" y1="140" x2="595" y2="140" stroke="#5b6478" stroke-width="2.5" marker-end="url(#ecs1-arrow)"></line>
            <line class="trail" x1="550" y1="140" x2="593" y2="140" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle downstream-particle" r="3.6" fill="#C084FC" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-3); --flow-delay:1.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="distribution" tabindex="0" role="button" aria-label="التوزيع الكهربائي">
            <circle class="box-shape" cx="655" cy="140" r="60" fill="url(#ecs1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#ecs1Elevate)"></circle>
            <text x="655" y="135" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">التوزيع</text>
            <text x="655" y="154" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#C084FC" direction="ltr">Distribution</text>
          </g>

          <!-- Accessories beside the supply chain -->
          <g class="link" data-link="distribution" data-link-to="control-panel">
            <path id="ecs1-wire-4" d="M 655,80 L 655,45" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#ecs1-arrow)"></path>
            <path class="trail" d="M 655,80 L 655,47" fill="none" stroke="#FBBF24" stroke-width="2" stroke-dasharray="5 6"></path>
            <circle class="current-particle downstream-particle" r="3" fill="#FBBF24" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-4); --flow-delay:2.0s; --flow-duration:0.8s;"></circle>
          </g>

          <g class="hotspot" data-component="control-panel" tabindex="0" role="button" aria-label="لوحة التحكم">
            <rect class="box-shape" x="565" y="12" width="180" height="35" rx="8" fill="url(#ecs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <text x="655" y="35" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="rtl">لوحة التحكم</text>
          </g>

          <g class="link" data-link="distribution" data-link-to="emergency-stop">
            <path id="ecs1-wire-5" d="M 715,140 L 748,140" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#ecs1-arrow)"></path>
            <path class="trail" d="M 715,140 L 746,140" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="5 6"></path>
            <circle class="current-particle downstream-particle" r="3" fill="#EF4444" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-5); --flow-delay:2.3s; --flow-duration:0.8s;"></circle>
          </g>

          <g class="hotspot" data-component="emergency-stop" tabindex="0" role="button" aria-label="مفتاح الطوارئ">
            <circle class="box-shape" cx="790" cy="140" r="32" fill="url(#ecs1GradPurple)" stroke="#EF4444" stroke-width="2.5" filter="url(#ecs1Elevate)"></circle>
            <text x="790" y="136" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">إيقاف</text>
            <text x="790" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">طوارئ</text>
          </g>

          <!-- Row 1 -> Row 2 elbow connectors: distribution fans out to 3 starters -->
          <g class="link" data-link="distribution" data-link-to="compressor-starter">
            <path id="ecs1-wire-6" d="M 620,195 L 620,240 L 165,240 L 165,280" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#ecs1-arrow)"></path>
            <path class="trail" d="M 620,195 L 620,240 L 165,240 L 165,278" fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></path>
            <circle class="current-particle downstream-particle" r="3.6" fill="#4ADE80" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-6); --flow-delay:2.7s; --flow-duration:1.8s;"></circle>
          </g>
          <g class="link" data-link="distribution" data-link-to="chair-starter">
            <path id="ecs1-wire-7" d="M 655,200 L 655,280" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#ecs1-arrow)"></path>
            <path class="trail" d="M 655,200 L 655,278" fill="none" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></path>
            <circle class="current-particle downstream-particle" r="3.6" fill="#38BDF8" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-7); --flow-delay:3.0s; --flow-duration:1.4s;"></circle>
          </g>
          <g class="link" data-link="distribution" data-link-to="suction-starter">
            <path id="ecs1-wire-8" d="M 690,195 L 690,240 L 780,240 L 780,280" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#ecs1-arrow)"></path>
            <path class="trail" d="M 690,195 L 690,240 L 780,240 L 780,278" fill="none" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></path>
            <circle class="current-particle downstream-particle" r="3.6" fill="#C084FC" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-8); --flow-delay:3.3s; --flow-duration:1.8s;"></circle>
          </g>

          <!-- Row 2: motor starters -->
          <g class="hotspot" data-component="compressor-starter" tabindex="0" role="button" aria-label="ستارتر محرك الضاغط">
            <rect class="box-shape" x="90" y="280" width="150" height="95" rx="10" fill="url(#ecs1GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <circle cx="165" cy="315" r="16" fill="none" stroke="#4ADE80" stroke-width="1.4" opacity="0.7"></circle>
            <!-- LIVING SIMULATION LAYER: rotor spoke, spins once the starter powers up -->
            <line class="rotor" x1="165" y1="315" x2="165" y2="301" stroke="#4ADE80" stroke-width="2" stroke-linecap="round" style="transform-origin: 165px 315px;"></line>
            <text x="165" y="352" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">ستارتر الضاغط</text>
            <text x="165" y="368" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#4ADE80" direction="ltr">Compressor Starter</text>
          </g>

          <g class="hotspot" data-component="chair-starter" tabindex="0" role="button" aria-label="ستارتر مضخة الكرسي">
            <rect class="box-shape" x="580" y="280" width="150" height="95" rx="10" fill="url(#ecs1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <circle cx="655" cy="315" r="16" fill="none" stroke="#38BDF8" stroke-width="1.4" opacity="0.7"></circle>
            <line class="rotor" x1="655" y1="315" x2="655" y2="301" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" style="transform-origin: 655px 315px;"></line>
            <text x="655" y="352" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">ستارتر الكرسي</text>
            <text x="655" y="368" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#38BDF8" direction="ltr">Chair Starter</text>
          </g>

          <g class="hotspot" data-component="suction-starter" tabindex="0" role="button" aria-label="ستارتر مضخة الشفط">
            <rect class="box-shape" x="705" y="280" width="150" height="95" rx="10" fill="url(#ecs1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <circle cx="780" cy="315" r="16" fill="none" stroke="#C084FC" stroke-width="1.4" opacity="0.7"></circle>
            <line class="rotor" x1="780" y1="315" x2="780" y2="301" stroke="#C084FC" stroke-width="2" stroke-linecap="round" style="transform-origin: 780px 315px;"></line>
            <text x="780" y="352" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">ستارتر الشفط</text>
            <text x="780" y="368" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#C084FC" direction="ltr">Suction Starter</text>
          </g>

          <!-- Status indicator cluster (aggregate accessory, like an oxygenMeter-style summary node) -->
          <g class="link" data-link="chair-starter" data-link-to="status-indicators">
            <path id="ecs1-wire-9" d="M 655,375 L 655,420" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#ecs1-arrow)"></path>
            <path class="trail" d="M 655,375 L 655,418" fill="none" stroke="#4ADE80" stroke-width="2" stroke-dasharray="5 6"></path>
            <circle class="current-particle downstream-particle" r="3" fill="#4ADE80" filter="url(#ecs1Glow)" style="offset-path: url(#ecs1-wire-9); --flow-delay:3.7s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="status-indicators" tabindex="0" role="button" aria-label="لوحة مؤشرات الحالة">
            <rect class="box-shape" x="330" y="420" width="450" height="90" rx="10" fill="url(#ecs1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#ecs1Elevate)"></rect>
            <circle cx="400" cy="450" r="7" fill="#4ADE80"></circle>
            <text x="415" y="454" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#dbe0ec" direction="rtl">تشغيل طبيعي</text>
            <circle cx="580" cy="450" r="7" fill="#EF4444"></circle>
            <text x="595" y="454" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#dbe0ec" direction="rtl">عطل أو تجاوز حمل</text>
            <circle cx="400" cy="480" r="7" fill="#FBBF24" opacity="0.85"></circle>
            <text x="415" y="484" font-family="Cairo, sans-serif" font-size="10" font-weight="600" fill="#dbe0ec" direction="rtl">ضغط أو حرارة عالية</text>
            <text x="555" y="484" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Status Panel</text>
          </g>

          <!-- LIVING SIMULATION LAYER: energy-arrival rings. Current-flow
               particles now live inside their own .link groups above (next
               to the wire they follow via offset-path) so the shared
               hover/click focus-mode dims/highlights them together with
               their wire — see diagram-simulator.css .link.is-related. -->
          <g class="flow-layer" aria-hidden="true">
            <circle class="arrival-ring" cx="110" cy="140" r="4" fill="none" stroke="#FBBF24" style="--ring-delay:0.1s;"></circle>
            <circle class="arrival-ring" cx="295" cy="140" r="4" fill="none" stroke="#FBBF24" style="--ring-delay:0.6s;"></circle>
            <circle class="arrival-ring" cx="480" cy="140" r="4" fill="none" stroke="#FBBF24" style="--ring-delay:1.1s;"></circle>
            <circle class="arrival-ring" cx="655" cy="140" r="4" fill="none" stroke="#C084FC" style="--ring-delay:1.6s;"></circle>
            <circle class="arrival-ring" cx="165" cy="315" r="4" fill="none" stroke="#4ADE80" style="--ring-delay:2.8s;"></circle>
            <circle class="arrival-ring" cx="655" cy="315" r="4" fill="none" stroke="#38BDF8" style="--ring-delay:3.1s;"></circle>
            <circle class="arrival-ring" cx="780" cy="315" r="4" fill="none" stroke="#C084FC" style="--ring-delay:3.4s;"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <!-- LIVING SIMULATION LAYER: live system-wide summary row -->
          <li class="status-row system-status-row" data-status="system-status"><span class="status-dot dot-yellow"></span><span class="status-label">حالة النظام العامة</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يعمل</span><span class="fault-badge" data-fault-badge>معطّل — القاطع مفتوح</span></span></li>
          <li class="status-row" data-status="power-supply"><span class="status-dot dot-yellow"></span><span class="status-label">مصدر التيار</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="main-switch"><span class="status-dot dot-yellow"></span><span class="status-label">المفتاح الرئيسي</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">موصول</span></span></li>
          <li class="status-row" data-status="circuit-breaker"><span class="status-dot dot-yellow"></span><span class="status-label">قاطع الدائرة</span><span class="status-value"><span class="value-off">مفصول</span><span class="value-on">موصول</span><span class="fault-badge" data-fault-badge>مفتوح</span></span></li>
