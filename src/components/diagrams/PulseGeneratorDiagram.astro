---
// Shared animated component for Figures 1-7 .. 1-10 (one/two/six/twelve
// -pulse generators), redesigned to the dark neumorphic simulator system
// established for diagrams 01-06. Reuses diagram-simulator.css +
// diagramSimulator.js like diagrams 03-06; unlike those, THIS component
// renders four times on one page (one per variant) with different
// circuit topology, so every SVG filter/gradient/arrow-marker id is
// suffixed with the variant name to stay unique across instances, and
// every hotspot/link id is likewise suffixed so COMPONENT_INFO (shared
// across all four instances in one <script> block) never collides.
//
// Geometry is untouched from the prior build (every coordinate, path
// and label identical) — only fill/stroke treatment, the hotspot/link/
// status-panel/legend/controls layer, and the animation timeline are
// new. Circuit differences between variants (one-pulse has no
// rectifier; two-pulse has a single 4-diode bridge; six/twelve-pulse
// have 3-phase primaries + 2/4 diode banks) are preserved exactly as
// before — see pulseGeneratorData.ts and the page-08/09 definitions for
// the source text.
//
// Color mapping: transformer/meter/current path = blue (matches
// diagram-01's meters); rectifier (bridge or diode banks) = orange
// (matches diagram-01's generator, the HV-transformation stage); tube
// = purple (radiation), matching every prior diagram.
import "../../styles/diagram-simulator.css";
import { pulseGeneratorVariants } from "./pulseGeneratorData";

interface Props {
  variant: keyof typeof pulseGeneratorVariants;
  caption: string;
}

const { variant, caption } = Astro.props;
const v = pulseGeneratorVariants[variant];

const bankCount = variant === "twelve-pulse" ? 4 : variant === "six-pulse" ? 2 : 0;
const bankSpacing = 130;
const bankOrdinals = ["الأولى", "الثانية", "الثالثة", "الرابعة"];
const banks = Array.from({ length: bankCount }, (_, i) => ({
  x: 480 + i * bankSpacing,
  isDelta: variant === "twelve-pulse" && i % 2 === 1,
  id: `bank-${variant}-${i}`,
  ordinal: bankOrdinals[i],
}));
const busY = 260;
const groundX = bankCount > 0 ? banks[0].x + ((bankCount - 1) * bankSpacing) / 2 : 460;
const svgWidth = bankCount > 2 ? 980 : 900;

const uid = (base: string) => `${base}-${variant}`;
const elevateId = uid("pulseElevate");
const lineGlowId = uid("pulseLineGlow");
const bgGradId = uid("pulseBgGrad");
const gridId = uid("pulseGrid");
const panelGradId = uid("pulsePanelGrad");
const meterGradId = uid("pulseMeterGrad");
const tubeGradId = uid("pulseTubeGrad");
const arrowGrayId = uid("arrow-pulse-gray");
const arrowBlueId = uid("arrow-pulse-blue");
const arrowOrangeId = uid("arrow-pulse-orange");

const titles: Record<string, string> = {
  "one-pulse": "محاكاة مولد نبضة واحدة",
  "two-pulse": "محاكاة مولد نبضتين",
  "six-pulse": "محاكاة مولدة ستة نبضات",
  "twelve-pulse": "محاكاة مولد اثنتي عشر نبضة",
};

const cycleMsByVariant: Record<string, number> = {
  "one-pulse": 3800,
  "two-pulse": 4000,
  "six-pulse": 4600,
  "twelve-pulse": 5000,
};
---

<figure class={`diagram-block neo-surface-soft pulse-diagram pulse-diagram-${variant}`}>
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">{titles[variant]}</span>
      <span class="simulator-subtitle">{v.circuitLabel}</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="pulse-svg"
          xmlns="http://www.w3.org/2000/svg"
          width={svgWidth}
          height="340"
          viewBox={`0 0 ${svgWidth} 340`}
          role="img"
          aria-label={v.circuitLabel}
        >
          <defs>
            <marker id={arrowGrayId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <marker id={arrowBlueId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#38BDF8"></path>
            </marker>
            <marker id={arrowOrangeId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#FB923C"></path>
            </marker>

            <linearGradient id={bgGradId} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id={gridId} width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id={panelGradId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0f1729"></stop>
              <stop offset="100%" stop-color="#080c16"></stop>
            </linearGradient>
            <radialGradient id={meterGradId} cx="35%" cy="30%" r="75%">
              <stop offset="0%" stop-color="#1a2436"></stop>
              <stop offset="100%" stop-color="#0b111c"></stop>
            </radialGradient>
            <radialGradient id={tubeGradId} cx="35%" cy="30%" r="75%">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </radialGradient>

            <filter id={elevateId} x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="4" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="4" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.32" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id={lineGlowId} x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width={svgWidth} height="340" rx="20" fill={`url(#${bgGradId})`}></rect>
          <rect x="0" y="0" width={svgWidth} height="340" rx="20" fill={`url(#${gridId})`}></rect>

          <!-- ===== Waveform panels (أ/ب) — verbatim traces, dark reskin ===== -->
          <rect x="30" y="20" width="220" height="130" rx="10" fill={`url(#${panelGradId})`} stroke="#2a3550" stroke-width="1.5"></rect>
          <line x1="40" y1="85" x2="240" y2="85" stroke="#2a3550" stroke-width="1"></line>
          <path class="wave-path input-wave" d={v.inputWave} fill="none" stroke="#38BDF8" stroke-width="2.5" filter={`url(#${lineGlowId})`}></path>
          <text x="140" y="172" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">أ- الإشارة الداخلة</text>

          <rect x="30" y="185" width="220" height="90" rx="10" fill={`url(#${panelGradId})`} stroke="#2a3550" stroke-width="1.5"></rect>
          <line x1="40" y1="230" x2="240" y2="230" stroke="#2a3550" stroke-width="1"></line>
          <path class="wave-path output-wave" d={v.outputWave} fill="none" stroke="#38BDF8" stroke-width="2.5" filter={`url(#${lineGlowId})`}></path>
          <text x="140" y="297" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">ب- الإشارة الخارجة</text>

          <text x={bankCount > 0 ? groundX : 430} y="60" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">{v.circuitLabel}</text>

          {variant === "one-pulse" && (
            <>
              <g class="hotspot" data-component={uid("transformer")} tabindex="0" role="button" aria-label="الملف الثانوي لمحولة الضغط العالي">
                <rect class="hit-area" x="270" y="90" width="90" height="90" fill="#000" fill-opacity="0"></rect>
                <line x1="290" y1="150" x2="330" y2="150" stroke="#5b6478" stroke-width="2"></line>
                <path class="box-shape" d={v.coilPath} fill="none" stroke="#38BDF8" stroke-width="2.2" filter={`url(#${elevateId})`}></path>
                <text x={v.maLabelX} y="100" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#8b94aa" text-anchor="end" direction="rtl">من المحولة</text>
              </g>

              <g class="link" data-link={uid("transformer")} data-link-to={uid("meter")}>
                <line x1="330" y1="150" x2="400" y2="150" stroke="#5b6478" stroke-width="2"></line>
                <line class="trail trail-blue" x1="330" y1="150" x2="400" y2="150" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="7 9"></line>
              </g>

              <g class="hotspot" data-component={uid("meter")} tabindex="0" role="button" aria-label="مبين mA">
                <circle class="box-shape" cx="430" cy="150" r="20" fill={`url(#${meterGradId})`} stroke="#38BDF8" stroke-width="2" filter={`url(#${elevateId})`}></circle>
                <circle cx="422" cy="150" r="3" fill="#eef1f8"></circle>
                <circle cx="438" cy="150" r="3" fill="#eef1f8"></circle>
                <text x="430" y="185" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">mA</text>
                <line x1="430" y1="170" x2="430" y2="195" stroke="#8b94aa" stroke-width="2"></line>
                <line x1="416" y1="195" x2="444" y2="195" stroke="#8b94aa" stroke-width="2"></line>
                <line x1="421" y1="201" x2="439" y2="201" stroke="#8b94aa" stroke-width="2"></line>
                <line x1="426" y1="207" x2="434" y2="207" stroke="#8b94aa" stroke-width="2"></line>
              </g>

              <g class="link" data-link={uid("meter")} data-link-to={uid("tube")}>
                <line x1="450" y1="150" x2="560" y2="150" stroke="#5b6478" stroke-width="2" marker-end={`url(#${arrowBlueId})`}></line>
                <line class="trail trail-blue" x1="450" y1="150" x2="555" y2="150" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="7 9"></line>
              </g>

              <g class="hotspot" data-component={uid("tube")} tabindex="0" role="button" aria-label="انبوبة الاشعة السينية">
                <circle class="box-shape" cx="590" cy="150" r="18" fill={`url(#${tubeGradId})`} stroke="#C084FC" stroke-width="2" filter={`url(#${elevateId})`}></circle>
                <line x1="583" y1="157" x2="598" y2="142" stroke="#C084FC" stroke-width="2.5"></line>
                <text x="590" y="190" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">انبوبة الاشعة</text>
              </g>
            </>
          )}

          {variant === "two-pulse" && (
            <>
              <g class="hotspot" data-component={uid("transformer")} tabindex="0" role="button" aria-label="الملف الثانوي لمحولة الضغط العالي">
                <rect class="hit-area" x="270" y="90" width="90" height="90" fill="#000" fill-opacity="0"></rect>
                <line x1="290" y1="150" x2="330" y2="150" stroke="#5b6478" stroke-width="2"></line>
                <path class="box-shape" d={v.coilPath} fill="none" stroke="#38BDF8" stroke-width="2.2" filter={`url(#${elevateId})`}></path>
                <text x={v.maLabelX} y="100" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#8b94aa" text-anchor="end" direction="rtl">من المحولة</text>
              </g>

              <g class="hotspot" data-component={uid("bridge")} tabindex="0" role="button" aria-label="دائرة التوحيد (قنطرة)">
                <rect class="hit-area" x="325" y="55" width="210" height="205" fill="#000" fill-opacity="0"></rect>
                <g class="box-shape" filter={`url(#${elevateId})`}>
                  <line x1="430" y1="70" x2="530" y2="150" stroke="#FB923C" stroke-width="2.2"></line>
                  <line x1="530" y1="150" x2="430" y2="230" stroke="#FB923C" stroke-width="2.2"></line>
                  <line x1="430" y1="230" x2="330" y2="150" stroke="#FB923C" stroke-width="2.2"></line>
                  <line x1="330" y1="150" x2="430" y2="70" stroke="#FB923C" stroke-width="2.2"></line>
                </g>
                <text x="430" y="60" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">X</text>
                <text x="430" y="252" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">Y</text>
                <text x="315" y="150" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#8b94aa" text-anchor="end" direction="ltr">A</text>
                <text x="545" y="150" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#8b94aa" text-anchor="start" direction="ltr">D</text>
                <path d="M 369.0,100.0 L 369.0,120.0 L 391.0,110.0 z" fill="#FB923C"></path>
                <line x1="391.0" y1="98.0" x2="391.0" y2="122.0" stroke="#FB923C" stroke-width="3"></line>
                <text x="360" y="92" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">B1</text>
                <path d="M 491.0,100.0 L 491.0,120.0 L 469.0,110.0 z" fill="#FB923C"></path>
                <line x1="469.0" y1="98.0" x2="469.0" y2="122.0" stroke="#FB923C" stroke-width="3"></line>
                <text x="500" y="92" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">B4</text>
                <path d="M 391.0,180.0 L 391.0,200.0 L 369.0,190.0 z" fill="#FB923C"></path>
                <line x1="369.0" y1="178.0" x2="369.0" y2="202.0" stroke="#FB923C" stroke-width="3"></line>
                <text x="360" y="215" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">B2</text>
                <path d="M 469.0,180.0 L 469.0,200.0 L 491.0,190.0 z" fill="#FB923C"></path>
                <line x1="491.0" y1="178.0" x2="491.0" y2="202.0" stroke="#FB923C" stroke-width="3"></line>
                <text x="500" y="215" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="ltr">B3</text>
              </g>

              <g class="hotspot" data-component={uid("meter")} tabindex="0" role="button" aria-label="مبين mA">
                <circle class="box-shape" cx="430" cy="150" r="16" fill={`url(#${meterGradId})`} stroke="#38BDF8" stroke-width="2" filter={`url(#${elevateId})`}></circle>
                <circle cx="424" cy="150" r="2.5" fill="#eef1f8"></circle>
                <circle cx="436" cy="150" r="2.5" fill="#eef1f8"></circle>
                <text x="430" y="255" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="rtl">mA</text>
              </g>

              <g class="hotspot" data-component={uid("tube")} tabindex="0" role="button" aria-label="انبوبة الاشعة السينية">
                <rect class="hit-area" x="525" y="120" width="120" height="60" fill="#000" fill-opacity="0"></rect>
                <line class="box-shape" x1="530" y1="150" x2="570" y2="150" stroke="#C084FC" stroke-width="2.4" marker-end={`url(#${arrowOrangeId})`} filter={`url(#${elevateId})`}></line>
                <text x="620" y="140" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">انبوبة</text>
                <text x="620" y="158" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الاشعة</text>
              </g>
            </>
          )}

          {bankCount > 0 && (
            <>
              <g class="hotspot" data-component={uid("primary")} tabindex="0" role="button" aria-label="الملف الابتدائي ثلاثي الطور">
                <rect class="hit-area" x={groundX - 65} y="60" width="130" height="90" fill="#000" fill-opacity="0"></rect>
                <path class="box-shape" d={`M ${groundX},70 L ${groundX - 60},130 L ${groundX + 60},130 Z`} fill="none" stroke="#38BDF8" stroke-width="2.2" filter={`url(#${elevateId})`}></path>
                <path d={`M ${groundX - 40},112 a5,5 0 1 1 0,10 M ${groundX - 28},112 a5,5 0 1 1 0,10 M ${groundX - 16},112 a5,5 0 1 1 0,10`} fill="none" stroke="#38BDF8" stroke-width="1.5"></path>
                <path d={`M ${groundX + 16},112 a5,5 0 1 1 0,10 M ${groundX + 28},112 a5,5 0 1 1 0,10 M ${groundX + 40},112 a5,5 0 1 1 0,10`} fill="none" stroke="#38BDF8" stroke-width="1.5"></path>
                <path d={`M ${groundX - 15},130 a5,5 0 1 1 0,10 M ${groundX - 3},130 a5,5 0 1 1 0,10 M ${groundX + 9},130 a5,5 0 1 1 0,10`} fill="none" stroke="#38BDF8" stroke-width="1.5"></path>
              </g>

              {banks.map((bank, i) => (
                <>
                  <g class="link" data-link={uid("primary")} data-link-to={bank.id}>
                    <line x1={bank.x} y1="130" x2={bank.x} y2="150" stroke="#5b6478" stroke-width="2"></line>
                    <line class="trail trail-blue" x1={bank.x} y1="130" x2={bank.x} y2="150" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
                  </g>

                  <g class="hotspot" data-component={bank.id} tabindex="0" role="button" aria-label={`مجموعة صمامات التقويم ${bank.ordinal}`}>
                    <rect class="hit-area" x={bank.x - 45} y="140" width="90" height="95" fill="#000" fill-opacity="0"></rect>
                    {bank.isDelta ? (
                      <g class="box-shape" filter={`url(#${elevateId})`}>
                        <path d={`M ${bank.x},150 L ${bank.x - 34},188 L ${bank.x + 34},188 Z`} fill="none" stroke="#38BDF8" stroke-width="2"></path>
                        <circle cx={bank.x} cy="150" r="3" fill="#38BDF8"></circle>
                      </g>
                    ) : (
                      <g class="box-shape" filter={`url(#${elevateId})`}>
                        <line x1={bank.x} y1="150" x2={bank.x - 30} y2="188" stroke="#38BDF8" stroke-width="2"></line>
                        <line x1={bank.x} y1="150" x2={bank.x + 30} y2="188" stroke="#38BDF8" stroke-width="2"></line>
                        <line x1={bank.x} y1="150" x2={bank.x} y2="188" stroke="#38BDF8" stroke-width="2"></line>
                        <circle cx={bank.x} cy="150" r="3" fill="#38BDF8"></circle>
                      </g>
                    )}

                    <line x1={bank.x - 30} y1="188" x2={bank.x - 30} y2="205" stroke="#8b94aa" stroke-width="2"></line>
                    <line x1={bank.x} y1="188" x2={bank.x} y2="205" stroke="#8b94aa" stroke-width="2"></line>
                    <line x1={bank.x + 30} y1="188" x2={bank.x + 30} y2="205" stroke="#8b94aa" stroke-width="2"></line>

                    <g class="diode-shape" filter={`url(#${elevateId})`}>
                      <path d={`M ${bank.x - 38},205 L ${bank.x - 22},205 L ${bank.x - 22},225 Z`} fill="#FB923C"></path>
                      <line x1={bank.x - 22} y1="203" x2={bank.x - 22} y2="227" stroke="#FB923C" stroke-width="2.5"></line>
                      <path d={`M ${bank.x - 8},205 L ${bank.x + 8},205 L ${bank.x + 8},225 Z`} fill="#FB923C"></path>
                      <line x1={bank.x + 8} y1="203" x2={bank.x + 8} y2="227" stroke="#FB923C" stroke-width="2.5"></line>
                      <path d={`M ${bank.x + 22},205 L ${bank.x + 38},205 L ${bank.x + 38},225 Z`} fill="#FB923C"></path>
                      <line x1={bank.x + 38} y1="203" x2={bank.x + 38} y2="227" stroke="#FB923C" stroke-width="2.5"></line>
                    </g>

                    <line x1={bank.x - 30} y1="205" x2={bank.x - 22} y2="205" stroke="#8b94aa" stroke-width="2"></line>
                    <line x1={bank.x} y1="205" x2={bank.x + 8} y2="205" stroke="#8b94aa" stroke-width="2"></line>
                    <line x1={bank.x + 30} y1="205" x2={bank.x + 22} y2="205" stroke="#8b94aa" stroke-width="2"></line>

                    <line x1={bank.x - 22} y1="227" x2={bank.x} y2={busY} stroke="#8b94aa" stroke-width="2"></line>
                    <line x1={bank.x + 8} y1="227" x2={bank.x} y2={busY} stroke="#8b94aa" stroke-width="2"></line>
                    <line x1={bank.x + 38} y1="227" x2={bank.x} y2={busY} stroke="#8b94aa" stroke-width="2"></line>
                  </g>

                  <g class="link" data-link={bank.id} data-link-to={uid("tube")}>
                    <line class="trail trail-orange" x1={bank.x} y1="227" x2={bank.x} y2={busY} stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
                  </g>
                </>
              ))}

              <line x1={banks[0].x} y1={busY} x2={banks[bankCount - 1].x} y2={busY} stroke="#8b94aa" stroke-width="2.5"></line>
              <line x1={groundX} y1={busY} x2={groundX} y2={busY + 20} stroke="#4ADE80" stroke-width="2"></line>
              <line x1={groundX - 14} y1={busY + 20} x2={groundX + 14} y2={busY + 20} stroke="#4ADE80" stroke-width="2"></line>
              <line x1={groundX - 8} y1={busY + 26} x2={groundX + 8} y2={busY + 26} stroke="#4ADE80" stroke-width="2"></line>
              <line x1={groundX - 3} y1={busY + 32} x2={groundX + 3} y2={busY + 32} stroke="#4ADE80" stroke-width="2"></line>

              <g class="hotspot" data-component={uid("tube")} tabindex="0" role="button" aria-label="انبوبة الاشعة السينية">
                <rect class="hit-area" x={groundX - 40} y={busY} width="80" height="80" fill="#000" fill-opacity="0"></rect>
                <line x1={groundX} y1={busY} x2={groundX} y2="310" stroke="#5b6478" stroke-width="2"></line>
                <line class="trail trail-orange" x1={groundX} y1={busY + 34} x2={groundX} y2="308" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
                <circle class="box-shape" cx={groundX} cy="322" r="14" fill={`url(#${tubeGradId})`} stroke="#C084FC" stroke-width="2" filter={`url(#${elevateId})`}></circle>
                <line x1={groundX - 6} y1="328" x2={groundX + 7} y2="315" stroke="#C084FC" stroke-width="2.5"></line>
                <text x={groundX + 30} y="326" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="start" direction="rtl">انبوبة الاشعة</text>
              </g>
            </>
          )}
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          {bankCount === 0 && (
            <li class="status-row" data-status={uid("transformer")}><span class="status-dot dot-blue"></span><span class="status-label">المحولة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          )}

          {bankCount > 0 && (
            <li class="status-row" data-status={uid("primary")}><span class="status-dot dot-blue"></span><span class="status-label">الملف الابتدائي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          )}

          {variant === "two-pulse" && (
            <li class="status-row" data-status={uid("bridge")}><span class="status-dot dot-orange"></span><span class="status-label">دائرة التوحيد</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          )}

          {(variant === "one-pulse" || variant === "two-pulse") && (
            <li class="status-row" data-status={uid("meter")}><span class="status-dot dot-blue"></span><span class="status-label">مبين mA</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          )}

          {bankCount > 0 && banks.map((bank) => (
            <li class="status-row" data-status={bank.id}><span class="status-dot dot-orange"></span><span class="status-label">مجموعة الصمامات {bank.ordinal}</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          ))}

          <li class="status-row" data-status={uid("tube")}><span class="status-dot dot-purple"></span><span class="status-label">انبوبة الاشعة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون في المخطط لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>التيار</li>
      {bankCount > 0 || variant === "two-pulse" ? (
        <li class="legend-item"><span class="legend-swatch legend-orange"></span>التوحيد (Rectification)</li>
      ) : null}
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الاشعة الصادرة</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style define:vars={{ elevateUrl: `url(#${elevateId})`, glowUrl: `url(#${lineGlowId})` }}>
  .hotspot .box-shape,
  .hotspot .diode-shape {
    filter: var(--elevateUrl) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:hover .diode-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot:focus-visible .diode-shape,
  .hotspot.is-selected .box-shape,
  .hotspot.is-selected .diode-shape {
    filter: var(--elevateUrl) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.015);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: var(--glowUrl);
  }

