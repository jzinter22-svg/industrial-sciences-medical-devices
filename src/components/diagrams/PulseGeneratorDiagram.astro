    .playing .input-wave { stroke-dasharray: 1000; animation: pulse-wave-draw 1s ease-out 0.2s forwards; }
    .playing .output-wave { stroke-dasharray: 1000; animation: pulse-wave-draw 0.8s ease-out 1.1s forwards; }

    @keyframes pulse-shape-activate { to { filter: var(--elevateUrl) saturate(1.35) brightness(1.4); } }
    @keyframes pulse-reveal-trail { to { opacity: 0.85; } }
    @keyframes pulse-status-value-on { to { opacity: 1; } }
    @keyframes pulse-status-value-off { to { opacity: 0; } }
    @keyframes pulse-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes pulse-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes pulse-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    /* ===== one-pulse: transformer -> meter -> tube ===== */
    .playing [data-component="transformer-one-pulse"] .box-shape { animation: pulse-shape-activate 0.5s ease-out 1.0s forwards; }
    .playing [data-status="transformer-one-pulse"] .status-dot { animation: pulse-dot-on-blue 0.4s ease-out 1.0s forwards; }
    .playing [data-status="transformer-one-pulse"] .value-on { animation: pulse-status-value-on 0.4s ease-out 1.0s forwards; }
    .playing [data-status="transformer-one-pulse"] .value-off { animation: pulse-status-value-off 0.4s ease-out 1.0s forwards; }
