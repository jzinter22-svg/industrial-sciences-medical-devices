---
// Figure 30-3 (المخطط الكتلوي لدائرة السيطرة على حرارة القلم الحراري)
// rebuilt as a dark neumorphic interactive simulator, following the
// exact Chapter 1/2 system.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft stylus-heat-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة السيطرة على حرارة القلم الحراري</span>
      <span class="simulator-subtitle">شكل 30-3 — مذبذب، ترانزستور شحن/تفريغ، ومقارن</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="sh-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="880"
          height="320"
          viewBox="0 0 880 320"
          role="img"
          aria-label="دائرة السيطرة على حرارة القلم الحراري"
        >
          <defs>
            <marker id="sh-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="shBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="shGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="shGradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="shGradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332210"></stop><stop offset="100%" stop-color="#1a1108"></stop></linearGradient>
            <linearGradient id="shGradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="shGradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1420"></stop><stop offset="100%" stop-color="#1c0a10"></stop></linearGradient>
            <filter id="shElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha"><feFuncA type="table" tableValues="1 0"></feFuncA></feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="3" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="2.5" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-2" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.3" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode><feMergeNode in="haloOuter"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode><feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="880" height="320" rx="20" fill="url(#shBgGrad)"></rect>
          <rect x="0" y="0" width="880" height="320" rx="20" fill="url(#shGrid)"></rect>

          <g class="hotspot" data-component="oscillator" tabindex="0" role="button" aria-label="مذبذب">
            <rect class="box-shape" x="40" y="120" width="110" height="70" rx="10" fill="url(#shGradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#shElevate)"></rect>
            <text x="95" y="148" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مذبذب</text>
            <text x="95" y="166" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Oscillator</text>
          </g>

          <g class="hotspot" data-component="chargeTransistor" tabindex="0" role="button" aria-label="ترانزستور الشحن/التفريغ">
            <rect class="box-shape" x="210" y="120" width="140" height="70" rx="10" fill="url(#shGradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#shElevate)"></rect>
            <text x="280" y="145" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">ترانزستور Q1</text>
            <text x="280" y="163" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FB923C" text-anchor="middle" direction="rtl">شحن/تفريغ متسعة</text>
          </g>

          <g class="hotspot" data-component="comparator" tabindex="0" role="button" aria-label="مقارن">
            <rect class="box-shape" x="410" y="120" width="120" height="70" rx="10" fill="url(#shGradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#shElevate)"></rect>
            <text x="470" y="148" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مقارن</text>
            <text x="470" y="166" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Comparator</text>
          </g>

          <g class="hotspot" data-component="powerTransistor" tabindex="0" role="button" aria-label="ترانزستور القدرة">
            <rect class="box-shape" x="580" y="120" width="130" height="70" rx="10" fill="url(#shGradRed)" stroke="#F87171" stroke-width="2" filter="url(#shElevate)"></rect>
            <text x="645" y="145" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">ترانزستور Q2</text>
            <text x="645" y="163" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#F87171" text-anchor="middle" direction="rtl">مغذي القلم الحراري</text>
          </g>

          <line x1="150" y1="155" x2="210" y2="155" stroke="#5b6478" stroke-width="2" marker-end="url(#sh-arrow)"></line>
          <line x1="350" y1="155" x2="410" y2="155" stroke="#5b6478" stroke-width="2" marker-end="url(#sh-arrow)"></line>
          <line x1="530" y1="155" x2="580" y2="155" stroke="#5b6478" stroke-width="2" marker-end="url(#sh-arrow)"></line>
          <line x1="710" y1="155" x2="770" y2="155" stroke="#5b6478" stroke-width="2" marker-end="url(#sh-arrow)"></line>
          <text x="800" y="140" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الى</text>
          <text x="800" y="160" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">القلم</text>
          <text x="800" y="180" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الحراري</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="oscillator"><span class="status-dot dot-green"></span><span class="status-label">مذبذب</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="chargeTransistor"><span class="status-dot dot-orange"></span><span class="status-label">ترانزستور الشحن</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="comparator"><span class="status-dot dot-purple"></span><span class="status-label">مقارن</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="powerTransistor"><span class="status-dot dot-red"></span><span class="status-label">ترانزستور القدرة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الموجة المربعة</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>شحن المتسعة</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>المقارنة</li>
      <li class="legend-item"><span class="legend-swatch" style="background:#F87171"></span>تغذية القلم</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#shElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease;
    transform-box: fill-box;
    transform-origin: center;
  }
  .hotspot:hover .box-shape, .hotspot:focus-visible .box-shape, .hotspot.is-selected .box-shape {
    filter: url(#shElevate) saturate(1.4) brightness(1.5);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes sh-activate { to { filter: url(#shElevate) saturate(1.4) brightness(1.45); } }
    @keyframes sh-status-value-on { to { opacity: 1; } }
    @keyframes sh-status-value-off { to { opacity: 0; } }
    @keyframes sh-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes sh-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes sh-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes sh-dot-on-red { to { background: #F87171; box-shadow: 0 0 8px 1px rgba(248, 113, 113, 0.8); } }

    .playing [data-component="oscillator"] .box-shape { animation: sh-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="oscillator"] .status-dot { animation: sh-dot-on-green 0.4s ease-out 0.1s forwards; }
    .playing [data-status="oscillator"] .value-on { animation: sh-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="oscillator"] .value-off { animation: sh-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-component="chargeTransistor"] .box-shape { animation: sh-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="chargeTransistor"] .status-dot { animation: sh-dot-on-orange 0.4s ease-out 0.6s forwards; }
    .playing [data-status="chargeTransistor"] .value-on { animation: sh-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="chargeTransistor"] .value-off { animation: sh-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-component="comparator"] .box-shape { animation: sh-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="comparator"] .status-dot { animation: sh-dot-on-purple 0.4s ease-out 1.1s forwards; }
    .playing [data-status="comparator"] .value-on { animation: sh-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="comparator"] .value-off { animation: sh-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-component="powerTransistor"] .box-shape { animation: sh-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="powerTransistor"] .status-dot { animation: sh-dot-on-red 0.4s ease-out 1.6s forwards; }
    .playing [data-status="powerTransistor"] .value-on { animation: sh-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="powerTransistor"] .value-off { animation: sh-status-value-off 0.4s ease-out 1.6s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    oscillator: {
      title: "المذبذب (Oscillator)",
      // src/data/chapter-03/page-19.json #stage5-p2 (excerpt)
      text: "يعطي المذبذب اشارة مربعة موجبة وسالبة، تتحول بعدها الى اشارة نبضية في بداية كل موجة مربعة وتوصل الى قاعدة الترانزستور Q1.",
    },
    chargeTransistor: {
      title: "ترانزستور شحن/تفريغ المتسعة",
      // src/data/chapter-03/page-19.json #stage5-p2 (excerpt)
      text: "عند تشغيل الترانزستور (ON) يعمل دائرة قصر (Short Circuit) على متسعة الشحن فتصبح (0V)، وعندما يكون (OFF) تشحن المتسعة عن طريق مقاومة متغيرة خارجية تسيطر على الفترة الزمنية لشحن المتسعة.",
    },
    comparator: {
      title: "المقارن",
      // src/data/chapter-03/page-19.json #stage5-p3 (excerpt)
      text: "يقارن هذا المقارن الفولتية الثابتة (من مقاومتي تجزئة) مع الفولتية المتغيرة للمتسعة، ويكون خرج المكبر متناسبا مع هاتين الفولتيتين.",
    },
    powerTransistor: {
      title: "ترانزستور القدرة",
      // src/data/chapter-03/page-19.json #stage5-p3 (excerpt)
      text: "يربط خرج المقارن بترانزستور القدرة الذي بدوره يوصل الجهد الـ (DC) الى القلم الحراري حسب درجة الحرارة المطلوبة.",
    },
  };

  wireDiagramSimulator(".stylus-heat-diagram", { cycleMs: 2400, componentInfo: COMPONENT_INFO });
</script>
