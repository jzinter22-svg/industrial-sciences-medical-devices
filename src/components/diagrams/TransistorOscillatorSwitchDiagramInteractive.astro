---
// Figure 8-16 (دائرة وحدة الجراحة باستعمال المذبذب والمفتاح الالكتروني)
// — Q1 oscillates continuously as the RF source; Q2 acts as an
// electronic switch controlled by Q1. In Cut mode Q2 stays conducting and
// Q1's continuous sine passes straight through the transformer. In
// Coagulation mode a square wave feeds Q2's base and chops that sine into
// bursts. Same Cut/Coagulation toggle pattern as Fig 8-8/8-13, scaled
// down to this specific two-transistor implementation.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft transistor-oscillator-switch-diagram">
  <div class="simulator-shell" data-mode="cut">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة دائرة المذبذب والمفتاح الالكتروني</span>
      <span class="simulator-subtitle">شكل 8-16 — Q1 مذبذب دائم، Q2 مفتاح إلكتروني</span>
    </div>

    <div class="mode-toggle-row">
      <button type="button" class="mode-toggle-button" data-mode-button="cut" aria-pressed="true">قطع (Cut)</button>
      <button type="button" class="mode-toggle-button" data-mode-button="coag" aria-pressed="false">تخثر (Coagulation)</button>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es16-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="320"
          viewBox="0 0 820 320"
          role="img"
          aria-label="دائرة المذبذب والمفتاح الالكتروني"
        >
          <defs>
            <marker id="es16-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="es16BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es16Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es16GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="es16GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="es16GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="es16GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="es16Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es16Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="320" rx="20" fill="url(#es16BgGrad)"></rect>
          <rect x="0" y="0" width="820" height="320" rx="20" fill="url(#es16Grid)"></rect>

          <text x="410" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">دائرة وحدة الجراحة باستعمال المذبذب والمفتاح الالكتروني</text>

          <g class="hotspot" data-component="q1-oscillator" tabindex="0" role="button" aria-label="الترانزستور Q1 (مذبذب RF)">
            <rect class="box-shape" x="40" y="80" width="140" height="110" rx="10" fill="url(#es16GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#es16Elevate)"></rect>
            <circle cx="110" cy="130" r="20" fill="none" stroke="#C084FC" stroke-width="1.6"></circle>
            <text x="110" y="135" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="ltr">Q1</text>
            <text x="110" y="170" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#C084FC" direction="rtl">مذبذب RF دائم</text>
          </g>

          <g class="link" data-link="q1-oscillator" data-link-to="q2-switch">
            <line id="es16-wire-1" x1="180" y1="135" x2="225" y2="135" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es16-arrow)"></line>
            <line class="trail" x1="180" y1="135" x2="223" y2="135" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#C084FC" filter="url(#es16Glow)" style="offset-path: url(#es16-wire-1); --flow-delay:0.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="q2-switch" tabindex="0" role="button" aria-label="الترانزستور Q2 (مفتاح إلكتروني)">
            <rect class="box-shape" x="225" y="80" width="140" height="110" rx="10" fill="url(#es16GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#es16Elevate)"></rect>
            <circle cx="295" cy="130" r="20" fill="none" stroke="#38BDF8" stroke-width="1.6"></circle>
            <text x="295" y="135" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="ltr">Q2</text>
            <text x="295" y="170" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#38BDF8" direction="rtl">مفتاح إلكتروني</text>
          </g>

          <!-- Coag control input into Q2's base -->
          <g class="coag-only">
            <rect class="box-shape" x="225" y="220" width="140" height="60" rx="10" fill="url(#es16GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es16Elevate)"></rect>
            <text x="295" y="245" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">نمط التخثر</text>
            <text x="295" y="261" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#FB923C" direction="rtl">موجة مربعة</text>
            <path d="M 295,220 L 295,190" fill="none" stroke="#FB923C" stroke-width="2" marker-end="url(#es16-arrow)"></path>
          </g>

          <g class="link" data-link="q2-switch" data-link-to="transformer">
            <line id="es16-wire-2" x1="365" y1="135" x2="410" y2="135" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es16-arrow)"></line>
            <line class="trail" x1="365" y1="135" x2="408" y2="135" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#38BDF8" filter="url(#es16Glow)" style="offset-path: url(#es16-wire-2); --flow-delay:0.9s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="transformer" tabindex="0" role="button" aria-label="المحولة T1">
            <rect class="box-shape" x="410" y="80" width="110" height="110" rx="10" fill="url(#es16GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es16Elevate)"></rect>
            <path d="M 445,140 a6,10 0 1 1 0,-20 M 460,140 a6,10 0 1 1 0,-20 M 475,140 a6,10 0 1 1 0,-20" fill="none" stroke="#FB923C" stroke-width="1.6"></path>
            <text x="465" y="170" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">T1</text>
          </g>

          <g class="link" data-link="transformer" data-link-to="output">
            <line id="es16-wire-3" x1="520" y1="135" x2="565" y2="135" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es16-arrow)"></line>
            <line class="trail" x1="520" y1="135" x2="563" y2="135" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle output-particle" r="3.6" fill="#4ADE80" filter="url(#es16Glow)" style="offset-path: url(#es16-wire-3); --flow-delay:1.4s; --flow-duration:0.7s;"></circle>
          </g>

          <g class="hotspot" data-component="output" tabindex="0" role="button" aria-label="الموجات الخارجة">
            <rect class="box-shape" x="565" y="70" width="220" height="130" rx="10" fill="url(#es16GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es16Elevate)"></rect>
            <text class="cut-only" x="675" y="145" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">موجة جيبية مستمرة</text>
            <text class="coag-only" x="675" y="145" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">موجة جيبية متقطعة</text>
            <text x="675" y="165" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#4ADE80" direction="rtl">الموجات الخارجة</text>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة الدائرة</h3>
        <ul class="status-list">
          <li class="status-row" data-status="q1-oscillator"><span class="status-dot dot-purple"></span><span class="status-label">Q1 (مذبذب)</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يذبذب دوما</span></span></li>
          <li class="status-row" data-status="q2-switch"><span class="status-dot dot-blue"></span><span class="status-label">Q2 (مفتاح)</span><span class="status-value"><span class="value-off">مقطوع</span><span class="value-on value-cut">موصول باستمرار</span><span class="value-on value-coag">يتقطع بموجة مربعة</span></span></li>
          <li class="status-row" data-status="output"><span class="status-dot dot-green"></span><span class="status-label">الخرج</span><span class="status-value"><span class="value-off">لا يوجد</span><span class="value-on value-cut">مستمر (قطع)</span><span class="value-on value-coag">متقطع (تخثر)</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>بدّل بين القطع والتخثر من الأزرار أعلاه، أو انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>المذبذب Q1</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>المفتاح Q2</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>المحولة / إشارة التخثر</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الخرج</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .mode-toggle-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    padding: 0 var(--neo-space-md) var(--neo-space-sm);
    flex-wrap: wrap;
  }

  .mode-toggle-button {
    font-family: "Cairo", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(255, 255, 255, 0.04);
    color: #c3c9dc;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .mode-toggle-button:hover { background: rgba(255, 255, 255, 0.08); }

  .mode-toggle-button[aria-pressed="true"] {
    background: #C084FC;
    border-color: #C084FC;
    color: #100a18;
  }

  .coag-only { opacity: 0; }
  .simulator-shell[data-mode="coag"] .coag-only { opacity: 1; }
  .value-cut, .value-coag { opacity: 0; }
  .simulator-shell[data-mode="coag"] .value-cut { display: none; }
  .simulator-shell[data-mode="coag"] text.cut-only { display: none; }
  .simulator-shell:not([data-mode="coag"]) .value-coag { display: none; }
  .simulator-shell:not([data-mode="coag"]) text.coag-only { display: none; }

  .hotspot .box-shape {
    filter: url(#es16Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es16Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#es16Glow); }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es16-shape-activate { to { filter: url(#es16Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es16-reveal-trail { to { opacity: 0.85; } }
    @keyframes es16-status-value-on { to { opacity: 1; } }
    @keyframes es16-status-value-off { to { opacity: 0; } }
    @keyframes es16-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes es16-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes es16-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="q1-oscillator"] .box-shape { animation: es16-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="q1-oscillator"] .status-dot { animation: es16-dot-on-purple 0.4s ease-out 0.1s forwards; }
    .playing [data-status="q1-oscillator"] .value-on { animation: es16-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="q1-oscillator"] .value-off { animation: es16-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="q1-oscillator"] .trail { animation: es16-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="q2-switch"] .box-shape { animation: es16-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="q2-switch"] .status-dot { animation: es16-dot-on-blue 0.4s ease-out 0.6s forwards; }
    .playing [data-status="q2-switch"] .value-on { animation: es16-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="q2-switch"] .value-off { animation: es16-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="q2-switch"] .trail { animation: es16-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="transformer"] .box-shape { animation: es16-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-link="transformer"] .trail { animation: es16-reveal-trail 0.3s ease-out 1.4s forwards; }

    .playing [data-component="output"] .box-shape { animation: es16-shape-activate 0.4s ease-out 1.7s forwards; }
    .playing [data-status="output"] .status-dot { animation: es16-dot-on-green 0.4s ease-out 1.7s forwards; }
    .playing [data-status="output"] .value-on { animation: es16-status-value-on 0.4s ease-out 1.7s forwards; }
    .playing [data-status="output"] .value-off { animation: es16-status-value-off 0.4s ease-out 1.7s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes es16-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: es16-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
    @keyframes es16-output-flow-coag {
      0%, 100% { offset-distance: 0%; opacity: 0; }
      6% { opacity: 1; }
      22% { opacity: 1; }
      28% { opacity: 0; }
      34% { opacity: 1; }
      50% { opacity: 1; }
      56% { opacity: 0; }
      62% { opacity: 1; }
      78% { opacity: 1; }
      84% { offset-distance: 100%; opacity: 0; }
    }
    .simulator-shell[data-mode="coag"] .playing .output-particle { animation: es16-output-flow-coag 1.6s linear var(--flow-delay, 0s) infinite; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "q1-oscillator": {
      title: "الترانزستور Q1 (مذبذب RF)",
      text: "يعمل كمذبذب تردد راديوي دائم بسبب اشتغاله (انحياز أمامي)، وتكون موجة الخرج المتولدة فيه دوما موجة جيبية مستمرة.",
    },
    "q2-switch": {
      title: "الترانزستور Q2 (مفتاح للسيطرة على Q1)",
      text: "في نمط القطع يبقى Q2 في حالة عمل مستمرة فتمر موجة Q1 كما هي. في نمط التخثر تُغذّى قاعدته بموجة مربعة فيعمل على تحويل الموجة الجيبية المستمرة إلى موجة متقطعة.",
    },
    transformer: {
      title: "المحولة T1",
      text: "تربط الدائرة بقطبي الجهاز، وتنقل الموجة (مستمرة أو متقطعة حسب النمط) إلى الخرج.",
    },
    output: {
      title: "الموجات الخارجة",
      text: "موجة جيبية مستمرة في نمط القطع، أو موجة جيبية متقطعة في نمط التخثر — النتيجة النهائية لعمل Q1 و Q2 معا.",
    },
  };

  wireDiagramSimulator(".transistor-oscillator-switch-diagram", { cycleMs: 3000, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".transistor-oscillator-switch-diagram .mode-toggle-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".transistor-oscillator-switch-diagram")?.querySelector(".simulator-shell");
      const mode = btn.getAttribute("data-mode-button");
      if (!(shell instanceof HTMLElement) || !mode) return;
      shell.dataset.mode = mode;
      shell.querySelectorAll(".mode-toggle-button").forEach((b) => {
        b.setAttribute("aria-pressed", b === btn ? "true" : "false");
      });
    });
  });
</script>
