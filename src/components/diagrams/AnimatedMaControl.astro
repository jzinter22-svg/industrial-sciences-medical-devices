---
// Animated Figure 1-4 (السيطرة على تيار أنبوب الأشعة).
//
// Rebuilt against the original textbook page (page 13 / PDF index 12) for
// fidelity. Two corrections to the previous build:
//
// 1. Part أ and ب were swapped left/right — the source has the simple
//    filament-transformer illustration (أ) on the LEFT and the practical
//    5-tap selector circuit (ب) on the RIGHT; the previous build reversed
//    them.
// 2. Part أ's right-hand box was mislabeled "مجهز القدرة" (power supply) —
//    in the source that label belongs to the resistor/node-A side, and the
//    box on the far side of the filament transformer is "انبوبة الاشعة"
//    (the X-ray tube, whose filament this circuit feeds). Also, part أ's
//    box was floating with no transformer between it and node A; the
//    source draws an actual filament transformer (primary coil + core +
//    secondary coil) between them, and part ب was missing that same
//    transformer, and 4 of its 5 resistor taps (300/200/150/100/75 mA),
//    entirely — only one generic resistor was drawn.
//
// The book's own text on this page ("مقاومة متغيرة مربوطة على التوالي مع
// محولة خافضة للفولتية") confirms the resistor is in series with the
// transformer, which resolves which transformer terminal the selector's
// wiper wire returns to (the coil's far/bottom terminal) — used here
// where the hand-drawn source line-crossing is otherwise ambiguous.
//
// Animation: part أ highlights resistor -> node A -> transformer; part ب
// keeps its existing 4-stage flow (resistor -> tap -> wiper -> onward)
// re-pointed at the corrected geometry, ending at the transformer/tube.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram ma-diagram">
  <div class="diagram-block-image">
    <svg
      class="ma-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="1080"
      height="380"
      viewBox="0 0 1080 380"
      role="img"
      aria-label="السيطرة على تيار انبوب الأشعة"
    >
      <defs>
        <marker id="arrow-ma" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
        <marker id="arrow-ma-green" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#15803d"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="1080" height="380" fill="none"></rect>

      <!-- ===== Part أ: simple illustrative circuit ===== -->
      <text x="230" y="28" font-family="Cairo, sans-serif" font-size="18" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">أ</text>

      <text x="70" y="170" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهز</text>
      <text x="70" y="188" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">القدرة</text>

      <path class="flow-highlight resistor-a" d="M 230.0,60.0 L 211.7,65.0 L 193.3,55.0 L 175.0,65.0 L 156.7,55.0 L 138.3,65.0 L 120.0,60.0" fill="none" stroke="#c2410c" stroke-width="2.2" marker-end="url(#arrow-ma)"></path>
      <line x1="230" y1="60" x2="230" y2="90" stroke="#263238" stroke-width="2"></line>
      <circle cx="230" cy="90" r="5" fill="#263238"></circle>
      <text x="245" y="85" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="start" direction="ltr">A</text>
      <line x1="230" y1="90" x2="280" y2="90" stroke="#263238" stroke-width="2"></line>
      <line x1="280" y1="90" x2="280" y2="110" stroke="#263238" stroke-width="2"></line>
      <line x1="280" y1="235" x2="100" y2="235" stroke="#263238" stroke-width="2" marker-end="url(#arrow-ma)"></line>

      <path class="flow-highlight coil-a-primary" d="M 280,110 a7,10 0 1 1 0,20 M 280,130 a7,10 0 1 1 0,20 M 280,150 a7,10 0 1 1 0,20 M 280,170 a7,10 0 1 1 0,20 M 280,190 a7,10 0 1 1 0,20 M 280,210 a7,10 0 1 1 0,20" fill="none" stroke="#263238" stroke-width="2"></path>
      <line x1="298" y1="110" x2="298" y2="230" stroke="#15803d" stroke-width="2"></line>
      <line x1="305" y1="110" x2="305" y2="230" stroke="#15803d" stroke-width="2"></line>
      <line x1="312" y1="110" x2="312" y2="230" stroke="#15803d" stroke-width="2"></line>
      <line x1="319" y1="110" x2="319" y2="230" stroke="#15803d" stroke-width="2"></line>
      <path d="M 335,140 a6,10 0 1 1 0,20 M 335,160 a6,10 0 1 1 0,20 M 335,180 a6,10 0 1 1 0,20" fill="none" stroke="#263238" stroke-width="2"></path>

      <line x1="335" y1="140" x2="365" y2="140" stroke="#263238" stroke-width="2"></line>
      <line x1="335" y1="200" x2="365" y2="200" stroke="#263238" stroke-width="2"></line>
      <rect x="365" y="130" width="60" height="80" fill="#ffffff" stroke="#263238" stroke-width="2"></rect>
      <circle cx="395" cy="170" r="13" fill="#ffffff" stroke="#f97316" stroke-width="2"></circle>
      <line x1="386" y1="178" x2="404" y2="162" stroke="#263238" stroke-width="2"></line>
      <text x="460" y="165" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">انبوبة</text>
      <text x="460" y="183" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الاشعة</text>
      <text x="300" y="262" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">محولة الفتيل</text>

      <!-- ===== Part ب: practical 5-tap selector circuit ===== -->
      <text x="700" y="28" font-family="Cairo, sans-serif" font-size="18" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">ب</text>

      <text x="500" y="212" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهز</text>
      <text x="500" y="230" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">القدرة</text>

      <line x1="580" y1="100" x2="540" y2="100" stroke="#263238" stroke-width="2" marker-end="url(#arrow-ma)"></line>
      <line x1="580" y1="340" x2="540" y2="340" stroke="#263238" stroke-width="2" marker-end="url(#arrow-ma)"></line>
      <line x1="580" y1="100" x2="580" y2="340" stroke="#263238" stroke-width="2"></line>
      <line x1="580" y1="100" x2="850" y2="100" stroke="#263238" stroke-width="2"></line>

      <g class="taps">
        <path class="flow-highlight resistor-300" d="M 670,140 L 655,146 L 640,134 L 625,146 L 610,134 L 595,146 L 580,140" fill="none" stroke="#c2410c" stroke-width="2.2" marker-end="url(#arrow-ma)"></path>
        <text x="625" y="128" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">300 mA</text>
        <line x1="670" y1="140" x2="700" y2="140" stroke="#263238" stroke-width="2"></line>
        <circle class="flow-highlight tap-300" cx="700" cy="140" r="5" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>

        <path d="M 670,175 L 655,181 L 640,169 L 625,181 L 610,169 L 595,181 L 580,175" fill="none" stroke="#c2410c" stroke-width="2.2" marker-end="url(#arrow-ma)"></path>
        <text x="625" y="163" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">200 mA</text>
        <line x1="670" y1="175" x2="700" y2="175" stroke="#263238" stroke-width="2"></line>
        <circle cx="700" cy="175" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>

        <path d="M 670,210 L 655,216 L 640,204 L 625,216 L 610,204 L 595,216 L 580,210" fill="none" stroke="#c2410c" stroke-width="2.2" marker-end="url(#arrow-ma)"></path>
        <text x="625" y="198" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">150 mA</text>
        <line x1="670" y1="210" x2="700" y2="210" stroke="#263238" stroke-width="2"></line>
        <circle cx="700" cy="210" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>

        <path d="M 670,245 L 655,251 L 640,239 L 625,251 L 610,239 L 595,251 L 580,245" fill="none" stroke="#c2410c" stroke-width="2.2" marker-end="url(#arrow-ma)"></path>
        <text x="625" y="233" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">100 mA</text>
        <line x1="670" y1="245" x2="700" y2="245" stroke="#263238" stroke-width="2"></line>
        <circle cx="700" cy="245" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>

        <path d="M 670,280 L 655,286 L 640,274 L 625,286 L 610,274 L 595,286 L 580,280" fill="none" stroke="#c2410c" stroke-width="2.2" marker-end="url(#arrow-ma)"></path>
        <text x="625" y="268" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">75 mA</text>
        <line x1="670" y1="280" x2="700" y2="280" stroke="#263238" stroke-width="2"></line>
        <circle cx="700" cy="280" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      </g>

      <text x="790" y="128" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مفتاح اختيار</text>
      <text x="790" y="145" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">mA</text>
      <circle cx="780" cy="245" r="6" fill="#ffffff" stroke="#263238" stroke-width="2"></circle>
      <text x="797" y="260" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="start" direction="ltr">S</text>
      <path d="M 775,240 L 705,145" stroke="#15803d" stroke-width="3" marker-end="url(#arrow-ma-green)"></path>

      <path class="flow-highlight ma-return" d="M 786,245 L 820,245 L 820,340 L 850,340" fill="none" stroke="#263238" stroke-width="2"></path>

      <path class="flow-highlight coil-b-primary" d="M 850,100 a7,12 0 1 1 0,24 M 850,124 a7,12 0 1 1 0,24 M 850,148 a7,12 0 1 1 0,24 M 850,172 a7,12 0 1 1 0,24 M 850,196 a7,12 0 1 1 0,24 M 850,220 a7,12 0 1 1 0,24 M 850,244 a7,12 0 1 1 0,24 M 850,268 a7,12 0 1 1 0,24 M 850,292 a7,12 0 1 1 0,24 M 850,316 a7,12 0 1 1 0,24" fill="none" stroke="#263238" stroke-width="2"></path>
      <line x1="868" y1="100" x2="868" y2="340" stroke="#15803d" stroke-width="2"></line>
      <line x1="875" y1="100" x2="875" y2="340" stroke="#15803d" stroke-width="2"></line>
      <line x1="882" y1="100" x2="882" y2="340" stroke="#15803d" stroke-width="2"></line>
      <line x1="889" y1="100" x2="889" y2="340" stroke="#15803d" stroke-width="2"></line>
      <path d="M 905,170 a6,12 0 1 1 0,24 M 905,194 a6,12 0 1 1 0,24 M 905,218 a6,12 0 1 1 0,24 M 905,242 a6,12 0 1 1 0,24" fill="none" stroke="#263238" stroke-width="2"></path>

      <line x1="905" y1="170" x2="960" y2="170" stroke="#263238" stroke-width="2" marker-end="url(#arrow-ma)"></line>
      <line x1="905" y1="266" x2="960" y2="266" stroke="#263238" stroke-width="2" marker-end="url(#arrow-ma)"></line>
      <text x="1010" y="212" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الى فتيل</text>
      <text x="1010" y="230" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">انبوبة الاشعة</text>

      <text x="870" y="365" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">محولة الفتيل</text>

      <g class="flow-layer" aria-hidden="true">
        <circle class="flow-particle pa1" cx="230" cy="60" r="4.5" style="--tx:-90px; --ty:0px; --particle-delay:0.2s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle pa2" cx="230" cy="90" r="4.5" style="--tx:50px; --ty:0px; --particle-delay:0.8s; --particle-duration:0.4s"></circle>

        <circle class="flow-particle p-resistor" cx="670" cy="140" r="5" style="--tx:-90px; --ty:0px; --particle-delay:1.5s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-diag" cx="700" cy="140" r="5" style="--tx:75px; --ty:105px; --particle-delay:2.1s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-down" cx="780" cy="245" r="5" style="--tx:70px; --ty:95px; --particle-delay:2.7s; --particle-duration:0.5s"></circle>
        <circle class="flow-particle p-out" cx="905" cy="170" r="5" style="--tx:55px; --ty:0px; --particle-delay:3.3s; --particle-duration:0.5s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 3.9s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 560px;
    display: flex;
    justify-content: center;
  }

  .ma-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .resistor-a {
    --highlight-delay: 0.1s;
    --highlight-duration: 0.5s;
  }

  .coil-a-primary {
    --highlight-delay: 0.7s;
    --highlight-duration: 0.6s;
  }

  .resistor-300 {
    --highlight-delay: 1.4s;
    --highlight-duration: 0.5s;
  }

  .tap-300 {
    --highlight-delay: 1.9s;
    --highlight-duration: 0.5s;
  }

  .ma-return {
    --highlight-delay: 2.6s;
    --highlight-duration: 0.6s;
  }

  .coil-b-primary {
    --highlight-delay: 3.2s;
    --highlight-duration: 0.6s;
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".ma-diagram");
</script>
