---
// Figure 4-3 (مقطع للقلب يوضح سريان الدم الشرياني والوريدي) plus section
// 3-4 (الدورتان الدمويتان) rebuilt as one dark neumorphic interactive
// simulator, following the exact Chapter 1/2 system.
//
// The heart sits at the center with two animated loops: the pulmonary
// circulation (right heart <-> lungs) and the systemic circulation
// (left heart <-> body tissues) — the two loops the book's own text
// names and contrasts in section 3-4.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft double-circulation-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة الدورتان الدمويتان</span>
      <span class="simulator-subtitle">شكل 4-3 — الدورة الرئوية والدورة الجهازية</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="dc-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="420"
          viewBox="0 0 820 420"
          role="img"
          aria-label="مقطع للقلب يوضح سريان الدم الشرياني والوريدي"
        >
          <defs>
            <marker id="dc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="dcBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="dcGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="dcGradRed" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a1420"></stop>
              <stop offset="100%" stop-color="#1c0a10"></stop>
            </linearGradient>
            <linearGradient id="dcGradCyan" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0e3238"></stop>
              <stop offset="100%" stop-color="#07181c"></stop>
            </linearGradient>
            <linearGradient id="dcGradGreen" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>

            <filter id="dcElevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="9" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="9" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="7" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fe8ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3.5" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="3" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-3" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.3" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="dcGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="420" rx="20" fill="url(#dcBgGrad)"></rect>
          <rect x="0" y="0" width="820" height="420" rx="20" fill="url(#dcGrid)"></rect>

          <!-- heart center -->
          <g class="hotspot" data-component="heart" tabindex="0" role="button" aria-label="القلب">
            <rect class="hit-area" x="335" y="155" width="150" height="110" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 410,165 L 480,165 Q 480,220 410,260 Q 340,220 340,165 L 410,165 Z"
                  fill="url(#dcGradRed)" stroke="#FB7185" stroke-width="2.5" filter="url(#dcElevate)"></path>
            <text x="410" y="215" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#f4f6fb" text-anchor="middle" direction="rtl">القلب</text>
          </g>

          <!-- lungs -->
          <g class="hotspot" data-component="lungs" tabindex="0" role="button" aria-label="الرئتان">
            <rect class="hit-area" x="335" y="20" width="150" height="90" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 355,100 Q 340,50 380,35 Q 405,30 410,60 Q 415,30 440,35 Q 480,50 465,100 Z"
                  fill="url(#dcGradCyan)" stroke="#22D3EE" stroke-width="2.5" filter="url(#dcElevate)"></path>
            <text x="410" y="70" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#f4f6fb" text-anchor="middle" direction="rtl">الرئتان</text>
          </g>

          <!-- body tissues -->
          <g class="hotspot" data-component="tissues" tabindex="0" role="button" aria-label="أنسجة الجسم">
            <rect class="hit-area" x="335" y="300" width="150" height="90" fill="#000" fill-opacity="0"></rect>
            <rect class="box-shape" x="345" y="315" width="130" height="65" rx="10" fill="url(#dcGradGreen)" stroke="#4ADE80" stroke-width="2.5" filter="url(#dcElevate)"></rect>
            <text x="410" y="342" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#f4f6fb" text-anchor="middle" direction="rtl">أنسجة الجسم</text>
            <text x="410" y="360" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Tissues</text>
          </g>

          <!-- pulmonary loop (right side) -->
          <g class="hotspot" data-component="pulmonaryLoop" tabindex="0" role="button" aria-label="الدورة الرئوية">
            <rect class="hit-area" x="485" y="20" width="230" height="245" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 480,180 Q 650,180 650,110 Q 650,60 480,60"
                  fill="none" stroke="#22D3EE" stroke-width="3" stroke-linecap="round" filter="url(#dcElevate)"></path>
            <text x="660" y="120" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#22D3EE" text-anchor="start" direction="rtl">الدورة الرئوية</text>
          </g>

          <!-- systemic loop (left side) -->
          <g class="hotspot" data-component="systemicLoop" tabindex="0" role="button" aria-label="الدورة الجهازية">
            <rect class="hit-area" x="105" y="155" width="230" height="245" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape" d="M 340,180 Q 160,180 160,270 Q 160,345 340,345"
                  fill="none" stroke="#FB7185" stroke-width="3" stroke-linecap="round" filter="url(#dcElevate)"></path>
            <text x="150" y="270" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#FB7185" text-anchor="end" direction="rtl">الدورة الجهازية</text>
          </g>

          <g class="link" data-link="heart" data-link-to="lungs">
            <path d="M 460,165 Q 460,110 425,80" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#dc-arrow)"></path>
            <path class="trail trail-cyan" d="M 460,165 Q 460,110 427,82" fill="none" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="lungs" data-link-to="heart">
            <path d="M 400,100 Q 380,140 380,165" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#dc-arrow)"></path>
            <path class="trail trail-red" d="M 400,100 Q 380,140 380,163" fill="none" stroke="#FB7185" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="heart" data-link-to="tissues">
            <path d="M 400,260 Q 390,290 400,315" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#dc-arrow)"></path>
            <path class="trail trail-red" d="M 400,260 Q 390,290 400,313" fill="none" stroke="#FB7185" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="tissues" data-link-to="heart">
            <path d="M 420,315 Q 430,285 420,260" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#dc-arrow)"></path>
            <path class="trail trail-cyan" d="M 420,315 Q 430,285 420,262" fill="none" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="460" cy="165" r="5" fill="#22D3EE" filter="url(#dcGlow)" style="--tx:-35px; --ty:-85px; --particle-delay:0.1s; --particle-duration:0.9s"></circle>
            <circle class="flow-particle" cx="400" cy="100" r="5" fill="#FB7185" filter="url(#dcGlow)" style="--tx:-20px; --ty:63px; --particle-delay:1.1s; --particle-duration:0.9s"></circle>
            <circle class="flow-particle" cx="400" cy="260" r="5" fill="#FB7185" filter="url(#dcGlow)" style="--tx:0px; --ty:55px; --particle-delay:2.1s; --particle-duration:0.7s"></circle>
            <circle class="flow-particle" cx="420" cy="315" r="5" fill="#22D3EE" filter="url(#dcGlow)" style="--tx:0px; --ty:-53px; --particle-delay:2.9s; --particle-duration:0.7s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="heart"><span class="status-dot dot-red"></span><span class="status-label">القلب</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="lungs"><span class="status-dot dot-cyan"></span><span class="status-label">الرئتان</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="tissues"><span class="status-dot dot-green"></span><span class="status-label">أنسجة الجسم</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="pulmonaryLoop"><span class="status-dot dot-cyan"></span><span class="status-label">الدورة الرئوية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="systemicLoop"><span class="status-dot dot-red"></span><span class="status-label">الدورة الجهازية</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على القلب أو أي دورة دموية لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch" style="background:#FB7185"></span>دم مؤكسج (شرياني)</li>
      <li class="legend-item"><span class="legend-swatch" style="background:#22D3EE"></span>دم غير مؤكسج (وريدي)</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>أنسجة الجسم</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#dcElevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#dcElevate) saturate(1.35) brightness(1.45);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#dcGlow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes dc-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: dc-particle-move var(--particle-duration, 0.8s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes dc-shape-activate { to { filter: url(#dcElevate) saturate(1.35) brightness(1.4); } }
    @keyframes dc-reveal-trail { to { opacity: 0.9; } }
    @keyframes dc-status-value-on { to { opacity: 1; } }
    @keyframes dc-status-value-off { to { opacity: 0; } }
    @keyframes dc-dot-on-red { to { background: #FB7185; box-shadow: 0 0 8px 1px rgba(251, 113, 133, 0.8); } }
    @keyframes dc-dot-on-cyan { to { background: #22D3EE; box-shadow: 0 0 8px 1px rgba(34, 211, 238, 0.8); } }
    @keyframes dc-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="heart"] .box-shape { animation: dc-shape-activate 0.5s ease-out 0.1s forwards; }
    .playing [data-status="heart"] .status-dot { animation: dc-dot-on-red 0.4s ease-out 0.1s forwards; }
    .playing [data-status="heart"] .value-on { animation: dc-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="heart"] .value-off { animation: dc-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="heart"] .trail { animation: dc-reveal-trail 0.3s ease-out 0.3s forwards; }

    .playing [data-component="lungs"] .box-shape { animation: dc-shape-activate 0.5s ease-out 1s forwards; }
    .playing [data-status="lungs"] .status-dot { animation: dc-dot-on-cyan 0.4s ease-out 1s forwards; }
    .playing [data-status="lungs"] .value-on { animation: dc-status-value-on 0.4s ease-out 1s forwards; }
    .playing [data-status="lungs"] .value-off { animation: dc-status-value-off 0.4s ease-out 1s forwards; }
    .playing [data-link="lungs"] .trail { animation: dc-reveal-trail 0.3s ease-out 1.3s forwards; }

    .playing [data-component="tissues"] .box-shape { animation: dc-shape-activate 0.5s ease-out 2.1s forwards; }
    .playing [data-status="tissues"] .status-dot { animation: dc-dot-on-green 0.4s ease-out 2.1s forwards; }
    .playing [data-status="tissues"] .value-on { animation: dc-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="tissues"] .value-off { animation: dc-status-value-off 0.4s ease-out 2.1s forwards; }
    .playing [data-link="tissues"] .trail { animation: dc-reveal-trail 0.3s ease-out 2.9s forwards; }

    .playing [data-component="pulmonaryLoop"] .box-shape { animation: dc-shape-activate 0.5s ease-out 3.6s forwards; }
    .playing [data-status="pulmonaryLoop"] .status-dot { animation: dc-dot-on-cyan 0.4s ease-out 3.6s forwards; }
    .playing [data-status="pulmonaryLoop"] .value-on { animation: dc-status-value-on 0.4s ease-out 3.6s forwards; }
    .playing [data-status="pulmonaryLoop"] .value-off { animation: dc-status-value-off 0.4s ease-out 3.6s forwards; }

    .playing [data-component="systemicLoop"] .box-shape { animation: dc-shape-activate 0.5s ease-out 4s forwards; }
    .playing [data-status="systemicLoop"] .status-dot { animation: dc-dot-on-red 0.4s ease-out 4s forwards; }
    .playing [data-status="systemicLoop"] .value-on { animation: dc-status-value-on 0.4s ease-out 4s forwards; }
    .playing [data-status="systemicLoop"] .value-off { animation: dc-status-value-off 0.4s ease-out 4s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    heart: {
      title: "القلب",
      // src/data/chapter-03/page-01.json #heart-p1 (excerpt)
      text: "هو عضلة مجوفة تنقبض وتنبسط بانتظام، وبانبساطه يتدفق الدم الى ثلاثة تجاويف ويدفع بقوة انقباضه نفس الدم خارجا الى الشرايين الرئيسة، ومنها الى أطراف الجسم.",
    },
    lungs: {
      title: "الرئتان",
      // src/data/chapter-03/page-04.json #circulation-p2 (excerpt)
      text: "الدورة الرئوية (Pulmonary Circulation) يسير فيها الدم من الناحية اليمنى من القلب، عبر الرئتين ثم يعود الى الناحية اليسرى من القلب.",
    },
    tissues: {
      title: "أنسجة الجسم (Tissues)",
      // src/data/chapter-03/page-04.json #circulation-p2 (excerpt)
      text: "يحمل هذا الطريق السريع الدم المشبع بالأوكسجين من الرئتين الى الأنسجة في كل أجزاء الجسم، وبالمثل ولكن في الاتجاه المضاد، يحمل ثاني اوكسيد الكربون بعيدا عن الأنسجة لكي يتم التخلص منه في الرئتين.",
    },
    pulmonaryLoop: {
      title: "الدورة الرئوية (Pulmonary Circulation)",
      // src/data/chapter-03/page-04.json #circulation-p2 (excerpt)
      text: "الدورة الرئوية تتميز عن الدورة الجهازية بأن الدم يسير فيها من الناحية اليمنى من القلب، عبر الرئتين، ثم يعود الى الناحية اليسرى من القلب.",
    },
    systemicLoop: {
      title: "الدورة الجهازية (Systemic Circulation)",
      // src/data/chapter-03/page-04.json #circulation-p2 (excerpt)
      text: "تضخ الناحية اليسرى من القلب الدم عبر الشرايين الى كل جزء من أجزاء الجسم ما عدا الرئتين، ويمر الدم عبر الشعيرات في الأنسجة، ويرجع عبر الأوردة الى الناحية اليمنى من القلب. وهذا الجزء من الدائرة كثيرا مايسمى الدورة الجهازية.",
    },
  };

  wireDiagramSimulator(".double-circulation-diagram", { cycleMs: 4400, componentInfo: COMPONENT_INFO });
</script>
