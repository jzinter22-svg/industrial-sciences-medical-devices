---
// Figure 9-16 (صمام أمان + صمام عدم رجوع) — two spring-loaded disc
// valves stacked in one housing on the back bar: a check valve (one-way
// only, protects the vaporizers from back-pressure) below a safety valve
// (vents to atmosphere above 35 kPa). Beyond the standard 5 playback
// controls this adds one extra button that simulates a pressure spike:
// it stamps data-pressure-spike="true" on the shell for ~1.5s (removed
// via setTimeout), which pops the safety disc open and bursts a few
// particles out through the vent mark, then relaxes back to normal —
// the same additive click-handler pattern used for mode-toggle buttons.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft check-safety-valve-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة صمام الأمان وصمام عدم الرجوع</span>
      <span class="simulator-subtitle">شكل 9-16 — Check Valve و Safety Valve</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="vl16-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="620"
          height="480"
          viewBox="0 0 620 480"
          role="img"
          aria-label="صمام الأمان وصمام عدم الرجوع"
        >
          <defs>
            <marker id="vl16-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="vl16BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="vl16Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="vl16GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="vl16GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="vl16GradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1414"></stop><stop offset="100%" stop-color="#1a0a0a"></stop></linearGradient>
            <linearGradient id="vl16GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="vl16Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="vl16Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="620" height="480" rx="20" fill="url(#vl16BgGrad)"></rect>
          <rect x="0" y="0" width="620" height="480" rx="20" fill="url(#vl16Grid)"></rect>

          <text x="310" y="24" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">صمام عدم الرجوع وصمام الأمان</text>

          <!-- outlet to patient circuit (top) -->
          <g class="hotspot" data-component="outlet-to-patient" tabindex="0" role="button" aria-label="إلى دائرة المريض">
            <rect class="box-shape" x="240" y="35" width="140" height="60" rx="10" fill="url(#vl16GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#vl16Elevate)"></rect>
            <text x="310" y="62" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">إلى دائرة المريض</text>
            <text x="310" y="78" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#bcf5d1" direction="ltr">To patient circuit</text>
          </g>

          <g class="link" data-link="safety-valve" data-link-to="outlet-to-patient">
            <line id="vl16-wire-1" x1="310" y1="115" x2="310" y2="93" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vl16-arrow)"></line>
            <line class="trail" x1="310" y1="115" x2="310" y2="95" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#4ADE80" filter="url(#vl16Glow)" style="offset-path: url(#vl16-wire-1); --flow-delay:1.8s; --flow-duration:0.6s;"></circle>
          </g>

          <!-- safety valve (upper), vents through the "-X" mark -->
          <g class="hotspot" data-component="safety-valve" tabindex="0" role="button" aria-label="صمام الأمان">
            <rect class="box-shape" x="215" y="115" width="190" height="115" rx="14" fill="url(#vl16GradRed)" stroke="#EF4444" stroke-width="2.5" filter="url(#vl16Elevate)"></rect>
            <path d="M 250,205 v-14 l6,-8 6,8 v14 l6,-8 6,8 v14 l6,-8 6,8 v14" fill="none" stroke="#EF4444" stroke-width="1.6"></path>
            <g class="safety-disc">
              <circle cx="310" cy="180" r="15" fill="#3a1414" stroke="#EF4444" stroke-width="1.8"></circle>
            </g>
            <text x="310" y="150" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">صمام الأمان</text>
            <text x="310" y="223" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#f7c9c9" direction="ltr">Safety Valve — 35 kPa</text>

            <!-- vent mark -->
            <g class="vent-mark">
              <path d="M 405,150 L 440,130" stroke="#FBBF24" stroke-width="2" marker-end="url(#vl16-arrow)"></path>
              <text x="450" y="128" text-anchor="start" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#FBBF24" direction="ltr">−X</text>
              <text x="450" y="145" text-anchor="start" font-family="Cairo, sans-serif" font-size="7.5" fill="#fbe9b8" direction="rtl">تنفيس للخارج</text>
            </g>
            <g class="vent-burst-particles">
              <circle class="vent-burst-particle" cx="405" cy="150" r="3" fill="#FBBF24" filter="url(#vl16Glow)"></circle>
              <circle class="vent-burst-particle p2" cx="405" cy="150" r="2.4" fill="#FBBF24" filter="url(#vl16Glow)"></circle>
              <circle class="vent-burst-particle p3" cx="405" cy="150" r="2.8" fill="#FBBF24" filter="url(#vl16Glow)"></circle>
            </g>
          </g>

          <g class="link" data-link="check-valve" data-link-to="safety-valve">
            <line id="vl16-wire-2" x1="310" y1="255" x2="310" y2="233" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vl16-arrow)"></line>
            <line class="trail" x1="310" y1="255" x2="310" y2="235" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FB923C" filter="url(#vl16Glow)" style="offset-path: url(#vl16-wire-2); --flow-delay:1.1s; --flow-duration:0.6s;"></circle>
          </g>

          <!-- check valve / non-return valve (lower) -->
          <g class="hotspot" data-component="check-valve" tabindex="0" role="button" aria-label="صمام عدم الرجوع">
            <rect class="box-shape" x="215" y="255" width="190" height="115" rx="14" fill="url(#vl16GradOrange)" stroke="#FB923C" stroke-width="2.5" filter="url(#vl16Elevate)"></rect>
            <path d="M 250,345 v-14 l6,-8 6,8 v14 l6,-8 6,8 v14 l6,-8 6,8 v14" fill="none" stroke="#FB923C" stroke-width="1.6"></path>
            <circle cx="310" cy="320" r="15" fill="#3a2210" stroke="#FB923C" stroke-width="1.8"></circle>
            <path d="M 302,320 L 318,320 M 310,312 L 318,320 L 310,328" fill="none" stroke="#FB923C" stroke-width="1.6"></path>
            <text x="310" y="290" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">صمام عدم الرجوع</text>
            <text x="310" y="363" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#fcd9b6" direction="ltr">Check Valve — one-way</text>
          </g>

          <g class="link" data-link="inlet-from-backbar" data-link-to="check-valve">
            <line id="vl16-wire-3" x1="310" y1="395" x2="310" y2="373" stroke="#5b6478" stroke-width="2.5" marker-end="url(#vl16-arrow)"></line>
            <line class="trail" x1="310" y1="395" x2="310" y2="375" stroke="#38BDF8" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#38BDF8" filter="url(#vl16Glow)" style="offset-path: url(#vl16-wire-3); --flow-delay:0.3s; --flow-duration:0.6s;"></circle>
          </g>

          <!-- inlet from back bar -->
          <g class="hotspot" data-component="inlet-from-backbar" tabindex="0" role="button" aria-label="من العمود الخلفي">
            <rect class="box-shape" x="240" y="397" width="140" height="60" rx="10" fill="url(#vl16GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#vl16Elevate)"></rect>
            <text x="310" y="424" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">من العمود الخلفي</text>
            <text x="310" y="440" text-anchor="middle" font-family="Cairo, sans-serif" font-size="7" fill="#9fd8f8" direction="ltr">From back bar</text>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة الصمامات</h3>
        <ul class="status-list">
          <li class="status-row" data-status="inlet-from-backbar"><span class="status-dot dot-blue"></span><span class="status-label">من العمود الخلفي</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يدخل الغاز</span></span></li>
          <li class="status-row" data-status="check-valve"><span class="status-dot dot-orange"></span><span class="status-label">صمام عدم الرجوع</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">يمرّر باتجاه واحد</span></span></li>
          <li class="status-row" data-status="safety-valve"><span class="status-dot dot-red"></span><span class="status-label">صمام الأمان</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">مراقب &lt; 35 kPa</span></span></li>
          <li class="status-row" data-status="outlet-to-patient"><span class="status-dot dot-green"></span><span class="status-label">إلى دائرة المريض</span><span class="status-value"><span class="value-off">لا خرج</span><span class="value-on">يصل المريض</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه — أو جرّب زر محاكاة زيادة الضغط أدناه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>من العمود الخلفي</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>صمام عدم الرجوع</li>
      <li class="legend-item"><span class="legend-swatch legend-red"></span>صمام الأمان (35 kPa)</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>إلى دائرة المريض</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
    <button type="button" class="diagram-replay-button pressure-spike-button">⚠ محاكاة زيادة الضغط</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#vl16Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#vl16Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#vl16Glow); }

  /* Pressure-spike interaction: user-triggered, so its short transitions
     stay outside the reduced-motion guard (same convention as the
     hover/selection glow above); only the continuous burst keyframe is
     guarded below. */
  .safety-disc circle {
    transition: transform 0.15s ease-out;
    transform-box: fill-box;
    transform-origin: center;
  }
  .simulator-shell[data-pressure-spike="true"] .safety-disc circle {
    transform: translateY(-12px) scale(1.08);
  }
  .vent-burst-particle { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes vl16-shape-activate { to { filter: url(#vl16Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes vl16-reveal-trail { to { opacity: 0.85; } }
    @keyframes vl16-status-value-on { to { opacity: 1; } }
    @keyframes vl16-status-value-off { to { opacity: 0; } }
    @keyframes vl16-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes vl16-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes vl16-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes vl16-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="inlet-from-backbar"] .box-shape { animation: vl16-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="inlet-from-backbar"] .status-dot { animation: vl16-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="inlet-from-backbar"] .value-on { animation: vl16-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="inlet-from-backbar"] .value-off { animation: vl16-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="inlet-from-backbar"] .trail { animation: vl16-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="check-valve"] .box-shape { animation: vl16-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="check-valve"] .status-dot { animation: vl16-dot-on-orange 0.4s ease-out 0.6s forwards; }
    .playing [data-status="check-valve"] .value-on { animation: vl16-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="check-valve"] .value-off { animation: vl16-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="check-valve"] .trail { animation: vl16-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="safety-valve"] .box-shape { animation: vl16-shape-activate 0.4s ease-out 1.3s forwards; }
    .playing [data-status="safety-valve"] .status-dot { animation: vl16-dot-on-red 0.4s ease-out 1.3s forwards; }
    .playing [data-status="safety-valve"] .value-on { animation: vl16-status-value-on 0.4s ease-out 1.3s forwards; }
    .playing [data-status="safety-valve"] .value-off { animation: vl16-status-value-off 0.4s ease-out 1.3s forwards; }
    .playing [data-link="safety-valve"] .trail { animation: vl16-reveal-trail 0.3s ease-out 1.6s forwards; }

    .playing [data-component="outlet-to-patient"] .box-shape { animation: vl16-shape-activate 0.4s ease-out 2.0s forwards; }
    .playing [data-status="outlet-to-patient"] .status-dot { animation: vl16-dot-on-green 0.4s ease-out 2.0s forwards; }
    .playing [data-status="outlet-to-patient"] .value-on { animation: vl16-status-value-on 0.4s ease-out 2.0s forwards; }
    .playing [data-status="outlet-to-patient"] .value-off { animation: vl16-status-value-off 0.4s ease-out 2.0s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes vl16-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: vl16-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }

    @keyframes vl16-vent-burst {
      0% { opacity: 0; transform: translate(0, 0); }
      15% { opacity: 1; }
      100% { opacity: 0; transform: translate(38px, -26px); }
    }
    .simulator-shell[data-pressure-spike="true"] .vent-burst-particle {
      animation: vl16-vent-burst 1.3s ease-out forwards;
      transform-box: fill-box;
    }
    .simulator-shell[data-pressure-spike="true"] .vent-burst-particle.p2 { animation-delay: 0.12s; }
    .simulator-shell[data-pressure-spike="true"] .vent-burst-particle.p3 { animation-delay: 0.24s; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "inlet-from-backbar": {
      title: "من العمود الخلفي",
      text: "خليط الغازات القادم من العمود الخلفي (بعد مروره بالمبخرات) يدخل من هنا متجها نحو صمام عدم الرجوع.",
    },
    "check-valve": {
      title: "صمام عدم الرجوع (Check Valve)",
      text: "صمام يسمح بمرور الغازات باتجاه واحد فقط، من العمود الخلفي إلى دائرة المريض، ويمنع الغازات من الرجوع إلى المبخرات مرة أخرى.",
    },
    "safety-valve": {
      title: "صمام الأمان (Safety Valve)",
      text: "صمام يسمح بتسريب الغاز عند ازدياد الضغط إلى أعلى من 35 كيلو باسكال. مبدأ عمله تطبيق قوة على الصمام تكون ضد ضغط الغاز؛ فإذا ازداد ضغط الغاز عن الحد المسموح به فإنه سوف يدفع الصمام ويتسرب الغاز إلى الخارج.",
    },
    "outlet-to-patient": {
      title: "إلى دائرة المريض",
      text: "المسار الطبيعي لخروج الغازات في الأحوال العادية (عند عدم تجاوز ضغط الأمان) متجها نحو دائرة المريض.",
    },
  };

  wireDiagramSimulator(".check-safety-valve-diagram", { cycleMs: 2400, componentInfo: COMPONENT_INFO });

  document.querySelectorAll(".check-safety-valve-diagram .pressure-spike-button").forEach((btn) => {
    btn.addEventListener("click", () => {
      const shell = btn.closest(".check-safety-valve-diagram")?.querySelector(".simulator-shell");
      if (!(shell instanceof HTMLElement)) return;
      shell.setAttribute("data-pressure-spike", "true");
      window.setTimeout(() => shell.removeAttribute("data-pressure-spike"), 1500);
    });
  });
</script>
