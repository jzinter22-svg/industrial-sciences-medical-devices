---
// Animated Figure 1-5 (مخطط دائرة المؤقت).
//
// Rebuilt against the original textbook page (page 13 / PDF index 12) for
// fidelity: the power source is drawn as a coil/reactor icon (not a
// plain box) in the source; both switches are open knife-switch symbols
// (two terminal circles + a diagonal blade), not a single stray diagonal
// line; both fuses have terminal circles around the zigzag; the
// contactor has TWO contact pairs (top pair + bottom pair, ganged
// together — the source draws the same open-blade symbol on both rails
// inside the orange box) feeding the HV transformer, with a distinct
// green coil block and a blue linkage line from the coil to the contact
// it pulls closed; the timer switch is a simple two-terminal contact
// symbol, not a lettered box. The source also sets this whole figure on
// a light cyan panel, reproduced here as a background rect behind the
// circuit.
//
// Teaches (unchanged cause -> effect sequence): the timer switch closes
// -> energizes the contactor coil -> both contact pairs close together
// -> power reaches the HV transformer only while that path is live —
// same class hooks / highlight-pulse timing as before, retargeted at the
// corrected symbols.
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram timer-diagram">
  <div class="diagram-block-image">
    <svg
      class="timer-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="900"
      height="460"
      viewBox="0 0 900 460"
      role="img"
      aria-label="مخطط دائرة المؤقت"
    >
      <defs>
        <marker id="arrow-timer" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#263238"></path>
        </marker>
      </defs>

      <rect x="0" y="0" width="900" height="460" fill="none"></rect>
      <rect x="8" y="8" width="884" height="420" rx="8" fill="#cdf5f8"></rect>

      <!-- Power source coil -->
      <text x="70" y="200" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مجهز</text>
      <text x="70" y="218" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">القدرة</text>
      <text x="70" y="236" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#263238" text-anchor="middle" direction="ltr">AC</text>
      <path d="M 130,70 a7,10 0 1 1 0,20 M 130,90 a7,10 0 1 1 0,20 M 130,110 a7,10 0 1 1 0,20 M 130,130 a7,10 0 1 1 0,20 M 130,150 a7,10 0 1 1 0,20 M 130,170 a7,10 0 1 1 0,20 M 130,190 a7,10 0 1 1 0,20 M 130,210 a7,10 0 1 1 0,20 M 130,230 a7,10 0 1 1 0,20 M 130,250 a7,10 0 1 1 0,20 M 130,270 a7,10 0 1 1 0,20 M 130,290 a7,10 0 1 1 0,20 M 130,310 a7,10 0 1 1 0,20 M 130,330 a7,10 0 1 1 0,20 M 130,350 a7,10 0 1 1 0,20 M 130,370 a7,10 0 1 1 0,20" fill="none" stroke="#263238" stroke-width="2"></path>

      <!-- Top rail: switch -> fuse -->
      <line x1="130" y1="70" x2="170" y2="70" stroke="#263238" stroke-width="2"></line>
      <circle cx="170" cy="70" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <circle cx="210" cy="70" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <line x1="170" y1="70" x2="200" y2="52" stroke="#1d4ed8" stroke-width="2.5"></line>
      <text x="190" y="40" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مفتاح</text>
      <line x1="210" y1="70" x2="240" y2="70" stroke="#263238" stroke-width="2"></line>
      <circle cx="240" cy="70" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <path d="M 240,70 L 250,65 L 260,75 L 270,65 L 280,75 L 290,70" fill="none" stroke="#c2410c" stroke-width="2.2"></path>
      <circle cx="290" cy="70" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <text x="265" y="40" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مصهر</text>
      <line x1="290" y1="70" x2="640" y2="70" stroke="#263238" stroke-width="2"></line>
      <line x1="640" y1="70" x2="640" y2="190" stroke="#263238" stroke-width="2"></line>

      <!-- Bottom rail: switch -> fuse -->
      <line x1="130" y1="370" x2="170" y2="370" stroke="#263238" stroke-width="2"></line>
      <circle cx="170" cy="370" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <circle cx="210" cy="370" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <line x1="170" y1="370" x2="200" y2="352" stroke="#1d4ed8" stroke-width="2.5"></line>
      <text x="190" y="400" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مفتاح</text>
      <line x1="210" y1="370" x2="240" y2="370" stroke="#263238" stroke-width="2"></line>
      <circle cx="240" cy="370" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <path d="M 240,370 L 250,365 L 260,375 L 270,365 L 280,375 L 290,370" fill="none" stroke="#c2410c" stroke-width="2.2"></path>
      <circle cx="290" cy="370" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <text x="265" y="400" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">مصهر</text>
      <line x1="290" y1="370" x2="600" y2="370" stroke="#263238" stroke-width="2"></line>
      <line x1="600" y1="370" x2="600" y2="270" stroke="#263238" stroke-width="2"></line>
      <line x1="600" y1="270" x2="640" y2="270" stroke="#263238" stroke-width="2"></line>

      <!-- Contactor: two ganged contact pairs + coil -->
      <rect class="flow-highlight contactor-box" x="640" y="150" width="150" height="150" rx="6" fill="#fed7aa" stroke="#263238" stroke-width="2"></rect>
      <text x="715" y="135" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">موصل هوائي</text>
      <text x="715" y="118" font-family="Cairo, sans-serif" font-size="11" font-weight="600" fill="#263238" text-anchor="middle" direction="ltr">Contactor</text>

      <circle cx="660" cy="190" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <circle cx="770" cy="190" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <line class="contact-blade" x1="660" y1="190" x2="750" y2="176" stroke="#263238" stroke-width="2.2"></line>
      <line x1="770" y1="190" x2="830" y2="190" stroke="#263238" stroke-width="2" marker-end="url(#arrow-timer)"></line>
      <line x1="600" y1="190" x2="640" y2="190" stroke="#263238" stroke-width="2"></line>
      <text x="595" y="165" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#263238" text-anchor="end" direction="rtl">الى مصدر القدرة</text>

      <circle cx="660" cy="270" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <circle cx="770" cy="270" r="4" fill="#ffffff" stroke="#263238" stroke-width="1.5"></circle>
      <line class="contact-blade" x1="660" y1="270" x2="750" y2="256" stroke="#263238" stroke-width="2.2"></line>
      <line x1="770" y1="270" x2="830" y2="270" stroke="#263238" stroke-width="2" marker-end="url(#arrow-timer)"></line>

      <text x="855" y="182" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الى محولة</text>
      <text x="855" y="200" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">الضغط العالي</text>

      <rect class="flow-highlight coil-box" x="685" y="235" width="60" height="20" fill="#15803d" stroke="#263238" stroke-width="1.5"></rect>
      <line x1="745" y1="245" x2="770" y2="270" stroke="#1d4ed8" stroke-width="2"></line>
      <text x="815" y="240" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="start" direction="rtl">ملف الموصل</text>
      <text x="815" y="253" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#263238" text-anchor="start" direction="rtl">الهوائي</text>

      <!-- Control loop: bottom rail -> timer switch -> coil -->
      <line x1="600" y1="370" x2="600" y2="400" stroke="#263238" stroke-width="2"></line>
      <line x1="600" y1="400" x2="640" y2="400" stroke="#263238" stroke-width="2"></line>
      <rect class="flow-highlight timer-switch-box" x="640" y="380" width="70" height="40" rx="4" fill="#ffffff" stroke="#1d4ed8" stroke-width="2"></rect>
      <circle cx="655" cy="400" r="4" fill="#ffffff" stroke="#1d4ed8" stroke-width="1.5"></circle>
      <circle cx="695" cy="400" r="4" fill="#ffffff" stroke="#1d4ed8" stroke-width="1.5"></circle>
      <line x1="675" y1="388" x2="675" y2="412" stroke="#c2410c" stroke-width="3"></line>
      <text x="675" y="368" font-family="Cairo, sans-serif" font-size="12" font-weight="700" fill="#1d4ed8" text-anchor="middle" direction="rtl">مفتاح مؤقت</text>
      <line x1="710" y1="400" x2="715" y2="400" stroke="#263238" stroke-width="2"></line>
      <path d="M 715,400 L 715,245 L 685,245" stroke="#263238" stroke-width="2" fill="none"></path>

      <g class="flow-layer" aria-hidden="true">
        <circle class="particle-loop p-timer" cx="600" cy="370" r="5"></circle>
        <circle class="flow-particle p-top" cx="130" cy="70" r="5" style="--tx:510px; --ty:0px; --particle-delay:2.0s; --particle-duration:0.9s"></circle>
        <circle class="particle-diag p-bottom" cx="600" cy="370" r="5"></circle>
        <circle class="flow-particle p-out" cx="770" cy="190" r="5" style="--tx:60px; --ty:0px; --particle-delay:2.9s; --particle-duration:0.6s"></circle>
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 3.8s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 520px;
    display: flex;
    justify-content: center;
  }

  .timer-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .timer-switch-box {
    --highlight-delay: 0.9s;
    --highlight-duration: 0.6s;
  }

  .coil-box {
    --highlight-delay: 1.4s;
    --highlight-duration: 0.7s;
  }

  .contactor-box {
    --highlight-delay: 1.9s;
    --highlight-duration: 0.8s;
  }

  .particle-loop,
  .particle-diag {
    fill: var(--neo-primary);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* (600,370) -> (600,400) -> (640,400): the timer branch's own wire,
       taken directly from the existing <line> coordinates above. */
    @keyframes timer-loop-move {
      0% {
        transform: translate(0, 0);
        opacity: 0;
      }
      8% {
        opacity: 1;
      }
      55% {
        transform: translate(0, 30px);
      }
      92% {
        opacity: 1;
      }
      100% {
        transform: translate(40px, 30px);
        opacity: 0;
      }
    }

    .playing .p-timer {
      animation: timer-loop-move 1.3s ease-in-out 0.2s;
    }

    /* (600,370) -> (600,270) -> (640,270): main bottom rail into the
       contactor, running once the coil above has already latched. */
    @keyframes bottom-rail-move {
      0% {
        transform: translate(0, 0);
        opacity: 0;
      }
      10% {
        opacity: 1;
      }
      70% {
        transform: translate(0, -100px);
        opacity: 1;
      }
      100% {
        transform: translate(40px, -100px);
        opacity: 0;
      }
    }

    .playing .p-bottom {
      animation: bottom-rail-move 0.8s ease-in-out 2.0s;
    }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".timer-diagram");
</script>
