---
// Figures 7-11 to 7-13 (تفاصيل الصمامات والمحركات الهيدروليكية) built as a
// dark neumorphic interactive simulator, following the exact Chapter 1-6
// system (see IncubatorBlockDiagram.astro / AnimatedTimerCircuit.astro's
// smaller-scale "detail" format). This is the valve/motor close-up the
// chapter's own text calls for — see src/data/chapter-07/page-06.json
// #valve-intro ("تتضمن الأنظمة الهيدروليكية عددا من الصمامات والمفاتيح
// الكهربائية التي تتحكم بحركة السائل الهيدروليكي") — reusing the same
// control-panel/hydraulic-pump concepts already established in
// ChairHydraulicSystemDiagramInteractive.astro, zoomed into the solenoid
// valve and the three actuators it directs.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft chair-valve-motor-detail-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة تفاصيل الصمامات والمحركات</span>
      <span class="simulator-subtitle">شكل 11-7 إلى 13-7 — من المفتاح الكهربائي إلى محركات الحركة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="cvm1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="420"
          viewBox="0 0 820 420"
          role="img"
          aria-label="تفاصيل الصمامات والمحركات الهيدروليكية"
        >
          <defs>
            <marker id="cvm1-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="cvm1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="cvm1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="cvm1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="cvm1GradCyan" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="cvm1GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>

            <filter id="cvm1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="cvm1Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="420" rx="20" fill="url(#cvm1BgGrad)"></rect>
          <rect x="0" y="0" width="820" height="420" rx="20" fill="url(#cvm1Grid)"></rect>

          <text x="410" y="32" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">صمامات ومحركات الكرسي</text>

          <g class="hotspot" data-component="electrical-switch" tabindex="0" role="button" aria-label="المفتاح الكهربائي">
            <rect class="box-shape" x="40" y="160" width="130" height="90" rx="10" fill="url(#cvm1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#cvm1Elevate)"></rect>
            <text x="105" y="198" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">المفتاح</text>
            <text x="105" y="215" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">الكهربائي</text>
          </g>

          <g class="link" data-link="electrical-switch" data-link-to="solenoid-valve">
            <line x1="170" y1="205" x2="215" y2="205" stroke="#5b6478" stroke-width="2.5" marker-end="url(#cvm1-arrow)"></line>
            <line class="trail" x1="170" y1="205" x2="213" y2="205" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>

          <g class="hotspot" data-component="solenoid-valve" tabindex="0" role="button" aria-label="الصمام الملفي الموجه">
            <rect class="box-shape" x="215" y="145" width="150" height="120" rx="10" fill="url(#cvm1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#cvm1Elevate)"></rect>
            <path d="M 250,195 L 280,180 L 280,210 Z" fill="none" stroke="#22D3EE" stroke-width="1.6" opacity="0.8"></path>
            <path d="M 330,195 L 300,180 L 300,210 Z" fill="none" stroke="#22D3EE" stroke-width="1.6" opacity="0.8"></path>
            <text x="290" y="230" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">الصمام الملفي</text>
            <text x="290" y="247" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#22D3EE" direction="ltr">Solenoid Valve</text>
          </g>

          <g class="link" data-link="solenoid-valve" data-link-to="lift-motor">
            <path d="M 365,165 L 410,165 L 410,110 L 460,110" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#cvm1-arrow)"></path>
            <path class="trail" d="M 365,165 L 410,165 L 410,110 L 458,110" fill="none" stroke="#22D3EE" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>
          <g class="link" data-link="solenoid-valve" data-link-to="tilt-motor">
            <line x1="365" y1="205" x2="460" y2="205" stroke="#5b6478" stroke-width="2.5" marker-end="url(#cvm1-arrow)"></line>
            <line class="trail" x1="365" y1="205" x2="458" y2="205" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="solenoid-valve" data-link-to="footrest-motor">
            <path d="M 365,245 L 410,245 L 410,300 L 460,300" fill="none" stroke="#5b6478" stroke-width="2.5" marker-end="url(#cvm1-arrow)"></path>
            <path class="trail" d="M 365,245 L 410,245 L 410,300 L 458,300" fill="none" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></path>
          </g>

          <g class="hotspot" data-component="lift-motor" tabindex="0" role="button" aria-label="محرك الرفع">
            <rect class="box-shape" x="460" y="75" width="130" height="70" rx="10" fill="url(#cvm1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#cvm1Elevate)"></rect>
            <circle cx="525" cy="110" r="16" fill="none" stroke="#22D3EE" stroke-width="1.4" opacity="0.7"></circle>
            <text x="525" y="163" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="rtl">محرك الرفع</text>
          </g>

          <g class="hotspot" data-component="tilt-motor" tabindex="0" role="button" aria-label="محرك الإمالة">
            <rect class="box-shape" x="460" y="170" width="130" height="70" rx="10" fill="url(#cvm1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#cvm1Elevate)"></rect>
            <circle cx="525" cy="205" r="16" fill="none" stroke="#C084FC" stroke-width="1.4" opacity="0.7"></circle>
            <text x="525" y="258" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="rtl">محرك الإمالة</text>
          </g>

          <g class="hotspot" data-component="footrest-motor" tabindex="0" role="button" aria-label="محرك مسند القدمين">
            <rect class="box-shape" x="460" y="265" width="130" height="70" rx="10" fill="url(#cvm1GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#cvm1Elevate)"></rect>
            <circle cx="525" cy="300" r="16" fill="none" stroke="#C084FC" stroke-width="1.4" opacity="0.7"></circle>
            <text x="525" y="353" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" direction="rtl">محرك المسند</text>
          </g>

          <g class="link" data-link="lift-motor" data-link-to="limit-switch">
            <path d="M 590,110 L 650,110 L 650,205" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#cvm1-arrow)"></path>
            <path class="trail" d="M 590,110 L 650,110 L 650,203" fill="none" stroke="#FBBF24" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>
          <g class="link" data-link="tilt-motor" data-link-to="limit-switch">
            <line x1="590" y1="205" x2="650" y2="205" stroke="#5b6478" stroke-width="2" marker-end="url(#cvm1-arrow)"></line>
            <line class="trail" x1="590" y1="205" x2="648" y2="205" stroke="#FBBF24" stroke-width="2" stroke-dasharray="5 6"></line>
          </g>
          <g class="link" data-link="footrest-motor" data-link-to="limit-switch">
            <path d="M 590,300 L 650,300 L 650,206" fill="none" stroke="#5b6478" stroke-width="2" marker-end="url(#cvm1-arrow)"></path>
            <path class="trail" d="M 590,300 L 650,300 L 650,208" fill="none" stroke="#FBBF24" stroke-width="2" stroke-dasharray="5 6"></path>
          </g>

          <g class="hotspot" data-component="limit-switch" tabindex="0" role="button" aria-label="مفتاح نهاية الحركة">
            <circle class="box-shape" cx="700" cy="205" r="42" fill="url(#cvm1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#cvm1Elevate)"></circle>
            <text x="700" y="200" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">مفتاح نهاية</text>
            <text x="700" y="216" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">الحركة</text>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="170" cy="205" r="4.5" fill="#FBBF24" filter="url(#cvm1Glow)" style="--tx:38px; --ty:0px; --particle-delay:0.1s; --particle-duration:0.4s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="electrical-switch"><span class="status-dot dot-yellow"></span><span class="status-label">المفتاح الكهربائي</span><span class="status-value"><span class="value-off">مفتوح</span><span class="value-on">موصول</span></span></li>
          <li class="status-row" data-status="solenoid-valve"><span class="status-dot dot-cyan"></span><span class="status-label">الصمام الملفي</span><span class="status-value"><span class="value-off">مغلق</span><span class="value-on">موجَّه</span></span></li>
          <li class="status-row" data-status="lift-motor"><span class="status-dot dot-cyan"></span><span class="status-label">محرك الرفع</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يعمل</span></span></li>
          <li class="status-row" data-status="tilt-motor"><span class="status-dot dot-purple"></span><span class="status-label">محرك الإمالة</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يعمل</span></span></li>
          <li class="status-row" data-status="footrest-motor"><span class="status-dot dot-purple"></span><span class="status-label">محرك المسند</span><span class="status-value"><span class="value-off">ثابت</span><span class="value-on">يعمل</span></span></li>
          <li class="status-row" data-status="limit-switch"><span class="status-dot dot-yellow"></span><span class="status-label">مفتاح نهاية الحركة</span><span class="status-value"><span class="value-off">جاهز</span><span class="value-on">أوقف الحركة</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مرحلة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>التحكم الكهربائي</li>
      <li class="legend-item"><span class="legend-swatch legend-cyan"></span>السائل الهيدروليكي</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الحركة الميكانيكية</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-cyan { background: #22D3EE; }
  .status-dot.dot-cyan { background: #3a4258; }

  .hotspot .box-shape {
    filter: url(#cvm1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#cvm1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#cvm1Glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes cvm1-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: cvm1-particle-move var(--particle-duration, 0.4s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes cvm1-shape-activate { to { filter: url(#cvm1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes cvm1-reveal-trail { to { opacity: 0.85; } }
    @keyframes cvm1-status-value-on { to { opacity: 1; } }
    @keyframes cvm1-status-value-off { to { opacity: 0; } }
    @keyframes cvm1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes cvm1-dot-on-cyan { to { background: #22D3EE; box-shadow: 0 0 8px 1px rgba(34, 211, 238, 0.8); } }
    @keyframes cvm1-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }

    .playing [data-component="electrical-switch"] .box-shape { animation: cvm1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="electrical-switch"] .status-dot { animation: cvm1-dot-on-yellow 0.4s ease-out 0.1s forwards; }
    .playing [data-status="electrical-switch"] .value-on { animation: cvm1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="electrical-switch"] .value-off { animation: cvm1-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="electrical-switch"] .trail { animation: cvm1-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="solenoid-valve"] .box-shape { animation: cvm1-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="solenoid-valve"] .status-dot { animation: cvm1-dot-on-cyan 0.4s ease-out 0.6s forwards; }
    .playing [data-status="solenoid-valve"] .value-on { animation: cvm1-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="solenoid-valve"] .value-off { animation: cvm1-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-link="solenoid-valve"][data-link-to="lift-motor"] .trail { animation: cvm1-reveal-trail 0.3s ease-out 1.0s forwards; }
    .playing [data-component="lift-motor"] .box-shape { animation: cvm1-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="lift-motor"] .status-dot { animation: cvm1-dot-on-cyan 0.4s ease-out 1.1s forwards; }
    .playing [data-status="lift-motor"] .value-on { animation: cvm1-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="lift-motor"] .value-off { animation: cvm1-status-value-off 0.4s ease-out 1.1s forwards; }

    .playing [data-link="solenoid-valve"][data-link-to="tilt-motor"] .trail { animation: cvm1-reveal-trail 0.3s ease-out 1.5s forwards; }
    .playing [data-component="tilt-motor"] .box-shape { animation: cvm1-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="tilt-motor"] .status-dot { animation: cvm1-dot-on-purple 0.4s ease-out 1.6s forwards; }
    .playing [data-status="tilt-motor"] .value-on { animation: cvm1-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="tilt-motor"] .value-off { animation: cvm1-status-value-off 0.4s ease-out 1.6s forwards; }

    .playing [data-link="solenoid-valve"][data-link-to="footrest-motor"] .trail { animation: cvm1-reveal-trail 0.3s ease-out 2.0s forwards; }
    .playing [data-component="footrest-motor"] .box-shape { animation: cvm1-shape-activate 0.4s ease-out 2.1s forwards; }
    .playing [data-status="footrest-motor"] .status-dot { animation: cvm1-dot-on-purple 0.4s ease-out 2.1s forwards; }
    .playing [data-status="footrest-motor"] .value-on { animation: cvm1-status-value-on 0.4s ease-out 2.1s forwards; }
    .playing [data-status="footrest-motor"] .value-off { animation: cvm1-status-value-off 0.4s ease-out 2.1s forwards; }

    .playing [data-link="lift-motor"] .trail,
    .playing [data-link="tilt-motor"] .trail,
    .playing [data-link="footrest-motor"] .trail { animation: cvm1-reveal-trail 0.3s ease-out 2.5s forwards; }
    .playing [data-component="limit-switch"] .box-shape { animation: cvm1-shape-activate 0.4s ease-out 2.6s forwards; }
    .playing [data-status="limit-switch"] .status-dot { animation: cvm1-dot-on-yellow 0.4s ease-out 2.6s forwards; }
    .playing [data-status="limit-switch"] .value-on { animation: cvm1-status-value-on 0.4s ease-out 2.6s forwards; }
    .playing [data-status="limit-switch"] .value-off { animation: cvm1-status-value-off 0.4s ease-out 2.6s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "electrical-switch": {
      title: "المفتاح الكهربائي (Electrical Switch)",
      text: "يبدأ إشارة التحكم عند ضغط الطبيب على زر الحركة في لوحة التحكم، ويوجّه هذه الإشارة إلى الصمام الملفي.",
    },
    "solenoid-valve": {
      title: "الصمام الملفي الموجه (Solenoid Valve)",
      text: "يتحكم بحركة السائل الهيدروليكي ويحدد نطاقات الحركة، ويوجّه السائل نحو المحرك المطلوب تشغيله حسب الإشارة الكهربائية الواردة.",
    },
    "lift-motor": {
      title: "محرك الرفع (Lift Motor)",
      text: "يحرك أسطوانة الرفع الهيدروليكية لتغيير ارتفاع كرسي المريض صعوداً أو هبوطاً.",
    },
    "tilt-motor": {
      title: "محرك الإمالة (Tilt Motor)",
      text: "يتحكم بإمالة ظهر الكرسي لتعديل زاوية استقبال المريض أثناء العلاج.",
    },
    "footrest-motor": {
      title: "محرك مسند القدمين (Footrest Motor)",
      text: "يحرك مسند القدمين رفعاً أو خفضاً أو إمالة حسب حاجة راحة المريض.",
    },
    "limit-switch": {
      title: "مفتاح نهاية الحركة (Limit Switch)",
