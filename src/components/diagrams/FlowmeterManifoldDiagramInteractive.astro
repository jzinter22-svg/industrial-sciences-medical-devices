---
// Figure 9-9 (مجمع أجهزة قياس التدفق مع التعديل). Four flowmeter columns
// are drawn left-to-right in this order: O2, CO2, C3H6 (cyclopropane),
// N2O — but the manifold's internal plumbing is deliberately NOT wired in
// that same left-to-right order. CO2, C3H6 and N2O each join the
// collection header directly above their own column, while the O2
// column's riser is routed all the way across the top of the manifold to
// join the header LAST, immediately before the outlet to the patient.
// That routing is the entire teaching point of the figure (source 9-9's
// caption/body): if any other gas's flowmeter tube breaks, the reversed
// pressure it creates cannot siphon oxygen away, because oxygen is added
// to the mixture only in the final few centimetres before it leaves the
// manifold.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft flowmeter-manifold-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة مجمع أجهزة قياس التدفق مع التعديل</span>
      <span class="simulator-subtitle">شكل 9-9 — الأوكسجين آخر غاز يختلط قبل الخروج من المشعب</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="mf9-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="900"
          height="460"
          viewBox="0 0 900 460"
          role="img"
          aria-label="مجمع أجهزة قياس التدفق مع التعديل"
        >
          <defs>
            <marker id="mf9-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="mf9BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="mf9Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="mf9GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f2438"></stop><stop offset="100%" stop-color="#081420"></stop></linearGradient>
            <linearGradient id="mf9GradPink" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1030"></stop><stop offset="100%" stop-color="#1a0818"></stop></linearGradient>
            <linearGradient id="mf9GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="mf9GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>
            <linearGradient id="mf9GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="mf9GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>

            <filter id="mf9Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="mf9Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="900" height="460" rx="20" fill="url(#mf9BgGrad)"></rect>
          <rect x="0" y="0" width="900" height="460" rx="20" fill="url(#mf9Grid)"></rect>

          <text x="450" y="26" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13.5" font-weight="700" fill="#eef1f8" direction="rtl">مجمع أجهزة قياس التدفق (الفلوميترات) مع التعديل</text>

          <!-- O2 riser: routed across the TOP, joining the header LAST -->
          <g class="link o2-riser" data-link="o2-column" data-link-to="manifold-header">
            <path id="mf9-wire-o2" d="M 110,175 L 110,60 L 780,60 L 780,95" fill="none" stroke="#5b6478" stroke-width="2.6" marker-end="url(#mf9-arrow)"></path>
            <path class="trail" d="M 110,175 L 110,60 L 780,60 L 780,97" fill="none" stroke="#38BDF8" stroke-width="2.6" stroke-dasharray="6 8"></path>
            <circle class="current-particle" r="3.6" fill="#38BDF8" filter="url(#mf9Glow)" style="offset-path: url(#mf9-wire-o2); --flow-delay:1.9s; --flow-duration:1.6s;"></circle>
          </g>
          <text x="445" y="52" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#9fd8f8" direction="rtl">مسار O2 يعبر أعلى المشعب ليختلط أخيرا، قبل الخروج مباشرة</text>

          <!-- O2 column -->
          <g class="hotspot" data-component="o2-column" tabindex="0" role="button" aria-label="فلوميتر الأوكسجين">
            <rect class="box-shape" x="65" y="175" width="90" height="170" rx="8" fill="url(#mf9GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#mf9Elevate)"></rect>
            <line x1="110" y1="195" x2="110" y2="325" stroke="#38BDF8" stroke-width="1.2" stroke-dasharray="3 5"></line>
            <text x="110" y="290" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">O2</text>
            <text x="110" y="365" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">فلوميتر</text>
          </g>
          <path d="M 110,420 L 110,345" fill="none" stroke="#5b6478" stroke-width="1.8" marker-end="url(#mf9-arrow)"></path>

          <!-- CO2 column -->
          <g class="hotspot" data-component="co2-column" tabindex="0" role="button" aria-label="فلوميتر ثاني أوكسيد الكربون">
            <rect class="box-shape" x="245" y="175" width="90" height="170" rx="8" fill="url(#mf9GradPink)" stroke="#F472B6" stroke-width="2" filter="url(#mf9Elevate)"></rect>
            <line x1="290" y1="195" x2="290" y2="325" stroke="#F472B6" stroke-width="1.2" stroke-dasharray="3 5"></line>
            <text x="290" y="290" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">CO2</text>
            <text x="290" y="365" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">فلوميتر</text>
          </g>
          <path d="M 290,420 L 290,345" fill="none" stroke="#5b6478" stroke-width="1.8" marker-end="url(#mf9-arrow)"></path>

          <g class="link" data-link="co2-column" data-link-to="manifold-header">
            <line id="mf9-wire-1" x1="290" y1="175" x2="290" y2="105" stroke="#5b6478" stroke-width="2.4" marker-end="url(#mf9-arrow)"></line>
            <line class="trail" x1="290" y1="175" x2="290" y2="107" stroke="#F472B6" stroke-width="2.4" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#F472B6" filter="url(#mf9Glow)" style="offset-path: url(#mf9-wire-1); --flow-delay:0.4s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- C3H6 column -->
          <g class="hotspot" data-component="c3h6-column" tabindex="0" role="button" aria-label="فلوميتر البروبان الحلقي">
            <rect class="box-shape" x="425" y="175" width="90" height="170" rx="8" fill="url(#mf9GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#mf9Elevate)"></rect>
            <line x1="470" y1="195" x2="470" y2="325" stroke="#FBBF24" stroke-width="1.2" stroke-dasharray="3 5"></line>
            <text x="470" y="290" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">C3H6</text>
            <text x="470" y="365" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">فلوميتر</text>
          </g>
          <path d="M 470,420 L 470,345" fill="none" stroke="#5b6478" stroke-width="1.8" marker-end="url(#mf9-arrow)"></path>

          <g class="link" data-link="c3h6-column" data-link-to="manifold-header">
            <line id="mf9-wire-2" x1="470" y1="175" x2="470" y2="105" stroke="#5b6478" stroke-width="2.4" marker-end="url(#mf9-arrow)"></line>
            <line class="trail" x1="470" y1="175" x2="470" y2="107" stroke="#FBBF24" stroke-width="2.4" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#FBBF24" filter="url(#mf9Glow)" style="offset-path: url(#mf9-wire-2); --flow-delay:0.9s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- N2O column -->
          <g class="hotspot" data-component="n2o-column" tabindex="0" role="button" aria-label="فلوميتر أوكسيد النتروز">
            <rect class="box-shape" x="605" y="175" width="90" height="170" rx="8" fill="url(#mf9GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#mf9Elevate)"></rect>
            <line x1="650" y1="195" x2="650" y2="325" stroke="#4ADE80" stroke-width="1.2" stroke-dasharray="3 5"></line>
            <text x="650" y="290" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">N2O</text>
            <text x="650" y="365" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#eef1f8" direction="rtl">فلوميتر</text>
          </g>
          <path d="M 650,420 L 650,345" fill="none" stroke="#5b6478" stroke-width="1.8" marker-end="url(#mf9-arrow)"></path>

          <g class="link" data-link="n2o-column" data-link-to="manifold-header">
            <line id="mf9-wire-3" x1="650" y1="175" x2="650" y2="105" stroke="#5b6478" stroke-width="2.4" marker-end="url(#mf9-arrow)"></line>
            <line class="trail" x1="650" y1="175" x2="650" y2="107" stroke="#4ADE80" stroke-width="2.4" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#4ADE80" filter="url(#mf9Glow)" style="offset-path: url(#mf9-wire-3); --flow-delay:1.4s; --flow-duration:0.7s;"></circle>
          </g>

          <!-- manifold header pipe -->
          <g class="hotspot" data-component="manifold-header" tabindex="0" role="button" aria-label="مشعب التجميع">
            <rect class="box-shape" x="240" y="90" width="560" height="24" rx="8" fill="url(#mf9GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#mf9Elevate)"></rect>
          </g>
          <text x="520" y="82" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#dcc8fb" direction="rtl">مشعب التجميع</text>

          <g class="link" data-link="manifold-header" data-link-to="patient-outlet">
            <line id="mf9-wire-4" x1="800" y1="102" x2="850" y2="102" stroke="#5b6478" stroke-width="2.6" marker-end="url(#mf9-arrow)"></line>
            <line class="trail" x1="800" y1="102" x2="848" y2="102" stroke="#C084FC" stroke-width="2.6" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.4" fill="#C084FC" filter="url(#mf9Glow)" style="offset-path: url(#mf9-wire-4); --flow-delay:2.6s; --flow-duration:0.5s;"></circle>
          </g>

          <!-- patient outlet -->
          <g class="hotspot" data-component="patient-outlet" tabindex="0" role="button" aria-label="إلى المريض">
            <rect class="box-shape" x="795" y="55" width="95" height="95" rx="10" fill="url(#mf9GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#mf9Elevate)"></rect>
            <text x="842" y="98" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">إلى</text>
            <text x="842" y="115" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">المريض</text>
          </g>

          <text x="450" y="415" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" fill="#dbe0ec" direction="rtl">يوضع فلوميتر الأوكسجين أولا، لكن التعديل الداخلي يجعله آخر غاز يختلط بالمزيج قبل خروجه من المشعب مباشرة</text>
          <text x="450" y="435" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#9aa4ba" direction="rtl">فكسر أنبوبة أي غاز آخر لن يستطيع سحب الأوكسجين بعيدا عن المريض</text>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة المشعب</h3>
        <ul class="status-list">
          <li class="status-row" data-status="o2-column"><span class="status-dot dot-blue"></span><span class="status-label">فلوميتر O2</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يختلط أخيرا</span></span></li>
          <li class="status-row" data-status="co2-column"><span class="status-dot dot-pink"></span><span class="status-label">فلوميتر CO2</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يدخل المشعب</span></span></li>
          <li class="status-row" data-status="c3h6-column"><span class="status-dot dot-yellow"></span><span class="status-label">فلوميتر C3H6</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يدخل المشعب</span></span></li>
          <li class="status-row" data-status="n2o-column"><span class="status-dot dot-green"></span><span class="status-label">فلوميتر N2O</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">يدخل المشعب</span></span></li>
          <li class="status-row" data-status="manifold-header"><span class="status-dot dot-purple"></span><span class="status-label">مشعب التجميع</span><span class="status-value"><span class="value-off">فارغ</span><span class="value-on">يجمع المزيج</span></span></li>
          <li class="status-row" data-status="patient-outlet"><span class="status-dot dot-orange"></span><span class="status-label">إلى المريض</span><span class="status-value"><span class="value-off">لا سريان</span><span class="value-on">مزيج نهائي</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي فلوميتر أو على المشعب لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>O2 (يختلط أخيرا)</li>
      <li class="legend-item"><span class="legend-swatch legend-pink"></span>CO2</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>C3H6</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>N2O</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>مشعب التجميع</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>إلى المريض</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#mf9Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#mf9Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#mf9Glow); }

  .legend-pink { background: #F472B6; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes mf9-shape-activate { to { filter: url(#mf9Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes mf9-reveal-trail { to { opacity: 0.85; } }
    @keyframes mf9-status-value-on { to { opacity: 1; } }
    @keyframes mf9-status-value-off { to { opacity: 0; } }
    @keyframes mf9-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
    @keyframes mf9-dot-on-pink { to { background: #F472B6; box-shadow: 0 0 8px 1px rgba(244, 114, 182, 0.8); } }
    @keyframes mf9-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes mf9-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes mf9-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes mf9-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }

    .playing [data-component="co2-column"] .box-shape { animation: mf9-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="co2-column"] .status-dot { animation: mf9-dot-on-pink 0.4s ease-out 0.1s forwards; }
    .playing [data-status="co2-column"] .value-on { animation: mf9-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="co2-column"] .value-off { animation: mf9-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="co2-column"] .trail { animation: mf9-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="c3h6-column"] .box-shape { animation: mf9-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="c3h6-column"] .status-dot { animation: mf9-dot-on-yellow 0.4s ease-out 0.6s forwards; }
    .playing [data-status="c3h6-column"] .value-on { animation: mf9-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="c3h6-column"] .value-off { animation: mf9-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="c3h6-column"] .trail { animation: mf9-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="n2o-column"] .box-shape { animation: mf9-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="n2o-column"] .status-dot { animation: mf9-dot-on-green 0.4s ease-out 1.1s forwards; }
    .playing [data-status="n2o-column"] .value-on { animation: mf9-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="n2o-column"] .value-off { animation: mf9-status-value-off 0.4s ease-out 1.1s forwards; }
    .playing [data-link="n2o-column"] .trail { animation: mf9-reveal-trail 0.3s ease-out 1.4s forwards; }

    .playing [data-component="o2-column"] .box-shape { animation: mf9-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="o2-column"] .status-dot { animation: mf9-dot-on-blue 0.4s ease-out 1.6s forwards; }
    .playing [data-status="o2-column"] .value-on { animation: mf9-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="o2-column"] .value-off { animation: mf9-status-value-off 0.4s ease-out 1.6s forwards; }
    .playing [data-link="o2-column"] .trail { animation: mf9-reveal-trail 0.3s ease-out 1.9s forwards; }

    .playing [data-component="manifold-header"] .box-shape { animation: mf9-shape-activate 0.4s ease-out 3.3s forwards; }
    .playing [data-status="manifold-header"] .status-dot { animation: mf9-dot-on-purple 0.4s ease-out 3.3s forwards; }
    .playing [data-status="manifold-header"] .value-on { animation: mf9-status-value-on 0.4s ease-out 3.3s forwards; }
    .playing [data-status="manifold-header"] .value-off { animation: mf9-status-value-off 0.4s ease-out 3.3s forwards; }
