---
// Animated Figure 2-4 (العربة واقفة وصافرتها تشتغل — الطول الموجي للصوت لا
// يتغير للمستمع الساكن) — printed page 28. Static artwork kept
// pixel-identical. Animation ripples the four already-drawn concentric
// wavefronts outward in emission order (innermost first) to show the
// stationary source radiating evenly-spaced waves, then highlights the
// unchanging sine trace and the stationary listener receiving the
// signal — reusing the same ripple-fade technique built for the radar
// diagram (Figure 2-2).
import "../../styles/diagram-animations.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft animated-diagram doppler-stationary-diagram">
  <div class="diagram-block-image">
    <svg
      class="ds-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="760"
      height="360"
      viewBox="0 0 760 360"
      role="img"
      aria-label="العربة واقفة وصافرتها تشتغل الطول الموجي للصوت لا يتغير للمستمع الساكن"
    >
      <defs>
        <marker id="ds-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#dc2626"></path>
        </marker>
      </defs>
      <rect x="0" y="0" width="760" height="360" fill="none"></rect>

      <g fill="none" stroke="#263238" stroke-width="2">
        <circle class="ripple-ring ring-1" cx="330" cy="170" r="50"></circle>
        <circle class="ripple-ring ring-2" cx="330" cy="170" r="90"></circle>
        <circle class="ripple-ring ring-3" cx="330" cy="170" r="130"></circle>
        <circle class="ripple-ring ring-4" cx="330" cy="170" r="170"></circle>
      </g>

      <g class="flow-highlight truck">
        <rect x="290" y="150" width="80" height="35" rx="4" fill="#dc2626" stroke="#263238" stroke-width="2"></rect>
        <rect x="300" y="130" width="35" height="24" rx="3" fill="#dc2626" stroke="#263238" stroke-width="2"></rect>
        <circle cx="305" cy="188" r="9" fill="#263238"></circle>
        <circle cx="355" cy="188" r="9" fill="#263238"></circle>
      </g>
      <text x="330" y="220" font-family="Cairo, sans-serif" font-size="16" font-weight="700" fill="#dc2626" text-anchor="middle" direction="ltr">V=0</text>

      <path class="flow-highlight sine-trace" d="M 170,270 q 20,-25 40,0 t 40,0 t 40,0 t 40,0 t 40,0 t 40,0 t 40,0 t 40,0" fill="none" stroke="#1d4ed8" stroke-width="2.5"></path>

      <g class="flow-highlight listener">
        <rect x="620" y="145" width="110" height="55" fill="#fde047" stroke="#263238" stroke-width="2"></rect>
        <text x="675" y="168" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#263238" text-anchor="middle" direction="rtl">المستمع ساكن</text>
        <text x="675" y="188" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#dc2626" text-anchor="middle" direction="ltr">v=0</text>
        <line x1="675" y1="135" x2="675" y2="105" stroke="#dc2626" stroke-width="3" marker-end="url(#ds-arrow)"></line>
      </g>

      <text x="60" y="175" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#263238" text-anchor="start" direction="ltr">L1</text>

      <g class="flow-layer" aria-hidden="true">
        <rect class="cycle-end-marker" x="0" y="0" width="1" height="1" fill="none" style="--cycle-length: 2.7s"></rect>
      </g>
    </svg>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
  </div>
</figure>

<style>
  .diagram-block {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
  }

  .diagram-block-image {
    width: 100%;
    max-width: 460px;
    display: flex;
    justify-content: center;
  }

  .ds-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }

  .truck { --highlight-delay: 0s; --highlight-duration: 0.5s; }
  .sine-trace { --highlight-delay: 1.3s; --highlight-duration: 0.9s; }
  .listener { --highlight-delay: 2.2s; --highlight-duration: 0.5s; }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes ripple-fade {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 1; }
    }

    .playing .ring-1 { animation: ripple-fade 0.45s ease-in-out 0.2s; }
    .playing .ring-2 { animation: ripple-fade 0.45s ease-in-out 0.55s; }
    .playing .ring-3 { animation: ripple-fade 0.45s ease-in-out 0.9s; }
    .playing .ring-4 { animation: ripple-fade 0.45s ease-in-out 1.25s; }
  }
</style>

<script>
  import { wireDiagramPlayback } from "../../scripts/diagramPlayback.js";
  wireDiagramPlayback(".doppler-stationary-diagram");
</script>
