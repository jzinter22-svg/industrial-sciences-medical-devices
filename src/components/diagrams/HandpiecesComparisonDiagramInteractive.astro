---
import '../../styles/diagram-simulator.css';
import type { Props as AstroProps } from 'astro';

interface ComponentInfo {
  [key: string]: {
    ar: string;
    en: string;
  };
}

const componentInfo: ComponentInfo = {
  'turbine': {
    ar: 'التوربينة - أداة دوران بسرعة عالية جداً (300,000 دورة في الدقيقة) مع تبريد بالماء والهواء. تُستخدم لعمليات التحضير والقطع السريعة. تولّد ضوضاء عالية جداً.',
    en: 'Turbine - High-speed rotary handpiece operating at 300,000 RPM with water and air cooling. Used for rapid cutting and preparation procedures. Generates very high noise levels.'
  },
  'slow-motor': {
    ar: 'محرك بطيء - أداة دوران بسرعة منخفضة (20,000 دورة في الدقيقة) مع عزم دوران عالي جداً. تُستخدم للحفر والتنظيف العميق. تعمل بتبريد بالماء فقط.',
    en: 'Slow Speed Motor - Low-speed rotary handpiece operating at 20,000 RPM with very high torque output. Used for deep drilling and cleaning procedures. Water-cooled only.'
  },
  'straight-handpiece': {
    ar: 'أداة مستقيمة - محرك مايكرو متعدد الاستخدامات بسرعة متوسطة (40,000 دورة في الدقيقة). تُستخدم للتنظيف والتلميع. تعمل بتبريد هواء فقط مع ضوضاء متوسطة.',
    en: 'Straight Handpiece - Versatile micromotor operating at 40,000 RPM with moderate speed. Used for cleaning and polishing procedures. Air-cooled only with moderate noise levels.'
  },
  'rotation-indicator': {
    ar: 'مؤشرات الدوران - تظهر سرعة الدوران بالدورات في الدقيقة (RPM) لكل أداة. التوربينة الأسرع بكثير تولد حرارة أكثر وتتطلب تبريد أقوى.',
    en: 'Rotation Indicators - Display the rotational speed in revolutions per minute (RPM) for each handpiece. The faster turbine generates more heat and requires stronger cooling.'
  },
  'water-cooling': {
    ar: 'نظام التبريد بالماء - يُستخدم في التوربينة والمحرك البطيء لتبريد رأس الأداة ومنطقة العمل. ضروري للعمليات عالية السرعة.',
    en: 'Water Cooling System - Used in turbine and slow-speed motor to cool the handpiece head and work area. Essential for high-speed operations.'
  },
  'power-supply': {
    ar: 'مصدر الطاقة الكهربائية - توفر الكهرباء اللازمة لتشغيل المحركات. المحرك البطيء يحتاج قوة أكبر من الأداة المستقيمة.',
    en: 'Power Supply - Provides electrical energy to operate the motors. The slow-speed motor requires more power than the straight handpiece.'
  },
  'comparison-specs': {
    ar: 'جدول المقارنة - يعرض المواصفات الرئيسية لكل أداة: السرعة، العزم، الاستخدام، التبريد، والضوضاء. يساعد في اختيار الأداة المناسبة لكل إجراء طبي.',
    en: 'Comparison Table - Displays the main specifications for each handpiece: speed, torque, use case, cooling, and noise levels. Helps in selecting the right tool for each dental procedure.'
  }
};

interface Props extends AstroProps {
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const isRTL = lang === 'ar';
---

<figure class="diagram-block neo-surface-soft">
  <div class="simulator-shell" data-diagram="handpieces-comparison">
    <div class="simulator-toolbar">
      <span class="simulator-title">{lang === 'ar' ? 'أدوات الحفر' : 'Handpieces Comparison'}</span>
      <span class="simulator-subtitle">{lang === 'ar' ? 'شكل 14-7 و 15-7' : 'Figures 7-14 & 7-15'}</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
      <svg id="handpieces-diagram-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 500" class="diagram-svg" data-animation-state="idle" style="--animation-speed: 1;">
        <defs>
          <style>
            .dark-box { fill: #2a3f4d; stroke: #4a6578; stroke-width: 2; }
            .light-box { fill: #3d5a6d; stroke: #5a7a8f; stroke-width: 2; }
            .handpiece { fill: #445a6d; stroke: #6a7f8f; stroke-width: 1.5; }
            .bur { fill: #8fa5b8; stroke: #6a8fa5; stroke-width: 1; }
            .arrow { stroke: #6a8fa5; stroke-width: 2; fill: none; marker-end: url(#arrowhead); }
            .text { fill: #eef1f8; font-family: 'Cairo', sans-serif; font-weight: 600; }
            .text-en { fill: #b7bfd1; font-family: Arial, sans-serif; font-weight: 500; }
            .label { fill: #b8c5d1; font-family: Arial, sans-serif; font-size: 10px; }
            .rotation { fill: none; stroke: #8fa5b8; stroke-width: 2; stroke-dasharray: 4,4; }

            .box-shape { transition: opacity 0.25s ease; }
            .box-active-glow { transition: opacity 0.25s ease; }

            .hotspot { cursor: pointer; outline: none; }
            .hotspot:hover .box-shape {
              opacity: 0.85;
              filter: brightness(1.15);
            }
            .hotspot.is-selected .box-shape {
              filter: brightness(1.2);
            }
            .hotspot.is-selected .box-active-glow {
              opacity: 1;
            }
            .hotspot .box-active-glow {
              opacity: 0;
            }

            .trail { stroke-dasharray: 8 10; animation: flowDash calc(0.6s / var(--animation-speed)) linear infinite; animation-play-state: paused; }
            #handpieces-diagram-svg[data-animation-state="running"] .trail { animation-play-state: running; }
            @keyframes flowDash { to { stroke-dashoffset: 18; } }

            .particle { animation: particleFloat calc(2s / var(--animation-speed)) ease-in-out infinite; animation-play-state: paused; }
            #handpieces-diagram-svg[data-animation-state="running"] .particle { animation-play-state: running; }
            @keyframes particleFloat { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

            @media (prefers-reduced-motion: reduce) {
              .trail { animation: none; stroke-dasharray: none; }
              .particle { animation: none; }
            }
          </style>

          <linearGradient id="grad-turbine" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#3a2f10"/>
            <stop offset="100%" stop-color="#18140a"/>
          </linearGradient>
          <linearGradient id="grad-motor" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0a2a40"/>
            <stop offset="100%" stop-color="#051520"/>
          </linearGradient>
          <linearGradient id="grad-straight" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1a2540"/>
            <stop offset="100%" stop-color="#0d131f"/>
          </linearGradient>

          <filter id="elevate" x="-70%" y="-70%" width="240%" height="240%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="10" result="blurOuter"/>
            <feOffset in="blurOuter" dx="0" dy="10" result="offsetOuter"/>
            <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"/>
            <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"/>

            <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurHalo"/>
            <feOffset in="blurHalo" dx="-5" dy="-5" result="offsetHalo"/>
            <feFlood flood-color="#9fb4ff" flood-opacity="0.18" result="colorHalo"/>
            <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"/>

            <feMerge>
              <feMergeNode in="shadowOuter"/>
              <feMergeNode in="haloOuter"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>

          <filter id="softGlow" x="-140%" y="-140%" width="380%" height="380%">
            <feGaussianBlur stdDeviation="9"/>
          </filter>

          <filter id="lineGlow" x="-180%" y="-180%" width="460%" height="460%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="3.4" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>

          <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
            <polygon points="0 0, 10 3, 0 6" fill="#6a8fa5"/>
          </marker>
          <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <!-- Title -->
        <text x="300" y="25" text-anchor="middle" class="text" font-size="16" font-weight="700">أدوات الحفر (Hand Pieces)</text>

        <!-- Turbine -->
        <g id="turbine" class="hotspot" data-component="turbine" role="button" tabindex="0" aria-label="Turbine handpiece">
          <g transform="translate(120, 120)">
            <g class="box-shape">
              <rect x="-15" y="0" width="30" height="80" rx="8" fill="url(#grad-turbine)" stroke="#fbbf24" stroke-width="2" filter="url(#elevate)"/>
              <rect x="-20" y="75" width="40" height="40" rx="4" fill="url(#grad-turbine)" stroke="#fbbf24" stroke-width="2" filter="url(#elevate)"/>
            </g>
            <rect class="box-active-glow" x="-15" y="0" width="30" height="80" rx="8" fill="none" stroke="#fbbf24" stroke-width="2"/>
            <circle cx="0" cy="95" r="8" fill="#fbbf24" opacity="0.6" stroke="#fbbf24" stroke-width="1"/>
            <path d="M -3 103 L -5 115 L 5 115 L 3 103 Z" fill="#fbbf24" opacity="0.6" stroke="#fbbf24" stroke-width="1"/>
            <circle cx="0" cy="60" r="25" class="rotation" stroke="#fbbf24" opacity="0.5"/>
            <path d="M 15 60 L 25 60 M 0 35 L 0 25" stroke="#fbbf24" stroke-width="1.5" fill="none" opacity="0.6"/>
            <text x="0" y="130" text-anchor="middle" class="text" font-size="11">التوربينة</text>
            <text x="0" y="143" text-anchor="middle" class="text-en" font-size="9">Turbine</text>
            <text x="0" y="158" text-anchor="middle" class="label" font-size="9">300,000 RPM</text>
            <text x="0" y="175" text-anchor="middle" class="label" font-size="8">سرعة عالية جداً</text>
            <line x1="-8" y1="80" x2="-12" y2="95" stroke="#7eb3cc" stroke-width="2"/>
            <circle cx="-14" cy="105" r="2" fill="#7eb3cc"/>
            <text x="-25" y="100" class="label" font-size="8">ماء</text>
          </g>
        </g>

        <!-- Slow Speed Motor -->
        <g id="slow-motor" class="hotspot" data-component="slow-motor" role="button" tabindex="0" aria-label="Slow speed motor">
          <g transform="translate(320, 120)">
            <g class="box-shape">
              <rect x="-20" y="0" width="40" height="90" rx="8" fill="url(#grad-motor)" stroke="#22d3ee" stroke-width="2" filter="url(#elevate)"/>
              <rect x="-18" y="80" width="36" height="35" rx="4" fill="url(#grad-motor)" stroke="#22d3ee" stroke-width="2" filter="url(#elevate)"/>
            </g>
            <rect class="box-active-glow" x="-20" y="0" width="40" height="90" rx="8" fill="none" stroke="#22d3ee" stroke-width="2"/>
            <circle cx="0" cy="105" r="10" fill="#22d3ee" opacity="0.6" stroke="#22d3ee" stroke-width="1"/>
            <path d="M -4 115 L -7 130 L 7 130 L 4 115 Z" fill="#22d3ee" opacity="0.6" stroke="#22d3ee" stroke-width="1"/>
            <circle cx="0" cy="50" r="22" class="rotation" stroke="#22d3ee" opacity="0.5"/>
            <path d="M 17 50 L 27 50 M 0 28 L 0 18" stroke="#22d3ee" stroke-width="1.5" fill="none" opacity="0.6"/>
            <text x="0" y="155" text-anchor="middle" class="text" font-size="11">المحرك البطيء</text>
            <text x="0" y="168" text-anchor="middle" class="text-en" font-size="9">Slow Speed</text>
            <text x="0" y="183" text-anchor="middle" class="label" font-size="9">20,000 RPM</text>
            <text x="0" y="200" text-anchor="middle" class="label" font-size="8">عزم دوران عالي</text>
            <line x1="-10" y1="80" x2="-15" y2="70" stroke="#d4854f" stroke-width="2"/>
            <text x="-28" y="65" class="label" font-size="8">قوة</text>
          </g>
        </g>

        <!-- Straight Handpiece (Micromotor) -->
        <g id="straight-handpiece" class="hotspot" data-component="straight-handpiece" role="button" tabindex="0" aria-label="Straight handpiece">
          <g transform="translate(480, 120)">
            <g class="box-shape">
              <rect x="-12" y="0" width="24" height="95" rx="6" fill="url(#grad-straight)" stroke="#38bdf8" stroke-width="2" filter="url(#elevate)"/>
              <rect x="-16" y="85" width="32" height="30" rx="3" fill="url(#grad-straight)" stroke="#38bdf8" stroke-width="2" filter="url(#elevate)"/>
            </g>
            <rect class="box-active-glow" x="-12" y="0" width="24" height="95" rx="6" fill="none" stroke="#38bdf8" stroke-width="2"/>
            <circle cx="0" cy="100" r="7" fill="#38bdf8" opacity="0.6" stroke="#38bdf8" stroke-width="1"/>
            <path d="M -2 107 L -4 120 L 4 120 L 2 107 Z" fill="#38bdf8" opacity="0.6" stroke="#38bdf8" stroke-width="1"/>
            <circle cx="0" cy="55" r="20" class="rotation" stroke="#38bdf8" opacity="0.5"/>
            <path d="M 16 55 L 24 55 M 0 35 L 0 25" stroke="#38bdf8" stroke-width="1.5" fill="none" opacity="0.6"/>
            <text x="0" y="140" text-anchor="middle" class="text" font-size="11">مستقيمة</text>
            <text x="0" y="153" text-anchor="middle" class="text-en" font-size="9">Straight</text>
            <text x="0" y="168" text-anchor="middle" class="label" font-size="9">40,000 RPM</text>
            <text x="0" y="185" text-anchor="middle" class="label" font-size="8">تنظيف وتلميع</text>
          </g>
        </g>

        <!-- Rotation Indicators Highlight -->
        <g id="rotation-system" class="hotspot" data-component="rotation-indicator" role="button" tabindex="0" aria-label="Rotation indicator system">
          <circle cx="120" cy="60" r="28" fill="none" stroke="#a5c9e0" stroke-width="1" stroke-dasharray="3,3" opacity="0.3"/>
          <circle cx="320" cy="52" r="25" fill="none" stroke="#a5c9e0" stroke-width="1" stroke-dasharray="3,3" opacity="0.3"/>
          <circle cx="480" cy="55" r="23" fill="none" stroke="#a5c9e0" stroke-width="1" stroke-dasharray="3,3" opacity="0.3"/>
        </g>

        <!-- Water Cooling System -->
        <g id="water-cooling" class="hotspot" data-component="water-cooling" role="button" tabindex="0" aria-label="Water cooling system">
          <circle cx="106" cy="105" r="12" fill="none" stroke="#7eb3cc" stroke-width="2" stroke-dasharray="2,2"/>
          <path d="M 100 98 L 110 98 L 110 108 L 100 108 Z" fill="none" stroke="#7eb3cc" stroke-width="1.5"/>
        </g>

        <!-- Power Supply -->
        <g id="power-supply" class="hotspot" data-component="power-supply" role="button" tabindex="0" aria-label="Power supply connection">
          <circle cx="305" cy="75" r="12" fill="none" stroke="#d4854f" stroke-width="2" stroke-dasharray="2,2"/>
          <path d="M 300 70 L 310 70 L 310 80 L 300 80 Z" fill="none" stroke="#d4854f" stroke-width="1.5"/>
        </g>

        <!-- Comparison Table -->
        <g id="comparison" class="hotspot" data-component="comparison-specs" role="button" tabindex="0" aria-label="Comparison specifications table">
          <rect x="30" y="280" width="540" height="190" rx="5" fill="none" stroke="#4a7a9a" stroke-width="2" stroke-dasharray="3,3"/>
          <text x="300" y="305" text-anchor="middle" class="text" font-size="13" font-weight="700">مقارنة أنواع أدوات الحفر</text>

          <!-- Table content (same as original SVG) -->
          <rect x="40" y="315" width="140" height="25" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="1"/>
          <text x="110" y="335" text-anchor="middle" class="text" font-size="10">المواصفات</text>
          <rect x="180" y="315" width="120" height="25" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="1"/>
          <text x="240" y="335" text-anchor="middle" class="text" font-size="10">التوربينة</text>
          <rect x="300" y="315" width="120" height="25" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="1"/>
          <text x="360" y="335" text-anchor="middle" class="text" font-size="10">محرك بطيء</text>
          <rect x="420" y="315" width="140" height="25" fill="#3d5a6d" stroke="#5a7a8f" stroke-width="1"/>
          <text x="490" y="335" text-anchor="middle" class="text" font-size="10">مستقيمة</text>

          <!-- Speed row -->
          <rect x="40" y="340" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="110" y="354" text-anchor="middle" class="label" font-size="9">السرعة</text>
          <rect x="180" y="340" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="240" y="354" text-anchor="middle" class="label" font-size="8">300,000</text>
          <rect x="300" y="340" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="360" y="354" text-anchor="middle" class="label" font-size="8">20,000</text>
          <rect x="420" y="340" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="490" y="354" text-anchor="middle" class="label" font-size="8">40,000</text>

          <!-- Torque row -->
          <rect x="40" y="360" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="110" y="374" text-anchor="middle" class="label" font-size="9">العزم</text>
          <rect x="180" y="360" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="240" y="374" text-anchor="middle" class="label" font-size="8">منخفض</text>
          <rect x="300" y="360" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="360" y="374" text-anchor="middle" class="label" font-size="8">عالي جداً</text>
          <rect x="420" y="360" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="490" y="374" text-anchor="middle" class="label" font-size="8">متوسط</text>

          <!-- Use row -->
          <rect x="40" y="380" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="110" y="394" text-anchor="middle" class="label" font-size="9">الاستخدام</text>
          <rect x="180" y="380" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="240" y="394" text-anchor="middle" class="label" font-size="8">حفر تحضير</text>
          <rect x="300" y="380" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="360" y="394" text-anchor="middle" class="label" font-size="8">حفر وتنظيف</text>
          <rect x="420" y="380" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="490" y="394" text-anchor="middle" class="label" font-size="8">تنظيف وتلميع</text>

          <!-- Cooling row -->
          <rect x="40" y="400" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="110" y="414" text-anchor="middle" class="label" font-size="9">التبريد</text>
          <rect x="180" y="400" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="240" y="414" text-anchor="middle" class="label" font-size="8">هواء وماء</text>
          <rect x="300" y="400" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="360" y="414" text-anchor="middle" class="label" font-size="8">ماء فقط</text>
          <rect x="420" y="400" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="490" y="414" text-anchor="middle" class="label" font-size="8">هواء فقط</text>

          <!-- Noise row -->
          <rect x="40" y="420" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="110" y="434" text-anchor="middle" class="label" font-size="9">الضوضاء</text>
          <rect x="180" y="420" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="240" y="434" text-anchor="middle" class="label" font-size="8">عالية جداً</text>
          <rect x="300" y="420" width="120" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="360" y="434" text-anchor="middle" class="label" font-size="8">منخفضة</text>
          <rect x="420" y="420" width="140" height="20" fill="#2a3f4d" stroke="#4a6578" stroke-width="0.5"/>
          <text x="490" y="434" text-anchor="middle" class="label" font-size="8">متوسطة</text>
        </g>
      </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">{lang === 'ar' ? 'حالة النظام' : 'System Status'}</h3>
        <ul class="status-list">
          <li class="status-row" data-status="rotation"><span class="status-dot dot-blue"></span><span class="status-label">{lang === 'ar' ? 'الدوران' : 'Rotation'}</span><span class="status-value"><span class="value-off">{lang === 'ar' ? 'متوقف' : 'Stopped'}</span><span class="value-on">{lang === 'ar' ? 'يدور' : 'Rotating'}</span></span></li>
          <li class="status-row" data-status="cooling"><span class="status-dot dot-cyan"></span><span class="status-label">{lang === 'ar' ? 'التبريد' : 'Cooling'}</span><span class="status-value"><span class="value-off">{lang === 'ar' ? 'غير نشط' : 'Inactive'}</span><span class="value-on">{lang === 'ar' ? 'نشط' : 'Active'}</span></span></li>
          <li class="status-row" data-status="power"><span class="status-dot dot-orange"></span><span class="status-label">{lang === 'ar' ? 'الطاقة' : 'Power'}</span><span class="status-value"><span class="value-off">{lang === 'ar' ? 'إيقاف' : 'Off'}</span><span class="value-on">{lang === 'ar' ? 'تشغيل' : 'On'}</span></span></li>
          <li class="status-row" data-status="speed"><span class="status-dot dot-blue2"></span><span class="status-label">{lang === 'ar' ? 'السرعة' : 'Speed'}</span><span class="status-value"><span class="value-off">0 RPM</span><span class="value-on" id="speed-display">40,000 RPM</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>{lang === 'ar' ? 'انقر على أي جزء من الرسم البياني للحصول على معلومات مفصلة' : 'Click on any part of the diagram to get detailed information'}</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>{lang === 'ar' ? 'مصدر الطاقة' : 'Power Supply'}</li>
      <li class="legend-item"><span class="legend-swatch legend-cyan"></span>{lang === 'ar' ? 'التبريد' : 'Cooling'}</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>{lang === 'ar' ? 'الدوران' : 'Rotation'}</li>
    </ul>
  </div>

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button" id="play-btn" aria-label="Play simulation">▶ {lang === 'ar' ? 'تشغيل' : 'Play'}</button>
    <button type="button" class="diagram-replay-button pause-button" id="pause-btn" aria-label="Pause simulation" disabled>⏸ {lang === 'ar' ? 'إيقاف' : 'Pause'}</button>
    <button type="button" class="diagram-replay-button reset-button" id="reset-btn" aria-label="Reset simulation">↻ {lang === 'ar' ? 'إعادة تعيين' : 'Reset'}</button>
  </div>
</figure>

<style>
  /* Status dot color variants */
  .status-dot.dot-orange {
    background: #FB923C;
  }

  .status-dot.dot-cyan {
    background: #7eb3cc;
  }

  .status-dot.dot-blue {
    background: #38BDF8;
  }

  .status-dot.dot-blue2 {
    background: #a5c9e0;
  }

  /* Legend color variants */
  .legend-cyan {
    background: #7eb3cc;
  }

  /* Hotspot styling */
  .hotspot {
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  .hotspot:hover {
    filter: brightness(1.15);
  }

  .hotspot:focus-visible {
    outline: 2px solid #7eb3cc;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hotspot {
      transition: none;
    }
  }
</style>

<script define:vars={{ componentInfo, lang }}>
  const isRTL = lang === 'ar';
  let isPlaying = false;
  let animationState = "idle";
  const container = document.querySelector('[data-diagram="handpieces-comparison"]');

  const hotspots = container.querySelectorAll('.hotspot');
  const infoPanel = container.querySelector('[data-info-panel]');
  const infoHint = infoPanel.querySelector('[data-info-hint]');
  const infoContent = infoPanel.querySelector('[data-info-content]');
  const infoTitle = infoContent.querySelector('[data-info-title]');
  const infoText = infoContent.querySelector('[data-info-text]');

  const playBtn = container.closest('figure').querySelector('.play-button');
  const pauseBtn = container.closest('figure').querySelector('.pause-button');
  const resetBtn = container.closest('figure').querySelector('.reset-button');
  const svgElement = document.getElementById('handpieces-diagram-svg');

  function updateAnimationState(newState) {
    animationState = newState;
    if (svgElement) {
      svgElement.setAttribute("data-animation-state", newState);
    }
  }

  // Status row references
  const statusRows = {
    rotation: container.querySelector('[data-status="rotation"] .status-value'),
    cooling: container.querySelector('[data-status="cooling"] .status-value'),
    power: container.querySelector('[data-status="power"] .status-value'),
    speed: container.querySelector('[data-status="speed"] .status-value'),
  };

  // Handpiece speed mapping
  const speedMap = {
    'turbine': 300000,
    'slow-motor': 20000,
    'straight-handpiece': 40000
  };

  const coolingMap = {
    'turbine': lang === 'ar' ? 'ماء وهواء' : 'Water & Air',
    'slow-motor': lang === 'ar' ? 'ماء فقط' : 'Water Only',
    'straight-handpiece': lang === 'ar' ? 'هواء فقط' : 'Air Only'
  };

  // Helper to set status row visibility
  function setStatusRow(statusKey, isActive) {
    const statusValue = statusRows[statusKey];
    if (statusValue) {
      const offSpan = statusValue.querySelector('.value-off');
      const onSpan = statusValue.querySelector('.value-on');
      if (offSpan) offSpan.style.opacity = isActive ? '0' : '1';
      if (onSpan) onSpan.style.opacity = isActive ? '1' : '0';
    }
  }

  // Hotspot click handler
  hotspots.forEach(hotspot => {
    hotspot.addEventListener('click', (e) => {
      const component = hotspot.getAttribute('data-component');
      const info = componentInfo[component];
      if (info) {
        infoHint.hidden = true;
        infoContent.hidden = false;
        infoTitle.textContent = component.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
        infoText.textContent = info[lang] || info.en;
      }
      // Update selection state for neumorphic glow effect
      hotspots.forEach((h) => h.classList.remove('is-selected'));
      hotspot.classList.add('is-selected');
      updateStatusDisplay(component);
    });

    // Keyboard navigation
    hotspot.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        hotspot.click();
      }
    });
  });

  // Play button handler
  playBtn.addEventListener('click', () => {
    isPlaying = true;
    updateAnimationState("running");
    setStatusRow('rotation', true);
    setStatusRow('cooling', true);
    setStatusRow('power', true);
    setStatusRow('speed', true);
  });

  // Pause button handler
  pauseBtn.addEventListener('click', () => {
    isPlaying = false;
    updateAnimationState("paused");
    setStatusRow('rotation', false);
    setStatusRow('cooling', false);
    setStatusRow('power', false);
    setStatusRow('speed', false);
  });

  // Reset button handler
  resetBtn.addEventListener('click', () => {
    isPlaying = false;
    updateAnimationState("idle");

    // Reset animation by removing and re-adding to trigger restart
    if (svgElement) {
      svgElement.style.animation = "none";
      setTimeout(() => {
        svgElement.style.animation = "";
      }, 10);
    }

    infoHint.hidden = false;
    infoContent.hidden = true;
    hotspots.forEach((h) => h.classList.remove('is-selected'));
    setStatusRow('rotation', false);
    setStatusRow('cooling', false);
    setStatusRow('power', false);
    setStatusRow('speed', false);
  });

  // Update status display based on selected component
  function updateStatusDisplay(component) {
    if (component === 'turbine' || component === 'slow-motor' || component === 'straight-handpiece') {
      setStatusRow('rotation', true);
      setStatusRow('cooling', true);
      setStatusRow('speed', true);
      if (isPlaying) {
        setStatusRow('power', true);
      }
    } else if (component === 'power-supply') {
      setStatusRow('power', true);
    } else if (component === 'water-cooling') {
      setStatusRow('cooling', true);
    }
  }

  // Initialize with reset state
  resetBtn.click();
</script>
