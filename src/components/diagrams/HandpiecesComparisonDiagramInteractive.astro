---
// Figures 7-14 and 7-15 (مقارنة أدوات الحفر) built as a dark neumorphic
// interactive simulator, following the exact Chapter 1-6 system (see
// IncubatorBlockDiagram.astro). Uses the shared wireDiagramSimulator()
// engine and diagram-simulator.css shell — no bespoke panel markup, CSS,
// or animation loop. Unlike the other Chapter 7 diagrams this one is a
// side-by-side comparison (no energy/flow chain between components), so
// "play" is a sequential spotlight tour across the three handpieces and
// their shared systems rather than a flow-reveal story.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft handpieces-comparison-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة مقارنة أدوات الحفر</span>
      <span class="simulator-subtitle">شكل 14-7 و 15-7 — التوربينة والمحرك البطيء والأداة المستقيمة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="hpc1-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="800"
          height="640"
          viewBox="0 0 800 640"
          role="img"
          aria-label="مقارنة أنواع أدوات حفر الأسنان"
        >
          <defs>
            <linearGradient id="hpc1BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="hpc1Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="hpc1GradYellow" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#332c10"></stop><stop offset="100%" stop-color="#1a1608"></stop></linearGradient>
            <linearGradient id="hpc1GradCyan" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>
            <linearGradient id="hpc1GradBlue" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123249"></stop><stop offset="100%" stop-color="#081826"></stop></linearGradient>

            <filter id="hpc1Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="800" height="640" rx="20" fill="url(#hpc1BgGrad)"></rect>
          <rect x="0" y="0" width="800" height="640" rx="20" fill="url(#hpc1Grid)"></rect>

          <text x="400" y="32" text-anchor="middle" font-family="Cairo, sans-serif" font-size="15" font-weight="700" fill="#eef1f8" direction="rtl">مقارنة أدوات الحفر (Hand Pieces)</text>

          <!-- Turbine -->
          <g class="hotspot" data-component="turbine" tabindex="0" role="button" aria-label="التوربينة">
            <g transform="translate(150, 130)">
              <rect class="box-shape" x="-18" y="0" width="36" height="90" rx="9" fill="url(#hpc1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
              <rect class="box-shape" x="-24" y="82" width="48" height="42" rx="6" fill="url(#hpc1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
              <circle cx="0" cy="103" r="9" fill="#FBBF24" opacity="0.6"></circle>
              <circle cx="0" cy="65" r="27" fill="none" stroke="#FBBF24" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.5"></circle>
              <text x="0" y="148" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">التوربينة</text>
              <text x="0" y="164" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#FBBF24" direction="ltr">Turbine · 300,000 RPM</text>
              <text x="0" y="180" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="600" fill="#b7bfd1" direction="rtl">سرعة عالية جداً</text>
            </g>
          </g>

          <!-- Slow Speed Motor -->
          <g class="hotspot" data-component="slow-motor" tabindex="0" role="button" aria-label="المحرك البطيء">
            <g transform="translate(400, 130)">
              <rect class="box-shape" x="-22" y="0" width="44" height="100" rx="9" fill="url(#hpc1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
              <rect class="box-shape" x="-20" y="90" width="40" height="38" rx="5" fill="url(#hpc1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
              <circle cx="0" cy="112" r="11" fill="#22D3EE" opacity="0.6"></circle>
              <circle cx="0" cy="55" r="24" fill="none" stroke="#22D3EE" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.5"></circle>
              <text x="0" y="158" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">المحرك البطيء</text>
              <text x="0" y="174" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#22D3EE" direction="ltr">Slow Motor · 20,000 RPM</text>
              <text x="0" y="190" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="600" fill="#b7bfd1" direction="rtl">عزم دوران عالي</text>
            </g>
          </g>

          <!-- Straight Handpiece -->
          <g class="hotspot" data-component="straight-handpiece" tabindex="0" role="button" aria-label="الأداة المستقيمة">
            <g transform="translate(650, 130)">
              <rect class="box-shape" x="-13" y="0" width="26" height="95" rx="7" fill="url(#hpc1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
              <rect class="box-shape" x="-17" y="85" width="34" height="33" rx="4" fill="url(#hpc1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
              <circle cx="0" cy="105" r="8" fill="#38BDF8" opacity="0.6"></circle>
              <circle cx="0" cy="58" r="22" fill="none" stroke="#38BDF8" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.5"></circle>
              <text x="0" y="148" text-anchor="middle" font-family="Cairo, sans-serif" font-size="12.5" font-weight="700" fill="#eef1f8" direction="rtl">الأداة المستقيمة</text>
              <text x="0" y="164" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#38BDF8" direction="ltr">Straight · 40,000 RPM</text>
              <text x="0" y="180" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="600" fill="#b7bfd1" direction="rtl">تنظيف وتلميع</text>
            </g>
          </g>

          <!-- Rotation indicator system (shared concept across all three) -->
          <g class="hotspot" data-component="rotation-indicator" tabindex="0" role="button" aria-label="مؤشرات الدوران">
            <circle class="box-shape" cx="400" cy="330" r="42" fill="url(#hpc1GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#hpc1Elevate)"></circle>
            <circle cx="400" cy="330" r="24" fill="none" stroke="#FBBF24" stroke-width="1.4" stroke-dasharray="3 3" opacity="0.6"></circle>
            <text x="400" y="326" text-anchor="middle" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" direction="rtl">مؤشرات الدوران</text>
            <text x="400" y="343" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FBBF24" direction="ltr">RPM</text>
          </g>

          <!-- Water cooling -->
          <g class="hotspot" data-component="water-cooling" tabindex="0" role="button" aria-label="نظام التبريد بالماء">
            <circle class="box-shape" cx="200" cy="330" r="42" fill="url(#hpc1GradCyan)" stroke="#22D3EE" stroke-width="2" filter="url(#hpc1Elevate)"></circle>
            <path d="M 190,322 Q 200,312 210,322 Q 220,332 210,342 Q 200,352 190,342 Q 180,332 190,322 Z" fill="none" stroke="#22D3EE" stroke-width="1.4" opacity="0.7"></path>
            <text x="200" y="365" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">التبريد بالماء</text>
          </g>

          <!-- Power supply -->
          <g class="hotspot" data-component="power-supply" tabindex="0" role="button" aria-label="مصدر الطاقة الكهربائية">
            <circle class="box-shape" cx="600" cy="330" r="42" fill="url(#hpc1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#hpc1Elevate)"></circle>
            <path d="M 604,312 L 590,332 L 600,332 L 596,350 L 612,326 L 601,326 Z" fill="#38BDF8" opacity="0.7"></path>
            <text x="600" y="365" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">مصدر الطاقة</text>
          </g>

          <!-- Comparison table -->
          <g class="hotspot" data-component="comparison-specs" tabindex="0" role="button" aria-label="جدول مقارنة المواصفات">
            <rect class="box-shape" x="60" y="410" width="680" height="200" rx="12" fill="url(#hpc1GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#hpc1Elevate)"></rect>
            <text x="400" y="440" text-anchor="middle" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#eef1f8" direction="rtl">مقارنة أنواع أدوات الحفر</text>

            <rect x="80" y="452" width="150" height="26" fill="#1a2540" stroke="#3a4a68" stroke-width="1"></rect>
            <text x="155" y="470" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" direction="rtl">المواصفات</text>
            <rect x="230" y="452" width="150" height="26" fill="#1a2540" stroke="#3a4a68" stroke-width="1"></rect>
            <text x="305" y="470" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#FBBF24" direction="rtl">التوربينة</text>
            <rect x="380" y="452" width="150" height="26" fill="#1a2540" stroke="#3a4a68" stroke-width="1"></rect>
            <text x="455" y="470" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#22D3EE" direction="rtl">محرك بطيء</text>
            <rect x="530" y="452" width="150" height="26" fill="#1a2540" stroke="#3a4a68" stroke-width="1"></rect>
            <text x="605" y="470" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#38BDF8" direction="rtl">مستقيمة</text>

            <rect x="80" y="478" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="155" y="495" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="600" fill="#dbe0ec" direction="rtl">السرعة</text>
            <rect x="230" y="478" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="305" y="495" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1">300,000 RPM</text>
            <rect x="380" y="478" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="455" y="495" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1">20,000 RPM</text>
            <rect x="530" y="478" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="605" y="495" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1">40,000 RPM</text>

            <rect x="80" y="502" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="155" y="519" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="600" fill="#dbe0ec" direction="rtl">العزم</text>
            <rect x="230" y="502" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="305" y="519" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">منخفض</text>
            <rect x="380" y="502" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="455" y="519" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">عالي جداً</text>
            <rect x="530" y="502" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="605" y="519" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">متوسط</text>

            <rect x="80" y="526" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="155" y="543" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="600" fill="#dbe0ec" direction="rtl">التبريد</text>
            <rect x="230" y="526" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="305" y="543" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">هواء وماء</text>
            <rect x="380" y="526" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="455" y="543" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">ماء فقط</text>
            <rect x="530" y="526" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="605" y="543" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">هواء فقط</text>

            <rect x="80" y="550" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="155" y="567" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="600" fill="#dbe0ec" direction="rtl">الضوضاء</text>
            <rect x="230" y="550" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="305" y="567" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">عالية جداً</text>
            <rect x="380" y="550" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="455" y="567" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">منخفضة</text>
            <rect x="530" y="550" width="150" height="24" fill="#0f1626" stroke="#2a3550" stroke-width="0.5"></rect>
            <text x="605" y="567" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9" fill="#b7bfd1" direction="rtl">متوسطة</text>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="turbine"><span class="status-dot dot-yellow"></span><span class="status-label">التوربينة</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يدور</span></span></li>
          <li class="status-row" data-status="slow-motor"><span class="status-dot dot-cyan"></span><span class="status-label">المحرك البطيء</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يدور</span></span></li>
          <li class="status-row" data-status="straight-handpiece"><span class="status-dot dot-blue"></span><span class="status-label">الأداة المستقيمة</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يدور</span></span></li>
          <li class="status-row" data-status="rotation-indicator"><span class="status-dot dot-yellow"></span><span class="status-label">مؤشرات الدوران</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="water-cooling"><span class="status-dot dot-cyan"></span><span class="status-label">التبريد بالماء</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="power-supply"><span class="status-dot dot-blue"></span><span class="status-label">مصدر الطاقة</span><span class="status-value"><span class="value-off">إيقاف</span><span class="value-on">تشغيل</span></span></li>
          <li class="status-row" data-status="comparison-specs"><span class="status-dot dot-blue"></span><span class="status-label">جدول المقارنة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي أداة في المخطط لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>التوربينة</li>
      <li class="legend-item"><span class="legend-swatch legend-cyan"></span>المحرك البطيء</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>الأداة المستقيمة</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .legend-cyan { background: #22D3EE; }
  .status-dot.dot-cyan { background: #3a4258; }

  .hotspot .box-shape {
    filter: url(#hpc1Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#hpc1Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.02);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes hpc1-shape-activate { to { filter: url(#hpc1Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes hpc1-status-value-on { to { opacity: 1; } }
    @keyframes hpc1-status-value-off { to { opacity: 0; } }
    @keyframes hpc1-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes hpc1-dot-on-cyan { to { background: #22D3EE; box-shadow: 0 0 8px 1px rgba(34, 211, 238, 0.8); } }
    @keyframes hpc1-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }

    .playing [data-component="turbine"] .box-shape { animation: hpc1-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="turbine"] .status-dot { animation: hpc1-dot-on-yellow 0.4s ease-out 0.1s forwards; }
    .playing [data-status="turbine"] .value-on { animation: hpc1-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="turbine"] .value-off { animation: hpc1-status-value-off 0.4s ease-out 0.1s forwards; }

    .playing [data-component="slow-motor"] .box-shape { animation: hpc1-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="slow-motor"] .status-dot { animation: hpc1-dot-on-cyan 0.4s ease-out 0.6s forwards; }
    .playing [data-status="slow-motor"] .value-on { animation: hpc1-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="slow-motor"] .value-off { animation: hpc1-status-value-off 0.4s ease-out 0.6s forwards; }

    .playing [data-component="straight-handpiece"] .box-shape { animation: hpc1-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="straight-handpiece"] .status-dot { animation: hpc1-dot-on-blue 0.4s ease-out 1.1s forwards; }
    .playing [data-status="straight-handpiece"] .value-on { animation: hpc1-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="straight-handpiece"] .value-off { animation: hpc1-status-value-off 0.4s ease-out 1.1s forwards; }

