---
// Figure 2-7 (دورة الهواء المضغوط) - Air Circuit System
// Shows air flow from compressor through filtration, fans, and drills
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft air-circuit-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">الدورة الهوائية</span>
      <span class="simulator-subtitle">شكل 2-7 — مسار الهواء المضغوط</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="acd-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="800"
          height="400"
          viewBox="0 0 800 400"
          role="img"
          aria-label="دورة الهواء المضغوط"
        >
          <defs>
            <linearGradient id="acdBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="acdGrid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M40 0 H0 V40" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="acdAir" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0f3d66"></stop>
              <stop offset="100%" stop-color="#081d33"></stop>
            </linearGradient>
            <marker id="acdArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#6db3f2"></path>
            </marker>
            <filter id="acdGlow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="coloredBlur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="800" height="400" rx="15" fill="url(#acdBgGrad)"></rect>
          <rect x="0" y="0" width="800" height="400" rx="15" fill="url(#acdGrid)"></rect>

          <!-- Title -->
          <text x="400" y="30" text-anchor="middle" fill="#9fb4ff" font-size="14" font-weight="600">الدورة الهوائية في جهاز الأسنان</text>

          <!-- Compressor -->
          <rect x="20" y="120" width="100" height="80" rx="6" fill="#332210" stroke="#5b6478" stroke-width="2"></rect>
          <text x="70" y="150" text-anchor="middle" fill="#f5deb3" font-size="11" font-weight="600">ضاغط الهواء</text>
          <text x="70" y="170" text-anchor="middle" fill="#d4af88" font-size="9">Air Compressor</text>
          <circle cx="115" cy="160" r="4" fill="#6db3f2"></circle>

          <!-- Arrow to filter -->
          <path d="M 125,160 L 170,160" stroke="#6db3f2" stroke-width="3" fill="none" marker-end="url(#acdArrow)"></path>
          <text x="147" y="145" text-anchor="middle" fill="#8ca8f5" font-size="8">مضغوط</text>

          <!-- Filter -->
          <rect x="170" y="120" width="90" height="80" rx="6" fill="url(#acdAir)" stroke="#5b6478" stroke-width="2"></rect>
          <text x="215" y="150" text-anchor="middle" fill="#9fb4ff" font-size="11" font-weight="600">مرشح دقيق</text>
          <text x="215" y="170" text-anchor="middle" fill="#7eb5f5" font-size="9">Micro Filter</text>
          <circle cx="260" cy="160" r="4" fill="#6db3f2"></circle>

          <!-- Arrow to fan -->
          <path d="M 270,160 L 315,160" stroke="#6db3f2" stroke-width="3" fill="none" marker-end="url(#acdArrow)"></path>
          <text x="292" y="145" text-anchor="middle" fill="#8ca8f5" font-size="8">نظيف</text>

          <!-- Fan -->
          <rect x="315" y="120" width="90" height="80" rx="6" fill="url(#acdAir)" stroke="#5b6478" stroke-width="2"></rect>
          <text x="360" y="150" text-anchor="middle" fill="#9fb4ff" font-size="11" font-weight="600">مروحة</text>
          <text x="360" y="170" text-anchor="middle" fill="#7eb5f5" font-size="9">Fan</text>
          <circle cx="405" cy="160" r="4" fill="#6db3f2"></circle>

          <!-- Arrow to heater -->
          <path d="M 415,160 L 460,160" stroke="#6db3f2" stroke-width="3" fill="none" marker-end="url(#acdArrow)"></path>
          <text x="437" y="145" text-anchor="middle" fill="#8ca8f5" font-size="8">تدفق</text>

          <!-- Heater -->
          <rect x="460" y="120" width="90" height="80" rx="6" fill="url(#acdAir)" stroke="#5b6478" stroke-width="2"></rect>
          <text x="505" y="150" text-anchor="middle" fill="#9fb4ff" font-size="11" font-weight="600">مسخن</text>
          <text x="505" y="170" text-anchor="middle" fill="#7eb5f5" font-size="9">Heater</text>
          <circle cx="555" cy="160" r="4" fill="#6db3f2"></circle>

          <!-- Arrow to drills -->
          <path d="M 565,160 L 650,160" stroke="#6db3f2" stroke-width="3" fill="none" marker-end="url(#acdArrow)"></path>
          <text x="607" y="145" text-anchor="middle" fill="#8ca8f5" font-size="8">مدفأ</text>

          <!-- Drills section -->
          <g>
            <rect x="650" y="80" width="130" height="160" rx="8" fill="#1a3d1a" stroke="#5b6478" stroke-width="2"></rect>
            <text x="715" y="105" text-anchor="middle" fill="#b4d9b4" font-size="11" font-weight="600">آلات الحفر</text>

            <!-- Slow-speed -->
            <circle cx="685" cy="140" r="18" fill="#0d250d" stroke="#3a6d3a" stroke-width="1"></circle>
            <text x="685" y="145" text-anchor="middle" fill="#8ec98e" font-size="8">بطيء</text>

            <!-- High-speed -->
            <circle cx="745" cy="140" r="18" fill="#0d250d" stroke="#3a6d3a" stroke-width="1"></circle>
            <text x="745" y="145" text-anchor="middle" fill="#8ec98e" font-size="8">سريع</text>

            <!-- Spray nozzles -->
            <circle cx="685" cy="200" r="14" fill="#0d250d" stroke="#3a6d3a" stroke-width="1"></circle>
            <text x="685" y="205" text-anchor="middle" fill="#8ec98e" font-size="7">رش</text>

            <circle cx="745" cy="200" r="14" fill="#0d250d" stroke="#3a6d3a" stroke-width="1"></circle>
            <text x="745" y="205" text-anchor="middle" fill="#8ec98e" font-size="7">رش</text>
          </g>

          <!-- Pressure gauge indicator -->
          <g data-component="pressure">
            <rect x="20" y="240" width="120" height="80" rx="6" fill="#241530" stroke="#4a5a7a" stroke-width="1"></rect>
            <text x="80" y="265" text-anchor="middle" fill="#d8b4ff" font-size="11" font-weight="600">مقياس الضغط</text>
            <circle cx="80" cy="310" r="20" fill="#1a0d2d" stroke="#6a5a9a" stroke-width="2"></circle>
            <text x="80" y="315" text-anchor="middle" fill="#c9a8f5" font-size="10" font-weight="600">bar</text>
          </g>

          <!-- Flow direction annotation -->
          <text x="400" y="360" text-anchor="middle" fill="#8b96a8" font-size="9">اتجاه التدفق: من اليسار إلى اليمين | الضغط يزداد بعد الضاغط ويُنظم في المرشح والمسخن</text>
        </svg>
      </div>
    </div>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}
</figure>

<style>
  .air-circuit-diagram {
    margin: 0;
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--neo-space-sm);
  }

  .acd-svg {
    width: 100%;
    max-width: 800px;
    height: auto;
  }

  .diagram-block-caption {
    margin: 0;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
    line-height: var(--neo-line-height);
  }
</style>
