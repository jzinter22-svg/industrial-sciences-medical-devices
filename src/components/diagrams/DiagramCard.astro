---
// A self-contained explanatory card for the Educational Diagram System —
// replaces the old bare-text DiagramCallout. Per the Golden Visual
// Reference, a direct label alone is not enough context: every region gets
// a number, a title, and one explanatory sentence together.
//
// Cards stack in normal document flow (see DiagramFrame's `.diagram-cards`)
// so their real rendered height — which varies with title/description
// length at different widths — can never overlap a neighbor the way a
// fixed evenly-spaced percentage position previously did (confirmed by
// measurement: that scheme overlapped every card at every breakpoint).
// `leaderId` pairs this card with its matching illustration anchor so
// DiagramFrame's generic leader-line overlay can connect them using their
// real measured positions instead of a computed percentage.
//
// `icon`, per Golden Visual Reference §4.3 item 4, is a small themed glyph
// reinforcing the region's concept — a static, developer-authored inline
// SVG string (never user input), rendered via set:html.
interface Props {
  number: number;
  title: string;
  description: string;
  leaderId: string;
  color: string;
  icon?: string;
}

const { number, title, description, leaderId, color, icon } = Astro.props;
---

<article class="diagram-card" data-leader-target={leaderId} style={`--card-color: ${color}`}>
  <div class="diagram-card-header">
    <span class="diagram-card-badge">{number}</span>
    <h4 class="diagram-card-title">{title}</h4>
    {icon && <span class="diagram-card-icon" set:html={icon} />}
  </div>
  <p class="diagram-card-description">{description}</p>
</article>

<style>
  /* Description sits on its own row, spanning the card's full width —
     not sharing a row with the badge — because at the mobile card-column
     width (~120px) that split left too little room and wrapped the
     description one word per line (confirmed by screenshot).
     No side border: a solid colored edge on every stacked card reads, once
     several cards sit close together in a column, as one continuous
     vertical colored rail beside the whole card stack — exactly what the
     Golden Reference does not have. Color identity comes from the badge,
     icon, and background tint instead. */
  .diagram-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: color-mix(in srgb, var(--card-color) 10%, var(--neo-surface));
    border-radius: var(--neo-radius-sm);
    padding: 0.35rem 0.5rem;
  }

  .diagram-card-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .diagram-card-badge {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--card-color);
    color: #ffffff;
    font-family: "Cairo", sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .diagram-card-title {
    margin: 0;
    min-width: 0;
    flex: 1 1 auto;
    font-family: "Cairo", sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--neo-text);
  }

  /* Smaller than the badge: the icon is a decorative reinforcing signal,
     not information on its own (the number and title already carry that),
     so it's the right thing to shrink when the header's available width
     is tight — unlike font-size, which must stay readable. */
  .diagram-card-icon {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    color: var(--card-color);
  }

  .diagram-card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .diagram-card-description {
    margin: 0;
    font-family: "Cairo", sans-serif;
    font-weight: 500;
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--neo-muted);
  }

  @media (min-width: 640px) {
    .diagram-card {
      padding: 0.5rem 0.65rem;
      gap: 0.2rem;
    }

    .diagram-card-title {
      font-size: 0.95rem;
    }

    .diagram-card-description {
      font-size: 0.8rem;
    }

    .diagram-card-icon {
      width: 1.2rem;
      height: 1.2rem;
    }
  }
</style>
