---
// Figures 6-6 (المخطط الكتلوي لمنظومة الرطوبة والدليل الورقي) and 6-7
// (الالية الميكانيكية ذات الزوايا الحادة) rebuilt as one dark
// neumorphic interactive simulator, following the exact Chapter 1/2
// system — both figures are the two halves of the humidity system per
// the book's own section (humidification-p1 introduces the basin/fan/
// filter/heater/paper-guide chain, humidity-mechanism-p1 is the small
// supplementary mechanical detail the book itself cross-references from
// figure 6-6's paragraph). Mirrors the Chapter 3 MainAmplifierDiagram
// precedent of covering two figure numbers in a single component.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft humidity-system-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة منظومة الرطوبة</span>
      <span class="simulator-subtitle">شكل 6-6 و6-7 — من حوض الماء الى زيادة نسبة الرطوبة داخل الكابينة</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="hs6-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="460"
          viewBox="0 0 820 460"
          role="img"
          aria-label="منظومة الرطوبة والدليل الورقي والالية الميكانيكية"
        >
          <defs>
            <marker id="hs6-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="hs6BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="hs6Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="hs6GradGreen" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123322"></stop>
              <stop offset="100%" stop-color="#0a1712"></stop>
            </linearGradient>
            <linearGradient id="hs6GradPurple" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#241530"></stop>
              <stop offset="100%" stop-color="#100a18"></stop>
            </linearGradient>
            <linearGradient id="hs6GradYellow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332c10"></stop>
              <stop offset="100%" stop-color="#1a1608"></stop>
            </linearGradient>
            <linearGradient id="hs6GradBlue" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#123249"></stop>
              <stop offset="100%" stop-color="#081826"></stop>
            </linearGradient>
            <linearGradient id="hs6GradOrange" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#332210"></stop>
              <stop offset="100%" stop-color="#1a1108"></stop>
            </linearGradient>
            <linearGradient id="hs6GradGray" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2a2f3d"></stop>
              <stop offset="100%" stop-color="#15181f"></stop>
            </linearGradient>

            <filter id="hs6Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feComponentTransfer in="SourceAlpha" result="invertedAlpha">
                <feFuncA type="table" tableValues="1 0"></feFuncA>
              </feComponentTransfer>
              <feGaussianBlur in="invertedAlpha" stdDeviation="3" result="blurInnerDark"></feGaussianBlur>
              <feOffset in="blurInnerDark" dx="2" dy="3" result="offsetInnerDark"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.5" result="colorInnerDark"></feFlood>
              <feComposite in="colorInnerDark" in2="offsetInnerDark" operator="in" result="shadowInnerRaw"></feComposite>
              <feComposite in="shadowInnerRaw" in2="SourceGraphic" operator="in" result="shadowInner"></feComposite>
              <feGaussianBlur in="invertedAlpha" stdDeviation="2.5" result="blurInnerLight"></feGaussianBlur>
              <feOffset in="blurInnerLight" dx="-2" dy="-2" result="offsetInnerLight"></feOffset>
              <feFlood flood-color="#ffffff" flood-opacity="0.3" result="colorInnerLight"></feFlood>
              <feComposite in="colorInnerLight" in2="offsetInnerLight" operator="in" result="highlightInnerRaw"></feComposite>
              <feComposite in="highlightInnerRaw" in2="SourceGraphic" operator="in" result="highlightInner"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
                <feMergeNode in="shadowInner"></feMergeNode>
                <feMergeNode in="highlightInner"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="hs6Glow" x="-220%" y="-220%" width="540%" height="540%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="460" rx="20" fill="url(#hs6BgGrad)"></rect>
          <rect x="0" y="0" width="820" height="460" rx="20" fill="url(#hs6Grid)"></rect>

          <!-- ===== Section A (fig 6-6): fan -> filter -> heater -> basin -> paper guide ===== -->

          <g class="hotspot" data-component="fan" tabindex="0" role="button" aria-label="ساحبة الهواء">
            <rect class="box-shape" x="40" y="90" width="110" height="80" rx="10" fill="url(#hs6GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#hs6Elevate)"></rect>
            <g class="fan-rotor" style="transform-box: fill-box; transform-origin: center;">
              <circle cx="95" cy="115" r="15" fill="none" stroke="#4ADE80" stroke-width="2"></circle>
              <path d="M 95,100 Q 105,108 95,115 M 95,115 Q 103,125 95,130 M 95,115 Q 85,108 80,115 M 95,115 Q 87,125 95,130" fill="none" stroke="#4ADE80" stroke-width="1.6"></path>
            </g>
            <text x="95" y="150" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">ساحبة الهواء</text>
            <text x="95" y="164" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#4ADE80" text-anchor="middle" direction="ltr">Fan</text>
          </g>

          <g class="hotspot" data-component="microfilter" tabindex="0" role="button" aria-label="مرشح دقيق">
            <rect class="box-shape" x="200" y="90" width="110" height="80" rx="10" fill="url(#hs6GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#hs6Elevate)"></rect>
            <path d="M 225,110 L 285,110 M 225,120 L 285,120 M 225,130 L 285,130 M 225,140 L 285,140" stroke="#C084FC" stroke-width="1.4" opacity="0.8"></path>
            <text x="255" y="158" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مرشح دقيق</text>
            <text x="255" y="171" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#C084FC" text-anchor="middle" direction="ltr">Filter</text>
          </g>

          <g class="hotspot" data-component="heater" tabindex="0" role="button" aria-label="مسخن">
            <rect class="box-shape" x="360" y="90" width="110" height="80" rx="10" fill="url(#hs6GradYellow)" stroke="#FBBF24" stroke-width="2" filter="url(#hs6Elevate)"></rect>
            <rect x="405" y="105" width="20" height="42" rx="4" fill="none" stroke="#FBBF24" stroke-width="1.6"></rect>
            <path d="M 415,113 L 415,139 M 409,119 L 421,133 M 421,119 L 409,133" stroke="#FBBF24" stroke-width="1.2"></path>
            <text x="415" y="158" font-family="Cairo, sans-serif" font-size="11" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">مسخن</text>
            <text x="415" y="171" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FBBF24" text-anchor="middle" direction="ltr">Heater</text>
          </g>

          <g class="hotspot" data-component="airWaterBasin" tabindex="0" role="button" aria-label="حوض الهواء وحوض الماء">
            <rect class="box-shape" x="520" y="55" width="170" height="150" rx="10" fill="url(#hs6GradBlue)" stroke="#38BDF8" stroke-width="2" filter="url(#hs6Elevate)"></rect>
            <line x1="530" y1="128" x2="680" y2="128" stroke="#38BDF8" stroke-width="1.3" stroke-dasharray="4 4" opacity="0.7"></line>
            <text x="605" y="90" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">هواء</text>
            <text x="605" y="165" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">ماء مقطر</text>
            <!-- control opening slider (فتحة التحكم) -->
            <rect x="662" y="72" width="10" height="116" rx="5" fill="none" stroke="#38BDF8" stroke-width="1.4"></rect>
            <circle class="control-slider" cx="667" cy="150" r="6" fill="#0a1c26" stroke="#38BDF8" stroke-width="1.6"></circle>
            <text x="605" y="192" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="ltr">Air / Water Basin</text>
          </g>

          <g class="hotspot" data-component="paperGuide" tabindex="0" role="button" aria-label="الدليل الورقي">
            <rect class="hit-area" x="720" y="15" width="90" height="215" fill="#000" fill-opacity="0"></rect>
            <rect class="box-shape" x="730" y="30" width="70" height="170" rx="8" fill="url(#hs6GradGray)" stroke="#9CA3AF" stroke-width="2" filter="url(#hs6Elevate)"></rect>
            <rect x="734" y="34" width="62" height="30" fill="#38BDF8"></rect>
            <rect x="734" y="64" width="62" height="30" fill="#22D3EE"></rect>
            <rect x="734" y="94" width="62" height="30" fill="#4ADE80"></rect>
            <rect x="734" y="124" width="62" height="30" fill="#FB923C"></rect>
            <rect x="734" y="154" width="62" height="30" fill="#FBBF24"></rect>
            <text x="765" y="53" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">100%</text>
            <text x="765" y="83" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">90%</text>
            <text x="765" y="113" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">80%</text>
            <text x="765" y="143" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">10%</text>
            <text x="765" y="173" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#0a0f1a" text-anchor="middle" direction="ltr">5%</text>
            <text x="765" y="24" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">الدليل الورقي</text>
          </g>

          <!-- connectors: main air/heat path -->
          <g class="link" data-link="fan" data-link-to="microfilter">
            <line x1="150" y1="130" x2="200" y2="130" stroke="#5b6478" stroke-width="2" marker-end="url(#hs6-arrow)"></line>
            <line class="trail trail-green" x1="150" y1="130" x2="198" y2="130" stroke="#4ADE80" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="microfilter" data-link-to="heater">
            <line x1="310" y1="130" x2="360" y2="130" stroke="#5b6478" stroke-width="2" marker-end="url(#hs6-arrow)"></line>
            <line class="trail trail-purple" x1="310" y1="130" x2="358" y2="130" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="heater" data-link-to="airWaterBasin">
            <line x1="470" y1="130" x2="520" y2="130" stroke="#5b6478" stroke-width="2" marker-end="url(#hs6-arrow)"></line>
            <line class="trail trail-yellow" x1="470" y1="130" x2="518" y2="130" stroke="#FBBF24" stroke-width="2.5" stroke-dasharray="6 8"></line>
          </g>
          <g class="link" data-link="airWaterBasin" data-link-to="paperGuide">
            <path d="M 690,110 Q 710,105 720,105" fill="none" stroke="#3a4258" stroke-width="1.6" stroke-dasharray="3 5" marker-end="url(#hs6-arrow)"></path>
            <path class="trail trail-gray" d="M 690,110 Q 710,105 718,105" fill="none" stroke="#9CA3AF" stroke-width="2.2" stroke-dasharray="5 7"></path>
          </g>

          <text x="605" y="230" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">شكل 6-6 — منظومة الرطوبة والدليل الورقي</text>

          <!-- ===== Section B (fig 6-7): sharp-angle mechanism ===== -->
          <line x1="30" y1="255" x2="790" y2="255" stroke="rgba(148,163,184,0.18)" stroke-width="1"></line>

          <g class="hotspot" data-component="sharpAngleMechanism" tabindex="0" role="button" aria-label="قطعة معدنية ذات زوايا حادة">
            <rect class="hit-area" x="225" y="278" width="545" height="145" fill="#000" fill-opacity="0"></rect>
            <text x="420" y="300" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">هواء</text>
            <line x1="250" y1="360" x2="600" y2="360" stroke="#38BDF8" stroke-width="1.4" opacity="0.5"></line>
            <path class="box-shape" d="M 260,360 L 297,320 L 335,360 L 372,320 L 410,360 L 447,320 L 485,360 L 522,320 L 560,360"
                  fill="none" stroke="#FB923C" stroke-width="3" stroke-linejoin="round" filter="url(#hs6Glow)"></path>
            <text x="420" y="405" font-family="Cairo, sans-serif" font-size="11.5" font-weight="700" fill="#eef1f8" text-anchor="middle" direction="rtl">ماء مقطر</text>
            <path d="M 560,330 L 610,300" fill="none" stroke="#5b6478" stroke-width="1.2" stroke-dasharray="2 4"></path>
            <text x="612" y="298" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FB923C" text-anchor="start" direction="rtl">قطعة معدنية بزوايا حادة</text>
            <text x="612" y="311" font-family="Cairo, sans-serif" font-size="9" font-weight="700" fill="#FB923C" text-anchor="start" direction="rtl">لزيادة المساحة السطحية</text>
          </g>

          <text x="420" y="435" font-family="Cairo, sans-serif" font-size="10.5" font-weight="700" fill="#8b94aa" text-anchor="middle" direction="rtl">شكل 6-7 — الالية الميكانيكية ذات الزوايا الحادة</text>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="150" cy="130" r="5" fill="#4ADE80" filter="url(#hs6Glow)" style="--tx:40px; --ty:0px; --particle-delay:0.4s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="310" cy="130" r="5" fill="#C084FC" filter="url(#hs6Glow)" style="--tx:40px; --ty:0px; --particle-delay:0.9s; --particle-duration:0.4s"></circle>
            <circle class="flow-particle" cx="470" cy="130" r="5" fill="#FBBF24" filter="url(#hs6Glow)" style="--tx:40px; --ty:0px; --particle-delay:1.4s; --particle-duration:0.4s"></circle>
            <circle class="vapor-particle" cx="605" cy="175" r="4" fill="#38BDF8" filter="url(#hs6Glow)"></circle>
            <circle class="flow-particle" cx="695" cy="108" r="4" fill="#9CA3AF" filter="url(#hs6Glow)" style="--tx:22px; --ty:-4px; --particle-delay:1.9s; --particle-duration:0.35s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="fan"><span class="status-dot dot-green"></span><span class="status-label">ساحبة الهواء</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="microfilter"><span class="status-dot dot-purple"></span><span class="status-label">المرشح الدقيق</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="heater"><span class="status-dot dot-yellow"></span><span class="status-label">المسخن</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="airWaterBasin"><span class="status-dot dot-blue"></span><span class="status-label">حوض الهواء/الماء</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="sharpAngleMechanism"><span class="status-dot dot-orange"></span><span class="status-label">القطعة ذات الزوايا الحادة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
          <li class="status-row" data-status="paperGuide"><span class="status-dot dot-gray"></span><span class="status-label">الدليل الورقي</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-green"></span>سحب الهواء</li>
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>الترشيح</li>
      <li class="legend-item"><span class="legend-swatch legend-yellow"></span>التسخين</li>
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>التبخر داخل الحوض</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>زيادة المساحة السطحية</li>
      <li class="legend-item"><span class="legend-swatch" style="background:#9CA3AF"></span>الدليل الورقي</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#hs6Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#hs6Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-2px) scale(1.02);
  }

  .trail {
    opacity: 0;
    stroke-width: 2.5px;
    filter: url(#hs6Glow);
  }

  .vapor-particle {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes hs6-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      6% { opacity: 1; }
      94% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: hs6-particle-move var(--particle-duration, 0.4s) linear var(--particle-delay, 0s) forwards;
    }
    @keyframes hs6-vapor-rise {
      0% { transform: translateY(0); opacity: 0; }
      15% { opacity: 1; }
      100% { transform: translateY(-70px); opacity: 0; }
    }
    .playing .vapor-particle {
      animation: hs6-vapor-rise 1.1s ease-out 1.7s infinite;
    }

    @keyframes hs6-shape-activate { to { filter: url(#hs6Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes hs6-reveal-trail { to { opacity: 0.85; } }
    @keyframes hs6-status-value-on { to { opacity: 1; } }
    @keyframes hs6-status-value-off { to { opacity: 0; } }
    @keyframes hs6-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }
    @keyframes hs6-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes hs6-dot-on-yellow { to { background: #FBBF24; box-shadow: 0 0 8px 1px rgba(251, 191, 36, 0.8); } }
    @keyframes hs6-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }
