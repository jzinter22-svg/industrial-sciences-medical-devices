---
// Figure 8-12 (دائرة مكبر القدرة) — MOSFET power amplifier: the RF
// signal from the oscillator drives the gate (G), the amplified wave
// appears at the drain (D), and a ferrite step-up transformer couples
// that amplified RF into the two output electrodes through the relay
// contacts.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft power-amplifier-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة دائرة مكبر القدرة</span>
      <span class="simulator-subtitle">شكل 8-12 — من إشارة RF إلى قطبي الجهاز عبر محولة الفرايت والمرحل</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="es12-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="820"
          height="320"
          viewBox="0 0 820 320"
          role="img"
          aria-label="دائرة مكبر القدرة"
        >
          <defs>
            <marker id="es12-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>
            <linearGradient id="es12BgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="es12Grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>
            <linearGradient id="es12GradPurple" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#241530"></stop><stop offset="100%" stop-color="#100a18"></stop></linearGradient>
            <linearGradient id="es12GradRed" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a1414"></stop><stop offset="100%" stop-color="#1a0a0a"></stop></linearGradient>
            <linearGradient id="es12GradOrange" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3a2210"></stop><stop offset="100%" stop-color="#1a0f08"></stop></linearGradient>
            <linearGradient id="es12GradGreen" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#123322"></stop><stop offset="100%" stop-color="#0a1712"></stop></linearGradient>

            <filter id="es12Elevate" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8" result="blurOuter"></feGaussianBlur>
              <feOffset in="blurOuter" dx="0" dy="8" result="offsetOuter"></feOffset>
              <feFlood flood-color="#000000" flood-opacity="0.58" result="colorOuter"></feFlood>
              <feComposite in="colorOuter" in2="offsetOuter" operator="in" result="shadowOuter"></feComposite>
              <feGaussianBlur in="SourceAlpha" stdDeviation="6" result="blurHalo"></feGaussianBlur>
              <feOffset in="blurHalo" dx="-4" dy="-4" result="offsetHalo"></feOffset>
              <feFlood flood-color="#9fb4ff" flood-opacity="0.16" result="colorHalo"></feFlood>
              <feComposite in="colorHalo" in2="offsetHalo" operator="in" result="haloOuter"></feComposite>
              <feMerge>
                <feMergeNode in="shadowOuter"></feMergeNode>
                <feMergeNode in="haloOuter"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
            <filter id="es12Glow" x="-200%" y="-200%" width="500%" height="500%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="820" height="320" rx="20" fill="url(#es12BgGrad)"></rect>
          <rect x="0" y="0" width="820" height="320" rx="20" fill="url(#es12Grid)"></rect>

          <text x="410" y="30" text-anchor="middle" font-family="Cairo, sans-serif" font-size="14" font-weight="700" fill="#eef1f8" direction="rtl">دائرة مكبر القدرة</text>

          <g class="hotspot" data-component="rf-input" tabindex="0" role="button" aria-label="إشارة RF من المذبذب">
            <rect class="box-shape" x="30" y="105" width="120" height="90" rx="10" fill="url(#es12GradPurple)" stroke="#C084FC" stroke-width="2" filter="url(#es12Elevate)"></rect>
            <text x="90" y="142" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="rtl">إشارة RF</text>
            <text x="90" y="158" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#C084FC" direction="rtl">من المذبذب</text>
          </g>

          <g class="link" data-link="rf-input" data-link-to="mosfet">
            <line id="es12-wire-1" x1="150" y1="150" x2="200" y2="150" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es12-arrow)"></line>
            <line class="trail" x1="150" y1="150" x2="198" y2="150" stroke="#C084FC" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#C084FC" filter="url(#es12Glow)" style="offset-path: url(#es12-wire-1); --flow-delay:0.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="mosfet" tabindex="0" role="button" aria-label="ترانزستور تأثير المجال MOS FET">
            <rect class="box-shape" x="200" y="95" width="120" height="110" rx="10" fill="url(#es12GradRed)" stroke="#EF4444" stroke-width="2" filter="url(#es12Elevate)"></rect>
            <text x="260" y="135" text-anchor="middle" font-family="Cairo, sans-serif" font-size="10" font-weight="700" fill="#eef1f8" direction="ltr">MOS FET</text>
            <text x="230" y="160" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#EF4444" direction="ltr">G</text>
            <text x="290" y="112" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#EF4444" direction="ltr">D</text>
            <text x="290" y="190" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#EF4444" direction="ltr">S</text>
          </g>

          <g class="link" data-link="mosfet" data-link-to="ferrite-transformer">
            <line id="es12-wire-2" x1="320" y1="150" x2="365" y2="150" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es12-arrow)"></line>
            <line class="trail" x1="320" y1="150" x2="363" y2="150" stroke="#EF4444" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#EF4444" filter="url(#es12Glow)" style="offset-path: url(#es12-wire-2); --flow-delay:0.9s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="ferrite-transformer" tabindex="0" role="button" aria-label="محولة رافعة نوع فرايت">
            <rect class="box-shape" x="365" y="90" width="130" height="120" rx="10" fill="url(#es12GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es12Elevate)"></rect>
            <path d="M 390,165 a6,9 0 1 1 0,-18 M 404,165 a6,9 0 1 1 0,-18 M 418,165 a6,9 0 1 1 0,-18 M 432,165 a6,9 0 1 1 0,-18" fill="none" stroke="#FB923C" stroke-width="1.6"></path>
            <text x="430" y="130" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">محولة فرايت</text>
            <text x="430" y="188" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8" font-weight="700" fill="#FB923C" direction="rtl">رافعة</text>
          </g>

          <g class="link" data-link="ferrite-transformer" data-link-to="relay">
            <line id="es12-wire-3" x1="495" y1="150" x2="540" y2="150" stroke="#5b6478" stroke-width="2.5" marker-end="url(#es12-arrow)"></line>
            <line class="trail" x1="495" y1="150" x2="538" y2="150" stroke="#FB923C" stroke-width="2.5" stroke-dasharray="6 8"></line>
            <circle class="current-particle" r="3.6" fill="#FB923C" filter="url(#es12Glow)" style="offset-path: url(#es12-wire-3); --flow-delay:1.4s; --flow-duration:1s;"></circle>
          </g>

          <g class="hotspot" data-component="relay" tabindex="0" role="button" aria-label="نقطتا توصيل المرحل">
            <rect class="box-shape" x="540" y="95" width="90" height="110" rx="10" fill="url(#es12GradOrange)" stroke="#FB923C" stroke-width="2" filter="url(#es12Elevate)"></rect>
            <circle cx="565" cy="125" r="3" fill="#1c2436" stroke="#8b94aa" stroke-width="1.3"></circle>
            <circle cx="605" cy="125" r="3" fill="#1c2436" stroke="#8b94aa" stroke-width="1.3"></circle>
            <line class="relay-blade" x1="565" y1="125" x2="597" y2="120" stroke="#FB923C" stroke-width="2"></line>
            <circle cx="565" cy="175" r="3" fill="#1c2436" stroke="#8b94aa" stroke-width="1.3"></circle>
            <circle cx="605" cy="175" r="3" fill="#1c2436" stroke="#8b94aa" stroke-width="1.3"></circle>
            <line class="relay-blade" x1="565" y1="175" x2="597" y2="170" stroke="#FB923C" stroke-width="2"></line>
            <text x="585" y="192" text-anchor="middle" font-family="Cairo, sans-serif" font-size="8.5" font-weight="700" fill="#eef1f8" direction="rtl">المرحل</text>
          </g>

          <g class="link" data-link="relay" data-link-to="active-electrode">
            <path id="es12-wire-4" d="M 630,120 L 670,120" fill="none" stroke="#5b6478" stroke-width="2.2" marker-end="url(#es12-arrow)"></path>
            <path class="trail" d="M 630,120 L 668,120" fill="none" stroke="#4ADE80" stroke-width="2.2" stroke-dasharray="5 7"></path>
            <circle class="current-particle" r="3" fill="#4ADE80" filter="url(#es12Glow)" style="offset-path: url(#es12-wire-4); --flow-delay:1.9s; --flow-duration:0.7s;"></circle>
          </g>
          <g class="link" data-link="relay" data-link-to="patient-electrode">
            <path id="es12-wire-5" d="M 630,170 L 670,170" fill="none" stroke="#5b6478" stroke-width="2.2" marker-end="url(#es12-arrow)"></path>
            <path class="trail" d="M 630,170 L 668,170" fill="none" stroke="#4ADE80" stroke-width="2.2" stroke-dasharray="5 7"></path>
            <circle class="current-particle" r="3" fill="#4ADE80" filter="url(#es12Glow)" style="offset-path: url(#es12-wire-5); --flow-delay:2.1s; --flow-duration:0.7s;"></circle>
          </g>

          <g class="hotspot" data-component="active-electrode" tabindex="0" role="button" aria-label="القطب الفعال">
            <rect class="box-shape" x="670" y="98" width="120" height="44" rx="8" fill="url(#es12GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es12Elevate)"></rect>
            <text x="730" y="125" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">القطب الفعال</text>
          </g>
          <g class="hotspot" data-component="patient-electrode" tabindex="0" role="button" aria-label="قطب المريض">
            <rect class="box-shape" x="670" y="148" width="120" height="44" rx="8" fill="url(#es12GradGreen)" stroke="#4ADE80" stroke-width="2" filter="url(#es12Elevate)"></rect>
            <text x="730" y="175" text-anchor="middle" font-family="Cairo, sans-serif" font-size="9.5" font-weight="700" fill="#eef1f8" direction="rtl">قطب المريض</text>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة الدائرة</h3>
        <ul class="status-list">
          <li class="status-row" data-status="rf-input"><span class="status-dot dot-purple"></span><span class="status-label">إشارة RF</span><span class="status-value"><span class="value-off">لا يوجد</span><span class="value-on">واردة</span></span></li>
          <li class="status-row" data-status="mosfet"><span class="status-dot dot-red"></span><span class="status-label">MOS FET</span><span class="status-value"><span class="value-off">متوقف</span><span class="value-on">يكبّر</span></span></li>
          <li class="status-row" data-status="ferrite-transformer"><span class="status-dot dot-orange"></span><span class="status-label">محولة الفرايت</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">ترفع الفولتية</span></span></li>
          <li class="status-row" data-status="relay"><span class="status-dot dot-orange"></span><span class="status-label">المرحل</span><span class="status-value"><span class="value-off">مفتوح</span><span class="value-on">موصول للقطبين</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على أي مكون لعرض شرحه</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-purple"></span>إشارة RF الداخلة</li>
      <li class="legend-item"><span class="legend-swatch legend-orange"></span>المكبر والمحولة والمرحل</li>
      <li class="legend-item"><span class="legend-swatch legend-green"></span>الخرج إلى القطبين</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    filter: url(#es12Elevate) saturate(0.95) brightness(0.98);
    transition: filter 0.2s ease, transform 0.25s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    filter: url(#es12Elevate) saturate(1.35) brightness(1.45);
    transform: translateY(-3px) scale(1.04);
  }

  .trail { opacity: 0; stroke-width: 2.5px; filter: url(#es12Glow); }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes es12-shape-activate { to { filter: url(#es12Elevate) saturate(1.35) brightness(1.4); } }
    @keyframes es12-reveal-trail { to { opacity: 0.85; } }
    @keyframes es12-status-value-on { to { opacity: 1; } }
    @keyframes es12-status-value-off { to { opacity: 0; } }
    @keyframes es12-dot-on-purple { to { background: #C084FC; box-shadow: 0 0 8px 1px rgba(192, 132, 252, 0.8); } }
    @keyframes es12-dot-on-red { to { background: #EF4444; box-shadow: 0 0 8px 1px rgba(239, 68, 68, 0.8); } }
    @keyframes es12-dot-on-orange { to { background: #FB923C; box-shadow: 0 0 8px 1px rgba(251, 146, 60, 0.8); } }
    @keyframes es12-dot-on-green { to { background: #4ADE80; box-shadow: 0 0 8px 1px rgba(74, 222, 128, 0.8); } }

    .playing [data-component="rf-input"] .box-shape { animation: es12-shape-activate 0.4s ease-out 0.1s forwards; }
    .playing [data-status="rf-input"] .status-dot { animation: es12-dot-on-purple 0.4s ease-out 0.1s forwards; }
    .playing [data-status="rf-input"] .value-on { animation: es12-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="rf-input"] .value-off { animation: es12-status-value-off 0.4s ease-out 0.1s forwards; }
    .playing [data-link="rf-input"] .trail { animation: es12-reveal-trail 0.3s ease-out 0.4s forwards; }

    .playing [data-component="mosfet"] .box-shape { animation: es12-shape-activate 0.4s ease-out 0.6s forwards; }
    .playing [data-status="mosfet"] .status-dot { animation: es12-dot-on-red 0.4s ease-out 0.6s forwards; }
    .playing [data-status="mosfet"] .value-on { animation: es12-status-value-on 0.4s ease-out 0.6s forwards; }
    .playing [data-status="mosfet"] .value-off { animation: es12-status-value-off 0.4s ease-out 0.6s forwards; }
    .playing [data-link="mosfet"] .trail { animation: es12-reveal-trail 0.3s ease-out 0.9s forwards; }

    .playing [data-component="ferrite-transformer"] .box-shape { animation: es12-shape-activate 0.4s ease-out 1.1s forwards; }
    .playing [data-status="ferrite-transformer"] .status-dot { animation: es12-dot-on-orange 0.4s ease-out 1.1s forwards; }
    .playing [data-status="ferrite-transformer"] .value-on { animation: es12-status-value-on 0.4s ease-out 1.1s forwards; }
    .playing [data-status="ferrite-transformer"] .value-off { animation: es12-status-value-off 0.4s ease-out 1.1s forwards; }
    .playing [data-link="ferrite-transformer"] .trail { animation: es12-reveal-trail 0.3s ease-out 1.4s forwards; }

    .playing [data-component="relay"] .box-shape { animation: es12-shape-activate 0.4s ease-out 1.6s forwards; }
    .playing [data-status="relay"] .status-dot { animation: es12-dot-on-orange 0.4s ease-out 1.6s forwards; }
    .playing [data-status="relay"] .value-on { animation: es12-status-value-on 0.4s ease-out 1.6s forwards; }
    .playing [data-status="relay"] .value-off { animation: es12-status-value-off 0.4s ease-out 1.6s forwards; }
    .playing [data-link="relay"] .trail { animation: es12-reveal-trail 0.3s ease-out 1.9s forwards; }

    .playing [data-component="active-electrode"] .box-shape { animation: es12-shape-activate 0.4s ease-out 2.2s forwards; }
    .playing [data-component="patient-electrode"] .box-shape { animation: es12-shape-activate 0.4s ease-out 2.3s forwards; }

    .current-particle { opacity: 0; offset-rotate: 0deg; }
    @keyframes es12-current-flow {
      0% { offset-distance: 0%; opacity: 0; }
      8% { opacity: 1; }
      92% { opacity: 1; }
      100% { offset-distance: 100%; opacity: 0; }
    }
    .playing .current-particle {
      animation: es12-current-flow var(--flow-duration, 1.2s) linear var(--flow-delay, 0s) infinite;
    }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    "rf-input": {
      title: "إشارة RF الواردة",
      text: "موجة التردد الراديوي القادمة من مذبذب (RC)، بجهد وقدرة منخفضين نسبيا.",
    },
    mosfet: {
      title: "ترانزستور تأثير المجال (MOS FET)",
      text: "ذو البوابة (G) المعزولة، يعمل على تكبير الترددات الراديوية العالية القادمة من المذبذب؛ الموجة الخارجة المكبرة تظهر عند المصرف (D).",
    },
    "ferrite-transformer": {
      title: "المحولة الرافعة نوع فرايت",
      text: "يتميز قلبها المصنوع من الفرايت بكفاءة عالية للعمل في الترددات الراديوية العالية، وباقتصادية من ناحية تبديد الطاقة أو الحرارة.",
    },
    relay: {
      title: "نقطتا توصيل المرحل",
      text: "يتصل الملف الثانوي للمحولة بقطبي الجهاز عن طريق نقطتي توصيل المرحل، الذي يحدد ما إذا كان الخرج مستمرا (قطع) أو متقطعا (تخثر).",
    },
  };

  wireDiagramSimulator(".power-amplifier-diagram", { cycleMs: 3400, componentInfo: COMPONENT_INFO });
</script>
