---
// Figure 7-2 & 7-3 (نظام ضاغط الهواء) — compressed air system showing
// motor, pump, tank, filtration, dryer, and safety valve. Dark
// neumorphic simulator style matching other chapters. Non-interactive
// educational diagram wrapped in the standard simulator shell.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const diagramSrc = import.meta.env.BASE_URL.replace(/\/$/, "") + "/assets/svg/chapter-07/diagram-02-compressor.svg";
---

<figure class="diagram-block neo-surface-soft air-compressor-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نظام الضاغط الهوائي</span>
      <span class="simulator-subtitle">شكل 2-7 و 3-7 — المكونات والتدفق</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <img
          src={diagramSrc}
          alt="نظام ضاغط الهواء المتكامل مع التنقية والتجفيف"
          style="max-width: 100%; height: auto;"
        />
      </div>
      {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}
    </div>
  </div>
</figure>

<style>
  .air-compressor-diagram {
    margin: 2rem 0;
  }

  .diagram-block-image {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
  }

  .diagram-block-caption {
    text-align: center;
    font-size: 0.95rem;
    color: #94a3b8;
    margin-top: 1rem;
    padding: 0 1rem;
    font-weight: 500;
  }
</style>
