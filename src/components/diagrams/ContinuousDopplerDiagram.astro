---
// Redesigned Figure 2-12 (موجة نمط دوبلر المستمر) using the Chapter 1
// dark neumorphic simulator system. Reuses the shared shell/controller
// (src/styles/diagram-simulator.css + src/scripts/diagramSimulator.js).
//
// Geometry unchanged (axis, unbroken sine trace identical to the prior
// build) — only fill/stroke treatment and the interaction/animation
// layer changed.
//
// Color mapping: a single continuous oscilloscope trace, not a flow
// circuit — uses the same blue "signal" accent as the pulsed-mode
// figure, contrasted by having no gaps.
import "../../styles/diagram-simulator.css";

interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="diagram-block neo-surface-soft continuous-doppler-diagram">
  <div class="simulator-shell">
    <div class="simulator-toolbar">
      <span class="simulator-title">محاكاة نمط دوبلر المستمر</span>
      <span class="simulator-subtitle">شكل 2-12 — اشارة مستمرة بلا فواصل</span>
    </div>

    <div class="simulator-main">
      <div class="diagram-block-image">
        <svg
          class="cd-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="700"
          height="220"
          viewBox="0 0 700 220"
          role="img"
          aria-label="موجة نمط دوبلر المستمر"
        >
          <defs>
            <marker id="cd-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#5b6478"></path>
            </marker>

            <linearGradient id="cdBgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#141d30"></stop>
              <stop offset="100%" stop-color="#0a0f1a"></stop>
            </linearGradient>
            <pattern id="cdGrid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0 H0 V36" fill="none" stroke="rgba(148,163,184,0.07)" stroke-width="1"></path>
            </pattern>

            <filter id="cdGlow" x="-180%" y="-180%" width="460%" height="460%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>

          <rect x="0" y="0" width="700" height="220" rx="20" fill="url(#cdBgGrad)"></rect>
          <rect x="0" y="0" width="700" height="220" rx="20" fill="url(#cdGrid)"></rect>

          <line x1="60" y1="110" x2="660" y2="110" stroke="#5b6478" stroke-width="2" marker-end="url(#cd-arrow)"></line>
          <line x1="60" y1="190" x2="60" y2="30" stroke="#5b6478" stroke-width="2" marker-end="url(#cd-arrow)"></line>
          <text x="30" y="40" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="rtl">السعة</text>
          <text x="640" y="130" font-family="Cairo, sans-serif" font-size="13" font-weight="700" fill="#38BDF8" text-anchor="middle" direction="rtl">الزمن</text>

          <g class="hotspot" data-component="wave" tabindex="0" role="button" aria-label="الموجة المستمرة">
            <rect class="hit-area" x="60" y="55" width="600" height="110" fill="#000" fill-opacity="0"></rect>
            <path class="box-shape continuous-wave" d="M 90,110 q 12,-40 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0 t 24,0"
                  fill="none" stroke="#38BDF8" stroke-width="2.5" filter="url(#cdGlow)"></path>
          </g>

          <g class="flow-layer" aria-hidden="true">
            <circle class="flow-particle" cx="60" cy="110" r="5" fill="#eef1f8" filter="url(#cdGlow)" style="--tx:600px; --ty:0px; --particle-delay:0.1s; --particle-duration:2.0s"></circle>
          </g>
        </svg>
      </div>

      <aside class="status-panel" aria-live="polite">
        <h3 class="status-title">حالة النظام</h3>
        <ul class="status-list">
          <li class="status-row" data-status="wave"><span class="status-dot dot-blue"></span><span class="status-label">الاشارة المستمرة</span><span class="status-value"><span class="value-off">غير نشط</span><span class="value-on">نشط</span></span></li>
        </ul>
      </aside>
    </div>

    <div class="info-panel" data-info-panel>
      <p class="info-hint" data-info-hint>انقر على الموجة لعرض شرحها</p>
      <div class="info-content" data-info-content hidden>
        <p class="info-title" data-info-title></p>
        <p class="info-text" data-info-text></p>
      </div>
    </div>

    <ul class="legend-panel">
      <li class="legend-item"><span class="legend-swatch legend-blue"></span>اشارة فوق صوتية مستمرة</li>
    </ul>
  </div>

  {caption && <figcaption class="diagram-block-caption">{caption}</figcaption>}

  <div class="diagram-controls">
    <button type="button" class="diagram-replay-button play-button">▶ تشغيل المخطط</button>
    <button type="button" class="diagram-replay-button pause-button" disabled>⏸ إيقاف مؤقت</button>
    <button type="button" class="diagram-replay-button reset-button">↻ إعادة التشغيل</button>
    <button type="button" class="diagram-replay-button speed-down-button">إبطاء −</button>
    <button type="button" class="diagram-replay-button speed-up-button">تسريع +</button>
  </div>
</figure>

<style>
  .hotspot .box-shape {
    transition: filter 0.2s ease;
  }

  .hotspot:hover .box-shape,
  .hotspot:focus-visible .box-shape,
  .hotspot.is-selected .box-shape {
    stroke-width: 3.5;
  }

  .flow-particle {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes cd-particle-move {
      0% { transform: translate(0, 0); opacity: 0; }
      4% { opacity: 1; }
      96% { opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)); opacity: 0; }
    }
    .playing .flow-particle {
      animation: cd-particle-move var(--particle-duration, 2s) linear var(--particle-delay, 0s) forwards;
    }

    @keyframes cd-glow-activate { to { filter: url(#cdGlow) brightness(1.6); } }
    @keyframes cd-status-value-on { to { opacity: 1; } }
    @keyframes cd-status-value-off { to { opacity: 0; } }
    @keyframes cd-dot-on-blue { to { background: #38BDF8; box-shadow: 0 0 8px 1px rgba(56, 189, 248, 0.8); } }

    .playing [data-component="wave"] .box-shape { animation: cd-glow-activate 0.6s ease-out 0.1s forwards; }
    .playing [data-status="wave"] .status-dot { animation: cd-dot-on-blue 0.4s ease-out 0.1s forwards; }
    .playing [data-status="wave"] .value-on { animation: cd-status-value-on 0.4s ease-out 0.1s forwards; }
    .playing [data-status="wave"] .value-off { animation: cd-status-value-off 0.4s ease-out 0.1s forwards; }
  }
</style>

<script>
  import { wireDiagramSimulator } from "../../scripts/diagramSimulator.js";

  const COMPONENT_INFO: Record<string, { title: string; text: string }> = {
    wave: {
      title: "الاشارة المستمرة",
      // src/data/chapter-02/page-09.json #cw-doppler-p1 (excerpt)
      text: "في هذا النمط ترسل اشارة مستمرة من الموجات الفوق صوتية من المجس، والصدى الراجع تستلم من مجس اخر. يستخدم هذا النمط في قياسات جريان الدم في الاوعية الدموية او سماع نبضات الجنين.",
    },
  };

  wireDiagramSimulator(".continuous-doppler-diagram", { cycleMs: 2300, componentInfo: COMPONENT_INFO });
</script>
