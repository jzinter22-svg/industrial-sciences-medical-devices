---
// Educational concept diagram for Device 05 (Computerized X-ray Scan Machine / Tomography).
// Every fact stated below comes directly from device-05.description.ar in
// page-01.json: "يستخدم هذا الجهاز وبمساعدة الحاسوب لتصوير الاجزاء المختلفة
// من الجسم كالرأس والعنق والصدر والبطن والحوض والعمود الفقري وحتى الاجزاء
// المتناهية الصغر في الجسم كالغدة النخامية والغدة فوق الكلوية... يصل سمكها
// 1ملم." Card structure mirrors that sentence's own tiering: five full
// numbered cards for the five main regions, and the spine/glands as
// lighter secondary callouts, not additional full cards.
//
// Illustration: the central artwork is a direct crop of
// docs/design/GOLDEN_VISUAL_REFERENCE.png's own illustration — the actual
// reference image, not a redrawing of it — saved at
// src/assets/diagrams/tomography-body-illustration.png. The crop keeps
// ONLY the artwork (the illustration plus its own translucent colored
// region bands, already baked into the reference at head/neck/chest/
// abdomen/pelvis); it deliberately excludes everything else in the
// reference PNG — the page header, chapter label, title, intro paragraph,
// its own cards/captions, and footer branding — all of which describe a
// *different* chapter (the nervous system) and would misrepresent this
// page's actual subject (an X-ray tomography device) if shown verbatim.
// Every label, number, description, and icon the student reads on this
// page is still this project's own, drawn only from device-05's real
// source sentence above — the reference contributes art, never text.
//
// Cards and minor labels stack in normal document flow (DiagramFrame) and
// are connected to their illustration anchor by DiagramFrame's generic
// leader-line overlay (anchor → illustration edge → target). Anchors here
// are small absolutely-positioned dots over the image, placed at each
// visible band's measured vertical center (read directly off the cropped
// image's pixels) rather than SVG coordinates.
import { Image } from "astro:assets";
import DiagramFrame from "./diagrams/DiagramFrame.astro";
import DiagramCard from "./diagrams/DiagramCard.astro";
import tomographyIllustration from "../assets/diagrams/tomography-body-illustration.png";

// One coherent icon style: bold stroke line icons, each evoking its
// region's own anatomy.
const headIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4c-3.6 0-6.2 2.6-6.2 6 0 2.1 1 3.9 2.6 5v1.5c0 1.1.9 2 2 2h3.2c1.1 0 2-.9 2-2V15c1.6-1.1 2.6-2.9 2.6-5 0-3.4-2.6-6-6.2-6Z"/><path d="M12 6.5v9"/></svg>';
const neckIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7.5" y="6" width="9" height="4" rx="2"/><rect x="7.5" y="13" width="9" height="4" rx="2"/></svg>';
const chestIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M9.5 6c-2 .2-3.6 1.6-3.6 3.4M14.5 6c2 .2 3.6 1.6 3.6 3.4"/><path d="M8.6 10.2c-2 .2-3.3 1.4-3.1 3M15.4 10.2c2 .2 3.3 1.4 3.1 3"/><path d="M8.9 14.4c-1.8.3-2.8 1.4-2.5 2.9M15.1 14.4c1.8.3 2.8 1.4 2.5 2.9"/></svg>';
const abdomenIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="5" width="12" height="14" rx="6"/><path d="M8.5 12c1-1.3 2-1.3 3 0s2 1.3 3 0"/></svg>';
const pelvisIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5c0 4.5 2.5 6.5 7 6.5s7-2 7-6.5"/><path d="M9 11.5V19M15 11.5V19"/></svg>';

// anchorYPercent values were read directly off
// tomography-body-illustration.png's pixels (a 145×944 crop): each
// region's colored band was located by sampling pixel color transitions
// down the image, then its vertical center converted to a percentage of
// the crop's height. They must stay in the same top-to-bottom order as
// the cards below — DiagramFrame's non-crossing proof requires the anchor
// sequence and the on-page target sequence to be sorted the same way.
const regions = [
  {
    number: 1,
    title: "رأس",
    color: "#e11d48",
    icon: headIcon,
    anchorYPercent: 10.3,
    description: "الرأس أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 2,
    title: "عنق",
    color: "#16a34a",
    icon: neckIcon,
    anchorYPercent: 30.2,
    description: "العنق أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 3,
    title: "صدر",
    color: "#2563eb",
    icon: chestIcon,
    anchorYPercent: 49.3,
    description: "الصدر أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 4,
    title: "بطن",
    color: "#9333ea",
    icon: abdomenIcon,
    anchorYPercent: 71.5,
    description: "البطن أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 5,
    title: "حوض",
    color: "#db2777",
    icon: pelvisIcon,
    anchorYPercent: 87.9,
    description: "الحوض أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
];

// Secondary callouts: the spinal column and the two glands, mirroring the
// source sentence's lesser tier for these (the glands explicitly named as
// "even the tiniest parts"). The adrenal anchor (68.3%) points at the
// kidney icon that is itself visible in the cropped reference artwork;
// the pituitary anchor (19.6%) marks its real anatomical location at the
// base of the skull, and the spine-note anchor (96.4%) the column's base.
const minorAnnotations = [
  {
    id: "gland-1",
    label: "الغدة النخامية",
    description: "من الأجزاء الدقيقة التي يمكن للجهاز تصويرها.",
    anchorYPercent: 19.6,
  },
  {
    id: "gland-2",
    label: "الغدة فوق الكلوية",
    description: "من الأجزاء الدقيقة التي يمكن للجهاز تصويرها.",
    anchorYPercent: 68.3,
  },
  {
    id: "spine-note",
    label: "العمود الفقري",
    description: "العمود الفقري أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
    anchorYPercent: 96.4,
  },
];
---

<DiagramFrame ariaLabel="مخطط توضيحي: مكونات تصوير مقاطع الجسم">
  <Fragment slot="minor">
    {minorAnnotations.map((m) => (
      <div class="diagram-minor-item" data-leader-target={m.id} title={m.description}>
        <span class="diagram-minor-label">{m.label}</span>
      </div>
    ))}
  </Fragment>

  <div slot="illustration" class="illustration-wrap" data-playable>
    <Image
      src={tomographyIllustration}
      alt="رسم توضيحي لجسم الإنسان يظهر مناطق الرأس والعنق والصدر والبطن والحوض والعمود الفقري، مقتبس من الرسم المرجعي المعتمد للتصاميم العلمية"
      class="tomography-illustration-img"
    />

    <div class="scan-line" aria-hidden="true"></div>

    {regions.map((r) => (
      <span
        class="anchor-dot"
        style={`top: ${r.anchorYPercent}%; --region-color: ${r.color}`}
        data-leader-anchor={String(r.number)}
        data-leader-color={r.color}
      />
    ))}

    {minorAnnotations.map((m) => (
      <span
        class="anchor-dot minor"
        style={`top: ${m.anchorYPercent}%`}
        data-leader-anchor={m.id}
        data-leader-color="var(--neo-muted)"
        data-leader-width="1"
        data-leader-dashed=""
      />
    ))}
  </div>

  <Fragment slot="cards">
    {regions.map((r) => (
      <DiagramCard
        number={r.number}
        title={r.title}
        description={r.description}
        leaderId={String(r.number)}
        color={r.color}
        icon={r.icon}
      />
    ))}
  </Fragment>

  <Fragment slot="caption">
    <p class="tomography-caption">سماكة المقطع: 1ملم</p>
  </Fragment>

  <Fragment slot="controls">
    <button type="button" class="diagram-replay-button">تشغيل حركة المسح</button>
  </Fragment>
</DiagramFrame>

<style>
  /* 57% of the illustration column's own actual rendered width (not a
     hard-coded pixel cap) — the column itself is sized by DiagramFrame's
     grid floors, so this percentage is what keeps the illustration
     responsive to its real container at every breakpoint rather than
     pinned to one screenshot's measurements. Reduced from 75% so the
     illustration reads as supporting the cards rather than competing with
     them for space. Anchor dots inside are positioned by percentage of
     this wrapper (see below), so they stay correctly aligned to the
     artwork automatically at any wrapper size — no coordinates to
     recompute here. Sized to its own intrinsic aspect ratio (never
     stretched/distorted); vertically centered within the row, which
     DiagramFrame's grid may make taller than the image alone (e.g. a
     taller card column). */
  .illustration-wrap {
    position: relative;
    width: 57%;
    margin-inline: auto;
    align-self: center;
  }

  .tomography-illustration-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--neo-radius-sm);
  }

  .anchor-dot {
    position: absolute;
    inset-inline-end: 2%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 999px;
    background: var(--region-color, var(--neo-muted));
    box-shadow: 0 0 0 2px var(--neo-surface);
  }

  .anchor-dot.minor {
    inset-inline-end: auto;
    inset-inline-start: 2%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
  }

  .scan-line {
    position: absolute;
    inset-inline: 8%;
    top: 3%;
    height: 4px;
    border-radius: 3px;
    background: var(--neo-primary);
    opacity: 0;
    pointer-events: none;
  }

  /* Animates `top` (a percentage of the wrapper's own height) rather than
     a pixel transform, so the sweep travels the full length of the
     illustration regardless of its rendered size at any breakpoint. */
  .illustration-wrap.playing .scan-line {
    animation: scan-sweep 2.2s ease-in-out;
  }

  @keyframes scan-sweep {
    0% {
      opacity: 0;
      top: 3%;
    }
    10% {
      opacity: 0.55;
    }
    90% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      top: 94%;
    }
  }

  .diagram-minor-item {
    text-align: end;
    padding-inline-end: 0.4rem;
  }

  .diagram-minor-label {
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.65rem;
    line-height: 1.25;
    color: var(--neo-muted);
  }

  @media (min-width: 640px) {
    .diagram-minor-label {
      font-size: 0.75rem;
    }
  }

  .tomography-caption {
    margin: 0;
    font-family: "Cairo", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
  }

  .diagram-replay-button {
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    color: var(--neo-primary);
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-replay-button:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-replay-button {
      display: none;
    }
  }
</style>
