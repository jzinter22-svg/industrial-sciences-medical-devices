---
// Educational concept diagram for Device 05 (Computerized X-ray Scan Machine / Tomography).
// Every fact stated below comes directly from device-05.description.ar in
// page-01.json: "يستخدم هذا الجهاز وبمساعدة الحاسوب لتصوير الاجزاء المختلفة
// من الجسم كالرأس والعنق والصدر والبطن والحوض والعمود الفقري وحتى الاجزاء
// المتناهية الصغر في الجسم كالغدة النخامية والغدة فوق الكلوية... يصل سمكها
// 1ملم." Card structure mirrors that sentence's own tiering: five full
// numbered cards for the five main regions, and the spine/glands as
// lighter secondary callouts, not additional full cards.
//
// Deconstructed, native composition (no embedded raster image of the
// reference — every layer below is an independent HTML/SVG element the
// project owns and can edit):
//   1. Central illustration: a single hand-authored inline <svg>, its own
//      element, containing only anatomical linework — no cards, captions,
//      or text of any kind live inside it.
//   2. Colored region overlays: <path> elements that reuse the EXACT same
//      "d" coordinates as the matching body-outline path one layer below,
//      so each translucent color traces that region's real illustrated
//      contour (head's actual head-shaped outline, pelvis's actual bowl
//      shape, etc.) rather than a generic bounding rectangle.
//   3. Explanatory cards: DiagramCard, plain HTML, rendered into
//      DiagramFrame's separate "cards" slot — never inside the SVG.
//   4. Leader lines: not baked into the illustration. DiagramFrame draws
//      them at runtime as a separate overlay <svg>, reading each card's
//      and each anchor's real DOM position (anchors below are ordinary
//      SVG <circle> elements carrying `data-leader-anchor`; the mechanism
//      doesn't care whether an anchor is SVG or HTML).
//   5. Additional labels (pituitary/adrenal/spine): independent HTML text
//      elements in DiagramFrame's "minor" slot, connected to their own
//      SVG anchor the same way the main cards are.
import DiagramFrame from "./diagrams/DiagramFrame.astro";
import DiagramCard from "./diagrams/DiagramCard.astro";

// One coherent icon style: bold stroke line icons, each evoking its
// region's own anatomy rather than a generic symbol.
const headIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4c-3.6 0-6.2 2.6-6.2 6 0 2.1 1 3.9 2.6 5v1.5c0 1.1.9 2 2 2h3.2c1.1 0 2-.9 2-2V15c1.6-1.1 2.6-2.9 2.6-5 0-3.4-2.6-6-6.2-6Z"/><path d="M12 6.5v9"/></svg>';
const neckIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="7.5" y="6" width="9" height="4" rx="2"/><rect x="7.5" y="13" width="9" height="4" rx="2"/></svg>';
const chestIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M9.5 6c-2 .2-3.6 1.6-3.6 3.4M14.5 6c2 .2 3.6 1.6 3.6 3.4"/><path d="M8.6 10.2c-2 .2-3.3 1.4-3.1 3M15.4 10.2c2 .2 3.3 1.4 3.1 3"/><path d="M8.9 14.4c-1.8.3-2.8 1.4-2.5 2.9M15.1 14.4c1.8.3 2.8 1.4 2.5 2.9"/></svg>';
const abdomenIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="5" width="12" height="14" rx="6"/><path d="M8.5 12c1-1.3 2-1.3 3 0s2 1.3 3 0"/></svg>';
const pelvisIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5c0 4.5 2.5 6.5 7 6.5s7-2 7-6.5"/><path d="M9 11.5V19M15 11.5V19"/></svg>';

// Each body part's real outline path, defined once and reused for BOTH
// the neutral base linework and its colored overlay (see the <svg>
// below) — so a region's colored wash is never a generic rectangle, it
// is the literal same contour as the illustrated anatomy at that region.
const headPath =
  "M130 14 C158 14 176 36 176 66 C176 88 166 104 150 113 L150 120 C150 125 141 129 130 129 C119 129 110 125 110 120 L110 113 C94 104 84 88 84 66 C84 36 102 14 130 14 Z";
const neckPath = "M110 120 L150 120 L158 148 L102 148 Z";
const chestPath =
  "M70 150 C55 156 46 172 44 195 C42 218 48 236 62 248 L198 248 C212 236 218 218 216 195 C214 172 205 156 190 150 C170 138 145 132 130 132 C115 132 90 138 70 150 Z";
const abdomenPath =
  "M62 248 C56 265 54 285 62 302 C68 315 80 326 96 330 L164 330 C180 326 192 315 198 302 C206 285 204 265 198 248 Z";
const pelvisPath =
  "M96 330 C88 345 90 365 104 378 C116 388 144 388 156 378 C170 365 172 345 164 330 C150 340 110 340 96 330 Z";

// anchorX/anchorY mark the true anatomical point each leader line starts
// from; DiagramFrame's overlay draws a short stub from that exact point
// to the illustration's edge, then a mostly-horizontal line on to the
// card. anchorY must stay in the same top-to-bottom order as the cards
// (the non-crossing proof requires both sequences sorted the same way).
const regions = [
  {
    number: 1,
    title: "رأس",
    color: "#e11d48",
    icon: headIcon,
    path: headPath,
    anchorX: 78,
    anchorY: 71,
    description: "الرأس أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 2,
    title: "عنق",
    color: "#16a34a",
    icon: neckIcon,
    path: neckPath,
    anchorX: 96,
    anchorY: 135,
    description: "العنق أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 3,
    title: "صدر",
    color: "#2563eb",
    icon: chestIcon,
    path: chestPath,
    anchorX: 38,
    anchorY: 199,
    description: "الصدر أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 4,
    title: "بطن",
    color: "#9333ea",
    icon: abdomenIcon,
    path: abdomenPath,
    anchorX: 54,
    anchorY: 289,
    description: "البطن أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
  {
    number: 5,
    title: "حوض",
    color: "#db2777",
    icon: pelvisIcon,
    path: pelvisPath,
    anchorX: 80,
    anchorY: 360,
    description: "الحوض أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
  },
];

// Secondary callouts: the spinal column and the two glands, mirroring the
// source sentence's lesser tier for these (the glands explicitly named as
// "even the tiniest parts"). Independent HTML labels (DiagramFrame's
// "minor" slot), each connected to its own SVG anchor circle below —
// never part of a flattened image.
// Sorted top-to-bottom by anchorY: the minor column renders in this array
// order via normal document flow, and the non-crossing proof requires the
// anchor sequence and the on-page target sequence to be sorted the same way.
const minorAnnotations = [
  {
    id: "gland-1",
    label: "الغدة النخامية",
    description: "من الأجزاء الدقيقة التي يمكن للجهاز تصويرها.",
    anchorX: 118,
    anchorY: 64,
  },
  {
    id: "gland-2",
    label: "الغدة فوق الكلوية",
    description: "من الأجزاء الدقيقة التي يمكن للجهاز تصويرها.",
    anchorX: 66,
    anchorY: 272,
  },
  {
    id: "spine-note",
    label: "العمود الفقري",
    description: "العمود الفقري أحد الأجزاء التي يصورها الجهاز بمساعدة الحاسوب.",
    anchorX: 122,
    anchorY: 384,
  },
];

// Vertebral column: an actual stack of small segments (not a dashed line),
// a real anatomical structure in its own right — running from the base of
// the neck to the base of the pelvis, part of the illustration itself.
const vertebraYs = Array.from({ length: 22 }, (_, i) => 132 + i * 12);
---

<DiagramFrame ariaLabel="مخطط توضيحي: مكونات تصوير مقاطع الجسم">
  <Fragment slot="minor">
    {minorAnnotations.map((m) => (
      <div class="diagram-minor-item" data-leader-target={m.id} title={m.description}>
        <span class="diagram-minor-label">{m.label}</span>
      </div>
    ))}
  </Fragment>

  <svg
    slot="illustration"
    class="tomography-svg"
    viewBox="0 0 260 420"
    role="presentation"
    preserveAspectRatio="xMidYMid meet"
    data-playable
  >
    <defs>
      <linearGradient id="brainGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#f6cec4" />
        <stop offset="100%" stop-color="#dfa494" />
      </linearGradient>
      <linearGradient id="cerebellumGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#c88f68" />
        <stop offset="100%" stop-color="#a06a45" />
      </linearGradient>
      <linearGradient id="boneGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#f2e0bd" />
        <stop offset="100%" stop-color="#d3ab7c" />
      </linearGradient>
    </defs>

    <!-- Layer 1: central anatomical illustration only — organic,
         recognizable linework, no cards/text/captions of any kind.
         Brain: gyri texture (folded-cortex line pairs) + a distinct
         scalloped cerebellum at its base, not a plain filled outline —
         the outline itself is unchanged (same headPath the region
         overlay below reuses), only the linework drawn on top of it. -->
    <g class="body-illustration">
      <path d={headPath} class="brain-shape" />
      <g class="gyri">
        <path d="M108 26 Q118 20 128 25" />
        <path d="M132 25 Q142 20 152 26" />
        <path d="M98 40 Q112 33 126 39" />
        <path d="M134 39 Q148 33 162 40" />
        <path d="M92 54 Q107 46 123 53" />
        <path d="M137 53 Q153 46 168 54" />
        <path d="M90 68 Q106 60 122 67" />
        <path d="M138 67 Q154 60 170 68" />
        <path d="M94 82 Q108 75 123 81" />
        <path d="M137 81 Q152 75 166 82" />
        <path d="M100 94 Q112 88 124 93" />
        <path d="M136 93 Q148 88 160 94" />
        <path d="M130 20 C129 40 130 60 130 80 C130 88 130 96 130 104" class="fissure" />
      </g>
      <path
        d="M104 106 C104 116 111 124 121 125 C126 126 129 123 130 119 C131 123 134 126 139 125 C149 124 156 116 156 106 C152 111 146 113 140 111 C136 108 133 106 130 110 C127 106 124 108 120 111 C114 113 108 111 104 106 Z"
        class="cerebellum"
      />
      <path d="M84 62c-6 0-9 5-9 10c0 5 3 9 9 9" class="body-outline" />
      <path d="M176 62c6 0 9 5 9 10c0 5-3 9-9 9" class="body-outline" />
      <path d={neckPath} class="body-outline" />
      <path d={chestPath} class="body-outline" />
      <path d="M80 175 Q130 188 180 175" class="body-linework" />
      <path d="M76 195 Q130 210 184 195" class="body-linework" />
      <path d="M74 215 Q130 228 186 215" class="body-linework" />
      <path d={abdomenPath} class="body-outline" />
      <circle cx="130" cy="270" r="2" class="body-linework" />
      <path d="M100 258 C95 275 96 292 104 305" class="body-linework" />
      <path d="M160 258 C165 275 164 292 156 305" class="body-linework" />
      <path d={pelvisPath} class="body-outline" />
    </g>

    <!-- Layer 2: colored region overlays — each path is the exact same
         contour as its matching body part above, not a generic rectangle,
         so the translucent color traces the real illustrated shape. -->
    <g class="region-bands">
      {regions.map((r) => (
        <path d={r.path} class="region-band" style={`--region-color: ${r.color}`} />
      ))}
    </g>

    <!-- vertebral column: a real anatomical structure, drawn on top of
         the bands so it stays legible; part of the illustration, not a
         numbered region of its own. Each segment is shaped like an actual
         vertebra — a central body, two transverse processes (the lateral
         "wings" bone grows on either side), and a small foramen (the
         canal the spinal cord passes through) — not a plain rectangle. -->
    <g class="vertebral-column">
      {vertebraYs.map((y) => (
        <g class="vertebra-unit">
          <ellipse cx="130" cy={y + 4} rx="9" ry="4.5" class="vertebra-body" />
          <ellipse cx="117" cy={y + 4} rx="4" ry="2.2" class="vertebra-wing" />
          <ellipse cx="143" cy={y + 4} rx="4" ry="2.2" class="vertebra-wing" />
          <circle cx="130" cy={y + 4} r="1.2" class="vertebra-foramen" />
        </g>
      ))}
    </g>

    <!-- region anchor dots: independent SVG elements, the leader-line
         start points DiagramFrame's overlay script reads via
         data-leader-anchor (no leader lines are baked into this SVG) -->
    <g class="anchors">
      {regions.map((r) => (
        <circle
          cx={r.anchorX}
          cy={r.anchorY}
          r="4"
          class="anchor"
          style={`--region-color: ${r.color}`}
          data-leader-anchor={String(r.number)}
          data-leader-color={r.color}
        />
      ))}
    </g>

    <!-- minor (spine/gland) anchor dots -->
    <g class="minor-anchors">
      {minorAnnotations.map((m) => (
        <circle
          cx={m.anchorX}
          cy={m.anchorY}
          r="2.5"
          class="minor-anchor"
          data-leader-anchor={m.id}
          data-leader-color="var(--neo-muted)"
          data-leader-width="1"
          data-leader-dashed=""
        />
      ))}
    </g>

    <!-- optional slice-sweep animation element (hidden unless "playing") -->
    <rect x="60" y="14" width="140" height="6" rx="3" class="scan-line" />
  </svg>

  <Fragment slot="cards">
    {regions.map((r) => (
      <DiagramCard
        number={r.number}
        title={r.title}
        description={r.description}
        leaderId={String(r.number)}
        color={r.color}
        icon={r.icon}
      />
    ))}
  </Fragment>

  <Fragment slot="caption">
    <p class="tomography-caption">سماكة المقطع: 1ملم</p>
  </Fragment>

  <Fragment slot="controls">
    <button type="button" class="diagram-replay-button">تشغيل حركة المسح</button>
  </Fragment>
</DiagramFrame>

<style>
  /* 88% of the illustration column's own actual rendered width (not a
     hard-coded pixel value) — proportional at every breakpoint since the
     SVG's viewBox scales all of its internal coordinates (anchors, paths,
     everything) together automatically; nothing here needs recomputing
     per screen size. A prior 57% was measured to render as small as 48px
     wide at 1024px (the tightest breakpoint, where the illustration
     column itself is narrowest) — illegible in real page context, not
     "medium." 88% keeps the illustration a supporting element rather than
     one competing with the cards, while staying clearly readable at every
     breakpoint. Vertically centered within the row, which DiagramFrame's
     grid may make taller than the illustration alone (e.g. a taller card
     column); preserveAspectRatio="xMidYMid meet" keeps the artwork itself
     undistorted. */
  .tomography-svg {
    display: block;
    width: 88%;
    height: auto;
    aspect-ratio: 260 / 420;
    margin-inline: auto;
    align-self: center;
  }

  .body-outline {
    fill: color-mix(in srgb, var(--neo-text) 6%, var(--neo-surface));
    stroke: var(--neo-muted);
    stroke-width: 1.6;
    pointer-events: none;
  }

  .body-linework {
    fill: none;
    stroke: var(--neo-muted);
    stroke-width: 1.2;
    opacity: 0.6;
    pointer-events: none;
  }

  .region-band {
    fill: var(--region-color);
    fill-opacity: 0.3;
    stroke: var(--region-color);
    stroke-width: 1;
    stroke-opacity: 0.5;
    pointer-events: none;
  }

  /* Brain: gradient-filled outline (not a flat neutral tone, unlike the
     rest of the body outline) plus gyri texture drawn on top — a handful
     of bold folded-cortex strokes rather than many fine ones, since dense
     detail turns to visual noise at this illustration's small rendered
     size (see the SVG's own comment on why it stays compact). */
  .brain-shape {
    fill: url(#brainGrad);
    stroke: #c17a68;
    stroke-width: 1.4;
    pointer-events: none;
  }

  .gyri path {
    fill: none;
    stroke: #c17a68;
    stroke-width: 1.1;
    stroke-linecap: round;
    opacity: 0.8;
    pointer-events: none;
  }

  .gyri .fissure {
    stroke-width: 1;
    stroke-dasharray: none;
    opacity: 0.55;
  }

  .cerebellum {
    fill: url(#cerebellumGrad);
    stroke: #8a5a3a;
    stroke-width: 1;
    pointer-events: none;
  }

  .vertebra-body,
  .vertebra-wing {
    fill: url(#boneGrad);
    stroke: #a5793f;
    stroke-width: 0.6;
    pointer-events: none;
  }

  .vertebra-foramen {
    fill: #7a5230;
    pointer-events: none;
  }

  .anchor {
    fill: var(--region-color);
    pointer-events: none;
  }

  .minor-anchor {
    fill: var(--neo-muted);
    pointer-events: none;
  }

  .scan-line {
    fill: var(--neo-primary);
    opacity: 0;
    pointer-events: none;
  }

  .tomography-svg.playing .scan-line {
    animation: scan-sweep 2.2s ease-in-out;
  }

  @keyframes scan-sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    10% {
      opacity: 0.55;
    }
    90% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: translateY(368px);
    }
  }

  .diagram-minor-item {
    text-align: end;
    padding-inline-end: 0.4rem;
  }

  .diagram-minor-label {
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.65rem;
    line-height: 1.25;
    color: var(--neo-muted);
  }

  @media (min-width: 640px) {
    .diagram-minor-label {
      font-size: 0.75rem;
    }
  }

  .tomography-caption {
    margin: 0;
    font-family: "Cairo", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
  }

  .diagram-replay-button {
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    color: var(--neo-primary);
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-replay-button:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-replay-button {
      display: none;
    }
  }
</style>
