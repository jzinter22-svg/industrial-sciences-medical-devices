---
// Educational concept diagram for Device 05 (Computerized X-ray Scan Machine / Tomography).
// Every label/description below is a direct restatement of
// device-05.description.ar in page-01.json — no anatomy, component, or
// specification beyond that sentence is introduced. The source sentence
// only lists which regions the device images (head, neck, chest, abdomen,
// pelvis, spine, and — as tiny examples — the pituitary and adrenal
// glands); it does not give a unique explanatory sentence per region, so
// every card below shares the same faithful restatement rather than
// inventing per-region facts the textbook doesn't provide.
//
// Rebuilt to match docs/design/GOLDEN_VISUAL_REFERENCE.md: one dominant
// illustration + a single column of numbered explanatory cards (not a
// bare label split across two sides), with the two gland mentions treated
// as lighter secondary annotations exactly as the reference treats its own
// minor detail (the adrenal glands) — a small label and dashed connector,
// not a full numbered card.
//
// Cards and minor labels stack in normal document flow (DiagramFrame) and
// are connected to their illustration anchor by DiagramFrame's generic
// leader-line overlay, matched via `data-leader-anchor`/`data-leader-target`
// ids and drawn from real measured positions. An earlier version placed
// cards at fixed evenly-spaced percentages of the illustration's height;
// measurement showed every card overlapping its neighbor at every
// breakpoint (card content is taller than an even 1/6 slot), so that
// scheme was replaced with normal-flow stacking, which cannot overlap.
//
// The illustration itself stays the existing simplified schematic body
// outline rather than fabricated realistic anatomical artwork: this
// project's asset rules require honestly-sourced or honestly-labeled
// illustrations, and no real medical illustration asset has been sourced
// for this device. Region shapes are filled with the card's own color so
// the "colored band over the region's exact extent" principle still holds.
import DiagramFrame from "./diagrams/DiagramFrame.astro";
import DiagramCard from "./diagrams/DiagramCard.astro";

const regionDescription = "أحد الأجزاء التي يقوم الجهاز بتصويرها";
const glandDescription = "من الأجزاء الدقيقة التي يمكن للجهاز تصويرها";

// viewBox is 260 x 400. Anchor coordinates mark each region's true
// anatomical position on the illustration; the leader line to each card is
// drawn at runtime from this anchor's real screen position to the card's
// real screen position (see DiagramFrame's leader-line overlay), so no
// hand-computed slot percentage is needed.
const regions = [
  { number: 1, title: "رأس", color: "#e11d48", anchorX: 165, anchorY: 42 },
  { number: 2, title: "عنق", color: "#16a34a", anchorX: 150, anchorY: 107 },
  { number: 3, title: "صدر", color: "#2563eb", anchorX: 188, anchorY: 155 },
  { number: 4, title: "بطن", color: "#9333ea", anchorX: 192, anchorY: 240 },
  { number: 5, title: "حوض", color: "#db2777", anchorX: 188, anchorY: 330 },
  { number: 6, title: "العمود الفقري", color: "#d97706", anchorX: 130, anchorY: 360 },
];

const minorAnnotations = [
  { id: "gland-1", label: "الغدة النخامية", description: glandDescription, anchorX: 98, anchorY: 64 },
  { id: "gland-2", label: "الغدة فوق الكلوية", description: glandDescription, anchorX: 72, anchorY: 240 },
];
---

<DiagramFrame ariaLabel="مخطط توضيحي: مكونات تصوير مقاطع الجسم">
  <Fragment slot="minor">
    {minorAnnotations.map((m) => (
      <div class="diagram-minor-item" data-leader-target={m.id} title={m.description}>
        <span class="diagram-minor-label">{m.label}</span>
      </div>
    ))}
  </Fragment>

  <svg
    slot="illustration"
    class="tomography-svg"
    viewBox="0 0 260 400"
    role="presentation"
    preserveAspectRatio="xMidYMid meet"
  >
    <!-- body silhouette (deliberately simplified, not anatomical) — each
         shape filled with its card's own color, giving the "colored band
         over the region's exact extent" the golden reference uses. -->
    <circle cx="130" cy="55" r="38" class="body-outline" style="--region-color: #e11d48" />
    <rect x="108" y="90" width="44" height="34" rx="10" class="body-outline" style="--region-color: #16a34a" />
    <rect x="70" y="120" width="120" height="92" rx="18" class="body-outline" style="--region-color: #2563eb" />
    <rect x="65" y="210" width="130" height="92" rx="16" class="body-outline" style="--region-color: #9333ea" />
    <rect x="70" y="300" width="120" height="70" rx="20" class="body-outline" style="--region-color: #db2777" />

    <!-- spine: its own region too (card 6), drawn as a line rather than a
         filled band since it is a slender structure, not an area -->
    <line x1="130" y1="120" x2="130" y2="368" class="spine-line" style="--region-color: #d97706" />

    <!-- region anchor dots: also the leader line's start point, read by
         DiagramFrame's overlay script via data-leader-anchor -->
    <g class="anchors">
      {regions.map((r) => (
        <circle
          cx={r.anchorX}
          cy={r.anchorY}
          r="4"
          class="anchor"
          style={`--region-color: ${r.color}`}
          data-leader-anchor={String(r.number)}
          data-leader-color={r.color}
        />
      ))}
    </g>

    <!-- minor (gland) anchor dots: lighter weight, dashed leader line -->
    <g class="minor-anchors">
      {minorAnnotations.map((m) => (
        <circle
          cx={m.anchorX}
          cy={m.anchorY}
          r="2.5"
          class="minor-anchor"
          data-leader-anchor={m.id}
          data-leader-color="var(--neo-muted)"
          data-leader-width="1"
          data-leader-dashed=""
        />
      ))}
    </g>

    <!-- optional slice-sweep animation element (hidden unless "playing") -->
    <rect x="72" y="14" width="116" height="6" rx="3" class="scan-line" />
  </svg>

  <Fragment slot="cards">
    {regions.map((r) => (
      <DiagramCard
        number={r.number}
        title={r.title}
        description={regionDescription}
        leaderId={String(r.number)}
        color={r.color}
      />
    ))}
  </Fragment>

  <Fragment slot="caption">
    <p class="tomography-caption">سماكة المقطع: 1ملم</p>
  </Fragment>

  <Fragment slot="controls">
    <button type="button" class="diagram-replay-button">تشغيل حركة المسح</button>
  </Fragment>
</DiagramFrame>

<style>
  /* Fills the row's full height (set by whichever of illustration/cards is
     naturally tallest — see DiagramFrame's grid) rather than a fixed
     aspect-ratio-derived height, so a taller card column never leaves the
     illustration short of the row. preserveAspectRatio="xMidYMid meet"
     keeps the artwork itself undistorted, letterboxing if needed. */
  .tomography-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .body-outline {
    fill: color-mix(in srgb, var(--region-color) 22%, var(--neo-bg));
    stroke: var(--region-color);
    stroke-width: 2;
    pointer-events: none;
  }

  .spine-line {
    stroke: var(--region-color);
    stroke-width: 2;
    stroke-dasharray: 4 4;
    pointer-events: none;
  }

  .anchor {
    fill: var(--region-color);
    pointer-events: none;
  }

  .minor-anchor {
    fill: var(--neo-muted);
    pointer-events: none;
  }

  .scan-line {
    fill: var(--neo-primary);
    opacity: 0;
    pointer-events: none;
  }

  svg.playing .scan-line {
    animation: scan-sweep 2.2s ease-in-out;
  }

  @keyframes scan-sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    10% {
      opacity: 0.55;
    }
    90% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: translateY(348px);
    }
  }

  .diagram-minor-item {
    text-align: end;
    padding-inline-end: 0.4rem;
  }

  .diagram-minor-label {
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.65rem;
    line-height: 1.25;
    color: var(--neo-muted);
  }

  @media (min-width: 640px) {
    .diagram-minor-label {
      font-size: 0.75rem;
    }
  }

  .tomography-caption {
    margin: 0;
    font-family: "Cairo", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
  }

  .diagram-replay-button {
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    color: var(--neo-primary);
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-replay-button:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-replay-button {
      display: none;
    }
  }
</style>
