---
// Educational concept diagram for Device 05 (Computerized X-ray Scan Machine / Tomography).
// Every label below is a direct restatement of device-05.description.ar in page-01.json —
// no anatomy, component, or specification beyond that sentence is introduced.
//
// Built on the Educational Diagram System (DiagramFrame + DiagramLegend):
// the illustration carries only shapes and small numbered markers, never
// Arabic text — labels live entirely in the HTML legend zone, connected to
// their marker by a shared number instead of a leader line reaching across
// the diagram. This is a structural fix, not a repositioning of the old
// in-SVG labels: see git history on this file for the earlier approach
// that caused label/illustration/leader-line collisions.
import DiagramFrame from "./diagrams/DiagramFrame.astro";
import DiagramLegend from "./diagrams/DiagramLegend.astro";

const legendItems = [
  { region: "head", number: 1, label: "رأس" },
  { region: "pituitary", number: 2, label: "الغدة النخامية" },
  { region: "neck", number: 3, label: "عنق" },
  { region: "chest", number: 4, label: "صدر" },
  { region: "abdomen", number: 5, label: "بطن" },
  { region: "adrenal", number: 6, label: "الغدة فوق الكلوية" },
  { region: "pelvis", number: 7, label: "حوض" },
  { region: "spine", number: 8, label: "العمود الفقري" },
];
---

<DiagramFrame ariaLabel="مخطط تفاعلي: تصوير مقاطع الجسم">
  <svg
    slot="illustration"
    class="tomography-svg"
    viewBox="80 0 160 395"
    role="presentation"
    preserveAspectRatio="xMidYMid meet"
  >
    <!-- body silhouette (deliberately simplified, not anatomical) -->
    <circle cx="160" cy="55" r="38" class="body-outline" />
    <rect x="138" y="90" width="44" height="34" rx="10" class="body-outline" />
    <rect x="100" y="120" width="120" height="92" rx="18" class="body-outline" />
    <rect x="95" y="210" width="130" height="92" rx="16" class="body-outline" />
    <rect x="100" y="300" width="120" height="70" rx="20" class="body-outline" />

    <!-- spine: decorative line only, no text, no hit area -->
    <line x1="160" y1="120" x2="160" y2="368" class="spine-line" />

    <!-- tiny reference dots at the glands' true (illustrative) position -->
    <circle cx="160" cy="58" r="3" class="gland-dot" />
    <circle cx="145" cy="268" r="3" class="gland-dot" />

    <!-- numbered markers: each corresponds 1:1 to a legend entry below -->
    <circle cx="179" cy="44" r="10" class="marker" data-region="head" />
    <text x="179" y="44" class="marker-number">1</text>

    <circle cx="143" cy="49" r="10" class="marker" data-region="pituitary" />
    <text x="143" y="49" class="marker-number">2</text>

    <circle cx="160" cy="107" r="10" class="marker" data-region="neck" />
    <text x="160" y="107" class="marker-number">3</text>

    <circle cx="130" cy="145" r="10" class="marker" data-region="chest" />
    <text x="130" y="145" class="marker-number">4</text>

    <circle cx="125" cy="230" r="10" class="marker" data-region="abdomen" />
    <text x="125" y="230" class="marker-number">5</text>

    <circle cx="125" cy="275" r="10" class="marker" data-region="adrenal" />
    <text x="125" y="275" class="marker-number">6</text>

    <circle cx="130" cy="325" r="10" class="marker" data-region="pelvis" />
    <text x="130" y="325" class="marker-number">7</text>

    <circle cx="160" cy="355" r="10" class="marker" data-region="spine" />
    <text x="160" y="355" class="marker-number">8</text>

    <!-- static slice-thickness caliper (purely visual, no text — the
         measurement is stated in words in the caption zone below) -->
    <g class="thickness-indicator">
      <line x1="95" y1="205" x2="111" y2="205" class="thickness-tick" />
      <line x1="95" y1="215" x2="111" y2="215" class="thickness-tick" />
      <line x1="97" y1="205" x2="97" y2="215" class="thickness-tick" />
    </g>

    <!-- optional slice-sweep animation element (hidden unless "playing") -->
    <rect x="95" y="14" width="130" height="6" rx="3" class="scan-line" />
  </svg>

  <Fragment slot="legend">
    <DiagramLegend items={legendItems} />
  </Fragment>

  <Fragment slot="caption">
    <p class="tomography-caption">سماكة المقطع: 1ملم</p>
  </Fragment>

  <Fragment slot="controls">
    <button type="button" class="diagram-replay-button">تشغيل حركة المسح</button>
  </Fragment>
</DiagramFrame>

<style>
  .tomography-svg {
    width: 100%;
    max-width: 220px;
    height: auto;
  }

  .body-outline {
    fill: var(--neo-bg);
    stroke: var(--neo-muted);
    stroke-width: 2;
    pointer-events: none;
  }

  .spine-line {
    stroke: var(--neo-muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    pointer-events: none;
  }

  .gland-dot {
    fill: var(--neo-primary);
    pointer-events: none;
    opacity: 0.6;
  }

  .marker {
    fill: var(--neo-primary);
    stroke: var(--neo-bg);
    stroke-width: 1.5;
    pointer-events: none;
  }

  .marker-number {
    font-family: "Cairo", sans-serif;
    font-size: 11px;
    font-weight: 700;
    fill: #ffffff;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }

  circle.marker.is-active {
    stroke: var(--neo-text);
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(1.35);
  }

  .thickness-tick {
    stroke: var(--neo-text);
    stroke-width: 1.5;
    pointer-events: none;
  }

  .scan-line {
    fill: var(--neo-primary);
    opacity: 0;
    pointer-events: none;
  }

  svg.playing .scan-line {
    animation: scan-sweep 2.2s ease-in-out;
  }

  @keyframes scan-sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    10% {
      opacity: 0.55;
    }
    90% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: translateY(355px);
    }
  }

  .tomography-caption {
    margin: 0;
    font-family: "Cairo", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
  }

  .diagram-replay-button {
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    color: var(--neo-primary);
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-replay-button:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-replay-button {
      display: none;
    }
  }
</style>
