---
// Educational concept diagram for Device 05 (Computerized X-ray Scan Machine / Tomography).
// Every label below is a direct restatement of device-05.description.ar in page-01.json —
// no anatomy, component, or specification beyond that sentence is introduced.
//
// Visual Style #2 — Simplified Educational Infographic (project-wide standard):
// direct Arabic labels sit outside the illustration, connected by short
// leader lines — no numbered legend. Labels are spaced evenly down each
// column (guaranteed room for two-line Arabic text, regardless of how
// close together the real anatomical points are — e.g. the pituitary
// gland sits right next to the head) while each leader line runs
// diagonally from the true anatomical point to that evenly-spaced label
// position. This is safe from crossings by construction, not by luck:
// within one column, both the anatomical points (top to bottom) and the
// label positions (evenly spaced, same top-to-bottom order) are sorted
// identically, and straight lines drawn between two same-ordered
// sequences on parallel tracks never cross. Because labels live in a
// separate HTML column (not SVG text), a leader line can never pass
// through label text either — it ends at the stage edge, not inside it.
import DiagramFrame from "./diagrams/DiagramFrame.astro";
import DiagramCallout from "./diagrams/DiagramCallout.astro";

// viewBox is 260 x 400. labelPercent positions the label evenly in its
// column; anchor{X,Y} is the true point on the illustration the leader
// line originates from — the two need not match, the line diagonals
// between them.
//
// Percentages below aren't arbitrary: measured at the narrowest supported
// width (375px), a two-line Arabic label at this font size renders ~35px
// tall and a one-line label ~18px. Positions are spaced so that even two
// adjacent two-line labels keep a real measured pixel gap between their
// rendered edges, not just a percentage that happens to look even —
// evenly-spaced percentages alone under-counted actual text height and
// produced a real, measured overlap at 375px in testing (adrenal gland /
// spine labels), which is why the columns are 4-and-4 rather than 3-and-5:
// the abdomen is wide enough that its adrenal-gland label can anchor from
// either side, and moving it out of the crowded five-label column is what
// actually fixed the overlap — reflowing content, not just shrinking text.
const startCallouts = [
  { label: "رأس", labelPercent: 12, anchorX: 152, anchorY: 42 },
  { label: "صدر", labelPercent: 38, anchorX: 182, anchorY: 148 },
  { label: "الغدة فوق الكلوية", labelPercent: 64, anchorX: 160, anchorY: 268 },
  { label: "حوض", labelPercent: 90, anchorX: 182, anchorY: 325 },
];

const endCallouts = [
  { label: "الغدة النخامية", labelPercent: 14, anchorX: 112, anchorY: 64 },
  { label: "عنق", labelPercent: 42, anchorX: 108, anchorY: 107 },
  { label: "بطن", labelPercent: 62, anchorX: 78, anchorY: 222 },
  { label: "العمود الفقري", labelPercent: 88, anchorX: 130, anchorY: 362 },
];

const viewBoxHeight = 400;
const toSvgY = (percent: number) => (percent / 100) * viewBoxHeight;
---

<DiagramFrame ariaLabel="مخطط توضيحي: تصوير مقاطع الجسم">
  <Fragment slot="callouts-start">
    {startCallouts.map((c) => <DiagramCallout label={c.label} topPercent={c.labelPercent} side="start" />)}
  </Fragment>

  <Fragment slot="callouts-end">
    {endCallouts.map((c) => <DiagramCallout label={c.label} topPercent={c.labelPercent} side="end" />)}
  </Fragment>

  <svg
    slot="illustration"
    class="tomography-svg"
    viewBox="0 0 260 400"
    role="presentation"
    preserveAspectRatio="xMidYMid meet"
  >
    <!-- body silhouette (deliberately simplified, not anatomical) -->
    <circle cx="130" cy="55" r="38" class="body-outline" />
    <rect x="108" y="90" width="44" height="34" rx="10" class="body-outline" />
    <rect x="70" y="120" width="120" height="92" rx="18" class="body-outline" />
    <rect x="65" y="210" width="130" height="92" rx="16" class="body-outline" />
    <rect x="70" y="300" width="120" height="70" rx="20" class="body-outline" />

    <!-- spine: decorative line only -->
    <line x1="130" y1="120" x2="130" y2="368" class="spine-line" />

    <!-- leader lines: each runs from the true anatomical anchor to the
         stage edge at the label's evenly-spaced height. Within a column,
         anchors and label positions share the same top-to-bottom order,
         so these diagonals are guaranteed not to cross one another (see
         comment above), and they can't cross a label since labels live
         outside the SVG entirely. -->
    <g class="leaders">
      {startCallouts.map((c) => (
        <line x1={c.anchorX} y1={c.anchorY} x2="260" y2={toSvgY(c.labelPercent)} class="leader" />
      ))}
      {endCallouts.map((c) => (
        <line x1={c.anchorX} y1={c.anchorY} x2="0" y2={toSvgY(c.labelPercent)} class="leader" />
      ))}
    </g>

    <!-- attachment points: mark precisely where each leader line meets the structure -->
    <g class="anchors">
      {[...startCallouts, ...endCallouts].map((c) => (
        <circle cx={c.anchorX} cy={c.anchorY} r="3.5" class="anchor" />
      ))}
    </g>

    <!-- static slice-thickness caliper (purely visual, no text — the
         measurement is stated in words in the caption zone below);
         placed between the chest and abdomen leader lines' heights, on
         the side with no leader line traffic at that height -->
    <g class="thickness-indicator">
      <line x1="182" y1="203" x2="198" y2="203" class="thickness-tick" />
      <line x1="182" y1="213" x2="198" y2="213" class="thickness-tick" />
      <line x1="184" y1="203" x2="184" y2="213" class="thickness-tick" />
    </g>

    <!-- optional slice-sweep animation element (hidden unless "playing") -->
    <rect x="72" y="14" width="116" height="6" rx="3" class="scan-line" />
  </svg>

  <Fragment slot="caption">
    <p class="tomography-caption">سماكة المقطع: 1ملم</p>
  </Fragment>

  <Fragment slot="controls">
    <button type="button" class="diagram-replay-button">تشغيل حركة المسح</button>
  </Fragment>
</DiagramFrame>

<style>
  .tomography-svg {
    width: 100%;
    aspect-ratio: 260 / 400;
    height: auto;
  }

  .body-outline {
    fill: var(--neo-bg);
    stroke: var(--neo-muted);
    stroke-width: 2;
    pointer-events: none;
  }

  .spine-line {
    stroke: var(--neo-muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    pointer-events: none;
  }

  .leader {
    stroke: var(--neo-muted);
    stroke-width: 1.25;
    pointer-events: none;
  }

  .anchor {
    fill: var(--neo-primary);
    pointer-events: none;
  }

  .thickness-tick {
    stroke: var(--neo-text);
    stroke-width: 1.5;
    pointer-events: none;
  }

  .scan-line {
    fill: var(--neo-primary);
    opacity: 0;
    pointer-events: none;
  }

  svg.playing .scan-line {
    animation: scan-sweep 2.2s ease-in-out;
  }

  @keyframes scan-sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    10% {
      opacity: 0.55;
    }
    90% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      transform: translateY(348px);
    }
  }

  .tomography-caption {
    margin: 0;
    font-family: "Cairo", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neo-muted);
  }

  .diagram-replay-button {
    border: none;
    border-radius: var(--neo-radius-sm);
    background: var(--neo-surface);
    color: var(--neo-primary);
    font-family: "Cairo", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    box-shadow:
      3px 3px 6px var(--neo-shadow-dark),
      -3px -3px 6px var(--neo-shadow-light);
  }

  .diagram-replay-button:focus-visible {
    outline: 2px solid var(--neo-primary);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-replay-button {
      display: none;
    }
  }
</style>
