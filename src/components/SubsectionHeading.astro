---
// A mid-level heading for "subsection" blocks — sits between a
// SectionHeader (full neo-surface-soft card, --neo-font-size-h2) and
// ordinary body content, establishing the Chapter > Section > Subsection >
// body hierarchy the source itself uses (e.g. "1-3-2 أنبوبة الاشعة
// السينية" nested under section "1-3"). Deliberately NOT another boxed
// card — a plain underlined heading is enough to read as one tier below
// the section card without stacking another full surface on the page.
interface Props {
  number?: string;
  titleAr: string;
  titleEn?: string;
}

const { number, titleAr, titleEn } = Astro.props;
---

<h3 class="subsection-heading">
  {number && <span class="subsection-badge" dir="ltr">{number}</span>}
  <span class="subsection-title-ar">{titleAr}</span>
  {titleEn && <span class="subsection-title-en" dir="ltr">— {titleEn}</span>}
</h3>

<style>
  .subsection-heading {
    margin: var(--neo-space-md) 0 var(--neo-space-sm);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--neo-space-xs);
    font-size: var(--neo-font-size-h3);
    font-weight: 700;
    color: var(--neo-text);
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--neo-shadow-dark);
  }

  .subsection-badge {
    flex: 0 0 auto;
    color: var(--neo-primary);
    font-weight: 800;
  }

  .subsection-title-en {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--neo-muted);
    unicode-bidi: isolate;
  }
</style>
