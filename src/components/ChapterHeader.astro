---
interface Props {
  chapterNumber: number;
  chapterLabel: string;
  titleAr: string;
  titleEn: string;
}

const { chapterNumber, chapterLabel, titleAr, titleEn } = Astro.props;
---

<header class="chapter-header">
  <div class="chapter-eyebrow">
    <span class="chapter-badge" dir="ltr">{chapterNumber}</span>
    <span class="chapter-label">{chapterLabel}</span>
  </div>
  <h1 class="chapter-title">{titleAr}</h1>
  <p class="chapter-title-en" dir="ltr">{titleEn}</p>
</header>

<style>
  .chapter-header {
    text-align: center;
    padding: var(--neo-space-lg) var(--neo-space-md);
    border-bottom: 1px solid var(--neo-shadow-dark);
  }

  .chapter-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--neo-space-xs);
    margin: 0 0 var(--neo-space-sm);
  }

  .chapter-badge {
    display: inline-grid;
    place-items: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--neo-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .chapter-label {
    color: var(--neo-muted);
    font-weight: 600;
    font-size: 1rem;
  }

  .chapter-title {
    margin: 0;
    font-size: var(--neo-font-size-h1);
    font-weight: 700;
    color: var(--neo-text);
  }

  .chapter-title-en {
    margin: var(--neo-space-xs) 0 0;
    color: var(--neo-primary);
    font-weight: 600;
    font-size: 1.1rem;
    unicode-bidi: isolate;
  }

  @media (max-width: 640px) {
    .chapter-header {
      padding: var(--neo-space-md) var(--neo-space-sm);
    }
  }
</style>
