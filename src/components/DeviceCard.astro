---
import "../styles/device-illustration-animations.css";

interface DeviceImageCredit {
  source: string;
  sourceUrl?: string;
  license: string;
  licenseUrl?: string;
}

interface DeviceImage {
  src: string;
  alt: string;
  credit?: DeviceImageCredit;
}

interface Props {
  number: number;
  nameAr: string;
  nameEn: string;
  description: string;
  image?: DeviceImage;
}

const { number, nameAr, nameEn, description, image } = Astro.props;
const resolvedImageSrc = image ? import.meta.env.BASE_URL.replace(/\/$/, "") + image.src : undefined;
---

<article class="device-card neo-surface-soft">
  <div class="device-card-header">
    <span class="device-number" aria-hidden="true">{number}</span>
    <div class="device-titles">
      <h3 class="device-name-ar">{nameAr}</h3>
      <p class="device-name-en" dir="ltr">{nameEn}</p>
    </div>
  </div>

  {Astro.slots.has("illustration") ? (
    <slot name="illustration" />
  ) : image ? (
    <div class="device-image">
      <img src={resolvedImageSrc} alt={image.alt} loading="lazy" />
    </div>
  ) : (
    <div class="device-image-placeholder neo-inset">
      <span class="placeholder-text">سيتم إضافة الصورة لاحقًا</span>
    </div>
  )}

  {image?.credit && (
    <p class="device-image-credit">
      المصدر:
      {image.credit.sourceUrl ? <a href={image.credit.sourceUrl} target="_blank" rel="noopener noreferrer">{image.credit.source}</a> : <span>{image.credit.source}</span>}
      {" · "}الترخيص:
      {image.credit.licenseUrl ? <a href={image.credit.licenseUrl} target="_blank" rel="noopener noreferrer">{image.credit.license}</a> : <span>{image.credit.license}</span>}
    </p>
  )}

  <p class="device-description">{description}</p>

  <slot name="visualization" />
</article>

<script>
  import { wireDeviceIllustrationEntrance } from "../scripts/deviceIllustrationEntrance.js";
  wireDeviceIllustrationEntrance(".device-illustration");
</script>

<style>
  .device-card {
    padding: var(--neo-space-md);
    display: flex;
    flex-direction: column;
    gap: var(--neo-space-sm);
    box-sizing: border-box;
    min-width: 0;
  }

  .device-card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--neo-space-sm);
    min-width: 0;
  }

  .device-number {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--neo-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
  }

  .device-titles {
    flex: 1;
    min-width: 0;
  }

  .device-name-ar {
    margin: 0;
    font-size: var(--neo-font-size-h3);
    font-weight: 700;
    color: var(--neo-text);
  }

  .device-name-en {
    margin: 2px 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--neo-primary);
    unicode-bidi: isolate;
  }

  .device-image-placeholder {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: var(--neo-space-sm);
    text-align: center;
  }

  .device-image {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: var(--neo-space-sm);
    border-radius: var(--neo-radius-sm);
    overflow: hidden;
    box-sizing: border-box;
  }

  .device-image img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }

  .device-image-credit {
    margin: 0;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--neo-muted);
    opacity: 0.8;
    direction: rtl;
  }

  .device-image-credit a {
    color: var(--neo-primary);
    text-decoration: none;
  }

  .device-image-credit a:hover,
  .device-image-credit a:focus-visible {
    text-decoration: underline;
  }

  .placeholder-text {
    color: var(--neo-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .device-description {
    margin: 0;
    font-size: 0.98rem;
    line-height: var(--neo-line-height);
    color: var(--neo-text);
  }
</style>
