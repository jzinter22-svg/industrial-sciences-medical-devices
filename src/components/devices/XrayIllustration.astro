---
import "../../styles/device-illustration-animations.css";
---

<figure class="device-image device-illustration illustration-xray">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 512 512"
    width="512"
    height="512"
    fill="none"
    stroke="#22303A"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    role="img"
    aria-label="جهاز الاشعة السينية ذات الصورة الثابتة"
  >
    <g id="floor-column">
      <rect x="70" y="110" width="26" height="320" rx="4" fill="#D8E1E6"></rect>
      <line x1="83" y1="126" x2="83" y2="424" stroke-width="2"></line>
      <rect x="58" y="430" width="50" height="14" rx="3" fill="#BCC9D1"></rect>
    </g>
    <g id="overhead-tube-arm">
      <rect x="96" y="120" width="150" height="18" rx="4" fill="#D8E1E6"></rect>
      <circle cx="102" cy="129" r="5" fill="#CFE2EC"></circle>
    </g>
    <g id="tube-mount">
      <rect x="222" y="136" width="14" height="26" fill="#D8E1E6"></rect>
      <circle cx="229" cy="146" r="5" fill="#CFE2EC"></circle>
    </g>
    <g id="tube-head">
      <rect x="182" y="160" width="96" height="56" rx="14" fill="#CFE2EC"></rect>
      <rect x="182" y="160" width="96" height="12" rx="6" fill="#EEF2F4"></rect>
      <line x1="200" y1="164" x2="200" y2="212" stroke-width="1.5"></line>
      <line x1="222" y1="164" x2="222" y2="212" stroke-width="1.5"></line>
      <line x1="244" y1="164" x2="244" y2="212" stroke-width="1.5"></line>
      <circle cx="192" cy="188" r="4" fill="#22303A"></circle>
      <rect x="182" y="178" width="8" height="20" rx="2" fill="#BCC9D1"></rect>
      <rect x="270" y="178" width="8" height="20" rx="2" fill="#BCC9D1"></rect>
    </g>
    <g id="collimator">
      <rect x="212" y="216" width="34" height="14" fill="#D8E1E6"></rect>
      <path d="M206 230 H252 L264 268 H194 Z" fill="#D8E1E6"></path>
      <line x1="206" y1="247" x2="252" y2="247" stroke-width="1.5"></line>
      <rect x="221" y="219" width="16" height="8" rx="1" fill="#EEF2F4"></rect>
      <circle cx="229" cy="223" r="2" fill="#22303A"></circle>
      <line x1="200" y1="260" x2="258" y2="260" stroke-width="1" opacity="0.6"></line>
    </g>
    <g id="beam-guide" opacity="0.5">
      <path d="M198 268 L210 300 M258 268 L246 300" stroke-width="1.2" stroke-dasharray="4 5"></path>
    </g>
    <g id="patient-table">
      <rect x="128" y="300" width="228" height="18" rx="5" fill="#EEF2F4"></rect>
      <line x1="146" y1="309" x2="342" y2="309" stroke-width="1.5"></line>
      <rect x="148" y="318" width="168" height="16" rx="3" fill="#CFE2EC"></rect>
      <rect x="160" y="321" width="46" height="9" rx="2" fill="#EEF2F4"></rect>
      <circle cx="336" cy="326" r="3.5" fill="#D8E1E6"></circle>
      <rect x="330" y="300" width="20" height="6" rx="1" fill="#BCC9D1"></rect>
    </g>
    <g id="table-pedestal">
      <rect x="212" y="334" width="52" height="102" fill="#D8E1E6"></rect>
      <line x1="238" y1="340" x2="238" y2="432" stroke-width="2"></line>
      <rect x="220" y="352" width="36" height="10" rx="2" fill="#CFE2EC"></rect>
      <rect x="220" y="376" width="36" height="10" rx="2" fill="#CFE2EC"></rect>
      <rect x="260" y="358" width="22" height="24" rx="3" fill="#EEF2F4"></rect>
      <circle cx="267" cy="365" r="2.5" fill="#D8E1E6"></circle>
      <circle cx="275" cy="365" r="2.5" fill="#D8E1E6"></circle>
      <line x1="264" y1="375" x2="278" y2="375" stroke-width="1"></line>
      <rect x="182" y="436" width="112" height="14" rx="3" fill="#BCC9D1"></rect>
    </g>
    <g id="wall-bucky-stand">
      <rect x="396" y="150" width="16" height="286" rx="3" fill="#D8E1E6"></rect>
      <line x1="404" y1="166" x2="404" y2="420" stroke-width="2"></line>
      <rect x="384" y="210" width="80" height="120" rx="5" fill="#EEF2F4"></rect>
      <rect x="396" y="222" width="56" height="96" rx="3" fill="#CFE2EC"></rect>
      <line x1="404" y1="234" x2="444" y2="234" stroke-width="1.2"></line>
      <line x1="404" y1="306" x2="444" y2="306" stroke-width="1.2"></line>
      <rect x="418" y="332" width="28" height="8" rx="2" fill="#D8E1E6"></rect>
      <rect x="388" y="172" width="32" height="8" rx="2" fill="#CFE2EC"></rect>
      <line x1="404" y1="176" x2="404" y2="176" stroke-width="0"></line>
      <circle cx="460" cy="270" r="3" fill="#22303A" opacity="0.4"></circle>
      <rect x="372" y="436" width="96" height="14" rx="3" fill="#BCC9D1"></rect>
    </g>
  </svg>
</figure>
