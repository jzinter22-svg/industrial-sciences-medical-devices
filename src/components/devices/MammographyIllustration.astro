---
// Animated device-04 illustration (mammography). Static artwork
// reproduced exactly from
// public/assets/svg/chapter-01/devices/mammography.svg. The paddle now
// moves through one controlled cycle — down, hold, exposure, return,
// long rest — instead of continuously bouncing, so it reads as a single
// compression event rather than mechanical pumping. The existing
// compression-gap dashed lines flash as the exposure indicator, timed
// to fire while the paddle is held down, and the detector tray gets a
// slight activation glow.
import "../../styles/device-illustration-animations.css";
---

<figure class="device-image device-illustration" data-device-animation="mammography">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="480"
    height="270"
    viewBox="0 0 480 270"
    role="img"
    aria-label="جهاز تصوير الثدي (الماموغرام)"
  >
    <rect x="300" y="228" width="60" height="14" rx="3" fill="#94a3b8" stroke="#263238" stroke-width="2.5"></rect>

    <rect x="322" y="60" width="16" height="172" rx="4" fill="#cbd5e1" stroke="#263238" stroke-width="2.5"></rect>

    <path d="M 330,90 A 78,78 0 0 0 250,168" fill="none" stroke="#cbd5e1" stroke-width="16" stroke-linecap="round"></path>
    <path d="M 330,90 A 78,78 0 0 0 250,168" fill="none" stroke="#263238" stroke-width="2.5"></path>

    <rect x="306" y="70" width="46" height="34" rx="8" fill="#F9E0A9" stroke="#263238" stroke-width="2.5"></rect>

    <g class="device-paddle-group">
      <rect x="196" y="140" width="70" height="8" rx="2" fill="#bfdbfe" stroke="#263238" stroke-width="1.5"></rect>
    </g>

    <rect class="device-detector-pulse" x="196" y="172" width="78" height="10" rx="2" fill="#94a3b8" stroke="#263238" stroke-width="2"></rect>

    <g class="device-mammo-exposure" stroke="#dc2626" stroke-width="1.6" stroke-dasharray="3 3" opacity="0.6">
      <line x1="210" y1="148" x2="210" y2="172"></line>
      <line x1="250" y1="148" x2="250" y2="172"></line>
    </g>

    <g fill="#bfdbfe" stroke="#263238" stroke-width="1.5">
      <circle cx="150" cy="128" r="14"></circle>
      <path d="M 132,146 Q 150,138 168,146 L 172,220 L 128,220 Z"></path>
    </g>
    <line x1="150" y1="220" x2="150" y2="238" stroke="#263238" stroke-width="3"></line>

    <g stroke="#263238" stroke-width="2" fill="none">
      <rect x="366" y="150" width="46" height="66" rx="4" fill="#e2e8f0"></rect>
    </g>
    <rect x="372" y="158" width="34" height="22" rx="2" fill="#1d4ed8"></rect>
    <circle cx="380" cy="196" r="5" fill="#cbd5e1" stroke="#263238" stroke-width="1.2"></circle>
    <circle cx="396" cy="196" r="5" fill="#cbd5e1" stroke="#263238" stroke-width="1.2"></circle>
  </svg>
</figure>
