---
import "../../styles/device-illustration-animations.css";
---

<figure class="device-image device-illustration illustration-mammography">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 512 512"
    width="512"
    height="512"
    fill="none"
    stroke="#22303A"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    role="img"
    aria-label="جهاز تصوير الثدي (الماموغرام)"
  >
    <g id="stand">
      <rect x="308" y="76" width="42" height="360" rx="5" fill="#D8E1E6"></rect>
      <line x1="329" y1="96" x2="329" y2="300" stroke-width="2"></line>
      <rect x="316" y="112" width="26" height="10" fill="#CFE2EC"></rect>
      <rect x="316" y="160" width="26" height="10" fill="#CFE2EC"></rect>
      <rect x="316" y="208" width="26" height="10" fill="#CFE2EC"></rect>
      <rect x="260" y="436" width="138" height="14" rx="3" fill="#BCC9D1"></rect>
    </g>
    <g id="rotation-bracket">
      <path d="M286 104 H306 A26 26 0 0 1 332 130 V266 A26 26 0 0 1 306 292 H286 Z" fill="#D8E1E6"></path>
      <circle cx="306" cy="130" r="4" fill="#22303A"></circle>
      <circle cx="306" cy="266" r="4" fill="#22303A"></circle>
    </g>
    <g id="x-ray-tube-head">
      <rect x="148" y="100" width="152" height="64" rx="12" fill="#CFE2EC"></rect>
      <rect x="148" y="100" width="152" height="12" rx="6" fill="#EEF2F4"></rect>
      <line x1="190" y1="106" x2="190" y2="158" stroke-width="1.5"></line>
      <line x1="232" y1="106" x2="232" y2="158" stroke-width="1.5"></line>
      <circle cx="160" cy="132" r="3.5" fill="#22303A"></circle>
    </g>
    <g id="collimator-neck">
      <path d="M196 172 H288 L276 192 H208 Z" fill="#D8E1E6"></path>
      <line x1="215" y1="180" x2="269" y2="180" stroke-width="1.5"></line>
    </g>
    <g id="face-guard">
      <path d="M186 172 H298 A6 6 0 0 1 300 184 L288 200 H198 L186 184 A6 6 0 0 1 186 172 Z" fill="#EEF2F4"></path>
    </g>
    <g id="compression-paddle-assembly">
      <rect x="288" y="200" width="14" height="18" fill="#BCC9D1"></rect>
      <rect x="282" y="164" width="16" height="60" fill="#BCC9D1"></rect>
      <rect x="192" y="236" width="98" height="10" rx="2" fill="#EEF2F4"></rect>
      <line x1="200" y1="241" x2="282" y2="241" stroke-width="1"></line>
      <circle cx="290" cy="172" r="3" fill="#22303A"></circle>
      <rect x="296" y="166" width="8" height="14" rx="2" fill="#D8E1E6"></rect>
    </g>
    <g id="breast-platform">
      <rect x="172" y="258" width="126" height="30" rx="4" fill="#EEF2F4"></rect>
      <line x1="184" y1="272" x2="288" y2="272" stroke-width="1.5"></line>
      <rect x="284" y="262" width="10" height="22" fill="#D8E1E6"></rect>
      <line x1="180" y1="264" x2="180" y2="282" stroke-width="1" opacity="0.5"></line>
    </g>
    <g id="handgrip">
      <rect x="292" y="306" width="44" height="12" rx="5" fill="#BCC9D1"></rect>
      <line x1="300" y1="312" x2="328" y2="312" stroke-width="1"></line>
    </g>
    <g id="control-panel">
      <rect x="294" y="330" width="80" height="56" rx="6" fill="#EEF2F4"></rect>
      <rect x="308" y="342" width="52" height="24" rx="3" fill="#CFE2EC"></rect>
      <line x1="314" y1="349" x2="352" y2="349" stroke-width="1.2"></line>
      <line x1="314" y1="356" x2="344" y2="356" stroke-width="1.2"></line>
      <circle cx="317" cy="375" r="4" fill="#D8E1E6"></circle>
      <circle cx="337" cy="375" r="4" fill="#D8E1E6"></circle>
      <circle cx="357" cy="375" r="4" fill="#D8E1E6"></circle>
    </g>
    <g id="base-pedestal">
      <line x1="341" y1="300" x2="341" y2="400" stroke-width="2"></line>
    </g>
  </svg>
</figure>
