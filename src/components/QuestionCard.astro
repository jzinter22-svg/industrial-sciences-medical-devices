---
// End-of-chapter exercise ("question" block) — per the Constitution,
// questions must remain visually identifiable as questions, distinct from
// explanatory prose. Some source questions (س4, س5) are split into
// lettered/numbered parts ("ما وظيفة كل من: أ- ... ب- ..."); the optional
// `parts` list preserves that structure instead of flattening it into one
// run-on sentence.
//
// `answer` (and each part's own `answer`) is additive: the original
// question-only layout is untouched above the "السؤال:"/"الحل:" labels,
// which only render when answer content actually exists, so a question
// without one yet still displays exactly as before.
interface QuestionPart {
  id: string;
  label: string;
  content: { ar: string };
  answer?: { ar: string };
}

interface Props {
  number: number;
  questionAr: string;
  parts?: QuestionPart[];
  answerAr?: string;
}

const { number, questionAr, parts, answerAr } = Astro.props;
const hasAnswer = Boolean(answerAr) || Boolean(parts?.some((part) => part.answer));
---

<article class="question-card neo-surface-soft">
  <div class="question-header">
    <span class="question-badge" dir="ltr">{number}</span>
    <div class="question-body">
      {hasAnswer && <span class="question-eyebrow">السؤال:</span>}
      <p class="question-text">{questionAr}</p>
    </div>
  </div>
  {parts && parts.length > 0 && (
    <ul class="question-parts">
      {parts.map((part) => (
        <li class="question-part">
          <div class="question-part-row">
            <span class="question-part-label" dir="ltr">{part.label}</span>
            <span class="question-part-text">{part.content.ar}</span>
          </div>
          {part.answer && (
            <div class="question-part-answer">
              <span class="answer-eyebrow">الحل:</span>
              <p class="answer-text">{part.answer.ar}</p>
            </div>
          )}
        </li>
      ))}
    </ul>
  )}
  {answerAr && (
    <div class="question-answer">
      <span class="answer-eyebrow">الحل:</span>
      <p class="answer-text">{answerAr}</p>
    </div>
  )}
</article>

<style>
  .question-card {
    padding: var(--neo-space-sm) var(--neo-space-md);
    display: flex;
    flex-direction: column;
    gap: var(--neo-space-xs);
    box-sizing: border-box;
  }

  .question-header {
    display: flex;
    align-items: flex-start;
    gap: var(--neo-space-sm);
  }

  .question-badge {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--neo-primary);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .question-body {
    flex: 1;
    min-width: 0;
  }

  .question-text {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    line-height: var(--neo-line-height);
    color: var(--neo-text);
  }

  .question-eyebrow,
  .answer-eyebrow {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--neo-muted);
  }

  .answer-eyebrow {
    color: #15803d;
  }

  .question-answer {
    margin-inline-start: calc(1.9rem + var(--neo-space-sm));
    padding-top: 0.3rem;
    border-top: 1px dashed var(--neo-shadow-dark);
  }

  .answer-text {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: var(--neo-line-height);
    color: var(--neo-text);
    white-space: pre-line;
  }

  .question-parts {
    margin: 0;
    padding-inline-start: 2.5rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .question-part {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .question-part-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .question-part-label {
    flex: 0 0 auto;
    font-weight: 700;
    color: var(--neo-primary);
  }

  .question-part-text {
    font-size: 0.92rem;
    color: var(--neo-text);
  }

  .question-part-answer {
    padding-top: 0.2rem;
  }
</style>
