---
import IntroCard from "./IntroCard.astro";
import DeviceCard from "./DeviceCard.astro";
import TomographySectionsDiagram from "./TomographySectionsDiagram.astro";
import XrayIllustration from "./devices/XrayIllustration.astro";
import FluoroscopyIllustration from "./devices/FluoroscopyIllustration.astro";
import AngiographyIllustration from "./devices/AngiographyIllustration.astro";
import MammographyIllustration from "./devices/MammographyIllustration.astro";
import CtIllustration from "./devices/CtIllustration.astro";
import DefinitionCard from "./DefinitionCard.astro";
import SubsectionHeading from "./SubsectionHeading.astro";
import ListBlock from "./ListBlock.astro";
import DiagramBlock from "./DiagramBlock.astro";
import PhotoBlock from "./PhotoBlock.astro";
import QuestionCard from "./QuestionCard.astro";
import EquationBlock from "./EquationBlock.astro";
import ExampleCard from "./ExampleCard.astro";
import TableBlock from "./TableBlock.astro";
import XraySystemBlockDiagram from "./diagrams/XraySystemBlockDiagram.astro";
import AnimatedTubeCrossSection from "./diagrams/AnimatedTubeCrossSection.astro";
import AnimatedKvControl from "./diagrams/AnimatedKvControl.astro";
import AnimatedMaControl from "./diagrams/AnimatedMaControl.astro";
import AnimatedTimerCircuit from "./diagrams/AnimatedTimerCircuit.astro";
import AnimatedTimerTypes from "./diagrams/AnimatedTimerTypes.astro";
import PulseGeneratorDiagram from "./diagrams/PulseGeneratorDiagram.astro";
import AnimatedFilmProcessor from "./diagrams/AnimatedFilmProcessor.astro";
import AScanBlockDiagram from "./diagrams/AScanBlockDiagram.astro";
import BScanBlockDiagram from "./diagrams/BScanBlockDiagram.astro";
import UltrasoundSystemDiagram from "./diagrams/UltrasoundSystemDiagram.astro";
import EchoSounderBlockDiagram from "./diagrams/EchoSounderBlockDiagram.astro";
import FetalPulseBlockDiagram from "./diagrams/FetalPulseBlockDiagram.astro";
import DeliveryMonitorBlockDiagram from "./diagrams/DeliveryMonitorBlockDiagram.astro";
import RadarDiagram from "./diagrams/RadarDiagram.astro";
import SpectrumDiagram from "./diagrams/SpectrumDiagram.astro";
import ReflectionRefractionDiagram from "./diagrams/ReflectionRefractionDiagram.astro";
import DopplerStationaryDiagram from "./diagrams/DopplerStationaryDiagram.astro";
import DopplerMovingDiagram from "./diagrams/DopplerMovingDiagram.astro";
import DopplerWavelengthDiagram from "./diagrams/DopplerWavelengthDiagram.astro";
import ProbeStructureDiagram from "./diagrams/ProbeStructureDiagram.astro";
import PulsedUltrasoundDiagram from "./diagrams/PulsedUltrasoundDiagram.astro";
import ContinuousDopplerDiagram from "./diagrams/ContinuousDopplerDiagram.astro";
import AScanTraceDiagram from "./diagrams/AScanTraceDiagram.astro";
import ScanComparisonDiagram from "./diagrams/ScanComparisonDiagram.astro";
import ScanTypesTraceDiagram from "./diagrams/ScanTypesTraceDiagram.astro";
import PowerSupplyCircuitDiagram from "./diagrams/PowerSupplyCircuitDiagram.astro";
import TransmitterCircuitDiagram from "./diagrams/TransmitterCircuitDiagram.astro";
import ReceiverCircuitDiagram from "./diagrams/ReceiverCircuitDiagram.astro";
import HeartAnatomyDiagram from "./diagrams/HeartAnatomyDiagram.astro";
import HeartValvesDiagram from "./diagrams/HeartValvesDiagram.astro";
import DoubleCirculationDiagram from "./diagrams/DoubleCirculationDiagram.astro";
import CardiacConductionDiagram from "./diagrams/CardiacConductionDiagram.astro";
import LimbElectrodeDiagram from "./diagrams/LimbElectrodeDiagram.astro";
import ChestElectrodeDiagram from "./diagrams/ChestElectrodeDiagram.astro";
import EinthovenTriangleDiagram from "./diagrams/EinthovenTriangleDiagram.astro";
import LeadWiringDiagram from "./diagrams/LeadWiringDiagram.astro";

// Chapter 2 diagram ids (c2-fig-2-XX) that have a hand-built animated
// replacement, same rationale as the Chapter 1 table above — the rest
// fall back to the generic DiagramBlock (static SVG or photographic
// figure, per docs/design/DIAGRAM_ANIMATION_AUDIT.md's "use the
// appropriate representation" rule).
const chapter2AnimatedDiagrams: Record<string, any> = {
  "c2-fig-2-1": SpectrumDiagram,
  "c2-fig-2-2": RadarDiagram,
  "c2-fig-2-3": ReflectionRefractionDiagram,
  "c2-fig-2-4": DopplerStationaryDiagram,
  "c2-fig-2-5": DopplerMovingDiagram,
  "c2-fig-2-6": DopplerWavelengthDiagram,
  "c2-fig-2-8": ProbeStructureDiagram,
  "c2-fig-2-11": PulsedUltrasoundDiagram,
  "c2-fig-2-12": ContinuousDopplerDiagram,
  "c2-fig-2-13": AScanBlockDiagram,
  "c2-fig-2-14": AScanTraceDiagram,
  "c2-fig-2-15": BScanBlockDiagram,
  "c2-fig-2-16": ScanComparisonDiagram,
  "c2-fig-2-18": ScanTypesTraceDiagram,
  "c2-fig-2-21": UltrasoundSystemDiagram,
  "c2-fig-2-23": EchoSounderBlockDiagram,
  "c2-fig-2-26": FetalPulseBlockDiagram,
  "c2-fig-2-27": PowerSupplyCircuitDiagram,
  "c2-fig-2-28": TransmitterCircuitDiagram,
  "c2-fig-2-29a": ReceiverCircuitDiagram,
  "c2-fig-2-29b": DeliveryMonitorBlockDiagram,
};

// Chapter 3 diagram ids (c3-fig-3-XX) that have a hand-built animated
// replacement, same rationale as the Chapter 1/2 tables above — the rest
// (photographic figures) fall back to the generic DiagramBlock.
const chapter3AnimatedDiagrams: Record<string, any> = {
  "c3-fig-3-1": HeartAnatomyDiagram,
  "c3-fig-3-3": HeartValvesDiagram,
  "c3-fig-3-4": DoubleCirculationDiagram,
  "c3-fig-3-6": CardiacConductionDiagram,
  "c3-fig-3-9": LimbElectrodeDiagram,
  "c3-fig-3-10": ChestElectrodeDiagram,
  "c3-fig-3-13": EinthovenTriangleDiagram,
  "c3-fig-3-15": LeadWiringDiagram,
};

// Chapter 1 device ids (device-0N) that have a hand-built animated
// inline-SVG illustration, rendered through DeviceCard's "illustration"
// slot. Any device not listed here falls back to DeviceCard's existing
// image/placeholder rendering, unchanged.
const deviceIllustrations: Record<string, any> = {
  "device-01": XrayIllustration,
  "device-02": FluoroscopyIllustration,
  "device-03": AngiographyIllustration,
  "device-04": MammographyIllustration,
  "device-05": CtIllustration,
};

interface Props {
  block: any;
}

const { block } = Astro.props;

// Every scientific diagram in the book (Figures 1-1 through 1-11) has an
// animated, hand-authored replacement for the plain static <img> render —
// see docs/design/DIAGRAM_ANIMATION_AUDIT.md for the per-diagram
// rationale. Diagrams not listed here (none currently) fall back to the
// generic DiagramBlock.
const pulseGeneratorVariantByDiagramId: Record<string, string> = {
  "diagram-07": "one-pulse",
  "diagram-08": "two-pulse",
  "diagram-09": "six-pulse",
  "diagram-10": "twelve-pulse",
};

const Chapter2Diagram = block.type === "diagram" ? chapter2AnimatedDiagrams[block.id] : undefined;
const Chapter3Diagram = block.type === "diagram" ? chapter3AnimatedDiagrams[block.id] : undefined;
const DeviceIllustration = block.type === "device" ? deviceIllustrations[block.id] : undefined;
---

{block.type === "paragraph" && <IntroCard content={block.content.ar} />}

{block.type === "device" && (
  <DeviceCard
    number={block.number}
    nameAr={block.name.ar}
    nameEn={block.name.en}
    description={block.description.ar}
    image={block.image}
  >
    {DeviceIllustration && <DeviceIllustration slot="illustration" />}
    {block.id === "device-05" && <TomographySectionsDiagram slot="visualization" />}
  </DeviceCard>
)}

{block.type === "subsection" && (
  <SubsectionHeading number={block.number} titleAr={block.title.ar} titleEn={block.title.en} />
)}

{block.type === "definition" && (
  <DefinitionCard
    number={block.number}
    termAr={block.term.ar}
    termEn={block.term.en}
    content={block.definition.ar}
  />
)}

{(block.type === "list" || block.type === "numbered-list") && (
  <ListBlock items={block.items} ordered={block.type === "numbered-list"} />
)}

{block.type === "diagram" && block.id === "diagram-01" && (
  <XraySystemBlockDiagram caption={block.caption?.ar} />
)}

{block.type === "diagram" && block.id === "diagram-02" && (
  <AnimatedTubeCrossSection caption={block.caption?.ar} />
)}

{block.type === "diagram" && block.id === "diagram-03" && (
  <AnimatedKvControl caption={block.caption?.ar} />
)}

{block.type === "diagram" && block.id === "diagram-04" && (
  <AnimatedMaControl caption={block.caption?.ar} />
)}

{block.type === "diagram" && block.id === "diagram-05" && (
  <AnimatedTimerCircuit caption={block.caption?.ar} />
)}

{block.type === "diagram" && block.id === "diagram-06" && (
  <AnimatedTimerTypes caption={block.caption?.ar} />
)}

{block.type === "diagram" && block.id in pulseGeneratorVariantByDiagramId && (
  <PulseGeneratorDiagram
    variant={pulseGeneratorVariantByDiagramId[block.id]}
    caption={block.caption?.ar}
  />
)}

{block.type === "diagram" && block.id === "diagram-11" && (
  <AnimatedFilmProcessor caption={block.caption?.ar} />
)}

{block.type === "diagram" && Chapter2Diagram && (
  <Chapter2Diagram caption={block.caption?.ar} />
)}

{block.type === "diagram" && Chapter3Diagram && (
  <Chapter3Diagram caption={block.caption?.ar} />
)}

{block.type === "diagram" &&
  !["diagram-01", "diagram-02", "diagram-03", "diagram-04", "diagram-05", "diagram-06", "diagram-11"].includes(block.id) &&
  !(block.id in pulseGeneratorVariantByDiagramId) &&
  !Chapter2Diagram &&
  !Chapter3Diagram && (
    <DiagramBlock src={block.src} alt={block.alt} caption={block.caption?.ar} />
  )}

{block.type === "photo" && (
  <PhotoBlock src={block.src} alt={block.alt} caption={block.caption?.ar} credit={block.credit} />
)}

{block.type === "question" && (
  <QuestionCard
    number={block.number}
    questionAr={block.question.ar}
    parts={block.parts}
    answerAr={block.answer?.ar}
  />
)}

{block.type === "equation" && (
  <EquationBlock formula={block.formula} equationNumber={block.equationNumber} legend={block.legend} />
)}

{block.type === "example" && (
  <ExampleCard number={block.number} problemAr={block.problem.ar} solutionSteps={block.solutionSteps} />
)}

{block.type === "table" && (
  <TableBlock captionAr={block.caption.ar} headers={block.headers} rows={block.rows} />
)}
